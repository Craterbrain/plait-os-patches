 .../statusbar/LineageStatusBarItemHolder.java |  2 -
 .../systemui/statusbar/NetworkTraffic.java    | 59 +++++++++++--------
 .../phone/PhoneStatusBarTransitions.java      |  3 +-
 4 files changed, 37 insertions(+), 33 deletions(-)

