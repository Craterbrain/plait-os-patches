diff --git a/services/core/java/com/android/server/pm/PlaitShizukuVisibility.java b/services/core/java/com/android/server/pm/PlaitShizukuVisibility.java
new file mode 100644
index 000000000..0fceb19dd
--- /dev/null
+++ b/services/core/java/com/android/server/pm/PlaitShizukuVisibility.java
@@ -0,0 +1,102 @@
+/*
