 .../server/pm/PackageManagerService.java      |   2 +
 .../server/pm/PlaitShizukuVisibility.java     | 102 ++++++++++++++++++
 3 files changed, 107 insertions(+)
 create mode 100644 services/core/java/com/android/server/pm/PlaitShizukuVisibility.java

