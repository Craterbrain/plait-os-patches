+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.pm;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Slog;
+
+import com.android.server.pm.pkg.PackageStateInternal;
+
+import java.util.Arrays;
+
+/**
+ * PlaitOS ships a code-less placeholder package named moe.shizuku.privileged.api: apps such as Aurora Store only offer their Shizuku
+ * features when Shizuku's own package is installed. The placeholder is hidden from every app except the ones Plait Broker authorized:
+ * the broker writes their app ids (comma separated) to the global setting plait_shizuku_visible. System apps (below the first
+ * application uid) always see it, like any package.
+ *
+ * Fails closed: a missing or unreadable setting means nobody sees the placeholder, and nothing else about package visibility changes.
+ */
+final class PlaitShizukuVisibility {
+    private static final String TAG = "PlaitShizukuVisibility";
+    static final String PACKAGE = "moe.shizuku.privileged.api";
+    private static final String SETTING = "plait_shizuku_visible";
+    private static final int[] NONE = new int[0];
+
+    /** Sorted app ids; replaced as a whole, so readers need no lock. */
+    private static volatile int[] sVisibleTo = NONE;
+
+    private final Context mContext;
+    private final Handler mHandler;
+
+    PlaitShizukuVisibility(Context context, Handler handler) {
+        mContext = context;
+        mHandler = handler;
+    }
+
+    /** True when the app with this app id must not see the target package. Cheap: a name check first. */
+    static boolean hides(int callingAppId, PackageStateInternal target) {
+        return PACKAGE.equals(target.getPackageName())
+                && Arrays.binarySearch(sVisibleTo, callingAppId) < 0;
+    }
+
+    void systemReady() {
+        final ContentResolver resolver = mContext.getContentResolver();
+        resolver.registerContentObserver(Settings.Global.getUriFor(SETTING), false,
+                new ContentObserver(mHandler) {
+                    @Override
+                    public void onChange(boolean selfChange) {
+                        reload(resolver, true);
+                    }
+                }, UserHandle.USER_ALL);
+        reload(resolver, false);
+    }
+
+    private static void reload(ContentResolver resolver, boolean invalidate) {
+        try {
+            final int[] ids = parse(Settings.Global.getString(resolver, SETTING));
+            if (Arrays.equals(ids, sVisibleTo)) {
+                return;
+            }
+            sVisibleTo = ids;
+            if (invalidate) {
+                // Apps and the system cache what getPackageInfo and friends answered; those answers just changed
+                final int reason = PackageMetrics.INVALIDATION_REASON_APP_FILTER_CHANGE;
+                PackageManagerService.invalidatePackageInfoCache(reason);
+                PackageManagerService.invalidateGetPackagesForUidCache(reason);
+                android.app.ApplicationPackageManager.invalidateQueryIntentActivitiesCache();
+            }
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "could not read " + SETTING + "; the placeholder stays hidden", e);
+            sVisibleTo = NONE;
+        }
+    }
+
+    /** "10234,10240" -> [10234, 10240]; anything that is not a number (the broker writes "-" for none) is ignored. */
+    static int[] parse(String value) {
+        if (value == null || value.isEmpty()) {
+            return NONE;
+        }
+        final String[] parts = value.split(",");
+        final int[] ids = new int[parts.length];
+        int n = 0;
+        for (String part : parts) {
+            try {
+                ids[n] = Integer.parseInt(part.trim());
+                n++;
+            } catch (NumberFormatException ignored) {
+                // skip
+            }
+        }
+        final int[] out = Arrays.copyOf(ids, n);
+        Arrays.sort(out);
+        return out;
+    }
+}
