+        // PlaitOS: start the default music player when a headset connects (plait_headset_connect_player)
+        BroadcastReceiver headsetReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                final String action = intent.getAction();
+                final boolean connected = AudioManager.ACTION_HEADSET_PLUG.equals(action)
+                        ? intent.getIntExtra("state", 0) == 1
+                        : intent.getIntExtra(BluetoothProfile.EXTRA_STATE, -1)
+                                == BluetoothProfile.STATE_CONNECTED;
+                if (!connected || Settings.System.getIntForUser(mContext.getContentResolver(),
+                        PLAIT_HEADSET_CONNECT_PLAYER, 0, UserHandle.USER_CURRENT) != 1) {
+                    return;
+                }
+                final Intent player = Intent.makeMainSelectorActivity(Intent.ACTION_MAIN,
+                        Intent.CATEGORY_APP_MUSIC);
+                player.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                try {
+                    startActivityAsUser(player, UserHandle.CURRENT);
+                } catch (ActivityNotFoundException e) {
+                    Slog.w(TAG, "No music player to start for the headset");
+                }
+            }
+        };
+        filter = new IntentFilter(AudioManager.ACTION_HEADSET_PLUG);
+        filter.addAction("android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED");
+        mContext.registerReceiverForAllUsers(headsetReceiver, filter, null, mHandler);
+
         mVibrator = (Vibrator) mContext.getSystemService(Context.VIBRATOR_SERVICE);
 
