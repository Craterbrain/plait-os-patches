+package com.android.systemui.qs.panels.data.repository
+
+/**
+ * Settings.System keys for the Quick Settings grid (written by Plait Settings). Unset = the stock
+ * resource value, so the grid looks like GrapheneOS until a value is chosen.
+ */
+internal object PlaitQsLayoutSettings {
+    const val QS_TILES_COLUMNS = "plait_qs_tiles_columns"
+    const val QS_TILES_COLUMNS_LANDSCAPE = "plait_qs_tiles_columns_landscape"
+    const val QS_TILES_ROWS = "plait_qs_tiles_rows"
+    const val QS_TILES_ROWS_LANDSCAPE = "plait_qs_tiles_rows_landscape"
+    const val QQS_TILES_ROWS = "plait_qqs_tiles_rows"
+    const val QQS_TILES_ROWS_LANDSCAPE = "plait_qqs_tiles_rows_landscape"
+}
diff --git a/packages/SystemUI/src/com/android/systemui/qs/panels/data/repository/QSColumnsRepository.kt b/packages/SystemUI/src/com/android/systemui/qs/panels/data/repository/QSColumnsRepository.kt
