From 6d713edb6223d3012b42cfdc7df1068419a30c28 Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Sat, 14 Nov 2026 20:39:59 -0600
Subject: [PATCH 22/75] PlaitOS: adapt app downgrade to GrapheneOS

- Key is Settings.Global plait_pm_downgrade_allowed (default 0 = stock),
  written by the PlaitOS page in Settings
- Read it before taking mPm.mLock instead of inside it: a settings read goes
  through the settings provider and does not belong under the package lock
- Also honor it for apps uninstalled with their data kept (DELETE_KEEP_DATA),
  the branch Android added after the crDroid patch
- Unchanged: system apps can't go below their preloaded version, APEX
  downgrades stay blocked, and the signature check still applies

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WNZzm3ssZ7eH5QDg4P9AiP
---
 .../android/server/pm/InstallPackageHelper.java    | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/services/core/java/com/android/server/pm/InstallPackageHelper.java b/services/core/java/com/android/server/pm/InstallPackageHelper.java
index c1e66851b..ae100e065 100644
--- a/services/core/java/com/android/server/pm/InstallPackageHelper.java
+++ b/services/core/java/com/android/server/pm/InstallPackageHelper.java
@@ -245,6 +245,8 @@ final class InstallPackageHelper {
     private final IncrementalManager mIncrementalManager;
     private final ApexManager mApexManager;
     private final Context mContext;
+    /** Settings.Global key (written by PlaitOS settings): allow installing lower app versions. */
+    private static final String PLAIT_PM_DOWNGRADE_ALLOWED = "plait_pm_downgrade_allowed";
     private final PackageAbiHelper mPackageAbiHelper;
     private final SharedLibrariesImpl mSharedLibraries;
     private final PackageManagerServiceInjector mInjector;
@@ -3026,6 +3028,11 @@ final class InstallPackageHelper {
         }
 
         String packageName = pkgLite.packageName;
+        // PlaitOS: app downgrades switched on in Settings (off by default). Read before taking
+        // mPm.mLock, as a settings read goes through the settings provider. System apps still
+        // can't go below their preloaded version, and APEX downgrades stay blocked.
+        final boolean plaitDowngradeAllowed = android.provider.Settings.Global.getInt(
+                mContext.getContentResolver(), PLAIT_PM_DOWNGRADE_ALLOWED, 0) == 1;
         synchronized (mPm.mLock) {
             PackageSetting dataOwnerPs = mPm.mSettings.getPackageLPr(packageName);
             if (dataOwnerPs == null) {
@@ -3075,7 +3082,7 @@ final class InstallPackageHelper {
             // archived apps
             if (dataOwnerPkg == null) {
                 if (!PackageManagerServiceUtils.isDowngradePermitted(installFlags,
-                        dataOwnerPs.isDebuggable())) {
+                        dataOwnerPs.isDebuggable()) && !plaitDowngradeAllowed) {
                     // The data exists on some users and downgrade is not permitted; a lower
                     // version of the app will not be allowed.
                     try {
@@ -3092,9 +3099,8 @@ final class InstallPackageHelper {
                 // system apps case like below.
             } else if (dataOwnerPkg != null && !dataOwnerPkg.isSdkLibrary()) {
                 if (!PackageManagerServiceUtils.isDowngradePermitted(installFlags,
-                        dataOwnerPkg.isDebuggable())
-                        && android.provider.Settings.Global.getInt(mContext.getContentResolver(),
-                        "pm_downgrade_allowed", 0) == 0) {
+                        dataOwnerPkg.isDebuggable()) && !plaitDowngradeAllowed) {
+                    // Downgrade is not permitted; a lower version of the app will not be allowed
                     try {
                         PackageManagerServiceUtils.checkDowngrade(dataOwnerPkg, pkgLite);
                     } catch (PackageManagerException e) {
