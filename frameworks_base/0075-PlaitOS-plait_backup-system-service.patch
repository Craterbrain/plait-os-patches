+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.plait;
+
+import android.os.ParcelFileDescriptor;
+
+/**
+ * PlaitOS's plait_backup service (system_server PlaitBackupService): app backups at root depth for the one app the
+ * Plait Broker manager has granted it to (Plait Backup). Every call carries a grant the manager signed; anything the
+ * grant does not cover is refused with a SecurityException.
+ *
+ * Streams are Android-DataBackup's archive parts: zstd-compressed tar. Calls block until the stream is done, so the
+ * caller reads (or writes) its end of the pipe on another thread. Keep the order of the methods: the Plait Backup app
+ * calls them with a hand-written proxy (an app can't use the framework's hidden copy of this class).
+ *
+ * @hide
+ */
+interface IPlaitBackup {
+    /** CE data, DE data, Android/data, obb, media of an app. */
+    const int PART_CE = 1;
+    const int PART_DE = 2;
+    const int PART_EXT_DATA = 3;
+    const int PART_EXT_OBB = 4;
+    const int PART_EXT_MEDIA = 5;
+
+    /** One data part as tar.zst into sink; false if the app has none. Scope backup.apps. */
+    boolean backupPart(String grant, String packageName, int userId, int part, in ParcelFileDescriptor sink);
+
+    /** The app's APKs (base + splits) as tar.zst into sink. Scope backup.apps. */
+    void backupApks(String grant, String packageName, int userId, in ParcelFileDescriptor sink);
+
+    /**
+     * Granted runtime permissions (one name per line), then a line "---", then app-ops in `appops get` form
+     * ("OP_NAME: mode"). Scope backup.apps.
+     */
+    String getState(String grant, String packageName, int userId);
+
+    /** Installs (or updates) the app from an APK tar.zst. Scope restore.apps. */
+    void installApks(String grant, String packageName, int userId, in ParcelFileDescriptor source);
+
+    /** Replaces one data part with a tar.zst; the app is force-stopped first. Scope restore.apps. */
+    void restorePart(String grant, String packageName, int userId, int part, in ParcelFileDescriptor source);
+
+    /**
+     * Grants the runtime permissions the app requests that are listed, and sets the listed app-ops. Scope
+     * restore.apps.
+     */
+    void restoreState(String grant, String packageName, int userId, in String[] permissions,
+            in String[] ops, in String[] modes);
+}
