     /** Settings.System key (written by Plait Settings): heads-up timeout in seconds; unset = stock. */
     private static final String PLAIT_HEADS_UP_TIMEOUT = "plait_heads_up_timeout";
 
+    /** The chosen timeout in ms; unset (or under a second) keeps the stock decay exactly. */
+    private int readPlaitHeadsUpTimeout(Context context) {
+        final int seconds = Settings.System.getIntForUser(context.getContentResolver(),
+                PLAIT_HEADS_UP_TIMEOUT, -1, UserHandle.USER_CURRENT);
+        return seconds >= 1 ? seconds * 1000 : mDecayDefault;
+    }
