                         MotionEvent.BUTTON_TERTIARY));
 
-        final float w = mQs.getView().getMeasuredWidth();
+        boolean showQsOverride = false;
+        // PlaitOS: mQs is null until the QS fragment exists (checked everywhere else here)
+        final View qsView = mQs != null ? mQs.getView() : null;
+        final float w = qsView != null ? qsView.getMeasuredWidth() : 0;
         final float x = event.getX();
         float region = w * 1.f / 4.f; // TODO overlay region fraction?
-        boolean showQsOverride = false;
 
-        switch (mOneFingerQuickSettingsIntercept) {
+        switch (qsView != null ? mOneFingerQuickSettingsIntercept : 0) {
             case 1: // Right side pulldown
-                showQsOverride = mQs.getView().isLayoutRtl() ? x < region : w - region < x;
+                showQsOverride = qsView.isLayoutRtl() ? x < region : w - region < x;
                 break;
             case 2: // Left side pulldown
-                showQsOverride = mQs.getView().isLayoutRtl() ? w - region < x : x < region;
+                showQsOverride = qsView.isLayoutRtl() ? w - region < x : x < region;
                 break;
             case 3: // PlaitOS: anywhere on the status bar
                 showQsOverride = true;
