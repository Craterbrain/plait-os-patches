From 0efba437cab43347f10698e6cae25d9fa8640164 Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Sun, 15 Nov 2026 17:12:42 -0600
Subject: [PATCH 76/78] PlaitOS: plait_backup refuses while the user's storage
 is locked

With credential-encrypted storage still locked, an app's CE data dir
can't be found by name, so a backup would quietly leave it out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../java/com/android/server/plait/PlaitBackupService.java     | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/services/core/java/com/android/server/plait/PlaitBackupService.java b/services/core/java/com/android/server/plait/PlaitBackupService.java
index b47eeff5d..30a2bda92 100644
--- a/services/core/java/com/android/server/plait/PlaitBackupService.java
+++ b/services/core/java/com/android/server/plait/PlaitBackupService.java
@@ -111,6 +111,10 @@ public final class PlaitBackupService extends IPlaitBackup.Stub {
             if (userId != UserHandle.getUserId(callingUid)) {
                 throw new SecurityException("only the caller's own user");
             }
+            // Locked credential storage hides the app's data (names are encrypted): it would look absent
+            if (!mContext.getSystemService(android.os.UserManager.class).isUserUnlocked(userId)) {
+                throw new IllegalStateException("unlock the phone first (its storage is still locked)");
+            }
             PlaitGrant g = PlaitGrant.verify(token, managerKey());
             if (g == null) throw new SecurityException("grant signature is invalid");
             if (g.uid != callingUid) throw new SecurityException("grant was issued to another uid");
