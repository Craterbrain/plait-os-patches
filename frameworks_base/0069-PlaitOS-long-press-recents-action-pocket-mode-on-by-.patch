         return onLongPressNavigationButtons(v, R.id.back, R.id.home);
     }
 
+    /**
+     * PlaitOS: with a recents long-press action chosen (Settings.System
+     * plait_recents_long_press_action), hand it to PhoneWindowManager as an APP_SWITCH down
+     * flagged LONG_PRESS plus a canceled up, which it consumes before recents would open. Unset,
+     * returns false so the press stays a normal click, as before.
+     */
+    private boolean onPlaitRecentsLongPress(View v) {
+        if (android.provider.Settings.System.getIntForUser(mContext.getContentResolver(),
+                "plait_recents_long_press_action", 0, android.os.UserHandle.USER_CURRENT) == 0) {
+            return false;
+        }
+        final long now = android.os.SystemClock.uptimeMillis();
+        final int displayId = v.getDisplay() != null
+                ? v.getDisplay().getDisplayId() : android.view.Display.DEFAULT_DISPLAY;
+        for (int action : new int[] {KeyEvent.ACTION_DOWN, KeyEvent.ACTION_UP}) {
+            final int flags = KeyEvent.FLAG_FROM_SYSTEM | KeyEvent.FLAG_VIRTUAL_HARD_KEY
+                    | (action == KeyEvent.ACTION_DOWN
+                            ? KeyEvent.FLAG_LONG_PRESS : KeyEvent.FLAG_CANCELED);
+            final KeyEvent ev = new KeyEvent(now, now, action, KeyEvent.KEYCODE_APP_SWITCH,
+                    action == KeyEvent.ACTION_DOWN ? 1 : 0, 0,
+                    android.view.KeyCharacterMap.VIRTUAL_KEYBOARD, 0, flags,
+                    android.view.InputDevice.SOURCE_KEYBOARD);
+            ev.setDisplayId(displayId);
+            android.hardware.input.InputManagerGlobal.getInstance().injectInputEvent(ev,
+                    android.hardware.input.InputManager.INJECT_INPUT_EVENT_MODE_ASYNC);
+        }
+        v.performHapticFeedback(android.view.HapticFeedbackConstants.LONG_PRESS);
+        return true;
+    }
+
     private boolean onLongPressBackRecents(View v) {
         return onLongPressNavigationButtons(v, R.id.back, R.id.recent_apps);
     }
