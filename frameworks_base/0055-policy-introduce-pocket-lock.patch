+    // vendor sensor
+    private int mVendorSensorState = VENDOR_SENSOR_UNKNOWN;
+    private int mLastVendorSensorState = VENDOR_SENSOR_UNKNOWN;
+    private String mVendorPocketSensor;
+    private boolean mVendorSensorRegistered;
