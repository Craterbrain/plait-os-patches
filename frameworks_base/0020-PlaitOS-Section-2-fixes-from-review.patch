@@ -174,8 +174,6 @@ import dagger.assisted.Assisted;
 import dagger.assisted.AssistedFactory;
 import dagger.assisted.AssistedInject;
 
-
-
 import java.util.ArrayList;
 import java.util.Arrays;
 import java.util.List;
@@ -735,7 +733,8 @@ public class GlobalActionsDialogLite implements DialogInterface.OnDismissListene
         final boolean keyguardLocked = km != null && km.inKeyguardRestrictedInputMode() && km.isKeyguardSecure();
         final boolean enabled = android.provider.Settings.Secure.getInt(mContext.getContentResolver(),
                 "plait_advanced_reboot", 0) == 1;
-        final boolean isPrimaryUser = android.os.UserHandle.getCallingUserId() == android.os.UserHandle.USER_SYSTEM;
+        // SystemUI runs as the system user for everyone, so ask UserTracker who is in front
+        final boolean isPrimaryUser = mUserTracker.getUserId() == android.os.UserHandle.USER_SYSTEM;
         return enabled && !keyguardLocked && isPrimaryUser;
     }
 
@@ -836,7 +835,9 @@ public class GlobalActionsDialogLite implements DialogInterface.OnDismissListene
                     }
                     break;
                 case USERS:
-                    if (mUserManager.getUsers().size() > 1) {
+                    // Work profiles and other non-switchable users don't count
+                    if (mUserManager.getUsers().stream()
+                            .filter(UserInfo::isUiSwitchableHumanUser).count() > 1) {
                         addUserActions(mUsersItems, currentUserInfo);
                         addIfShouldShowAction(tempActions, new UsersAction());
                     }
