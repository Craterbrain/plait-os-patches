 import com.android.systemui.dagger.SysUISingleton
@@ -26,7 +27,6 @@ import com.android.systemui.plugins.FalsingManager
 import com.android.systemui.plugins.statusbar.StatusBarStateController
 import com.android.systemui.statusbar.StatusBarState
 import com.android.systemui.statusbar.phone.CentralSurfaces
-import lineageos.providers.LineageSettings
 import javax.inject.Inject
 
 @SysUISingleton
@@ -38,23 +38,9 @@ class QQSGestureListener @Inject constructor(
         private val centralSurfaces: CentralSurfaces,
 ) : GestureDetector.SimpleOnGestureListener() {
 
-    private var doubleTapToSleepEnabled = false
     private val quickQsOffsetHeight: Int
 
     init {
-        val contentObserver = object : ContentObserver(null) {
-            override fun onChange(selfChange: Boolean) {
-                doubleTapToSleepEnabled = LineageSettings.System.getInt(
-                        context.contentResolver, LineageSettings.System.DOUBLE_TAP_SLEEP_GESTURE,
-                        if (context.resources.getBoolean(org.lineageos.platform.internal.
-                                R.bool.config_dt2sGestureEnabledByDefault)) 1 else 0) != 0
-            }
-        }
-        context.contentResolver.registerContentObserver(
-                LineageSettings.System.getUriFor(LineageSettings.System.DOUBLE_TAP_SLEEP_GESTURE),
-                false, contentObserver)
-        contentObserver.onChange(true)
-
         quickQsOffsetHeight = context.resources.getDimensionPixelSize(
                 com.android.internal.R.dimen.quick_qs_offset_height)
     }
@@ -65,7 +51,7 @@ class QQSGestureListener @Inject constructor(
         if (
             e.actionMasked == MotionEvent.ACTION_UP &&
                 !statusBarStateController.isDozing &&
-                doubleTapToSleepEnabled &&
+                isDoubleTapToSleepEnabled(context.contentResolver) &&
                 (e.getY() < quickQsOffsetHeight ||
                     statusBarStateController.getState() == StatusBarState.KEYGUARD &&
                         !centralSurfaces.isBouncerShowing()) &&
@@ -77,4 +63,14 @@ class QQSGestureListener @Inject constructor(
         return false
     }
 
+    companion object {
+        /** Settings.System key (written by Plait Settings); off by default. */
+        const val DOUBLE_TAP_TO_SLEEP = "plait_double_tap_to_sleep"
+
+        /** Read on each double tap, for the user in front, so no observer is needed. */
+        @JvmStatic
+        fun isDoubleTapToSleepEnabled(resolver: android.content.ContentResolver): Boolean =
+            Settings.System.getIntForUser(resolver, DOUBLE_TAP_TO_SLEEP, 0,
+                UserHandle.USER_CURRENT) != 0
+    }
 }
