+    /** Parses "HH:mm,HH:mm" into {fromHour, fromMinute, tillHour, tillMinute}, or null. */
+    @Nullable
+    private static int[] parseTimeWindow(String value) {
+        try {
+            final String[] times = value.split(",", 0);
+            if (times.length != 2) return null;
+            final String[] since = times[0].trim().split(":", 0);
+            final String[] till = times[1].trim().split(":", 0);
+            if (since.length != 2 || till.length != 2) return null;
+            final int[] out = {Integer.parseInt(since[0]), Integer.parseInt(since[1]),
+                    Integer.parseInt(till[0]), Integer.parseInt(till[1])};
+            if (out[0] < 0 || out[0] > 23 || out[2] < 0 || out[2] > 23
+                    || out[1] < 0 || out[1] > 59 || out[3] < 0 || out[3] > 59) {
+                return null;
+            }
+            return out;
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
