 </resources>
diff --git a/core/res/res/values/plait_styles.xml b/core/res/res/values/plait_styles.xml
new file mode 100644
index 000000000..dd211a15c
--- /dev/null
+++ b/core/res/res/values/plait_styles.xml
@@ -0,0 +1,22 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- PlaitOS framework styles. Pocket mode styles from crDroid's cr_styles.xml. -->
+<resources>
+    <!-- Pocket Mode -->
+    <style name="PocketModeTitle">
+        <item name="android:textSize">@dimen/pocket_mode_title_size</item>
+        <item name="android:textColor">@android:color/white</item>
+        <item name="android:alpha">0.85</item>
+    </style>
+
+    <style name="PocketModeInstructionsTitle">
+        <item name="android:textSize">@dimen/pocket_mode_instructions_title_size</item>
+        <item name="android:textColor">@android:color/white</item>
+        <item name="android:alpha">0.5</item>
+    </style>
+
+    <style name="PocketModeInstructionStep">
+        <item name="android:textSize">@dimen/pocket_mode_instructions_step_size</item>
+        <item name="android:textColor">@android:color/white</item>
+        <item name="android:alpha">0.5</item>
+    </style>
+</resources>
diff --git a/core/res/res/values/plait_symbols.xml b/core/res/res/values/plait_symbols.xml
