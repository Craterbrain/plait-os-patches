From ef205ab5be5e127c5ed213220b26521cf0d3b572 Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Sat, 14 Nov 2026 22:16:49 -0600
Subject: [PATCH 62/78] PlaitOS: adapt pocket lock to GrapheneOS

- Switch is Settings.System plait_pocket_judge (default off, as in crDroid),
  observed for all users, instead of a new Settings API constant
- Resources from crDroid's cr_*.xml (final values, after the refactor and
  the blue-area change) go to plait_config.xml, plait_dimens.xml,
  plait_styles.xml, plait_strings.xml and plait_symbols.xml
- config_pocketBridgeSysfsInpocket stays empty: the Pixel kernel has no
  pocket judge driver, so PocketBridgeService is not started

The service's SELinux types (pocket_service, service_contexts) come with
rom-overlay vendor/plait/sepolicy/private.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 core/res/res/values/plait_config.xml          | 17 ++++++++++++++
 core/res/res/values/plait_dimens.xml          | 16 ++++++++++++++
 core/res/res/values/plait_strings.xml         |  7 ++++++
 core/res/res/values/plait_styles.xml          | 22 +++++++++++++++++++
 core/res/res/values/plait_symbols.xml         | 13 +++++++++++
 .../server/pocket/PocketBridgeService.java    |  7 ++++--
 .../android/server/pocket/PocketService.java  |  7 ++++--
 7 files changed, 85 insertions(+), 4 deletions(-)
 create mode 100644 core/res/res/values/plait_config.xml
 create mode 100644 core/res/res/values/plait_dimens.xml
 create mode 100644 core/res/res/values/plait_styles.xml

diff --git a/core/res/res/values/plait_config.xml b/core/res/res/values/plait_config.xml
new file mode 100644
index 000000000..7437bdd5d
--- /dev/null
+++ b/core/res/res/values/plait_config.xml
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- PlaitOS framework config (overlayable per device). Pocket lock values from crDroid's cr_config.xml. -->
+<resources>
+    <!-- Defines the sysfs attribute path used by pocket bridge
+         to communicate pocket state to the pocket judge kernel driver.
+         Empty: no bridge (the Pixel kernel has no pocket judge driver). -->
+    <string name="config_pocketBridgeSysfsInpocket"></string>
+
+    <!-- Pocket Lock -->
+    <bool name="config_pocketModeSupported">true</bool>
+    <bool name="config_pocketUseLightSensor">true</bool>
+
+    <!-- Defines custom OEM sensor for pocket detection. -->
+    <string name="config_pocketJudgeVendorSensorName"></string>
+    <item name="config_pocketJudgeVendorSensorValue" format="float" type="dimen">1.0</item>
+    <string name="config_pocketJudgeVendorProximitySensorName"></string>
+</resources>
diff --git a/core/res/res/values/plait_dimens.xml b/core/res/res/values/plait_dimens.xml
