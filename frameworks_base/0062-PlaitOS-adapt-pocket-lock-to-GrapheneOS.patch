+    <java-symbol type="bool" name="config_pocketUseLightSensor" />
+
+    <!-- Pocket Service -->
+    <java-symbol type="string" name="config_pocketJudgeVendorSensorName" />
+    <java-symbol type="dimen" name="config_pocketJudgeVendorSensorValue" />
+    <java-symbol type="string" name="config_pocketJudgeVendorProximitySensorName" />
 </resources>
diff --git a/services/core/java/com/android/server/pocket/PocketBridgeService.java b/services/core/java/com/android/server/pocket/PocketBridgeService.java
index 5fc5e2721..537354144 100644
--- a/services/core/java/com/android/server/pocket/PocketBridgeService.java
+++ b/services/core/java/com/android/server/pocket/PocketBridgeService.java
@@ -33,7 +33,6 @@ import android.util.Slog;
 import com.android.internal.util.FastPrintWriter;
 import com.android.server.SystemService;
 
-import static android.provider.Settings.System.POCKET_JUDGE;
 
 /**
  * This service communicates pocket state to the pocket judge kernel driver.
@@ -44,6 +43,9 @@ import static android.provider.Settings.System.POCKET_JUDGE;
  */
 public class PocketBridgeService extends SystemService {
 
+    /** PlaitOS: Settings.System key (written by Plait Settings): pocket lock on (default off). */
+    private static final String POCKET_JUDGE = "plait_pocket_judge";
+
     private static final String TAG = PocketBridgeService.class.getSimpleName();
     private static final int MSG_POCKET_STATE_CHANGED = 1;
 
@@ -167,7 +169,8 @@ public class PocketBridgeService extends SystemService {
         public void register() {
             if (!mRegistered) {
                 mContext.getContentResolver().registerContentObserver(
-                        System.getUriFor(POCKET_JUDGE), true, this);
+                        System.getUriFor(POCKET_JUDGE), true, this,
+                        UserHandle.USER_ALL);
                 mRegistered = true;
             }
         }
