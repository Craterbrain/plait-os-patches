@@ -2778,6 +2778,9 @@ public class PhoneWindowManager implements WindowManagerPolicy {
                     startActivityAsUser(player, UserHandle.CURRENT);
                 } catch (ActivityNotFoundException e) {
                     Slog.w(TAG, "No music player to start for the headset");
+                } catch (RuntimeException e) {
+                    // A receiver runs on the handler thread: an exception here would kill system_server
+                    Slog.w(TAG, "Could not start the music player for the headset", e);
                 }
             }
         };
