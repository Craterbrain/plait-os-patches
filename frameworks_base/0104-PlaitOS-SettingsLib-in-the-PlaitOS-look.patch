+    /**
+     * The space after each row. PlaitOS: rows of one group touch (no gap) with a hairline between them that starts where
+     * the text starts, as in plait-design's SettingsGroup; the space after a group's last row stays.
+     */
     internal class MarginItemDecoration() : RecyclerView.ItemDecoration() {
+        private val paint = Paint().apply { style = Paint.Style.FILL }
+        private val title = Rect()
+
         override fun getItemOffsets(
             outRect: Rect,
             view: View,
@@ -272,10 +282,11 @@ abstract class SettingsBasePreferenceFragment : PreferenceFragmentCompat() {
         ) {
             val viewHolder = parent.getChildViewHolder(view)
             val position = viewHolder.bindingAdapterPosition
+            val adapter = parent.adapter as? SettingsPreferenceGroupAdapter
 
             val dimensionResId =
-                (parent.adapter as? SettingsPreferenceGroupAdapter)?.let { adapter ->
-                    if (adapter.getItem(position) is ChainedMixin) {
+                adapter?.let {
+                    if (it.getItem(position) is ChainedMixin || it.isGroupedWithNext(position)) {
                         R.dimen.settingslib_expressive_space_none
                     } else {
                         R.dimen.settingslib_expressive_space_extrasmall1
@@ -287,5 +298,43 @@ abstract class SettingsBasePreferenceFragment : PreferenceFragmentCompat() {
                 bottom = view.resources.getDimensionPixelSize(dimensionResId)
             }
         }
+
+        override fun onDrawOver(canvas: Canvas, parent: RecyclerView, state: RecyclerView.State) {
+            val adapter = parent.adapter as? SettingsPreferenceGroupAdapter ?: return
+            val context = parent.context
+            paint.color = context.getColor(R.color.settingslib_materialColorOutlineVariant)
+            val thickness = maxOf(1f, context.resources.displayMetrics.density * 0.75f)
+            // The group's card is inset by the list item padding on each side (settingslib_round_background_*)
+            val inset = TypedValue().let {
+                if (context.theme.resolveAttribute(android.R.attr.listPreferredItemPaddingEnd, it, true))
+                    it.getDimension(context.resources.displayMetrics) else 0f
+            }
+            for (i in 0 until parent.childCount) {
+                val child = parent.getChildAt(i)
+                val position = parent.getChildAdapterPosition(child)
+                if (position == RecyclerView.NO_POSITION || !adapter.isGroupedWithNext(position)) continue
+                val text = child.findViewById<View>(android.R.id.title)
+                val rtl = child.layoutDirection == View.LAYOUT_DIRECTION_RTL
+                val left: Float
+                val right: Float
+                if (text != null && text.isShown && child is ViewGroup) {
+                    text.getDrawingRect(title)
+                    child.offsetDescendantRectToMyCoords(text, title)
+                    if (rtl) {
+                        left = child.left + inset
+                        right = child.left + title.right.toFloat()
+                    } else {
+                        left = child.left + title.left.toFloat()
+                        right = child.right - inset
+                    }
+                } else {
+                    left = child.left + inset
+                    right = child.right - inset
+                }
+                if (right <= left) continue
+                val bottom = child.bottom + child.translationY
+                canvas.drawRect(left + child.translationX, bottom - thickness, right + child.translationX, bottom, paint)
+            }
+        }
     }
 }
