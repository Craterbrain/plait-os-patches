--- a/core/res/res/values/strings.xml
+++ b/core/res/res/values/strings.xml
@@ -7326,7 +7326,7 @@
     <string name="aerr_show_details">Show details</string>
     <java-symbol type="string" name="aerr_show_details" />
 
-    <string name="deprecated_abi_message_grapheneos">This app only supports 32-bit and therefore isn\'t compatible with more recent devices. If the app is still developed, switch to a build for modern devices. GrapheneOS plans to phase out 32-bit app support on older devices for improved security.</string>
+    <string name="deprecated_abi_message_grapheneos">This app only supports 32-bit and therefore isn\'t compatible with more recent devices. If the app is still developed, switch to a build for modern devices. PlaitOS plans to phase out 32-bit app support on older devices for improved security.</string>
     <!-- Label describing no blinking for Settings.Secure.ACCESSIBILITY_TEXT_CURSOR_BLINK_INTERVAL_MS. -->
     <string name="no_blink_accessibility_text_cursor_blink_label">Don\'t blink</string>
 
