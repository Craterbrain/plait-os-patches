diff --git a/services/core/java/com/android/server/policy/PlaitKeyActions.java b/services/core/java/com/android/server/policy/PlaitKeyActions.java
new file mode 100644
index 000000000..660e420cb
--- /dev/null
+++ b/services/core/java/com/android/server/policy/PlaitKeyActions.java
@@ -0,0 +1,156 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Ported to PlaitOS from lineage-sdk (DeviceKeysConstants.Action and ActionUtils, lineage-24.0):
+ * the action list is trimmed to what works with a 3-button navigation bar and gains POWER_MENU;
+ * settings are plain Settings.System keys; the kill toast uses a framework string and the last-app
+ * switch the default animation instead of lineage-sdk resources.
+ */
+
+package com.android.server.policy;
+
+import android.app.ActivityManager;
+import android.app.ActivityOptions;
+import android.app.ActivityTaskManager;
+import android.app.ActivityTaskManager.RootTaskInfo;
+import android.app.IActivityManager;
+import android.app.IActivityTaskManager;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ResolveInfo;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Log;
+import android.widget.Toast;
+
+import java.util.List;
+
+/** Actions a navigation bar key press can be bound to, and the helpers that need more than a call. */
+final class PlaitKeyActions {
+    private static final String TAG = "PlaitKeyActions";
+    private static final String SYSTEMUI_PACKAGE = "com.android.systemui";
+
+    /** Settings.System keys (written by Plait Settings); unset or NOTHING keeps the stock behavior. */
+    static final String HOME_LONG_PRESS = "plait_home_long_press_action";
+    static final String BACK_LONG_PRESS = "plait_back_long_press_action";
+
+    /** Order is the stored value: append only. */
+    enum Action {
+        NOTHING,
+        POWER_MENU,
+        KILL_APP,
+        SCREENSHOT,
+        SLEEP,
+        LAST_APP,
+        RECENTS,
+        SPLIT_SCREEN,
+        ASSISTANT,
+        VOICE_ASSIST,
+        NOTIFICATIONS,
+        PLAY_PAUSE_MUSIC;
+
+        static Action fromIntSafe(int id) {
+            if (id < 0 || id >= values().length) {
+                return NOTHING;
+            }
+            return values()[id];
+        }
+
+        static Action fromSettings(ContentResolver cr, String setting) {
+            return fromIntSafe(Settings.System.getIntForUser(cr, setting, NOTHING.ordinal(),
+                    UserHandle.USER_CURRENT));
+        }
+    }
+
+    private PlaitKeyActions() {
+    }
+
+    /** Kills the top most user application, but leaves out the launcher and SystemUI. */
+    static boolean killForegroundApp(Context context, int userId) {
+        try {
+            final IActivityTaskManager atm = ActivityTaskManager.getService();
+            if (atm.getLockTaskModeState() == ActivityManager.LOCK_TASK_MODE_PINNED) {
+                return false;
+            }
+            final RootTaskInfo foregroundTask = getForegroundTask(context, userId);
+            if (foregroundTask == null) {
+                return false;
+            }
+            final String packageName = foregroundTask.topActivity.getPackageName();
+            if (packageName == null) {
+                return false;
+            }
+            ActivityManager.getService().forceStopPackage(packageName, foregroundTask.userId);
+            new Handler(Looper.getMainLooper()).post(() -> Toast.makeText(context,
+                    com.android.internal.R.string.plait_app_killed_message, Toast.LENGTH_SHORT).show());
+            return true;
+        } catch (RemoteException e) {
+            Log.e(TAG, "Could not kill foreground app");
+            return false;
+        }
+    }
+
+    /** Brings up the activity before the current one in recents, skipping the launcher and SystemUI. */
+    static boolean switchToLastApp(Context context, int userId) {
+        try {
+            final ActivityManager.RecentTaskInfo lastTask = getLastTask(context, userId);
+            if (lastTask == null || lastTask.id < 0) {
+                return false;
+            }
+            final IActivityManager am = ActivityManager.getService();
+            am.moveTaskToFront(null, null, lastTask.id, ActivityManager.MOVE_TASK_NO_USER_ACTION,
+                    ActivityOptions.makeBasic().toBundle());
+            return true;
+        } catch (RemoteException e) {
+            Log.e(TAG, "Could not switch to last app");
+            return false;
+        }
+    }
+
+    private static ActivityManager.RecentTaskInfo getLastTask(Context context, int userId)
+            throws RemoteException {
+        final String defaultHomePackage = resolveCurrentLauncherPackage(context, userId);
+        final List<ActivityManager.RecentTaskInfo> tasks = ActivityManager.getService().getRecentTasks(5,
+                ActivityManager.RECENT_IGNORE_UNAVAILABLE, userId).getList();
+        for (int i = 1; i < tasks.size(); i++) {
+            final ActivityManager.RecentTaskInfo task = tasks.get(i);
+            if (task.origActivity != null) {
+                task.baseIntent.setComponent(task.origActivity);
+            }
+            final String packageName = task.baseIntent.getComponent().getPackageName();
+            if (!packageName.equals(defaultHomePackage) && !packageName.equals(SYSTEMUI_PACKAGE)) {
+                return task;
+            }
+        }
+        return null;
+    }
+
+    private static RootTaskInfo getForegroundTask(Context context, int userId) throws RemoteException {
+        final String defaultHomePackage = resolveCurrentLauncherPackage(context, userId);
+        final RootTaskInfo focusedStack = ActivityManager.getService().getFocusedRootTaskInfo();
+        if (focusedStack == null || focusedStack.topActivity == null) {
+            return null;
+        }
+        final String packageName = focusedStack.topActivity.getPackageName();
+        if (!packageName.equals(defaultHomePackage) && !packageName.equals(SYSTEMUI_PACKAGE)) {
+            return focusedStack;
+        }
+        return null;
+    }
+
+    private static String resolveCurrentLauncherPackage(Context context, int userId) {
+        final Intent launcherIntent = new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME);
+        final ResolveInfo launcherInfo = context.getPackageManager().resolveActivityAsUser(
+                launcherIntent, 0, userId);
+        if (launcherInfo != null && launcherInfo.activityInfo != null
+                && !launcherInfo.activityInfo.packageName.equals("android")) {
+            return launcherInfo.activityInfo.packageName;
+        }
+        return null;
+    }
+}
