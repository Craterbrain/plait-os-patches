+    /**
+     * Runs a navigation bar key action chosen in Plait Settings. Adapted from LineageOS's
+     * performKeyAction (Phil Tunstall et al., hardware keys custom rebinding); POWER_MENU is new.
+     * [event] is null for keys handled by the single key gesture detector (back).
+     */
+    private void performPlaitKeyAction(PlaitKeyActions.Action action, KeyEvent event) {
+        switch (action) {
+            case NOTHING:
+                break;
+            case POWER_MENU:
+                showGlobalActionsInternal();
+                break;
+            case KILL_APP:
+                PlaitKeyActions.killForegroundApp(mContext, mCurrentUserId);
+                break;
+            case SCREENSHOT: {
+                final com.android.internal.util.ScreenshotRequest request =
+                        new com.android.internal.util.ScreenshotRequest.Builder(
+                                WindowManager.TAKE_SCREENSHOT_FULLSCREEN,
+                                WindowManager.ScreenshotSource.SCREENSHOT_KEY_OTHER).build();
+                new com.android.internal.util.ScreenshotHelper(mContext).takeScreenshot(
+                        request, mHandler, null /* completionConsumer */);
+                break;
+            }
+            case SLEEP:
+                mPowerManager.goToSleep(SystemClock.uptimeMillis());
+                break;
+            case LAST_APP:
+                PlaitKeyActions.switchToLastApp(mContext, mCurrentUserId);
+                break;
+            case RECENTS:
+                toggleRecentApps();
+                break;
+            case SPLIT_SCREEN: {
+                final StatusBarManagerInternal statusbar = getStatusBarManagerInternal();
+                if (statusbar != null) {
+                    statusbar.toggleSplitScreen();
+                }
+                break;
+            }
+            case ASSISTANT:
+                launchAssistAction(null, event != null ? event.getDeviceId() : -1,
+                        event != null ? event.getDisplayId() : DEFAULT_DISPLAY,
+                        event != null ? event.getEventTime() : SystemClock.uptimeMillis(),
+                        AssistUtils.INVOCATION_TYPE_UNKNOWN);
+                break;
+            case VOICE_ASSIST:
+                launchVoiceAssist(false /* allowDuringSetup */);
+                break;
+            case NOTIFICATIONS:
+                toggleNotificationPanel();
+                break;
+            case PLAY_PAUSE_MUSIC: {
+                final AudioManager audio = mContext.getSystemService(AudioManager.class);
+                if (audio != null) {
+                    final long now = SystemClock.uptimeMillis();
+                    final KeyEvent down = new KeyEvent(now, now, KeyEvent.ACTION_DOWN,
+                            KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE, 0);
+                    audio.dispatchMediaKeyEvent(down);
+                    audio.dispatchMediaKeyEvent(KeyEvent.changeAction(down, KeyEvent.ACTION_UP));
+                }
+                break;
+            }
+        }
+    }
