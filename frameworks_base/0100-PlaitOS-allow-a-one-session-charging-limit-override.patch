From 47c675423b494a6b3f2f32df1f075b24dd9e109e Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Tue, 24 Nov 2026 10:48:18 -0600
Subject: [PATCH] PlaitOS: allow a one-session charging limit override

---
 .../server/plait/PlaitChargeLimitService.java | 45 +++++++++++++++++--
 1 file changed, 41 insertions(+), 4 deletions(-)

diff --git a/services/core/java/com/android/server/plait/PlaitChargeLimitService.java b/services/core/java/com/android/server/plait/PlaitChargeLimitService.java
index 8c0c9fb44..ed12cf0ad 100644
--- a/services/core/java/com/android/server/plait/PlaitChargeLimitService.java
+++ b/services/core/java/com/android/server/plait/PlaitChargeLimitService.java
@@ -13,6 +13,7 @@ import android.content.Context;
 import android.content.Intent;
 import android.content.IntentFilter;
 import android.database.ContentObserver;
+import android.os.BatteryManager;
 import android.os.Handler;
 import android.os.SystemProperties;
 import android.os.UserHandle;
@@ -39,6 +40,7 @@ public final class PlaitChargeLimitService extends SystemService {
     static final String ENABLED = "plait_charge_limit_enabled";
     static final String LIMIT = "plait_charge_limit";
     static final String BY_ALARM = "plait_charge_limit_by_alarm";
+    private static final String CHARGE_ONCE = "plait_charge_once";
     private static final int DEFAULT_LIMIT = 80;
     private static final int MIN_LIMIT = 50;
     private static final int MARGIN = 5;
@@ -69,7 +71,7 @@ public final class PlaitChargeLimitService extends SystemService {
     private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
         @Override
         public void onReceive(Context context, Intent intent) {
-            apply();
+            apply(Intent.ACTION_POWER_DISCONNECTED.equals(intent.getAction()));
         }
     };
 
@@ -101,7 +103,11 @@ public final class PlaitChargeLimitService extends SystemService {
             mContext.getContentResolver().registerContentObserver(
                     Settings.System.getUriFor(key), false, mObserver, UserHandle.USER_SYSTEM);
         }
+        clearOverride();
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(CHARGE_ONCE), false, mObserver, UserHandle.USER_SYSTEM);
         final IntentFilter filter = new IntentFilter(Intent.ACTION_POWER_CONNECTED);
+        filter.addAction(Intent.ACTION_POWER_DISCONNECTED);
         filter.addAction(AlarmManager.ACTION_NEXT_ALARM_CLOCK_CHANGED);
         filter.addAction(Intent.ACTION_TIME_CHANGED);
         filter.addAction(Intent.ACTION_TIMEZONE_CHANGED);
@@ -110,13 +116,42 @@ public final class PlaitChargeLimitService extends SystemService {
     }
 
     private void apply() {
+        apply(false);
+    }
+
+    private void apply(boolean disconnected) {
         try {
+            if (disconnected) {
+                clearOverride();
+            }
             applyLimit();
         } catch (Throwable t) {
             Slog.e(TAG, "the charging limit could not be applied", t);
         }
     }
 
+    private void clearOverride() {
+        if (Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                CHARGE_ONCE, 0, UserHandle.USER_SYSTEM) != 0) {
+            Settings.Secure.putIntForUser(mContext.getContentResolver(),
+                    CHARGE_ONCE, 0, UserHandle.USER_SYSTEM);
+        }
+    }
+
+    private boolean chargeOnce(boolean available) {
+        if (Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                CHARGE_ONCE, 0, UserHandle.USER_SYSTEM) != 1) {
+            return false;
+        }
+        final Intent battery = mContext.registerReceiver(null,
+                new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+        if (!available || battery == null || battery.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) == 0) {
+            clearOverride();
+            return false;
+        }
+        return true;
+    }
+
     private void applyLimit() {
         final AlarmManager alarms = mContext.getSystemService(AlarmManager.class);
         alarms.cancel(mWindowAlarmListener);
@@ -126,9 +161,11 @@ public final class PlaitChargeLimitService extends SystemService {
         int stop = 100;
         int start = 0;
         long target = 0;
-        if (enabled) {
-            stop = Math.max(MIN_LIMIT, Math.min(100, Settings.System.getIntForUser(
-                    mContext.getContentResolver(), LIMIT, DEFAULT_LIMIT, UserHandle.USER_SYSTEM)));
+        final int limit = Math.max(MIN_LIMIT, Math.min(100, Settings.System.getIntForUser(
+                mContext.getContentResolver(), LIMIT, DEFAULT_LIMIT, UserHandle.USER_SYSTEM)));
+        final boolean once = chargeOnce(enabled && limit < 100);
+        if (enabled && !once) {
+            stop = limit;
             start = stop == 100 ? 0 : stop - MARGIN;
             if (stop < 100 && Settings.System.getIntForUser(mContext.getContentResolver(),
                     BY_ALARM, 0, UserHandle.USER_SYSTEM) == 1) {
-- 
