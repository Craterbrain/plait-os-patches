+    private static final int PERSONAL_QUERY_TIMEOUT_MS = 120_000;
+    private static final int PERSONAL_QUERY_LIMIT = 2;
+    private final Semaphore mPersonalQueries = new Semaphore(PERSONAL_QUERY_LIMIT);
+    private final ExecutorService mPersonalQueryWorkers = Executors.newFixedThreadPool(PERSONAL_QUERY_LIMIT);
