+    private record PersonalQuery(String[] columns, String selection, String sort, boolean restore) {}
+
+    private static PersonalQuery checkedPersonalQuery(PersonalUri target, String[] projection,
+            String selection, String[] selectionArgs, String sortOrder) {
+        if (selectionArgs != null && selectionArgs.length != 0) {
+            throw new SecurityException("personal queries do not accept selection arguments");
+        }
+        String authority = target.uri.getAuthority();
+        String path = String.join("/", target.uri.getPathSegments());
+        if ("mms-sms".equals(authority) && projection == null && selection == null && sortOrder == null) {
+            return new PersonalQuery(null, null, null, true);
+        }
+        boolean collection = ("call_log".equals(authority) && "calls".equals(path))
+                || (("sms".equals(authority) || "mms".equals(authority)) && path.isEmpty());
+        if (collection && "0".equals(selection) && projection == null && sortOrder == null) {
+            return new PersonalQuery(null, "0", null, true);
+        }
+        if (collection && selection == null && sortOrder == null && projection != null) {
+            String[] deduplication = switch (authority) {
+                case "call_log" -> new String[] {"number", "date", "duration", "type"};
+                case "sms" -> new String[] {"date", "type", "address", "body"};
+                default -> new String[] {"date", "msg_box", "m_type", "sub"};
+            };
+            if (Arrays.equals(deduplication, projection)) {
+                return new PersonalQuery(deduplication, null, null, true);
+            }
+        }
+        boolean rawContacts = "com.android.contacts".equals(authority) && "raw_contacts".equals(path);
+        if (rawContacts && "deleted = 0".equals(selection) && sortOrder == null
+                && Arrays.equals(projection, new String[] {"display_name"})) {
+            return new PersonalQuery(new String[] {"display_name"}, "deleted = 0", null, true);
+        }
+        if (collection && projection == null && selection == null && "date DESC".equals(sortOrder)) {
+            return new PersonalQuery(null, null, "date DESC", false);
+        }
+        if (rawContacts && projection == null && "deleted = 0".equals(selection) && sortOrder == null) {
+            return new PersonalQuery(null, "deleted = 0", null, false);
+        }
+        if (projection == null && selection == null && sortOrder == null
+                && (("mms".equals(authority) && ("part".equals(path) || path.matches("[0-9]+/addr")))
+                || ("com.android.contacts".equals(authority) && "data".equals(path)))) {
+            return new PersonalQuery(null, null, null, false);
+        }
+        throw new SecurityException("unsupported personal-data query");
+    }
+
+    /** The service-owned writer is nonblocking, and the deadline also bounds progress on a slow reader. */
+    private static void writePersonalLine(java.io.FileDescriptor fd, String json, long deadline)
+            throws IOException, ErrnoException {
+        byte[] bytes = (json + "\n").getBytes(StandardCharsets.UTF_8);
+        StructPollfd poll = new StructPollfd();
+        poll.fd = fd;
+        poll.events = (short) OsConstants.POLLOUT;
+        StructPollfd[] polls = {poll};
+        int offset = 0;
+        while (offset < bytes.length) {
+            long remaining = deadline - SystemClock.elapsedRealtime();
+            if (remaining <= 0 || Os.poll(polls, (int) remaining) == 0) {
+                throw new IOException("personal-data query timed out");
+            }
+            if ((poll.revents & OsConstants.POLLOUT) == 0) throw new IOException("query reader closed");
+            try {
+                offset += Os.write(fd, bytes, offset, bytes.length - offset);
+            } catch (ErrnoException e) {
+                if (e.errno != OsConstants.EAGAIN) throw e;
+            }
+        }
+    }
