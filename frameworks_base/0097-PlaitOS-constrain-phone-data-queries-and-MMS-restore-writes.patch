+    private void runPersonalQuery(Call call, PersonalUri target, PersonalQuery query,
+            ParcelFileDescriptor writer, long deadline) {
+        CancellationSignal cancellation = new CancellationSignal();
+        Runnable timeout = () -> {
+            failPersonalQuery(writer, "Personal-data query timed out");
+            cancellation.cancel();
+        };
+        try {
+            long remaining = deadline - SystemClock.elapsedRealtime();
+            if (remaining <= 0) throw new IOException("personal-data query timed out");
+            java.io.FileDescriptor fd = writer.getFileDescriptor();
+            int flags = Os.fcntlInt(fd, OsConstants.F_GETFL, 0);
+            Os.fcntlInt(fd, OsConstants.F_SETFL, flags | OsConstants.O_NONBLOCK);
+            BackgroundThread.getHandler().postDelayed(timeout, remaining);
+            try (android.database.Cursor c = resolver(call.userId).query(target.uri, query.columns,
+                    query.selection, null, query.sort, cancellation)) {
                 org.json.JSONObject head = new org.json.JSONObject();
                 head.put("columns", new org.json.JSONArray(c == null ? new String[0] : c.getColumnNames()));
