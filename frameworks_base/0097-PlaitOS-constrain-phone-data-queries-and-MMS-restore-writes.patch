+    private record MmsRestore(Uri message, Set<Long> parts) {}
+    private final java.util.LinkedHashMap<String, MmsRestore> mMmsRestores = new java.util.LinkedHashMap<>();
+
+    private synchronized void rememberMms(Call call, Uri message) {
+        mMmsRestores.remove(call.grant.grantId);
+        if (mMmsRestores.size() >= 32) mMmsRestores.remove(mMmsRestores.keySet().iterator().next());
+        mMmsRestores.put(call.grant.grantId, new MmsRestore(message, new HashSet<>()));
+    }
+
+    private synchronized MmsRestore requireMms(Call call, Uri uri, boolean attachment) {
+        MmsRestore restore = mMmsRestores.get(call.grant.grantId);
+        List<String> path = uri.getPathSegments();
+        if (restore == null || (attachment
+                ? !restore.parts.contains(android.content.ContentUris.parseId(uri))
+                : !path.get(0).equals(restore.message.getLastPathSegment()))) {
+            throw new SecurityException("MMS row was not created by this restore");
+        }
+        return restore;
+    }
+
+    private synchronized void rememberMmsPart(MmsRestore restore, Uri uri) {
+        if (restore.parts.size() < 256) restore.parts.add(android.content.ContentUris.parseId(uri));
+    }
