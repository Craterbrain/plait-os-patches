+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.peek
+
+import android.app.AlarmManager
+import android.content.Context
+import android.content.Intent
+import android.graphics.PixelFormat
+import android.os.Handler
+import android.os.UserHandle
+import android.provider.Settings
+import android.service.notification.NotificationStats
+import android.util.Log
+import android.view.Gravity
+import android.view.WindowManager
+import android.view.WindowManager.LayoutParams
+import com.android.systemui.CoreStartable
+import com.android.systemui.biometrics.AuthController
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Application
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.doze.DozeLog
+import com.android.systemui.keyguard.domain.interactor.KeyguardInteractor
+import com.android.systemui.plugins.ActivityStarter
+import com.android.systemui.statusbar.NotificationClickNotifier
+import com.android.systemui.statusbar.NotificationLockscreenUserManager
+import com.android.systemui.statusbar.notification.collection.NotifCollection
+import com.android.systemui.statusbar.notification.collection.NotificationEntry
+import com.android.systemui.statusbar.notification.collection.notifcollection.DismissedByUserStats
+import com.android.systemui.statusbar.notification.collection.provider.NotificationDismissibilityProvider
+import com.android.systemui.statusbar.notification.collection.render.NotificationVisibilityProvider
+import com.android.systemui.statusbar.notification.domain.interactor.ActiveNotificationsInteractor
+import com.android.systemui.statusbar.notification.shared.ActiveNotificationModel
+import com.android.systemui.statusbar.phone.DozeServiceHost
+import com.android.systemui.util.AlarmTimeout
+import dagger.Lazy
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.launch
+
+/**
+ * Peek Display: a Motorola-style ambient display. While the screen is off, a pulse (new
+ * notification, or a "breath" while unseen notifications remain) shows only the clock, the date
+ * and one icon per app instead of the stock notification card. Touching and holding an icon shows
+ * that app's newest notification; sliding up opens it (unlocking first when needed), sliding down
+ * dismisses it. Off unless Settings.Secure [SETTING_ENABLED] is 1.
+ *
+ * Design: plait-os docs/peek-display-design.md.
+ */
+@SysUISingleton
+class PeekDisplayController
+@Inject
+constructor(
+    @Application private val context: Context,
+    @Application private val scope: CoroutineScope,
+    @Main private val mainHandler: Handler,
+    private val windowManager: WindowManager,
+    private val alarmManager: AlarmManager,
+    private val keyguardInteractor: KeyguardInteractor,
+    private val activeNotificationsInteractor: ActiveNotificationsInteractor,
+    private val notifCollection: NotifCollection,
+    private val lockscreenUserManager: NotificationLockscreenUserManager,
+    private val dismissibilityProvider: NotificationDismissibilityProvider,
+    private val visibilityProvider: NotificationVisibilityProvider,
+    private val clickNotifier: NotificationClickNotifier,
+    private val activityStarter: ActivityStarter,
+    private val authController: AuthController,
+    private val dozeServiceHost: Lazy<DozeServiceHost>,
+) : CoreStartable, DozeServiceHost.PulseListener {
+
+    /** What the overlay shows; updated while it is up. */
+    internal val items = MutableStateFlow<List<PeekItem>>(emptyList())
+
+    private var allNotifications: Map<String, ActiveNotificationModel> = emptyMap()
+    private var isDozing = false
+    private var isPulsing = false
+    /** Wall-clock time the screen last went off: notifications posted after it are unseen. */
+    private var screenOffTime = System.currentTimeMillis()
+
+    private var window: PeekDisplayWindow? = null
+    private val breathAlarm =
+        AlarmTimeout(alarmManager, { onBreathAlarm() }, "PeekDisplay:breath", mainHandler)
+    private val extendPulseRunnable =
+        object : Runnable {
+            override fun run() {
+                if (!isPulsing) return
+                dozeServiceHost.get().extendPulse(DozeLog.PULSE_REASON_NOTIFICATION)
+                mainHandler.postDelayed(this, EXTEND_PULSE_EVERY_MS)
+            }
+        }
+
+    override fun start() {
+        dozeServiceHost.get().addPulseListener(this)
+        scope.launch {
+            activeNotificationsInteractor.allRepresentativeNotifications.collect {
+                allNotifications = it
+                if (window != null) items.value = buildItems()
+            }
+        }
+        scope.launch {
+            keyguardInteractor.isDozing.collect { dozing ->
+                if (dozing && !isDozing) screenOffTime = System.currentTimeMillis()
+                isDozing = dozing
+                if (dozing) {
+                    scheduleBreath()
+                } else {
+                    breathAlarm.cancel()
+                    hideWindow()
+                }
+            }
+        }
+    }
+
+    // DozeServiceHost.PulseListener (main thread)
+
+    override fun onPulseStarted(reason: Int) {
+        isPulsing = true
+        breathAlarm.cancel()
+        // Only notification pulses and our own breaths; never cover fingerprint or other pulses
+        if (!isEnabled() ||
+            (reason != DozeLog.PULSE_REASON_NOTIFICATION && reason != DozeLog.PULSE_REASON_INTENT)
+        ) {
+            return
+        }
+        items.value = buildItems()
+        showWindow()
+    }
+
+    override fun onPulseFinished() {
+        isPulsing = false
+        mainHandler.removeCallbacks(extendPulseRunnable)
+        hideWindow()
+        if (isDozing) scheduleBreath()
+    }
+
+    // Called by the overlay
+
+    internal fun onHoldChanged(holding: Boolean) {
+        mainHandler.removeCallbacks(extendPulseRunnable)
+        // Keep the pulse alive under the finger, as stock does while a pulsing card is touched
+        if (holding && isPulsing) extendPulseRunnable.run()
+    }
+
+    internal fun open(item: PeekItem) {
+        val entry = notifCollection.getEntry(item.key) ?: return
+        val intent = entry.sbn.notification.contentIntent ?: return
+        // Out of the way first: the bouncer comes up under it otherwise
+        hideWindow()
+        activityStarter.startPendingIntentDismissingKeyguard(intent) {
+            // Like a lock-screen tap: report the click once the intent is sent (auto-cancel)
+            clickNotifier.onNotificationClick(entry.key, visibilityProvider.obtain(entry, true))
+        }
+    }
+
+    internal fun dismiss(item: PeekItem) {
+        val entry = notifCollection.getEntry(item.key) ?: return
+        if (!dismissibilityProvider.isDismissable(entry.key)) return
+        notifCollection.dismissNotification(
+            entry,
+            DismissedByUserStats(
+                NotificationStats.DISMISSAL_AOD,
+                NotificationStats.DISMISS_SENTIMENT_NEUTRAL,
+                visibilityProvider.obtain(entry, true),
+            ),
+        )
+    }
+
+    // Content
+
+    /** One item per app: its newest unseen notification, redacted as the lock screen would. */
+    private fun buildItems(): List<PeekItem> {
+        if (!lockscreenUserManager.shouldShowLockscreenNotifications()) return emptyList()
+        return allNotifications.values
+            .asSequence()
+            .filter { isPeekable(it) }
+            .mapNotNull { model -> notifCollection.getEntry(model.key)?.let { model to it } }
+            .filter { (_, entry) -> entry.sbn.postTime >= screenOffTime }
+            .groupBy { (model, _) -> model.packageName to model.uid }
+            .values
+            .map { group -> group.maxBy { (_, entry) -> entry.sbn.postTime } }
+            .sortedByDescending { (_, entry) -> entry.sbn.postTime }
+            .take(MAX_ICONS)
+            .map { (model, entry) -> toItem(model, entry) }
+            .toList()
+    }
+
+    private fun isPeekable(model: ActiveNotificationModel): Boolean =
+        !model.isGroupSummary &&
+            !model.isSilent &&
+            !model.isAmbient &&
+            !model.isOngoingEvent &&
+            !model.isForegroundService &&
+            !model.isRowDismissed
+
+    private fun toItem(model: ActiveNotificationModel, entry: NotificationEntry): PeekItem {
+        val notification = entry.sbn.notification
+        val redacted =
+            lockscreenUserManager.getRedactionType(entry) !=
+                NotificationLockscreenUserManager.REDACTION_TYPE_NONE
+        val extras = notification.extras
+        val title = extras.getCharSequence(android.app.Notification.EXTRA_TITLE)
+        val text =
+            extras.getCharSequence(android.app.Notification.EXTRA_BIG_TEXT)
+                ?: extras.getCharSequence(android.app.Notification.EXTRA_TEXT)
+        return PeekItem(
+            key = model.key,
+            appName = model.appName,
+            icon = notification.smallIcon,
+            iconPackage = entry.sbn.packageName,
+            iconUserId = entry.sbn.user.identifier,
+            title = if (redacted) null else title,
+            text = if (redacted) null else text,
+            redacted = redacted,
+            canOpen = notification.contentIntent != null,
+            canDismiss = dismissibilityProvider.isDismissable(model.key),
+        )
+    }
+
+    // Breathing
+
+    private fun scheduleBreath() {
+        if (!isEnabled() || !isDozing || isPulsing) return
+        if (Settings.Secure.getIntForUser(
+                context.contentResolver, SETTING_BREATHING, 1, UserHandle.USER_CURRENT) == 0
+        ) {
+            return
+        }
+        val newest = allNotifications.values
+            .filter { isPeekable(it) }
+            .mapNotNull { notifCollection.getEntry(it.key)?.sbn?.postTime }
+            .filter { it >= screenOffTime }
+            .maxOrNull() ?: return
+        val durationMs = readSeconds(SETTING_BREATHING_DURATION, DEFAULT_DURATION_MIN * 60) * 1000L
+        if (System.currentTimeMillis() - newest > durationMs) return
+        val intervalMs = readSeconds(SETTING_BREATHING_INTERVAL, DEFAULT_INTERVAL_S) * 1000L
+        breathAlarm.schedule(intervalMs, AlarmTimeout.MODE_RESCHEDULE_IF_SCHEDULED)
+    }
+
+    private fun onBreathAlarm() {
+        if (!isDozing || isPulsing || !isEnabled()) return
+        // The same pulse request the always-on schedule uses; DozeTriggers does the proximity
+        // (pocket) check and the pulse itself
+        context.sendBroadcastAsUser(
+            Intent(PULSE_ACTION).setPackage(context.packageName),
+            UserHandle.CURRENT,
+        )
+    }
+
+    /** Interval is stored in seconds, duration in minutes; returns seconds. */
+    private fun readSeconds(key: String, defaultSeconds: Int): Int {
+        val raw = Settings.Secure.getIntForUser(context.contentResolver, key, -1,
+            UserHandle.USER_CURRENT)
+        return when {
+            raw < 1 -> defaultSeconds
+            key == SETTING_BREATHING_DURATION -> raw.coerceAtMost(60) * 60
+            else -> raw.coerceIn(MIN_INTERVAL_S, MAX_INTERVAL_S)
+        }
+    }
+
+    private fun isEnabled(): Boolean =
+        Settings.Secure.getIntForUser(context.contentResolver, SETTING_ENABLED, 0,
+            UserHandle.USER_CURRENT) == 1
+
+    // Window
+
+    private fun showWindow() {
+        if (window != null) return
+        val peekWindow = PeekDisplayWindow(context, this)
+        val params =
+            LayoutParams(
+                LayoutParams.MATCH_PARENT,
+                windowHeight(),
+                LayoutParams.TYPE_SECURE_SYSTEM_OVERLAY,
+                LayoutParams.FLAG_NOT_FOCUSABLE or
+                    LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                    LayoutParams.FLAG_SHOW_WHEN_LOCKED or
+                    LayoutParams.FLAG_HARDWARE_ACCELERATED,
+                PixelFormat.OPAQUE,
+            )
+        params.gravity = Gravity.TOP
+        params.title = "PeekDisplay"
+        params.layoutInDisplayCutoutMode = LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+        params.privateFlags = params.privateFlags or LayoutParams.PRIVATE_FLAG_TRUSTED_OVERLAY
+        try {
+            windowManager.addView(peekWindow, params)
+            window = peekWindow
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "Could not show Peek Display", e)
+        }
+    }
+
+    private fun hideWindow() {
+        mainHandler.removeCallbacks(extendPulseRunnable)
+        window?.let {
+            try {
+                windowManager.removeViewImmediate(it)
+            } catch (e: RuntimeException) {
+                Log.w(TAG, "Could not remove Peek Display", e)
+            }
+        }
+        window = null
+    }
+
+    /**
+     * Full height, except on under-display fingerprint phones: stop above the sensor so the
+     * stock screen-off fingerprint icon and its touch area stay usable during the pulse.
+     */
+    private fun windowHeight(): Int {
+        val location = authController.udfpsLocation ?: return LayoutParams.MATCH_PARENT
+        val top = location.y - authController.udfpsRadius.toInt() -
+            context.resources.displayMetrics.density.times(UDFPS_GAP_DP).toInt()
+        return if (top > 0) top else LayoutParams.MATCH_PARENT
+    }
+
+    companion object {
+        private const val TAG = "PeekDisplay"
+
+        /** Settings.Secure keys (written by Plait Settings). */
+        const val SETTING_ENABLED = "plait_peek_display"
+        const val SETTING_BREATHING = "plait_peek_breathing"
+        /** Seconds between breaths. */
+        const val SETTING_BREATHING_INTERVAL = "plait_peek_breathing_interval"
+        /** Minutes after the newest unseen notification during which to keep breathing. */
+        const val SETTING_BREATHING_DURATION = "plait_peek_breathing_duration"
+
+        private const val DEFAULT_INTERVAL_S = 30
+        private const val MIN_INTERVAL_S = 10
+        private const val MAX_INTERVAL_S = 600
+        private const val DEFAULT_DURATION_MIN = 10
+
+        private const val MAX_ICONS = 6
+        private const val EXTEND_PULSE_EVERY_MS = 2000L
+        private const val UDFPS_GAP_DP = 24f
+
+        /** DozeTriggers' pulse request (see DozeTriggers.PULSE_ACTION). */
+        private const val PULSE_ACTION = "com.android.systemui.doze.pulse"
+    }
+}
+
+/** One app's newest unseen notification, as Peek Display shows it. */
+internal data class PeekItem(
+    val key: String,
+    val appName: String,
+    val icon: android.graphics.drawable.Icon?,
+    val iconPackage: String,
+    val iconUserId: Int,
+    val title: CharSequence?,
+    val text: CharSequence?,
+    val redacted: Boolean,
+    val canOpen: Boolean,
+    val canDismiss: Boolean,
+)
