+
+/** The Peek Display window: a black surface with the clock, date, app icons and the held card. */
+internal class PeekDisplayWindow(context: Context, private val controller: PeekDisplayController) :
+    FrameLayout(context) {
+
+    init {
+        setBackgroundColor(AndroidColor.BLACK)
+        addView(ComposeView(context).apply { setContent { PeekDisplayContent(controller) } })
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        ComposeInitializer.onAttachedToWindow(this)
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        ComposeInitializer.onDetachedFromWindow(this)
+    }
+}
+
+/** Where the held finger is heading. */
+private enum class HoldAction {
+    NONE,
+    OPEN,
+    DISMISS,
+}
+
+@Composable
+private fun PeekDisplayContent(controller: PeekDisplayController) {
+    val items by controller.items.collectAsState()
+    val context = LocalContext.current
+    val density = LocalDensity.current
+    val slidePx = with(density) { SLIDE_DISTANCE.toPx() }
+
+    var heldKey by remember { mutableStateOf<String?>(null) }
+    var action by remember { mutableStateOf(HoldAction.NONE) }
+    val iconBounds = remember { mutableStateMapOf<String, Rect>() }
+    // Burn-in: a new small offset every time the window appears (once per pulse or breath)
+    val shift = remember {
+        Pair(Random.nextInt(-MAX_SHIFT_DP, MAX_SHIFT_DP + 1), Random.nextInt(-MAX_SHIFT_DP, MAX_SHIFT_DP + 1))
+    }
+    val held = items.firstOrNull { it.key == heldKey }
+    // The gesture loop reads the latest items without restarting (a restart would drop a hold)
+    val currentItems by rememberUpdatedState(items)
+    // Drop bounds of icons that are gone, so a stale area can't be held
+    LaunchedEffect(items) { iconBounds.keys.retainAll(items.map { it.key }.toSet()) }
+
+    Box(
+        modifier =
+            Modifier.fillMaxSize().background(Color.Black).pointerInput(Unit) {
+                awaitEachGesture {
+                    val down = awaitFirstDown(requireUnconsumed = false)
+                    val startKey =
+                        iconBounds.entries.firstOrNull { it.value.contains(down.position) }?.key
+                            ?: return@awaitEachGesture // touching the clock does nothing
+                    heldKey = startKey
+                    action = HoldAction.NONE
+                    controller.onHoldChanged(true)
+                    var lastPosition = down.position
+                    while (true) {
+                        val event = awaitPointerEvent()
+                        val change = event.changes.firstOrNull { it.id == down.id } ?: break
+                        if (!change.pressed) break
+                        lastPosition = change.position
+                        val dy = change.position.y - down.position.y
+                        action =
+                            when {
+                                dy < -slidePx -> HoldAction.OPEN
+                                dy > slidePx -> HoldAction.DISMISS
+                                else -> HoldAction.NONE
+                            }
+                        // Sliding sideways along the row switches to the icon under the finger
+                        if (abs(dy) < slidePx / 2) {
+                            iconBounds.entries
+                                .firstOrNull {
+                                    it.value.left <= lastPosition.x && lastPosition.x <= it.value.right
+                                }
+                                ?.let { heldKey = it.key }
+                        }
+                        change.consume()
+                    }
+                    val item = currentItems.firstOrNull { it.key == heldKey }
+                    val finalAction = action
+                    heldKey = null
+                    action = HoldAction.NONE
+                    controller.onHoldChanged(false)
+                    if (item != null) {
+                        when (finalAction) {
+                            HoldAction.OPEN -> if (item.canOpen) controller.open(item)
+                            HoldAction.DISMISS -> if (item.canDismiss) controller.dismiss(item)
+                            HoldAction.NONE -> {}
+                        }
+                    }
+                }
+            }
+    ) {
+        Column(
+            modifier =
+                Modifier.fillMaxSize()
+                    .offset(shift.first.dp, shift.second.dp)
+                    .padding(horizontal = 32.dp),
+            horizontalAlignment = Alignment.CenterHorizontally,
+            verticalArrangement = Arrangement.Center,
+        ) {
+            Clock(context)
+            Spacer(Modifier.height(24.dp))
+            // Fixed height so the icons don't jump when the card appears
+            Box(Modifier.fillMaxWidth().height(CARD_HEIGHT), contentAlignment = Alignment.Center) {
+                if (held != null) HeldCard(held, action)
+            }
+            Spacer(Modifier.height(16.dp))
+            Row(horizontalArrangement = Arrangement.spacedBy(20.dp)) {
+                for (item in items) {
+                    val isHeld = item.key == heldKey
+                    Box(
+                        modifier =
+                            Modifier.size(ICON_SIZE)
+                                .onGloballyPositioned { iconBounds[item.key] = it.boundsInRoot() }
+                                .alpha(if (heldKey == null || isHeld) 1f else 0.35f)
+                                .scale(if (isHeld) 1.25f else 1f),
+                        contentAlignment = Alignment.Center,
+                    ) {
+                        AppIcon(item)
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun Clock(context: Context) {
+    val now = remember { Date() }
+    val is24 = DateFormat.is24HourFormat(context, UserHandle.myUserId())
+    val time = DateFormat.format(if (is24) "HH:mm" else "h:mm", now).toString()
+    val locale = context.resources.configuration.locales[0]
+    val date =
+        DateFormat.format(DateFormat.getBestDateTimePattern(locale, "EEEEMMMMd"), now).toString()
+    BasicText(
+        time,
+        style = TextStyle(color = Color.White, fontSize = 72.sp, fontWeight = FontWeight.Light),
+    )
+    BasicText(
+        date,
+        style = TextStyle(color = Color.White.copy(alpha = 0.7f), fontSize = 16.sp),
+    )
+}
+
+@Composable
+private fun HeldCard(item: PeekItem, action: HoldAction) {
+    val context = LocalContext.current
+    Column(horizontalAlignment = Alignment.CenterHorizontally) {
+        BasicText(
+            item.appName,
+            style = TextStyle(color = Color.White.copy(alpha = 0.6f), fontSize = 13.sp),
+        )
+        Spacer(Modifier.height(6.dp))
+        if (item.redacted) {
+            BasicText(
+                context.getString(R.string.plait_peek_contents_hidden),
+                style = TextStyle(color = Color.White, fontSize = 18.sp),
+            )
+        } else {
+            item.title?.let {
+                BasicText(
+                    it.toString(),
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                    style =
+                        TextStyle(color = Color.White, fontSize = 18.sp, fontWeight = FontWeight.Medium),
+                )
+            }
+            item.text?.let {
+                BasicText(
+                    it.toString(),
+                    maxLines = 3,
+                    overflow = TextOverflow.Ellipsis,
+                    style =
+                        TextStyle(
+                            color = Color.White.copy(alpha = 0.85f),
+                            fontSize = 15.sp,
+                            textAlign = TextAlign.Center,
+                        ),
+                )
+            }
+        }
+        Spacer(Modifier.height(10.dp))
+        val hint =
+            when (action) {
+                HoldAction.OPEN ->
+                    if (item.canOpen) R.string.plait_peek_release_to_open else R.string.plait_peek_hint
+                HoldAction.DISMISS ->
+                    if (item.canDismiss) R.string.plait_peek_release_to_dismiss
+                    else R.string.plait_peek_hint
+                HoldAction.NONE -> R.string.plait_peek_hint
+            }
+        BasicText(
+            context.getString(hint),
+            style = TextStyle(color = Color.White.copy(alpha = 0.5f), fontSize = 12.sp),
+        )
+    }
+}
+
+@Composable
+private fun AppIcon(item: PeekItem) {
+    val context = LocalContext.current
+    val sizePx = with(LocalDensity.current) { ICON_SIZE.roundToPx() }
+    val bitmap: ImageBitmap? =
+        remember(item.key) {
+            try {
+                item.icon
+                    ?.loadDrawableAsUser(context, item.iconUserId)
+                    ?.mutate()
+                    ?.apply { setTint(AndroidColor.WHITE) }
+                    ?.toBitmap(sizePx, sizePx)
+                    ?.asImageBitmap()
+            } catch (e: RuntimeException) {
+                null
+            }
+        }
+    if (bitmap != null) {
+        Image(bitmap, contentDescription = item.appName, modifier = Modifier.size(ICON_SIZE))
+    } else {
+        Box(Modifier.size(ICON_SIZE).background(Color.White.copy(alpha = 0.3f)))
+    }
+}
+
+private val ICON_SIZE = 36.dp
+private val CARD_HEIGHT = 150.dp
+private val SLIDE_DISTANCE = 72.dp
+private const val MAX_SHIFT_DP = 12
