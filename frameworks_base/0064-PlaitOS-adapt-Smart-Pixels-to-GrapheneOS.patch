diff --git a/packages/SystemUI/src/com/android/systemui/smartpixel/ui/SmartPixelView.kt b/packages/SystemUI/src/com/android/systemui/smartpixel/ui/SmartPixelView.kt
index b208f2ecb..8d957e6e3 100644
--- a/packages/SystemUI/src/com/android/systemui/smartpixel/ui/SmartPixelView.kt
+++ b/packages/SystemUI/src/com/android/systemui/smartpixel/ui/SmartPixelView.kt
@@ -20,6 +20,7 @@ import android.content.Context
 import android.graphics.Bitmap
 import android.graphics.BitmapShader
 import android.graphics.Canvas
+import android.graphics.Matrix
 import android.graphics.Paint
 import android.graphics.Shader
 import android.view.View
@@ -28,18 +29,45 @@ class SmartPixelView(context: Context) : View(context) {
 
     private val patternPaint = Paint()
     private var patternBitmap: Bitmap? = null
+    private val shiftMatrix = Matrix()
+    private var shiftStep = 0
+
+    // PlaitOS: move the pattern one pixel a minute through all 64 positions of the 8x8 tile,
+    // so every pixel spends the same share of time dark and the panel wears evenly (a fixed
+    // pattern would age the always-lit pixels faster and could leave a faint grid)
+    private val shiftRunnable =
+        object : Runnable {
+            override fun run() {
+                shiftStep = (shiftStep + 1) % (TILE * TILE)
+                applyShift()
+                invalidate()
+                postDelayed(this, SHIFT_INTERVAL_MS)
+            }
+        }
 
     init {
         setLayerType(LAYER_TYPE_HARDWARE, null)
     }
 
     fun updatePattern(bitmap: Bitmap) {
-        patternBitmap?.recycle()
+        // PlaitOS: no recycle() of the old 8x8 bitmap; the render thread may still draw with it
         patternBitmap = bitmap
-        patternPaint.shader = BitmapShader(bitmap, Shader.TileMode.REPEAT, Shader.TileMode.REPEAT)
+        patternPaint.shader =
+            BitmapShader(bitmap, Shader.TileMode.REPEAT, Shader.TileMode.REPEAT)
+        applyShift()
         invalidate()
     }
 
+    private fun applyShift() {
+        shiftMatrix.setTranslate((shiftStep % TILE).toFloat(), (shiftStep / TILE).toFloat())
+        patternPaint.shader?.setLocalMatrix(shiftMatrix)
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        postDelayed(shiftRunnable, SHIFT_INTERVAL_MS)
+    }
+
     override fun onDraw(canvas: Canvas) {
         if (patternBitmap == null) return
         canvas.drawRect(0f, 0f, width.toFloat(), height.toFloat(), patternPaint)
@@ -47,7 +75,12 @@ class SmartPixelView(context: Context) : View(context) {
 
     override fun onDetachedFromWindow() {
         super.onDetachedFromWindow()
-        patternBitmap?.recycle()
+        removeCallbacks(shiftRunnable)
         patternBitmap = null
     }
+
+    private companion object {
+        const val TILE = 8 // matches SmartPixelViewController's tile
+        const val SHIFT_INTERVAL_MS = 60_000L
+    }
 }
