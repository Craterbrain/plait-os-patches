@@ -0,0 +1,25 @@
+package com.android.deskclock.timer;
+
+import android.content.Context;
+import android.util.AttributeSet;
+
+import androidx.gridlayout.widget.GridLayout;
+
+/** Keeps the portrait timer keypad's rows and columns on the same pitch. */
+public final class TimerKeypadGrid extends GridLayout {
+    public TimerKeypadGrid(Context context, AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        // Landscape supplies an exact height and retains its side-by-side layout.
+        if (MeasureSpec.getMode(heightMeasureSpec) != MeasureSpec.EXACTLY) {
+            final int width = Math.round(MeasureSpec.getSize(widthMeasureSpec) * 0.85f);
+            final int height = Math.round(width * 4f / 3f);
+            widthMeasureSpec = MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY);
+            heightMeasureSpec = MeasureSpec.makeMeasureSpec(height, MeasureSpec.EXACTLY);
+        }
+        super.onMeasure(widthMeasureSpec, heightMeasureSpec);
+    }
+}
