+// applyMemoryBudget (PlaitOS) sets the default -j and caps soong_build's Go heap from the memory available now.
+// parseArgs runs later, so an explicit -j still wins; so does a smaller GOMEMLIMIT (or GOMEMLIMIT=off).
+func (c *configImpl) applyMemoryBudget(ctx Context) {
+	if v, _ := c.environ.Get("PLAIT_MEM_BUDGET"); v == "off" {
+		return
+	}
+	m := detectMemInfo(ctx)
+	if c.totalRAM != 0 {
+		m.total = c.totalRAM
+	}
+	for _, line := range c.applyMemoryPlan(m, detectOomd(ctx), runtime.NumCPU()) {
+		ctx.Println(line)
+	}
+}
+
+// applyMemoryPlan is applyMemoryBudget without the probes (for tests); it returns the lines to print.
+func (c *configImpl) applyMemoryPlan(m memInfo, oomd oomdState, cpus int) []string {
+	ceiling, _ := c.environ.GetInt("PLAIT_MEM_CEILING_PCT")
+	var extra uint64
+	if i, ok := c.environ.GetInt("PLAIT_MEM_RESERVE_GB"); ok && i > 0 {
+		extra = uint64(i) * gib
+	}
+	plan := memoryBudget(m, oomd, ceiling, extra)
+	if !plan.known {
+		return nil
+	}
+	c.memBudget, c.memBudgetKnown = plan.budget, true
+	c.parallel = memoryParallel(plan.budget, cpus)
+	existing, _ := c.environ.Get("GOMEMLIMIT")
+	limit := effectiveGoMemLimit(existing, memoryGoLimit(plan.budget))
+	c.environ.Set("GOMEMLIMIT", limit)
+
+	g := func(b uint64) float64 { return float64(b) / float64(gib) }
+	oomdText := "systemd-oomd off"
+	if oomd.active {
+		oomdText = fmt.Sprintf("systemd-oomd kills at %d%% swap", oomd.swapLimitPct)
+	}
+	swapText := "no swap"
+	if m.swapTotal > 0 {
+		swapText = fmt.Sprintf("%.1f GiB swap headroom", g(plan.swapHeadroom))
+		if plan.swapCut > 0 {
+			swapText += fmt.Sprintf(" (budget cut %.1f GiB)", g(plan.swapCut))
+		}
+	}
+	lines := []string{fmt.Sprintf("PlaitOS memory budget: %.1f GiB free of %.1f GiB, ceiling %d%% (%s) + %.0f GiB reserve, %s, %s -> %.1f GiB for the build: default -j%d, %d memory-heavy job(s), Go heap limit %s (PLAIT_MEM_BUDGET=off to disable)",
+		g(m.available), g(m.total), plan.ceilingPct, plan.ceilingFrom, g(extra), oomdText, swapText,
+		g(plan.budget), c.parallel, memoryHighmemParallel(plan.budget), limit)}
+	if plan.budget < plaitLowBudget {
+		lines = append(lines, fmt.Sprintf("WARNING: PlaitOS memory budget: only %.1f GiB for the build; soong_build's analysis alone can need about 20 GiB, so expect heavy swapping or a kill. Close programs, or lower PLAIT_MEM_RESERVE_GB if you raised it.", g(plan.budget)))
+	}
+	return lines
+}
+
 func (c *configImpl) HighmemParallel() int {
 	if i, ok := c.environ.GetInt("NINJA_HIGHMEM_NUM_JOBS"); ok {
 		return i
 	}
+	if c.memBudgetKnown && !c.UseRemoteBuild() {
+		// PlaitOS: from the free memory now, never above the -j limit (remote builds keep Soong's rule below)
+		if p := memoryHighmemParallel(c.memBudget); p < c.parallel {
+			return p
+		}
+		return c.parallel
+	}
 
 	const minMemPerHighmemProcess = 8 * 1024 * 1024 * 1024
 	parallel := c.Parallel()
