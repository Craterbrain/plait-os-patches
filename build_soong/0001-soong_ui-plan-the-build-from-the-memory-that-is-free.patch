+)
 
 func detectTotalRAM(ctx Context) uint64 {
 	var info syscall.Sysinfo_t
@@ -25,3 +30,62 @@ func detectTotalRAM(ctx Context) uint64 {
 	}
 	return uint64(info.Totalram) * uint64(info.Unit)
 }
+
+// detectMemInfo reads /proc/meminfo (zeros if it cannot). PlaitOS: see memory_budget.go.
+func detectMemInfo(ctx Context) memInfo {
+	f, err := os.Open("/proc/meminfo")
+	if err != nil {
+		return memInfo{}
+	}
+	defer f.Close()
+	return parseMemInfo(f)
+}
+
+// detectOomd finds out whether systemd-oomd is running (a process named systemd-oomd) and reads its SwapUsedLimit
+// from oomd.conf and its drop-ins, in systemd's order. PlaitOS: see memory_budget.go.
+func detectOomd(ctx Context) oomdState {
+	st := oomdState{swapLimitPct: 90}
+	procs, _ := os.ReadDir("/proc")
+	for _, p := range procs {
+		if p.Name()[0] < '0' || p.Name()[0] > '9' {
+			continue
+		}
+		if comm, err := os.ReadFile("/proc/" + p.Name() + "/comm"); err == nil && strings.TrimSpace(string(comm)) == "systemd-oomd" {
+			st.active = true
+			break
+		}
+	}
+	if !st.active {
+		return st
+	}
+	// systemd's order: only the highest-priority main file (/etc, /run, /usr/local/lib, /usr/lib), then the drop-ins
+	// of all four sorted by file name, a same-named file in a higher-priority directory replacing the lower one.
+	var confs []string
+	for _, dir := range []string{"/etc/systemd", "/run/systemd", "/usr/local/lib/systemd", "/usr/lib/systemd"} {
+		if b, err := os.ReadFile(dir + "/oomd.conf"); err == nil {
+			confs = append(confs, string(b))
+			break
+		}
+	}
+	dropins := map[string]string{}
+	for _, dir := range []string{"/usr/lib/systemd/oomd.conf.d", "/usr/local/lib/systemd/oomd.conf.d", "/run/systemd/oomd.conf.d", "/etc/systemd/oomd.conf.d"} {
+		entries, _ := os.ReadDir(dir)
+		for _, e := range entries {
+			if strings.HasSuffix(e.Name(), ".conf") {
+				dropins[e.Name()] = dir + "/" + e.Name()
+			}
+		}
+	}
+	names := make([]string, 0, len(dropins))
+	for n := range dropins {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	for _, n := range names {
+		if b, err := os.ReadFile(dropins[n]); err == nil {
+			confs = append(confs, string(b))
+		}
+	}
+	st.swapLimitPct = parseOomdSwapLimit(confs, st.swapLimitPct)
+	return st
+}
