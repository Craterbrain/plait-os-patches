+package shared
+
+import (
+	"fmt"
+	"runtime/debug"
+	"strconv"
+	"strings"
+)
+
+// PlaitOS: Go memory settings for soong_build.
+//
+// soong_build runs with `env -i`, so GOGC and GOMEMLIMIT from soong_ui's environment never reach the Go runtime at
+// startup. Passing them on the command line would put them into the ninja command, and any change of value would then
+// re-run the whole analysis. soong_build applies them itself from the available-environment file instead (not a ninja
+// input, and read without dependency tracking, like LOG_DIR).
+
+// ParseGoMemLimit reads a GOMEMLIMIT value the way the Go runtime does ("18GiB", "512MiB", "1073741824", "100B").
+// It returns 0, false for "off", an empty value or anything it cannot read.
+func ParseGoMemLimit(s string) (uint64, bool) {
+	s = strings.TrimSpace(s)
+	if s == "" || s == "off" {
+		return 0, false
+	}
+	mult := uint64(1)
+	for _, u := range []struct {
+		suffix string
+		mult   uint64
+	}{{"TiB", 1 << 40}, {"GiB", 1 << 30}, {"MiB", 1 << 20}, {"KiB", 1 << 10}, {"B", 1}} {
+		if strings.HasSuffix(s, u.suffix) {
+			mult = u.mult
+			s = strings.TrimSuffix(s, u.suffix)
+			break
+		}
+	}
+	n, err := strconv.ParseUint(s, 10, 64)
+	if err != nil || n == 0 || n > (1<<63-1)/mult {
+		return 0, false
+	}
+	return n * mult, true
+}
+
+// GoMemorySettings is what ApplyGoMemorySettings would change: a GC percentage (-1 = GOGC=off) and a heap limit.
+type GoMemorySettings struct {
+	GCPercent    int
+	HasGCPercent bool
+	MemLimit     uint64
+	HasMemLimit  bool
+}
+
+// GoMemorySettingsFromEnv reads GOGC and GOMEMLIMIT from an environment map. Unreadable values are left out, so the
+// runtime keeps its defaults, as it would for a bad value in the real environment.
+func GoMemorySettingsFromEnv(env map[string]string) GoMemorySettings {
+	var s GoMemorySettings
+	if v := strings.TrimSpace(env["GOGC"]); v == "off" {
+		s.GCPercent, s.HasGCPercent = -1, true
+	} else if p, err := strconv.Atoi(v); err == nil && p >= 0 {
+		s.GCPercent, s.HasGCPercent = p, true
+	}
+	s.MemLimit, s.HasMemLimit = ParseGoMemLimit(env["GOMEMLIMIT"])
+	return s
+}
+
+// ApplyGoMemorySettings sets the running program's GC percentage and heap limit from GOGC and GOMEMLIMIT in env, and
+// describes what it did ("" if nothing).
+func ApplyGoMemorySettings(env map[string]string) string {
+	s := GoMemorySettingsFromEnv(env)
+	var done []string
+	if s.HasGCPercent {
+		debug.SetGCPercent(s.GCPercent)
+		done = append(done, "GOGC="+strings.TrimSpace(env["GOGC"]))
+	}
+	if s.HasMemLimit {
+		debug.SetMemoryLimit(int64(s.MemLimit))
+		done = append(done, fmt.Sprintf("GOMEMLIMIT=%.1fGiB", float64(s.MemLimit)/(1<<30)))
+	}
+	return strings.Join(done, " ")
+}
