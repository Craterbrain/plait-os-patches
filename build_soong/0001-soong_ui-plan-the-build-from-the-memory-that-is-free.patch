+	if m := parseMemInfo(strings.NewReader("")); m != (memInfo{}) {
+		t.Errorf("empty %+v", m)
+	}
+}
+
+func TestParseOomdSwapLimit(t *testing.T) {
+	cases := []struct {
+		confs []string
+		want  int
+	}{
+		{nil, 90},
+		{[]string{"[OOM]\nSwapUsedLimit=80%\n"}, 80},
+		{[]string{"[OOM]\n#SwapUsedLimit=50%\nSwapUsedLimit = 85.7%"}, 85},
+		{[]string{"[OOM]\nSwapUsedLimit=9500‱"}, 95},
+		{[]string{"[OOM]\nSwapUsedLimit=80%", "[OOM]\nSwapUsedLimit=70%"}, 70}, // later drop-in wins
+		{[]string{"[Other]\nSwapUsedLimit=10%"}, 90},                           // wrong section
+		{[]string{"[OOM]\nSwapUsedLimit=lots", "[OOM]\nSwapUsedLimit=0%"}, 90}, // unreadable / zero ignored
+	}
+	for _, c := range cases {
+		if got := parseOomdSwapLimit(c.confs, 90); got != c.want {
+			t.Errorf("%q -> %d want %d", c.confs, got, c.want)
+		}
+	}
+}
+
+func TestBudget(t *testing.T) {
+	total := 30 * gib
+	// Idle machine, no swap: 25 GiB free -> 25 - 12% of 30 (3.6) = 21.4 GiB
+	p := memoryBudget(ram(total, 25*gib), noOomd, 0, 0)
+	if !p.known || p.budget < 21*gib || p.budget > 22*gib || p.ceilingFrom != "default" {
+		t.Fatalf("%+v", p)
+	}
+	if n := memoryParallel(p.budget, 12); n != 8 {
+		t.Errorf("parallel %d", n)
+	}
+	if h := memoryHighmemParallel(p.budget); h != 2 {
+		t.Errorf("highmem %d", h)
+	}
+	if g := memoryGoLimit(p.budget); g != 18*gib {
+		t.Errorf("go limit %d GiB", g/gib)
+	}
+	// The failing situation: 6 GiB free -> 2.4 GiB
+	tight := memoryBudget(ram(total, 6*gib), noOomd, 0, 0)
+	if memoryParallel(tight.budget, 12) != 2 || memoryHighmemParallel(tight.budget) != 1 || memoryGoLimit(tight.budget) != 8*gib {
+		t.Errorf("tight %+v", tight)
+	}
+	// No room at all is "known, zero"; no figures is "unknown"
+	if p := memoryBudget(ram(total, 2*gib), noOomd, 0, 0); !p.known || p.budget != 0 {
+		t.Errorf("none %+v", p)
+	}
+	if p := memoryBudget(ram(0, 5*gib), noOomd, 0, 0); p.known {
+		t.Errorf("unknown total")
+	}
+	if p := memoryBudget(ram(total, 0), noOomd, 0, 0); p.known {
+		t.Errorf("unknown available")
+	}
+	// Extra reserve shrinks it; a silly override falls back to the default
+	if p2 := memoryBudget(ram(total, 25*gib), noOomd, 0, 8*gib); p2.budget != p.budget-8*gib {
+		t.Errorf("reserve %+v", p2)
+	}
+	if p2 := memoryBudget(ram(total, 25*gib), noOomd, 5, 0); p2.budget != p.budget || p2.ceilingFrom != "default" {
+		t.Errorf("bad override %+v", p2)
+	}
+	// Huge machine: capped at cpus+2 jobs, 2 highmem jobs, Go limit capped
+	big := memoryBudget(ram(256*gib, 250*gib), noOomd, 0, 0)
+	if memoryParallel(big.budget, 12) != 14 || memoryHighmemParallel(big.budget) != 2 || memoryGoLimit(big.budget) != 24*gib {
+		t.Errorf("big %+v", big)
+	}
+}
+
+func TestBudgetCeilingFromOomd(t *testing.T) {
+	total := 100 * gib
+	if p := memoryBudget(ram(total, 50*gib), oomd90, 0, 0); p.ceilingPct != 88 || p.ceilingFrom != "oomd" || p.budget != 38*gib {
+		t.Errorf("oomd 90 -> 88: %+v", p)
+	}
+	if p := memoryBudget(ram(total, 50*gib), oomdState{active: true, swapLimitPct: 70}, 0, 0); p.ceilingPct != 68 || p.budget != 18*gib {
+		t.Errorf("oomd 70 -> 68: %+v", p)
+	}
+	if p := memoryBudget(ram(total, 50*gib), oomd90, 80, 0); p.ceilingPct != 80 || p.ceilingFrom != "PLAIT_MEM_CEILING_PCT" {
+		t.Errorf("override wins: %+v", p)
+	}
+	if p := memoryBudget(ram(total, 50*gib), oomdState{active: false, swapLimitPct: 70}, 0, 0); p.ceilingPct != 88 {
+		t.Errorf("oomd off keeps the default: %+v", p)
+	}
+}
+
+func TestBudgetSwap(t *testing.T) {
+	total := 30 * gib
+	m := ram(total, 25*gib) // 21.4 GiB from RAM
+	base := memoryBudget(m, noOomd, 0, 0).budget
+
+	// Plenty of swap left: no cut
+	m.swapTotal, m.swapFree = 64*gib, 60*gib
+	if p := memoryBudget(m, oomd90, 0, 0); p.swapCut != 0 || p.budget != base {
+		t.Errorf("plenty %+v", p)
+	}
+	// oomd at 90% of 10 GiB swap = 9 GiB allowed, 7 GiB used -> 2 GiB headroom -> cut 2 GiB
+	m.swapTotal, m.swapFree = 10*gib, 3*gib
+	if p := memoryBudget(m, oomd90, 0, 0); p.swapHeadroom != 2*gib || p.swapCut != 2*gib || p.budget != base-2*gib {
+		t.Errorf("near the oomd line %+v", p)
+	}
+	// Already past the oomd line: the whole cushion is cut
+	m.swapFree = 0
+	if p := memoryBudget(m, oomd90, 0, 0); p.swapHeadroom != 0 || p.budget != base-plaitSwapCushion {
+		t.Errorf("past the line %+v", p)
+	}
+	// Without oomd the line is 95%: 9.5 GiB allowed of 10, 7 used -> 2.5 GiB headroom
+	m.swapFree = 3 * gib
+	if p := memoryBudget(m, noOomd, 0, 0); p.swapHeadroom != 10*gib*95/100-7*gib {
+		t.Errorf("no oomd %+v", p)
+	}
+	// The cut never goes below zero
+	m.available = 4 * gib
+	if p := memoryBudget(m, oomd90, 0, 0); p.budget != 0 {
+		t.Errorf("floor %+v", p)
+	}
+}
+
+func TestGoLimitIsWholeGiB(t *testing.T) {
+	for _, b := range []uint64{9 * gib, 13*gib + 12345, 17*gib + gib/3, 20 * gib} {
+		if l := memoryGoLimit(b); l%gib != 0 || l > b {
