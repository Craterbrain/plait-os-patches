 	return uint64(info.Totalram) * uint64(info.Unit)
 }
+
+// detectAvailableRAM is the kernel's estimate of the memory a new workload can use without swapping (MemAvailable),
+// 0 if it cannot be read. PlaitOS: see memory_budget.go.
+func detectAvailableRAM(ctx Context) uint64 {
+	f, err := os.Open("/proc/meminfo")
+	if err != nil {
+		return 0
+	}
+	defer f.Close()
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		if rest, ok := strings.CutPrefix(sc.Text(), "MemAvailable:"); ok {
+			fields := strings.Fields(rest)
+			if len(fields) >= 1 {
+				if kb, err := strconv.ParseUint(fields[0], 10, 64); err == nil {
+					return kb * 1024
+				}
+			}
+		}
+	}
+	return 0
+}
