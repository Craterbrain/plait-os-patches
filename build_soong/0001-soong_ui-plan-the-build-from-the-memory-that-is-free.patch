+package shared
+
+import (
+	"math"
+	"runtime/debug"
+	"testing"
+)
+
+func TestParseGoMemLimit(t *testing.T) {
+	for in, want := range map[string]uint64{
+		"18GiB": 18 << 30, "512MiB": 512 << 20, "1073741824": 1 << 30, "100B": 100, "2GiB ": 2 << 30, "1TiB": 1 << 40,
+		"": 0, "off": 0, "x": 0, "-1": 0, "0": 0, "1.5GiB": 0, "99999999999TiB": 0,
+	} {
+		got, ok := ParseGoMemLimit(in)
+		if got != want || ok != (want != 0) {
+			t.Errorf("%q -> %d %v, want %d", in, got, ok, want)
+		}
+	}
+}
+
+func TestGoMemorySettingsFromEnv(t *testing.T) {
+	s := GoMemorySettingsFromEnv(map[string]string{"GOGC": "50", "GOMEMLIMIT": "18GiB"})
+	if !s.HasGCPercent || s.GCPercent != 50 || !s.HasMemLimit || s.MemLimit != 18<<30 {
+		t.Errorf("both: %+v", s)
+	}
+	if s := GoMemorySettingsFromEnv(map[string]string{"GOGC": "off"}); !s.HasGCPercent || s.GCPercent != -1 || s.HasMemLimit {
+		t.Errorf("off: %+v", s)
+	}
+	if s := GoMemorySettingsFromEnv(map[string]string{"GOGC": "lots", "GOMEMLIMIT": "off"}); s.HasGCPercent || s.HasMemLimit {
+		t.Errorf("unreadable/off must leave the defaults: %+v", s)
+	}
+	if s := GoMemorySettingsFromEnv(nil); s.HasGCPercent || s.HasMemLimit {
+		t.Errorf("empty: %+v", s)
+	}
+}
+
+func TestApplyGoMemorySettings(t *testing.T) {
+	oldGC := debug.SetGCPercent(100)
+	oldLimit := debug.SetMemoryLimit(math.MaxInt64)
+	defer func() { debug.SetGCPercent(oldGC); debug.SetMemoryLimit(oldLimit) }()
+
+	if d := ApplyGoMemorySettings(map[string]string{"GOGC": "50", "GOMEMLIMIT": "18GiB"}); d != "GOGC=50 GOMEMLIMIT=18.0GiB" {
+		t.Errorf("description %q", d)
+	}
+	if got := debug.SetMemoryLimit(-1); got != 18<<30 {
+		t.Errorf("limit %d", got)
+	}
+	if got := debug.SetGCPercent(-1); got != 50 {
+		t.Errorf("gc percent %d", got)
+	}
+	if d := ApplyGoMemorySettings(map[string]string{}); d != "" {
+		t.Errorf("nothing to apply: %q", d)
+	}
+}
