+
+package build
+
+import (
+	"bufio"
+	"io"
+	"strconv"
+	"strings"
+
+	"android/soong/shared"
+)
+
+// PlaitOS: plan the build from the memory that is free now, not from the machine's total.
+//
+// Soong sizes its parallelism from total RAM ("32 GB or less: 2 memory-heavy jobs"), whatever else is running. On a
+// 30 GB desktop that already holds 10+ GB (and swaps idle pages out to zram), a full ROM build then drove memory and
+// swap past the 90% swap line at which systemd-oomd kills the whole build, four times in a row (2026-11-15).
+//
+// The budget is what the build may use now:
+//
+//   - RAM: available RAM (MemAvailable) minus (100-ceiling)% of the total, minus an optional extra reserve. The
+//     ceiling is 2 points under systemd-oomd's SwapUsedLimit when oomd is running (read from its config), else 88%.
+//   - Swap: under pressure Linux moves pages out to swap even inside the budget. If less than plaitSwapCushion of
+//     swap is left before the kill line (oomd's SwapUsedLimit, or 95% of swap without oomd), the budget shrinks by
+//     the shortfall.
+//
+// From the budget come the default -j (about 2.5 GiB per job), the number of memory-heavy jobs (about 10 GiB each, at
+// most Soong's usual 2), and a cap on Go's heap for soong_build's analysis, in whole GiB so that the value is stable.
+// An explicit -j, NINJA_HIGHMEM_NUM_JOBS or a smaller GOMEMLIMIT always wins; GOMEMLIMIT=off is left alone.
+//
+//   PLAIT_MEM_BUDGET=off          switch all of this off (back to stock Soong)
+//   PLAIT_MEM_CEILING_PCT=88      the RAM ceiling, in percent of total RAM (50..98); overrides the oomd-derived one
+//   PLAIT_MEM_RESERVE_GB=0        extra memory to leave to everything else, e.g. raised on each restart after a kill
+
+const (
+	gib                     = uint64(1024 * 1024 * 1024)
+	plaitDefaultCeilingPct  = 88
+	plaitOomdMarginPct      = 2  // ceiling = oomd's SwapUsedLimit minus this
+	plaitNoOomdSwapPct      = 95 // without oomd, the swap kill line is the kernel's: treat 95% as full
+	plaitSwapCushion        = 4 * gib
+	plaitMemPerJob          = gib * 5 / 2 // a typical compile/link job; heavier ones are in the highmem pool
+	plaitMemPerHighmemJob   = 10 * gib
+	plaitMinGoMemLimit      = 8 * gib
+	plaitMaxGoMemLimit      = 24 * gib
+	plaitGoMemLimitShare    = 85 // percent of the budget soong_build's heap may use
+	plaitMinParallel        = 2
+	plaitMaxHighmemParallel = 2
+	plaitLowBudget          = plaitMinGoMemLimit // below this, soong_build's analysis alone will swap heavily
+)
+
+// memInfo is the part of /proc/meminfo the budget needs (bytes). total or available 0 = unknown.
+type memInfo struct {
+	total, available, swapTotal, swapFree uint64
+}
+
+// parseMemInfo reads /proc/meminfo's format ("MemAvailable:   123 kB").
+func parseMemInfo(r io.Reader) memInfo {
+	var m memInfo
+	fields := map[string]*uint64{
+		"MemTotal": &m.total, "MemAvailable": &m.available, "SwapTotal": &m.swapTotal, "SwapFree": &m.swapFree,
+	}
+	sc := bufio.NewScanner(r)
+	for sc.Scan() {
+		name, rest, ok := strings.Cut(sc.Text(), ":")
+		dst, want := fields[name]
+		if !ok || !want {
+			continue
+		}
+		f := strings.Fields(rest)
+		if len(f) == 0 {
+			continue
+		}
+		if n, err := strconv.ParseUint(f[0], 10, 64); err == nil {
+			if len(f) > 1 && f[1] == "kB" {
+				n *= 1024
+			}
+			*dst = n
+		}
+	}
+	return m
+}
+
+// oomdState is whether systemd-oomd is running and its swap kill line in percent of swap (systemd's default 90).
+type oomdState struct {
+	active       bool
+	swapLimitPct int
+}
+
+// parseOomdSwapLimit returns SwapUsedLimit from oomd.conf files given in systemd's order (later files win).
+// It accepts "90%", "90.5%" (rounded down) and "9050‱"; anything else keeps the previous value.
+func parseOomdSwapLimit(confs []string, def int) int {
+	limit := def
+	for _, conf := range confs {
+		section := ""
+		for _, line := range strings.Split(conf, "\n") {
+			line = strings.TrimSpace(line)
+			if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
+				section = line
+				continue
+			}
+			k, v, ok := strings.Cut(line, "=")
+			if !ok || section != "[OOM]" || strings.TrimSpace(k) != "SwapUsedLimit" {
+				continue
+			}
+			v = strings.TrimSpace(v)
+			var pct float64
+			var err error
+			switch {
+			case strings.HasSuffix(v, "%"):
+				pct, err = strconv.ParseFloat(strings.TrimSuffix(v, "%"), 64)
+			case strings.HasSuffix(v, "‱"):
+				pct, err = strconv.ParseFloat(strings.TrimSuffix(v, "‱"), 64)
+				pct /= 100
+			default:
+				continue
+			}
+			if err == nil && pct > 0 && pct <= 100 {
+				limit = int(pct)
+			}
+		}
+	}
+	return limit
+}
+
+// budgetPlan is the budget and how it came about (for the message soong_ui prints).
+type budgetPlan struct {
+	budget       uint64
+	known        bool
+	ceilingPct   int
+	ceilingFrom  string // "oomd", "PLAIT_MEM_CEILING_PCT" or "default"
+	swapHeadroom uint64 // swap left before the kill line
+	swapCut      uint64 // how much the budget was cut for lack of swap headroom
+	extraReserve uint64
+}
+
+// memoryBudget plans how much memory the build may use now. known is false if the RAM figures are missing; a known
+// budget of 0 means there is no room beyond the reserve. ceilingOverride <= 0 means "not set".
+func memoryBudget(m memInfo, oomd oomdState, ceilingOverride int, extraReserve uint64) budgetPlan {
+	p := budgetPlan{ceilingPct: plaitDefaultCeilingPct, ceilingFrom: "default", extraReserve: extraReserve}
+	if ceilingOverride >= 50 && ceilingOverride <= 98 {
+		p.ceilingPct, p.ceilingFrom = ceilingOverride, "PLAIT_MEM_CEILING_PCT"
+	} else if oomd.active && oomd.swapLimitPct > 0 {
+		p.ceilingPct, p.ceilingFrom = clampInt(oomd.swapLimitPct-plaitOomdMarginPct, 50, 98), "oomd"
+	}
+	if m.total == 0 || m.available == 0 {
+		return p
+	}
+	p.known = true
+	reserve := m.total*uint64(100-p.ceilingPct)/100 + extraReserve
+	if m.available > reserve {
+		p.budget = m.available - reserve
+	}
+
+	if m.swapTotal > 0 {
+		killPct := uint64(plaitNoOomdSwapPct)
+		if oomd.active && oomd.swapLimitPct > 0 {
+			killPct = uint64(oomd.swapLimitPct)
+		}
+		allowed := m.swapTotal * killPct / 100
+		used := uint64(0)
+		if m.swapTotal > m.swapFree {
+			used = m.swapTotal - m.swapFree
+		}
+		if allowed > used {
+			p.swapHeadroom = allowed - used
+		}
+		if p.swapHeadroom < plaitSwapCushion {
+			p.swapCut = plaitSwapCushion - p.swapHeadroom
+			if p.swapCut > p.budget {
+				p.swapCut = p.budget
+			}
+			p.budget -= p.swapCut
+		}
+	}
+	return p
+}
+
+func clampInt(v, lo, hi int) int {
+	if v < lo {
+		return lo
+	}
+	if v > hi {
+		return hi
+	}
+	return v
+}
+
+// memoryParallel is the default number of ninja jobs for a budget (never above cpus+2, Soong's default).
+func memoryParallel(budget uint64, cpus int) int {
+	return clampInt(int(budget/plaitMemPerJob), plaitMinParallel, cpus+2)
+}
+
+// memoryHighmemParallel is the number of memory-heavy jobs for a budget, at most Soong's own limit for small machines.
+func memoryHighmemParallel(budget uint64) int {
+	return clampInt(int(budget/plaitMemPerHighmemJob), 1, plaitMaxHighmemParallel)
+}
+
+// memoryGoLimit is the Go heap limit for soong_build's analysis for a budget, rounded down to whole GiB.
+func memoryGoLimit(budget uint64) uint64 {
+	limit := budget / 100 * plaitGoMemLimitShare / gib * gib
+	if limit < plaitMinGoMemLimit {
+		limit = plaitMinGoMemLimit
+	}
+	if limit > plaitMaxGoMemLimit {
+		limit = plaitMaxGoMemLimit
+	}
+	return limit
+}
+
+// effectiveGoMemLimit is the GOMEMLIMIT value to use, given one already in the environment and the budget's: a smaller
+// existing value or "off" is kept as written, otherwise the budget's in whole GiB.
+func effectiveGoMemLimit(existing string, fromBudget uint64) string {
+	if strings.TrimSpace(existing) == "off" {
+		return "off"
+	}
+	if e, ok := shared.ParseGoMemLimit(existing); ok && e < fromBudget {
+		return strings.TrimSpace(existing)
+	}
+	return strconv.FormatUint(fromBudget/gib, 10) + "GiB"
+}
