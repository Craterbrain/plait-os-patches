+package build
+
+import (
+	"strconv"
+	"strings"
+)
+
+// PlaitOS: plan the build from the memory that is free now, not from the machine's total.
+//
+// Soong sizes its parallelism from total RAM ("32 GB or less: 2 memory-heavy jobs"), whatever else is running. On a
+// 30 GB desktop that already holds 10+ GB (and swaps idle pages out to zram), a full ROM build then drove memory and
+// swap past the 90% swap line at which systemd-oomd kills the whole build, four times in a row (2026-11-15).
+//
+// The budget is what the build may use while the machine stays under a ceiling (88% by default, just under oomd's
+// 90%): available RAM minus (100-ceiling)% of the total, minus an optional extra reserve. From it come the default
+// -j (about 2.5 GiB per job), the number of memory-heavy jobs (about 10 GiB each, at most Soong's usual 2), and a
+// cap on Go's heap for soong_build's analysis. An explicit -j, NINJA_HIGHMEM_NUM_JOBS or GOMEMLIMIT always wins.
+//
+//   PLAIT_MEM_BUDGET=off          switch all of this off (back to stock Soong)
+//   PLAIT_MEM_CEILING_PCT=88      the ceiling, in percent of total RAM (50..98)
+//   PLAIT_MEM_RESERVE_GB=0        extra memory to leave to everything else, e.g. raised on each restart after a kill
+
+const (
+	gib                     = uint64(1024 * 1024 * 1024)
+	plaitDefaultCeilingPct  = 88
+	plaitMemPerJob          = gib * 5 / 2 // a typical compile/link job; heavier ones are in the highmem pool
+	plaitMemPerHighmemJob   = 10 * gib
+	plaitMinGoMemLimit      = 8 * gib
+	plaitMaxGoMemLimit      = 24 * gib
+	plaitGoMemLimitShare    = 85 // percent of the budget soong_build's heap may use
+	plaitMinParallel        = 2
+	plaitMaxHighmemParallel = 2
+	plaitUnknownBudget      = uint64(0)
+)
+
+// memoryBudget returns how much memory the build may use now, and false if it cannot be known (no RAM figures).
+// A known budget of 0 means there is no room beyond the reserve.
+func memoryBudget(total, available uint64, ceilingPct int, extraReserve uint64) (uint64, bool) {
+	if total == 0 || available == 0 {
+		return plaitUnknownBudget, false
+	}
+	if ceilingPct < 50 || ceilingPct > 98 {
+		ceilingPct = plaitDefaultCeilingPct
+	}
+	reserve := total*uint64(100-ceilingPct)/100 + extraReserve
+	if available <= reserve {
+		return 0, true
+	}
+	return available - reserve, true
+}
+
+func clampInt(v, lo, hi int) int {
+	if v < lo {
+		return lo
+	}
+	if v > hi {
+		return hi
+	}
+	return v
+}
+
+// memoryParallel is the default number of ninja jobs for a budget (never above cpus+2, Soong's default).
+func memoryParallel(budget uint64, cpus int) int {
+	return clampInt(int(budget/plaitMemPerJob), plaitMinParallel, cpus+2)
+}
+
+// memoryHighmemParallel is the number of memory-heavy jobs for a budget, at most Soong's own limit for small machines.
+func memoryHighmemParallel(budget uint64) int {
+	return clampInt(int(budget/plaitMemPerHighmemJob), 1, plaitMaxHighmemParallel)
+}
+
+// memoryGoLimit is the Go heap limit for soong_build's analysis for a budget.
+func memoryGoLimit(budget uint64) uint64 {
+	limit := budget / 100 * plaitGoMemLimitShare
+	if limit < plaitMinGoMemLimit {
+		limit = plaitMinGoMemLimit
+	}
+	if limit > plaitMaxGoMemLimit {
+		limit = plaitMaxGoMemLimit
+	}
+	return limit
+}
+
+// parseGoMemLimit reads a GOMEMLIMIT value ("18GiB", "512MiB", "1073741824", ...); 0 for off/unparseable.
+func parseGoMemLimit(s string) uint64 {
+	s = strings.TrimSpace(s)
+	if s == "" || s == "off" {
+		return 0
+	}
+	mult := uint64(1)
+	for _, u := range []struct {
+		suffix string
+		mult   uint64
+	}{{"TiB", gib * 1024}, {"GiB", gib}, {"MiB", 1024 * 1024}, {"KiB", 1024}, {"B", 1}} {
+		if strings.HasSuffix(s, u.suffix) {
+			mult = u.mult
+			s = strings.TrimSuffix(s, u.suffix)
+			break
+		}
+	}
+	n, err := strconv.ParseUint(strings.TrimSpace(s), 10, 64)
+	if err != nil {
+		return 0
+	}
+	return n * mult
+}
+
+// effectiveGoMemLimit combines a GOMEMLIMIT already in the environment with the budget's: the smaller one wins.
+func effectiveGoMemLimit(existing string, fromBudget uint64) uint64 {
+	if e := parseGoMemLimit(existing); e != 0 && e < fromBudget {
+		return e
+	}
+	return fromBudget
+}
diff --git a/ui/build/memory_budget_test.go b/ui/build/memory_budget_test.go
new file mode 100644
index 0000000..9dce6a0
--- /dev/null
+++ b/ui/build/memory_budget_test.go
@@ -0,0 +1,71 @@
+package build
+
+import "testing"
+
+func TestBudget(t *testing.T) {
+	total := 30 * gib
+	// Idle machine: 25 GiB free -> 25 - 12% of 30 (3.6) = 21.4 GiB
+	b, ok := memoryBudget(total, 25*gib, 88, 0)
+	if !ok || b < 21*gib || b > 22*gib {
+		t.Fatalf("budget %v %v", b/gib, ok)
+	}
+	if p := memoryParallel(b, 12); p != 8 {
+		t.Errorf("parallel %d", p)
+	}
+	if h := memoryHighmemParallel(b); h != 2 {
+		t.Errorf("highmem %d", h)
+	}
+	if g := memoryGoLimit(b); g < 18*gib || g > 19*gib {
+		t.Errorf("go limit %d GiB", g/gib)
+	}
+	// The failing situation: 6 GiB free -> 6 - 3.6 = 2.4 GiB
+	b2, _ := memoryBudget(total, 6*gib, 88, 0)
+	if memoryParallel(b2, 12) != 2 || memoryHighmemParallel(b2) != 1 {
+		t.Errorf("tight: %d %d", memoryParallel(b2, 12), memoryHighmemParallel(b2))
+	}
+	if memoryGoLimit(b2) != 8*gib {
+		t.Errorf("floor %d", memoryGoLimit(b2)/gib)
+	}
+	// No room at all is "known, zero"; no figures is "unknown"
+	if b3, ok := memoryBudget(total, 2*gib, 88, 0); !ok || b3 != 0 {
+		t.Errorf("none %v %v", b3, ok)
+	}
+	if _, ok := memoryBudget(0, 5*gib, 88, 0); ok {
+		t.Errorf("unknown total")
+	}
+	if _, ok := memoryBudget(total, 0, 88, 0); ok {
+		t.Errorf("unknown available")
+	}
+	// Extra reserve (raised on restarts) shrinks it; a silly ceiling falls back to the default
+	b4, _ := memoryBudget(total, 25*gib, 88, 8*gib)
+	if b4 >= b || b4 < 13*gib {
+		t.Errorf("reserve %d", b4/gib)
+	}
+	b5, _ := memoryBudget(total, 25*gib, 5, 0)
+	if b5 != b {
+		t.Errorf("bad ceiling not defaulted")
+	}
+	// Huge machine: capped at cpus+2 jobs and 2 highmem jobs, Go limit capped
+	big, _ := memoryBudget(256*gib, 250*gib, 88, 0)
+	if memoryParallel(big, 12) != 14 || memoryHighmemParallel(big) != 2 || memoryGoLimit(big) != 24*gib {
+		t.Errorf("big")
+	}
+}
+
+func TestGoMemLimit(t *testing.T) {
+	for in, want := range map[string]uint64{"18GiB": 18 * gib, "512MiB": 512 << 20, "1073741824": gib, "": 0, "off": 0, "x": 0, "2GiB ": 2 * gib} {
+		if got := parseGoMemLimit(in); got != want {
+			t.Errorf("%q -> %d want %d", in, got, want)
+		}
+	}
+	// The smaller of an existing limit and the budget's wins
+	if effectiveGoMemLimit("12GiB", 19*gib) != 12*gib {
+		t.Error("existing smaller")
+	}
+	if effectiveGoMemLimit("30GiB", 19*gib) != 19*gib {
+		t.Error("budget smaller")
+	}
+	if effectiveGoMemLimit("", 19*gib) != 19*gib {
+		t.Error("none")
+	}
+}
