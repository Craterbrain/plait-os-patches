+func ram(total, available uint64) memInfo { return memInfo{total: total, available: available} }
+
+func TestParseMemInfo(t *testing.T) {
+	m := parseMemInfo(strings.NewReader("MemTotal:       31987324 kB\nMemFree:  1 kB\nMemAvailable:   27000000 kB\nSwapTotal:      100 kB\nSwapFree:        40 kB\nBogus\n"))
