+		}
+	}
+	for in, want := range map[string]string{"12GiB": "12GiB", "30GiB": "19GiB", "": "19GiB", "off": "off", " off ": "off", "junk": "19GiB", "1073741824": "1073741824"} {
+		if got := effectiveGoMemLimit(in, 19*gib); got != want {
+			t.Errorf("%q -> %q want %q", in, got, want)
+		}
+	}
+}
