+// applyMemoryBudget (PlaitOS) sets the default -j and caps soong_build's Go heap from the memory available now.
+// parseArgs runs later, so an explicit -j still wins; so does an explicit GOMEMLIMIT if it is smaller.
+func (c *configImpl) applyMemoryBudget(ctx Context) {
+	if v, _ := c.environ.Get("PLAIT_MEM_BUDGET"); v == "off" {
+		return
+	}
+	ceiling := plaitDefaultCeilingPct
+	if i, ok := c.environ.GetInt("PLAIT_MEM_CEILING_PCT"); ok {
+		ceiling = i
+	}
+	var extra uint64
+	if i, ok := c.environ.GetInt("PLAIT_MEM_RESERVE_GB"); ok && i > 0 {
+		extra = uint64(i) * gib
+	}
+	available := detectAvailableRAM(ctx)
+	budget, known := memoryBudget(c.totalRAM, available, ceiling, extra)
+	if !known {
+		return
+	}
+	c.memBudget, c.memBudgetKnown = budget, true
+	c.parallel = memoryParallel(budget, runtime.NumCPU())
+	existing, _ := c.environ.Get("GOMEMLIMIT")
+	limit := effectiveGoMemLimit(existing, memoryGoLimit(budget))
+	c.environ.Set("GOMEMLIMIT", strconv.FormatUint(limit, 10)+"B")
+	ctx.Printf("PlaitOS memory budget: %.1f GiB free of %.1f GiB, ceiling %d%% + %.0f GiB reserve -> %.1f GiB for the build: -j%d, %d memory-heavy job(s), Go heap limit %.1f GiB (PLAIT_MEM_BUDGET=off to disable)",
+		float64(available)/float64(gib), float64(c.totalRAM)/float64(gib), ceiling, float64(extra)/float64(gib),
+		float64(budget)/float64(gib), c.parallel, memoryHighmemParallel(budget), float64(limit)/float64(gib))
+}
+
 func (c *configImpl) HighmemParallel() int {
 	if i, ok := c.environ.GetInt("NINJA_HIGHMEM_NUM_JOBS"); ok {
 		return i
 	}
+	if c.memBudgetKnown {
+		// PlaitOS: from the free memory now, never above Soong's own limit
+		if p := memoryHighmemParallel(c.memBudget); p < c.parallel {
+			return p
+		}
+		return c.parallel
+	}
 
 	const minMemPerHighmemProcess = 8 * 1024 * 1024 * 1024
 	parallel := c.Parallel()
