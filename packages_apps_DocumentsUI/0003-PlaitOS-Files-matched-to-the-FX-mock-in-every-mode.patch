+    /**
+     * A picker's request ("Choose a file for Gmail"): its own full-width line under the top bar,
+     * so the path keeps the bar's full height.
+     */
+    private void updatePlaitCaption() {
+        final String caption = mActivity.getPlaitCaption();
+        if (mCaption == null) {
+            if (caption == null) return;
+            View appBar = mActivity.findViewById(getRes(R.id.app_bar));
+            if (!(appBar instanceof ViewGroup)) return;
+            mCaption = new android.widget.TextView(mActivity);
+            mCaption.setTextSize(android.util.TypedValue.COMPLEX_UNIT_SP, 13);
+            mCaption.setTextColor(com.google.android.material.color.MaterialColors.getColor(
+                    mCaption, androidx.appcompat.R.attr.colorPrimary));
+            mCaption.setMaxLines(1);
+            mCaption.setEllipsize(android.text.TextUtils.TruncateAt.END);
+            final int dp = Math.round(mActivity.getResources().getDisplayMetrics().density);
+            mCaption.setPadding(18 * dp, 0, 18 * dp, 8 * dp);
+            ViewGroup bar = (ViewGroup) appBar;
+            bar.addView(mCaption, bar.indexOfChild(mActivity.findViewById(
+                    getRes(R.id.collapsing_toolbar))) + 1, new ViewGroup.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        }
+        mCaption.setText(caption);
+        mCaption.setVisibility(caption == null || mIsActionModeActivated ? GONE : VISIBLE);
+    }
