diff --git a/src/com/android/documentsui/clipping/PlaitClipboard.java b/src/com/android/documentsui/clipping/PlaitClipboard.java
new file mode 100644
index 0000000..c8bec2b
--- /dev/null
+++ b/src/com/android/documentsui/clipping/PlaitClipboard.java
@@ -0,0 +1,67 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.documentsui.clipping;
+
+import android.content.ClipData;
+import android.content.ClipDescription;
+import android.content.ClipboardManager;
+
+import androidx.annotation.Nullable;
+
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * PlaitOS: Files' own clipboard for Cut and Copy (FX's model). The files never reach the system
+ * clipboard: no "Copied" overlay, other apps don't see the list, and a text copy elsewhere doesn't
+ * drop it. It lives as long as the Files process (every Files window shares it). Same calls as
+ * ClipboardManager, so RuntimeDocumentClipper works unchanged on top of it.
+ */
+public final class PlaitClipboard {
+    private static @Nullable ClipData sClip;
+    private static final CopyOnWriteArrayList<ClipboardManager.OnPrimaryClipChangedListener>
+            sListeners = new CopyOnWriteArrayList<>();
+
+    private PlaitClipboard() {}
+
+    public static synchronized boolean hasPrimaryClip() {
+        return sClip != null;
+    }
+
+    public static synchronized @Nullable ClipData getPrimaryClip() {
+        return sClip;
+    }
+
+    public static synchronized @Nullable ClipDescription getPrimaryClipDescription() {
+        return sClip == null ? null : sClip.getDescription();
+    }
+
+    public static void setPrimaryClip(ClipData clip) {
+        synchronized (PlaitClipboard.class) {
+            sClip = clip;
+        }
+        notifyChanged();
+    }
+
+    public static void clearPrimaryClip() {
+        synchronized (PlaitClipboard.class) {
+            if (sClip == null) return;
+            sClip = null;
+        }
+        notifyChanged();
+    }
+
+    public static void addPrimaryClipChangedListener(ClipboardManager.OnPrimaryClipChangedListener l) {
+        sListeners.addIfAbsent(l);
+    }
+
+    public static void removePrimaryClipChangedListener(ClipboardManager.OnPrimaryClipChangedListener l) {
+        sListeners.remove(l);
+    }
+
+    private static void notifyChanged() {
+        for (ClipboardManager.OnPrimaryClipChangedListener l : sListeners) l.onPrimaryClipChanged();
+    }
+}
