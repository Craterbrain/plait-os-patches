+    /** PlaitOS: LocalSend (bundled), the app Send nearby hands files to. */
+    static final String LOCALSEND = "org.localsend.localsend_app";
+
+    /** The share intent aimed at LocalSend, or null when it is not installed or can't take files. */
+    static @Nullable Intent plaitSendNearbyIntent(android.content.Context context) {
+        Intent probe = new Intent(Intent.ACTION_SEND_MULTIPLE).setType("*/*").setPackage(LOCALSEND);
+        return context.getPackageManager().queryIntentActivities(probe, 0).isEmpty() ? null : probe;
+    }
+
+    /** PlaitOS: the selection straight to LocalSend, the same intent Share builds, no chooser. */
+    @Override
+    public void plaitSendNearby() {
+        Selection<String> selection = getStableSelection();
+        if (selection.isEmpty()) return;
+        if (selection.size() > SHARE_FILES_COUNT_LIMIT) {
+            mDialogs.showShareOverLimit(SHARE_FILES_COUNT_LIMIT);
+            return;
+        }
+        Intent intent = createShareIntent(selection);
+        if (intent == null) return;
+        intent.setPackage(LOCALSEND);
+        try {
+            mActivity.startActivity(intent);
+        } catch (android.content.ActivityNotFoundException e) {
+            Log.w(TAG, "LocalSend can't take the files", e);
+        }
+    }
+
     @Override
     public void loadDocumentsForCurrentStack() {
         super.loadDocumentsForCurrentStack();
