From 98fe5846da94487e14a351a3364a5a0cfbff737d Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Fri, 27 Nov 2026 08:29:45 -0600
Subject: [PATCH] PlaitOS: storage provider icons themed for contrast on their
 tile

Glyph (vector) icons and an app icon's monochrome layer are tinted with the readable
on-surface colour, like Android's themed icons; full app icons and bitmaps keep theirs.
Dark provider icons (Termux, the bug-report and trace providers) were near invisible on
the dark tile.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017VXjYUWzBqMCeUoJD2Suc4
---
 src/com/android/documentsui/PlaitCompose.kt | 23 +++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/src/com/android/documentsui/PlaitCompose.kt b/src/com/android/documentsui/PlaitCompose.kt
index c139a32..f898dd9 100644
--- a/src/com/android/documentsui/PlaitCompose.kt
+++ b/src/com/android/documentsui/PlaitCompose.kt
@@ -27,6 +27,7 @@ import androidx.compose.runtime.mutableStateOf
 import androidx.compose.runtime.setValue
 import androidx.compose.ui.Alignment
 import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.toArgb
 import androidx.compose.ui.platform.ComposeView
 import androidx.compose.ui.platform.ViewCompositionStrategy
 import androidx.compose.ui.text.style.TextOverflow
@@ -179,17 +180,35 @@ internal object PlaitCompose {
 
 @Composable
 internal fun ProviderIcon(drawable: Drawable, modifier: Modifier = Modifier) {
-    // On a neutral tile, like the mock's provider tiles (the provider's own icon keeps its colours)
+    // A provider's or app's own icon on a neutral tile, readable on any wallpaper: plain glyphs
+    // (vectors) and an app icon's monochrome layer are tinted like Android's themed icons; full
+    // app icons and bitmaps keep their colours and background
+    val tint = MaterialTheme.colorScheme.onSurfaceVariant.toArgb()
     Box(modifier.size(42.dp).background(MaterialTheme.colorScheme.surfaceContainerHighest,
         RoundedCornerShape(12.dp)), contentAlignment = Alignment.Center) {
         AndroidView(
             factory = { ImageView(it).apply { importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO } },
-            update = { it.setImageDrawable(drawable.constantState?.newDrawable() ?: drawable) },
+            update = {
+                val (icon, tinted) = themedIcon(drawable)
+                it.setImageDrawable(icon)
+                it.imageTintList = if (tinted) android.content.res.ColorStateList.valueOf(tint) else null
+            },
             modifier = Modifier.size(24.dp),
         )
     }
 }
 
+/** The drawable to show and whether to tint it (see [ProviderIcon]). */
+private fun themedIcon(source: Drawable): Pair<Drawable, Boolean> {
+    val drawable = source.constantState?.newDrawable()?.mutate() ?: source
+    if (drawable is android.graphics.drawable.AdaptiveIconDrawable) {
+        val mono = if (android.os.Build.VERSION.SDK_INT >= 33) drawable.monochrome else null
+        return if (mono != null) mono to true else drawable to false
+    }
+    if (drawable is android.graphics.drawable.BitmapDrawable) return drawable to false
+    return drawable to true
+}
+
 internal class PlaitTabs(context: android.content.Context) : android.widget.FrameLayout(context) {
     private var tabs by androidx.compose.runtime.mutableStateOf(emptyList<Tab>())
     private var newTab: Runnable? = null
