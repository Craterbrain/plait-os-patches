+        if (mime.startsWith("video/")) return FileGroup.VIDEOS;
+        if (mime.startsWith("audio/")) return FileGroup.AUDIO;
+        if (MimeTypes.isApkType(mime) || "application/zip".equals(mime)
+                || mime.contains("compressed") || "application/x-tar".equals(mime)) {
+            return FileGroup.ARCHIVES;
+        }
