+                    Row(Modifier.fillMaxWidth().padding(horizontal = 12.dp), verticalAlignment = Alignment.CenterVertically) {
+                        androidx.compose.foundation.lazy.LazyRow(
+                            Modifier.weight(1f), state = scroll,
+                            horizontalArrangement = Arrangement.spacedBy(6.dp),
+                        ) {
+                            items(current.size) { index ->
+                                val tab = current[index]
+                                val colors = MaterialTheme.colorScheme
+                                Row(
+                                    Modifier.background(
+                                        if (tab.selected) colors.primaryContainer else colors.surfaceContainer,
+                                        RoundedCornerShape(14.dp),
+                                    ),
+                                    verticalAlignment = Alignment.CenterVertically,
+                                ) {
+                                    Text(
+                                        tab.label,
+                                        Modifier.clickable { tab.select.run() }.heightIn(min = 48.dp)
+                                            .padding(horizontal = 12.dp, vertical = 14.dp),
+                                        maxLines = 1,
+                                        overflow = TextOverflow.Ellipsis,
+                                        color = if (tab.selected) colors.onPrimaryContainer else colors.onSurface,
+                                    )
+                                    tab.close?.let { close ->
+                                        androidx.compose.material3.IconButton(onClick = close::run) {
+                                            app.plait.design.PlaitIcon(
+                                                app.plait.design.PlaitIcon.Close, tab.closeLabel,
+                                            )
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                        androidx.compose.material3.IconButton(onClick = { newTab?.run() }) {
+                            app.plait.design.PlaitIcon(app.plait.design.PlaitIcon.Add,
+                                androidx.compose.ui.res.stringResource(R.string.plait_new_tab))
+                        }
+                    }
+                }
+            }
+        }, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+    }
+
+    fun update(tabs: List<Tab>, add: Runnable) {
+        newTab = add
+        this.tabs = tabs
+    }
+
+    data class Tab(val label: String, val selected: Boolean, val select: Runnable,
+        val closeLabel: String?, val close: Runnable?)
+}
+
+internal class PlaitSelectionActions(private val activity: AppCompatActivity) :
+    android.widget.FrameLayout(activity) {
+    private var selection by mutableStateOf<SelectionUi?>(null)
+
+    init {
+        visibility = GONE
+        addView(ComposeView(activity).apply {
+            id = View.generateViewId()
+            setViewCompositionStrategy(ViewCompositionStrategy.DisposeOnViewTreeLifecycleDestroyed)
+            setContent {
+                val ui = selection ?: return@setContent
+                PlaitTheme {
+                    androidx.compose.material3.Surface(color = MaterialTheme.colorScheme.surfaceContainerLow) {
+                        Column(Modifier.fillMaxWidth().padding(horizontal = 8.dp)) {
+                            Row(
+                                Modifier.fillMaxWidth().heightIn(min = 32.dp),
+                                verticalAlignment = Alignment.CenterVertically,
+                            ) {
+                                androidx.compose.material3.IconButton(onClick = ui.clear::run) {
+                                    app.plait.design.PlaitIcon(app.plait.design.PlaitIcon.Close,
+                                        activity.getString(R.string.clear_selection))
+                                }
+                                Text(ui.title, style = MaterialTheme.typography.titleSmall)
+                            }
+                            Row(
+                                Modifier.fillMaxWidth().heightIn(min = 56.dp),
+                                horizontalArrangement = Arrangement.SpaceEvenly,
+                            ) {
+                                ui.actions.forEach { row ->
+                                    Column(
+                                        Modifier.weight(1f).clickable { row.action?.run() }.padding(4.dp),
+                                        horizontalAlignment = Alignment.CenterHorizontally,
+                                    ) {
+                                        TonalTile(row.icon)
+                                        Text(row.label, style = MaterialTheme.typography.labelSmall,
+                                            maxLines = 1, overflow = TextOverflow.Ellipsis)
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+    }
+
+    fun clear() {
+        selection = null
+        visibility = GONE
+    }
+
+    fun show(title: String, menu: android.view.Menu, clear: Runnable,
+        invoke: java.util.function.Consumer<android.view.MenuItem>) {
+        val visible = (0 until menu.size()).map(menu::getItem).filter { it.isVisible && it.isEnabled }
+        val art = app.plait.design.PlaitIcon
+        val primary = mapOf(
+            appId(R.id.action_menu_cut_to_clipboard) to art.Cut,
+            appId(R.id.action_menu_copy_to_clipboard) to art.Copy,
+            appId(R.id.action_menu_share) to art.Share,
+            appId(R.id.action_menu_delete) to art.Delete,
+            appId(R.id.action_menu_move_to_trash) to art.Delete,
+        )
+        fun row(item: android.view.MenuItem, icon: Int, drawable: Drawable? = null) =
+            PlaitCompose.SheetRow(item.title.toString(), icon, drawable, Runnable { invoke.accept(item) })
+        val direct = visible.filter { it.itemId in primary }
+            .sortedBy { primary.keys.indexOf(it.itemId) }
+            .map { row(it, primary.getValue(it.itemId)) }
+        val more = visible.filter { it.itemId !in primary }
+        val actions = if (more.isEmpty()) direct else direct + PlaitCompose.SheetRow(
+            activity.getString(R.string.plait_more), art.More, null,
+            Runnable {
+                PlaitCompose.showSheet(activity, activity.getString(R.string.plait_more), null,
+                    more.map { row(it, 0, it.icon) })
+            },
+        )
+        selection = SelectionUi(title, clear, actions)
+        visibility = VISIBLE
+    }
+
+    private fun appId(id: Int) = com.android.documentsui.util.Material3Config.getRes(id)
+    private data class SelectionUi(val title: String, val clear: Runnable,
+        val actions: List<PlaitCompose.SheetRow>)
+}
+
+internal class PlaitFileGroupLabel(context: android.content.Context) : android.widget.FrameLayout(context) {
+    private var labelResource by mutableStateOf(0)
+
+    init {
+        importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+        addView(ComposeView(context).apply {
+            id = View.generateViewId()
+            setContent {
+                val resource = labelResource
+                if (resource != 0) {
+                    PlaitTheme {
+                        app.plait.design.SectionLabel(androidx.compose.ui.res.stringResource(resource))
+                    }
+                }
+            }
+        }, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+    }
+
+    fun setLabel(resource: Int) {
+        labelResource = resource
+    }
+}
