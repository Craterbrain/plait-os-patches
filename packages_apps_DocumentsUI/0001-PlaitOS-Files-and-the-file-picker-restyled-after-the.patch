index 0000000..9aae91a
--- /dev/null
+++ b/src/com/android/documentsui/files/PlaitOpenWith.java
@@ -0,0 +1,113 @@
+package com.android.documentsui.files;
+
+import android.content.ActivityNotFoundException;
+import android.content.ContentResolver;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.graphics.Typeface;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import androidx.appcompat.app.AlertDialog;
+
+import com.android.documentsui.ProviderExecutor;
+import com.android.documentsui.PlaitCompose;
+import app.plait.design.PlaitIcon;
+import com.android.documentsui.R;
+import com.android.documentsui.base.DocumentInfo;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Locale;
+
+final class PlaitOpenWith {
+    private static final int PREVIEW_BYTES = 256;
+
+    static void show(FilesActivity activity, DocumentInfo doc, Runnable open, Runnable details,
+            Intent viewIntent, Runnable choose) {
+        java.util.List<PlaitCompose.SheetRow> rows = new java.util.ArrayList<>();
+        addRow(activity, rows, R.string.plait_built_in, 0, null);
+        if (doc.isContainer()) {
+            addRow(activity, rows, R.string.plait_browse_archive, PlaitIcon.INSTANCE.getZip(), open);
+        }
+        if (!doc.isVirtual()) {
+            addRow(activity, rows, R.string.plait_binary_viewer, PlaitIcon.INSTANCE.getFile(),
+                    () -> showBinary(activity, doc));
+        }
+        addRow(activity, rows, R.string.menu_inspect, PlaitIcon.INSTANCE.getInfo(), details);
+        addRow(activity, rows, R.string.plait_open_with_app, 0, null);
+        PackageManager packages = doc.userId.getPackageManager(activity);
+        for (ResolveInfo app : packages.queryIntentActivities(viewIntent,
+                PackageManager.MATCH_DEFAULT_ONLY)) {
+            if (app.activityInfo == null || !app.activityInfo.exported
+                    || activity.getPackageName().equals(app.activityInfo.packageName)
+                    || "android".equals(app.activityInfo.packageName)) continue;
+            rows.add(new PlaitCompose.SheetRow(app.loadLabel(packages).toString(), 0,
+                    app.loadIcon(packages), () -> {
+                        Intent target = new Intent(viewIntent).setClassName(
+                                app.activityInfo.packageName, app.activityInfo.name);
+                        try {
+                            doc.userId.startActivityAsUser(activity, target);
+                        } catch (ActivityNotFoundException | SecurityException e) {
+                            choose.run();
+                        }
+                    }));
+        }
+        addRow(activity, rows, R.string.plait_choose_app, PlaitIcon.INSTANCE.getOpenInNew(), choose);
+        PlaitCompose.showSheet(activity, activity.getString(R.string.plait_open_with),
+                doc.displayName, rows);
+    }
+
+    private static void addRow(FilesActivity activity, java.util.List<PlaitCompose.SheetRow> rows,
+            int label, int icon, Runnable action) {
+        rows.add(new PlaitCompose.SheetRow(activity.getString(label), icon, null, action));
+    }
+
+    private static void showBinary(FilesActivity activity, DocumentInfo doc) {
+        ProviderExecutor.forAuthority(doc.authority).execute(() -> {
+            String message;
+            ContentResolver resolver = doc.userId.getContentResolver(activity);
+            try (InputStream stream = resolver.openInputStream(doc.derivedUri)) {
+                if (stream == null) throw new IOException("No stream from provider");
+                byte[] bytes = new byte[PREVIEW_BYTES];
+                int count = 0;
+                while (count < bytes.length) {
+                    int read = stream.read(bytes, count, bytes.length - count);
+                    if (read <= 0) break;
+                    count += read;
+                }
+                StringBuilder hex = new StringBuilder();
+                for (int i = 0; i < count; i++) {
+                    if (i % 8 == 0 && i != 0) hex.append('\n');
+                    hex.append(String.format(Locale.ROOT, "%02X ", bytes[i] & 0xff));
+                }
+                message = activity.getString(R.string.plait_binary_preview, count)
+                        + "\n\n" + hex;
+            } catch (IOException | RuntimeException e) {
+                message = activity.getString(R.string.plait_binary_unavailable);
+            }
+            String preview = message;
+            activity.runOnUiThread(() -> {
+                if (activity.isFinishing() || activity.isDestroyed()) return;
+                ScrollView scroll = new ScrollView(activity);
+                TextView text = new TextView(activity);
+                text.setText(preview);
+                text.setTypeface(Typeface.MONOSPACE);
+                text.setTextIsSelectable(true);
+                int padding = dp(activity, 20);
+                text.setPadding(padding, padding, padding, padding);
+                scroll.addView(text);
+                new AlertDialog.Builder(activity)
+                        .setTitle(doc.displayName)
+                        .setView(scroll)
+                        .setPositiveButton(android.R.string.ok, null)
+                        .show();
+            });
+        });
+    }
+
+    private static int dp(FilesActivity activity, int amount) {
+        return Math.round(activity.getResources().getDisplayMetrics().density * amount);
+    }
+}
