+package app.plait.design
+
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.Shapes
+import androidx.compose.ui.unit.dp
+
+/** Modest corners: 10 dp controls, 14 dp groups, 28 dp for sheets. Nothing is a pill except chips and switches. */
+val PlaitShapes = Shapes(
+    extraSmall = RoundedCornerShape(6.dp),
+    small = RoundedCornerShape(8.dp),
+    medium = RoundedCornerShape(10.dp),
+    large = RoundedCornerShape(14.dp),
+    extraLarge = RoundedCornerShape(28.dp),
+)
diff --git a/plait-design/java/app/plait/design/PlaitTheme.kt b/plait-design/java/app/plait/design/PlaitTheme.kt
new file mode 100644
index 0000000..5e27432
--- /dev/null
+++ b/plait-design/java/app/plait/design/PlaitTheme.kt
@@ -0,0 +1,64 @@
+package app.plait.design
+
+import android.os.Build
+import androidx.compose.foundation.isSystemInDarkTheme
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.dynamicDarkColorScheme
+import androidx.compose.material3.dynamicLightColorScheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.Immutable
+import androidx.compose.runtime.staticCompositionLocalOf
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+
+/**
+ * PlaitOS's unified look ("Graphite, refined"): the system's wallpaper colours (Material You, which the ROM patches to
+ * fall back to the Graphite blue when a wallpaper has too little colour), tonal surfaces instead of outlines, one accent,
+ * a 12 sp type floor and tonal icon tiles. Colours are roles, never hex values: an app asks for
+ * `MaterialTheme.colorScheme.surfaceContainer`, not for a colour.
+ *
+ * [dynamicColor] = false uses the Graphite-blue scheme (previews, and a system with no dynamic colours).
+ */
+@Composable
+fun PlaitTheme(
+    dark: Boolean = isSystemInDarkTheme(),
+    dynamicColor: Boolean = true,
+    content: @Composable () -> Unit,
+) {
+    val context = LocalContext.current
+    val scheme = when {
+        dynamicColor && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S ->
+            if (dark) dynamicDarkColorScheme(context) else dynamicLightColorScheme(context)
+        dark -> GraphiteDark
+        else -> GraphiteLight
+    }
+    CompositionLocalProvider(LocalPlaitExtras provides if (dark) DarkExtras else LightExtras) {
+        MaterialTheme(colorScheme = scheme, typography = PlaitTypography, shapes = PlaitShapes, content = content)
+    }
+}
+
+/** What Material 3 has no role for: state colours other than error. Fixed per mode, readable on any surface. */
+@Immutable
+class PlaitExtras(
+    val success: Color,
+    val successContainer: Color,
+    val warning: Color,
+    val warningContainer: Color,
+)
+
+private val DarkExtras = PlaitExtras(
+    success = Color(0xFF7CCAA0), successContainer = Color(0x247CCAA0),
+    warning = Color(0xFFDEC06E), warningContainer = Color(0x24DEC06E),
+)
+private val LightExtras = PlaitExtras(
+    success = Color(0xFF25744B), successContainer = Color(0x1A25744B),
+    warning = Color(0xFF855F0C), warningContainer = Color(0x1C855F0C),
+)
+
+internal val LocalPlaitExtras = staticCompositionLocalOf { DarkExtras }
+
+object PlaitTheme {
+    val extras: PlaitExtras
+        @Composable get() = LocalPlaitExtras.current
+}
diff --git a/plait-design/java/app/plait/design/PlaitType.kt b/plait-design/java/app/plait/design/PlaitType.kt
new file mode 100644
index 0000000..d75cf3b
--- /dev/null
+++ b/plait-design/java/app/plait/design/PlaitType.kt
@@ -0,0 +1,28 @@
+package app.plait.design
+
+import androidx.compose.material3.Typography
+import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.sp
+
+/**
+ * The system font (no bundled font), with nothing smaller than 12 sp: Material's own scale goes down to 11 and the mockups'
+ * screens were found to be set at 9-11 dp, which is why this exists. Titles are semibold, body is regular.
+ */
+val PlaitTypography = Typography().let { d ->
+    d.copy(
+        headlineSmall = d.headlineSmall.copy(fontSize = 24.sp, lineHeight = 30.sp, fontWeight = FontWeight.SemiBold),
+        titleLarge = d.titleLarge.copy(fontSize = 22.sp, lineHeight = 28.sp, fontWeight = FontWeight.SemiBold),
+        titleMedium = d.titleMedium.copy(fontSize = 16.sp, lineHeight = 22.sp, fontWeight = FontWeight.SemiBold),
+        titleSmall = d.titleSmall.copy(fontSize = 14.sp, lineHeight = 20.sp, fontWeight = FontWeight.SemiBold),
+        bodyLarge = d.bodyLarge.copy(fontSize = 16.sp, lineHeight = 24.sp),
+        bodyMedium = d.bodyMedium.copy(fontSize = 14.sp, lineHeight = 20.sp),
+        bodySmall = d.bodySmall.copy(fontSize = 13.sp, lineHeight = 18.sp),
+        labelLarge = d.labelLarge.copy(fontSize = 14.sp, lineHeight = 20.sp, fontWeight = FontWeight.Medium),
+        labelMedium = d.labelMedium.copy(fontSize = 12.sp, lineHeight = 16.sp, fontWeight = FontWeight.Medium),
+        labelSmall = d.labelSmall.copy(fontSize = 12.sp, lineHeight = 16.sp, fontWeight = FontWeight.Medium),
+    )
+}
+
+/** The big clock-style numerals (launcher, Boost & EQ's gain): light, tight. */
+val PlaitDisplay = TextStyle(fontSize = 56.sp, lineHeight = 56.sp, fontWeight = FontWeight.Light, letterSpacing = (-2).sp)
