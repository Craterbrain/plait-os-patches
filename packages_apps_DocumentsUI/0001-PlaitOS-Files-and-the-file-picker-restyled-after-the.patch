+internal object PlaitCompose {
+    @JvmStatic
+    fun showSheet(activity: AppCompatActivity, title: String, caption: String?, rows: List<SheetRow>) {
+        val content = activity.findViewById<ViewGroup>(android.R.id.content)
+        val host = ComposeView(activity).apply {
+            id = View.generateViewId()
+            setViewCompositionStrategy(ViewCompositionStrategy.DisposeOnViewTreeLifecycleDestroyed)
+        }
+        fun dismiss() {
+            host.disposeComposition()
+            content.removeView(host)
+        }
+
+        content.addView(host, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0))
+        host.setContent {
+            PlaitTheme {
+                PlaitSheet(onDismiss = ::dismiss, title = title) {
+                    Column(
+                        Modifier.heightIn(max = 560.dp).verticalScroll(rememberScrollState()),
+                        verticalArrangement = Arrangement.spacedBy(6.dp),
+                    ) {
+                        if (!caption.isNullOrEmpty()) {
+                            Text(caption, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                        }
+                        rows.forEach { row ->
+                            if (row.action == null) {
+                                Text(
+                                    row.label,
+                                    Modifier.padding(top = 10.dp),
+                                    color = MaterialTheme.colorScheme.primary,
+                                    style = MaterialTheme.typography.labelLarge,
+                                )
+                            } else {
+                                Row(
+                                    Modifier.fillMaxWidth()
+                                        .background(
+                                            MaterialTheme.colorScheme.surfaceContainer,
+                                            RoundedCornerShape(14.dp),
+                                        )
+                                        .clickable {
+                                            dismiss()
+                                            row.action.run()
+                                        }
+                                        .heightIn(min = 56.dp).padding(horizontal = 10.dp),
+                                    verticalAlignment = Alignment.CenterVertically,
+                                    horizontalArrangement = Arrangement.spacedBy(12.dp),
+                                ) {
+                                    if (row.icon != 0) TonalTile(row.icon)
+                                    else if (row.drawable != null) ProviderIcon(row.drawable)
+                                    Text(
+                                        row.label,
+                                        Modifier.weight(1f),
+                                        maxLines = 2,
+                                        overflow = TextOverflow.Ellipsis,
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    @JvmStatic
+    fun titleView(context: android.content.Context, label: String): View =
+        ComposeView(context).apply {
+            id = View.generateViewId()
+            setViewCompositionStrategy(ViewCompositionStrategy.DisposeOnViewTreeLifecycleDestroyed)
+            setContent {
+                PlaitTheme {
+                    Text(label, Modifier.padding(horizontal = 12.dp),
+                        style = MaterialTheme.typography.titleLarge,
+                        color = MaterialTheme.colorScheme.onSurface, maxLines = 1,
+                        overflow = TextOverflow.Ellipsis)
+                }
+            }
+        }
+
+    @JvmStatic
+    fun messageView(context: android.content.Context, message: String): View =
+        ComposeView(context).apply {
+            id = View.generateViewId()
+            setContent {
+                PlaitTheme {
+                    Text(message, Modifier.fillMaxWidth().padding(horizontal = 24.dp, vertical = 12.dp),
+                        style = MaterialTheme.typography.bodyMedium,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant)
+                }
+            }
+        }
+
+    @JvmStatic
+    fun showSort(activity: AppCompatActivity, model: com.android.documentsui.sorting.SortModel) {
+        val sort = com.android.documentsui.sorting.SortListFragment::getSheetLabelId
+        val ascending = com.android.documentsui.sorting.SortDimension.SORT_DIRECTION_ASCENDING
+        val descending = com.android.documentsui.sorting.SortDimension.SORT_DIRECTION_DESCENDING
+        val rows = buildList {
+            for (i in 0 until model.size) {
+                val dimension = model.getDimensionAt(i)
+                if (dimension.visibility != View.VISIBLE) continue
+                val first = dimension.defaultSortDirection
+                val directions = listOf(first,
+                    if (first == ascending) descending else ascending).distinct()
+                for (direction in directions) {
+                    if (direction == 0 || (dimension.sortCapability and direction) == 0) continue
+                    val selected = dimension.id == model.sortedDimensionId &&
+                        direction == model.currentSortDirection
+                    add(SheetRow(activity.getString(sort(dimension, direction)),
+                        if (selected) app.plait.design.PlaitIcon.Check else app.plait.design.PlaitIcon.Sort,
+                        null, Runnable { model.sortByUser(dimension.id, direction) }))
+                }
+            }
+        }
+        showSheet(activity, activity.getString(R.string.menu_sort), null, rows)
+    }
+
+    data class SheetRow(val label: String, val icon: Int, val drawable: Drawable?, val action: Runnable?)
+}
