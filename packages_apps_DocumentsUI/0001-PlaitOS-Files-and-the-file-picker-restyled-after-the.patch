new file mode 100644
index 0000000..0f6717e
--- /dev/null
+++ b/src/com/android/documentsui/PlaitPathBar.kt
@@ -0,0 +1,128 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.documentsui
+
+import android.content.Context
+import android.content.res.ColorStateList
+import android.graphics.Typeface
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.RippleDrawable
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.HorizontalScrollView
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.google.android.material.color.MaterialColors
+
+/**
+ * PlaitOS: the path in the top bar, FX style, shared by Files and every picker mode.
+ * Home (Places) › storage icon › folder › … › current folder (bold). Every part is tappable; the
+ * path scrolls so the current folder stays in view. On Places it shows the Home icon and a title.
+ */
+internal class PlaitPathBar(context: Context) : LinearLayout(context) {
+    /** One part of the path: a label, or an icon for the storage root (label still read aloud). */
+    class Part(val label: String, val icon: Drawable?, val onClick: Runnable?)
+
+    private val row = LinearLayout(context).apply {
+        orientation = LinearLayout.HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+    }
+    private val text = MaterialColors.getColor(this, com.google.android.material.R.attr.colorOnSurface)
+    private val muted = MaterialColors.getColor(this, com.google.android.material.R.attr.colorOnSurfaceVariant)
+    private val pressed = MaterialColors.getColor(this, androidx.appcompat.R.attr.colorPrimary)
+
+    private val scroll = HorizontalScrollView(context).apply {
+        isHorizontalScrollBarEnabled = false
+        overScrollMode = OVER_SCROLL_NEVER
+        addView(row, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+    }
+    /** A picker's request ("Requested by Gmail"), under the path. */
+    private val caption = TextView(context).apply {
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+        setTextColor(pressed)
+        maxLines = 1
+        ellipsize = TextUtils.TruncateAt.END
+        setPadding(dp(8), 0, dp(8), 0)
+        visibility = GONE
+    }
+
+    init {
+        orientation = VERTICAL
+        gravity = Gravity.CENTER_VERTICAL
+        addView(scroll, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+        addView(caption, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+    }
+
+    /**
+     * home: opens Places (null on Places itself). title/version: shown after the Home icon on
+     * Places. parts: the folders, root first; the last one is where you are.
+     */
+    fun show(home: Runnable?, title: String?, version: String?, parts: List<Part>, note: String?) {
+        caption.text = note
+        caption.visibility = if (note.isNullOrEmpty()) GONE else VISIBLE
+        row.removeAllViews()
+        row.addView(crumb(null, context.getDrawable(app.plait.design.R.drawable.ps_home), home,
+            context.getString(R.string.plait_home), parts.isEmpty()))
+        if (parts.isEmpty() && title != null) {
+            row.addView(label(title, true, 20f).apply { setPadding(dp(2), 0, dp(6), 0) })
+            if (version != null) {
+                row.addView(label(version, false, 12f).apply { setPadding(0, dp(4), dp(8), 0) })
+            }
+        }
+        parts.forEachIndexed { i, part ->
+            row.addView(ImageView(context).apply {
+                setImageResource(app.plait.design.R.drawable.ps_chevron_right)
+                imageTintList = ColorStateList.valueOf(muted)
+                alpha = 0.7f
+            }, LinearLayout.LayoutParams(dp(16), dp(16)))
+            val last = i == parts.size - 1
+            // The storage root is an icon unless it is the folder you are in
+            row.addView(crumb(if (part.icon != null && !last) null else part.label,
+                if (last) null else part.icon, if (last) null else part.onClick, part.label, last))
+        }
+        scroll.post { scroll.fullScroll(FOCUS_RIGHT) }
+    }
+
+    private fun crumb(label: String?, icon: Drawable?, onClick: Runnable?, description: String,
+            current: Boolean): View {
+        val item = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            minimumHeight = dp(40)
+            setPadding(dp(if (label == null) 8 else 6), 0, dp(if (label == null) 8 else 6), 0)
+            contentDescription = description
+            if (onClick != null) {
+                val mask = GradientDrawable().apply { cornerRadius = dp(10).toFloat(); setColor(-1) }
+                background = RippleDrawable(ColorStateList.valueOf((pressed and 0xffffff) or 0x33000000), null, mask)
+                setOnClickListener { onClick.run() }
+            }
+        }
+        if (icon != null) {
+            item.addView(ImageView(context).apply {
+                setImageDrawable(icon.mutate())
+                imageTintList = ColorStateList.valueOf(if (current) text else muted)
+            }, LinearLayout.LayoutParams(dp(22), dp(22)))
+        }
+        if (label != null) item.addView(label(label, current, if (current) 18f else 14f))
+        return item
+    }
+
+    private fun label(value: String, strong: Boolean, sp: Float) = TextView(context).apply {
+        text = value
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, sp)
+        setTextColor(if (strong) this@PlaitPathBar.text else muted)
+        typeface = Typeface.create(Typeface.DEFAULT, if (strong) 600 else 500, false)
+        maxLines = 1
+        ellipsize = TextUtils.TruncateAt.END
+        maxWidth = dp(if (strong) 220 else 140)
+    }
+
+    private fun dp(value: Int) = Math.round(value * resources.displayMetrics.density)
+}
