 .../values/styles_m3.xml                      |  4 +++-
 src/com/android/documentsui/BaseActivity.java |  7 +++++++
 .../documentsui/NavigationViewManager.java    | 15 +++++++++++++-
 src/com/android/documentsui/PlaitCompose.kt   |  6 +++++-
 .../documentsui/files/ActionHandler.java      | 20 +++++++++++++++----
 6 files changed, 49 insertions(+), 7 deletions(-)

