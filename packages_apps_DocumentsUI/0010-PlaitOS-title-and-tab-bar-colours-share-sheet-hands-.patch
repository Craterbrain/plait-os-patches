diff --git a/src/com/android/documentsui/BaseActivity.java b/src/com/android/documentsui/BaseActivity.java
index 0c7af55..761c45c 100644
--- a/src/com/android/documentsui/BaseActivity.java
+++ b/src/com/android/documentsui/BaseActivity.java
@@ -741,6 +741,13 @@ public abstract class BaseActivity
      * applies there; folder actions (view, sort, new folder, select all) come back in a folder.
      */
     protected final void plaitPrepareMenu(Menu menu) {
+        // Top-bar icons in the readable on-surface colour, like Broker's
+        if (isUseMaterial3FlagEnabled()) {
+            android.content.res.ColorStateList onSurface = android.content.res.ColorStateList.valueOf(
+                    com.google.android.material.color.MaterialColors.getColor(this,
+                            com.google.android.material.R.attr.colorOnSurface, 0xffffffff));
+            for (int i = 0; i < menu.size(); i++) menu.getItem(i).setIconTintList(onSurface);
+        }
         if (!isPlaitPlacesVisible()) return;
         for (int id : new int[] {R.id.sub_menu_grid, R.id.sub_menu_list, R.id.option_menu_sort,
                 R.id.option_menu_create_dir, R.id.option_menu_select_all,
diff --git a/src/com/android/documentsui/NavigationViewManager.java b/src/com/android/documentsui/NavigationViewManager.java
index 59c56ad..356576d 100644
--- a/src/com/android/documentsui/NavigationViewManager.java
+++ b/src/com/android/documentsui/NavigationViewManager.java
@@ -462,6 +462,12 @@ public class NavigationViewManager implements AppBarLayout.OnOffsetChangedListen
             }
         }
         mPath.show(places ? null : mActivity::showPlaitPlaces, title, version, parts);
+        // Top-bar actions in the readable on-surface colour, like Broker's
+        android.content.res.ColorStateList onSurface =
+                android.content.res.ColorStateList.valueOf(plaitOnSurface());
+        for (int i = 0; i < mToolbar.getMenu().size(); i++) {
+            mToolbar.getMenu().getItem(i).setIconTintList(onSurface);
+        }
         updatePlaitCaption();
         if (!places) {
             setPlaitNavigation(app.plait.design.R.drawable.ps_back, R.string.plait_up,
@@ -502,6 +508,11 @@ public class NavigationViewManager implements AppBarLayout.OnOffsetChangedListen
         mCaption.setVisibility(caption == null || mIsActionModeActivated ? GONE : VISIBLE);
     }
 
+    private int plaitOnSurface() {
+        return com.google.android.material.color.MaterialColors.getColor(mToolbar,
+                com.google.android.material.R.attr.colorOnSurface);
+    }
+
     private void plaitUp() {
         if (mState.stack.size() > 1) {
             onNavigationItemSelected(mState.stack.size() - 2);
@@ -511,7 +522,9 @@ public class NavigationViewManager implements AppBarLayout.OnOffsetChangedListen
     }
 
     private void setPlaitNavigation(int icon, int description, Runnable action) {
-        mToolbar.setNavigationIcon(icon);
+        Drawable drawable = mActivity.getDrawable(icon).mutate();
+        drawable.setTint(plaitOnSurface());
+        mToolbar.setNavigationIcon(drawable);
         mToolbar.setNavigationContentDescription(description);
         mToolbar.setNavigationOnClickListener(v -> action.run());
     }
