+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.documentsui;
+
+import android.content.Context;
+import android.graphics.drawable.Drawable;
+import android.provider.DocumentsContract;
+
+/** PlaitOS: file type icons for tiles and rows (standalone, so the screenshot mock uses it too). */
+public final class PlaitTypeIcons {
+    private PlaitTypeIcons() {}
+
+    /**
+     * PlaitOS: a file's type as a design-guide icon (Material Symbols via plait-design), tinted
+     * for the tile it sits on: folders on the tonal tile, files on the neutral one.
+     */
+    public static Drawable forMime(Context context, String mimeType) {
+        final String mime = mimeType == null ? "" : mimeType.toLowerCase(java.util.Locale.ROOT);
+        final int icon;
+        boolean folder = false;
+        if (DocumentsContract.Document.MIME_TYPE_DIR.equals(mime)) {
+            icon = app.plait.design.R.drawable.ps_folder;
+            folder = true;
+        } else if (mime.startsWith("image/")) {
+            icon = app.plait.design.R.drawable.ps_image;
+        } else if (mime.startsWith("video/")) {
+            icon = app.plait.design.R.drawable.ps_movie;
+        } else if (mime.startsWith("audio/") || mime.equals("application/ogg")) {
+            icon = app.plait.design.R.drawable.ps_music;
+        } else if (mime.equals("application/pdf")) {
+            icon = app.plait.design.R.drawable.ps_pdf;
+        } else if (mime.equals("application/vnd.android.package-archive")) {
+            icon = app.plait.design.R.drawable.ps_apk;
+        } else if (mime.contains("zip") || mime.contains("compressed") || mime.contains("x-tar")
+                || mime.contains("gzip") || mime.contains("x-7z") || mime.contains("x-rar")
+                || mime.contains("x-bzip") || mime.contains("x-xz")) {
+            icon = app.plait.design.R.drawable.ps_zip;
+        } else if (mime.startsWith("text/") || mime.contains("document") || mime.contains("msword")
+                || mime.contains("opendocument") || mime.contains("rtf") || mime.contains("epub")
+                || mime.contains("spreadsheet") || mime.contains("presentation")
+                || mime.contains("ms-excel") || mime.contains("ms-powerpoint")
+                || mime.equals("application/json") || mime.equals("application/xml")) {
+            icon = app.plait.design.R.drawable.ps_document;
+        } else {
+            icon = app.plait.design.R.drawable.ps_file;
+        }
+        Drawable drawable = context.getDrawable(icon).mutate();
+        drawable.setTint(com.google.android.material.color.MaterialColors.getColor(context,
+                folder ? com.google.android.material.R.attr.colorOnPrimaryContainer
+                        : com.google.android.material.R.attr.colorOnSurfaceVariant, 0xff888888));
+        return drawable;
+    }
+}
