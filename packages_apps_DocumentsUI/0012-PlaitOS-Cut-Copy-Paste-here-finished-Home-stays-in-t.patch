From 76bed0e61782dadd12789d928f92ede734eee1ae Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Fri, 27 Nov 2026 22:50:23 -0600
Subject: [PATCH] PlaitOS: Cut / Copy / Paste here finished; Home stays in the
 path

- Cut and Copy taps were ignored with Material 3 (the menu showed them but the folder view
  only handled them under the desktop UX flag): handled now
- Cut and Copy end the selection, so the Paste here bar shows straight away
- No Paste here in the folder a cut came from (moving files into their own folder does
  nothing; Copy still offers it there, for a duplicate)
- The Home crumb sits outside the scrolling path, so it stays in view in deep folders

Checked on the phone: copy two files from Download, paste in Documents; cut them in
Documents (no bar there), paste in another folder (moved, gone from Documents).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017VXjYUWzBqMCeUoJD2Suc4
---
 src/com/android/documentsui/PlaitPathBar.kt           | 11 ++++++++---
 .../android/documentsui/clipping/DocumentClipper.java |  7 +++++++
 .../documentsui/clipping/RuntimeDocumentClipper.java  |  8 ++++++++
 .../documentsui/dirlist/DirectoryFragment.java        |  3 ++-
 src/com/android/documentsui/files/ActionHandler.java  | 10 ++++------
 src/com/android/documentsui/files/FilesActivity.java  |  6 +++++-
 6 files changed, 34 insertions(+), 11 deletions(-)

diff --git a/src/com/android/documentsui/PlaitPathBar.kt b/src/com/android/documentsui/PlaitPathBar.kt
index d323996..576e794 100644
--- a/src/com/android/documentsui/PlaitPathBar.kt
+++ b/src/com/android/documentsui/PlaitPathBar.kt
@@ -43,10 +43,14 @@ internal class PlaitPathBar(context: Context) : LinearLayout(context) {
         overScrollMode = OVER_SCROLL_NEVER
         addView(row, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
     }
+    /** Home stays put; the folders after it scroll (the current one kept in view). */
+    private val home = android.widget.FrameLayout(context)
+
     init {
-        orientation = VERTICAL
+        orientation = HORIZONTAL
         gravity = Gravity.CENTER_VERTICAL
-        addView(scroll, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+        addView(home, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+        addView(scroll, LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f))
     }
 
     /**
@@ -55,7 +59,8 @@ internal class PlaitPathBar(context: Context) : LinearLayout(context) {
      */
     fun show(home: Runnable?, title: String?, version: String?, parts: List<Part>) {
         row.removeAllViews()
-        row.addView(crumb(null, context.getDrawable(app.plait.design.R.drawable.ps_home), home,
+        this.home.removeAllViews()
+        this.home.addView(crumb(null, context.getDrawable(app.plait.design.R.drawable.ps_home), home,
             context.getString(R.string.plait_home), parts.isEmpty()))
         if (parts.isEmpty() && title != null) {
             row.addView(label(title, true, 20f).apply { setPadding(dp(2), 0, dp(6), 0) })
