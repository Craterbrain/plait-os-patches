diff --git a/src/com/android/documentsui/clipping/RuntimeDocumentClipper.java b/src/com/android/documentsui/clipping/RuntimeDocumentClipper.java
index 4dffc76..8e9aa78 100644
--- a/src/com/android/documentsui/clipping/RuntimeDocumentClipper.java
+++ b/src/com/android/documentsui/clipping/RuntimeDocumentClipper.java
@@ -111,6 +111,14 @@ final class RuntimeDocumentClipper implements DocumentClipper {
         return clip == null ? 0 : clip.getItemCount();
     }
 
+    @Override
+    public @Nullable Uri plaitSourceParent() {
+        ClipDescription description = mClipboard.getPrimaryClipDescription();
+        if (description == null || description.getExtras() == null) return null;
+        String parent = description.getExtras().getString(SRC_PARENT_KEY);
+        return parent == null ? null : Uri.parse(parent);
+    }
+
     @Override
     public boolean plaitIsMove() {
         ClipDescription description = mClipboard.getPrimaryClipDescription();
