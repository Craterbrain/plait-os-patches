diff --git a/src/com/android/documentsui/files/FilesActivity.java b/src/com/android/documentsui/files/FilesActivity.java
index 068735a..8e47c7c 100644
--- a/src/com/android/documentsui/files/FilesActivity.java
+++ b/src/com/android/documentsui/files/FilesActivity.java
@@ -373,7 +373,11 @@ public class FilesActivity extends BaseActivity implements AbstractActionHandler
     private void updatePlaitPaste() {
         if (mPlaitPaste == null || mPlaitClipper == null) return;
         DirectoryFragment directory = getDirectoryFragment();
-        boolean visible = !mDismissedPaste && !isPlaitPlacesVisible()
+        // Not where a cut came from: moving files into their own folder does nothing
+        DocumentInfo here = getCurrentDirectory();
+        boolean intoSource = mPlaitClipper.plaitIsMove() && here != null
+                && java.util.Objects.equals(mPlaitClipper.plaitSourceParent(), here.getDocumentUri());
+        boolean visible = !mDismissedPaste && !isPlaitPlacesVisible() && !intoSource
                 && !mInjector.selectionMgr.hasSelection() && directory != null
                 && mPlaitClipper.hasDocumentOperation() && canCreateDirectory();
         mPlaitPaste.setVisibility(visible ? View.VISIBLE : View.GONE);
