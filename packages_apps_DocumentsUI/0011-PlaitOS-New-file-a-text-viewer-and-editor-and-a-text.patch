+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.documentsui
+
+import android.content.Intent
+import android.provider.DocumentsContract
+import android.view.inputmethod.EditorInfo
+import android.webkit.MimeTypeMap
+import android.widget.EditText
+import android.widget.FrameLayout
+import android.widget.Toast
+import com.android.documentsui.base.DocumentInfo
+import com.android.documentsui.text.PlaitTextActivity
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+
+/**
+ * PlaitOS: New file (overflow menu). Asks for a name ("New file.txt", the name part selected),
+ * creates the empty document in this folder and opens a text file in the editor.
+ */
+internal object PlaitNewFile {
+    @JvmStatic
+    fun show(activity: BaseActivity, folder: DocumentInfo?) {
+        val dir = folder?.derivedUri ?: return
+        val pad = Math.round(20 * activity.resources.displayMetrics.density)
+        val name = EditText(activity).apply {
+            setSingleLine()
+            imeOptions = EditorInfo.IME_ACTION_DONE
+            setText(R.string.plait_new_file_default)
+            val dot = text.lastIndexOf('.')
+            setSelection(0, if (dot > 0) dot else text.length)
+        }
+        val box = FrameLayout(activity).apply {
+            setPadding(pad, pad / 2, pad, 0)
+            addView(name)
+        }
+        val dialog = MaterialAlertDialogBuilder(activity)
+            .setTitle(R.string.plait_new_file)
+            .setView(box)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(R.string.plait_create) { _, _ -> create(activity, dir, name.text.toString().trim()) }
+            .create()
+        name.setOnEditorActionListener { _, action, _ ->
+            if (action == EditorInfo.IME_ACTION_DONE) {
+                dialog.dismiss(); create(activity, dir, name.text.toString().trim()); true
+            } else false
+        }
+        dialog.setOnShowListener { name.requestFocus() }
+        dialog.window?.setSoftInputMode(android.view.WindowManager.LayoutParams.SOFT_INPUT_STATE_VISIBLE)
+        dialog.show()
+    }
+
+    private fun create(activity: BaseActivity, dir: android.net.Uri, displayName: String) {
+        if (displayName.isEmpty()) return
+        val ext = displayName.substringAfterLast('.', "").lowercase()
+        val mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext)
+            ?: if (ext.isEmpty()) "text/plain" else "application/octet-stream"
+        Thread {
+            val created = runCatching {
+                DocumentsContract.createDocument(activity.contentResolver, dir, mime, displayName)
+            }.getOrNull()
+            activity.runOnUiThread {
+                if (created == null) {
+                    Toast.makeText(activity, activity.getString(R.string.plait_new_file_failed, displayName),
+                        Toast.LENGTH_SHORT).show()
+                } else if (PlaitTextActivity.isText(mime)) {
+                    activity.startActivity(Intent(Intent.ACTION_EDIT)
+                        .setDataAndType(created, mime)
+                        .setClass(activity, PlaitTextActivity::class.java)
+                        .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION))
+                }
+            }
+        }.start()
+    }
+}
