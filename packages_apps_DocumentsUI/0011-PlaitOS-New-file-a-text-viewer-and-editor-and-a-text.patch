+import androidx.compose.foundation.layout.windowInsetsPadding
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.text.BasicTextField
+import androidx.compose.foundation.text.selection.SelectionContainer
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.DropdownMenu
+import androidx.compose.material3.DropdownMenuItem
+import androidx.compose.material3.IconButton
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.graphics.SolidColor
+import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.text.font.FontFamily
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.input.TextFieldValue
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import androidx.core.view.WindowCompat
+import app.plait.design.PlaitFilledButton
+import app.plait.design.PlaitIcon
+import app.plait.design.PlaitTheme
+import com.android.documentsui.R
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+
+/**
+ * PlaitOS: the Files text viewer and editor. Opens a text file (VIEW: the viewer, EDIT: the
+ * editor; Files' Open with sheet offers both), saves it back in place, or Save as a new file.
+ * Also a share target: shared text (or a shared text file) opens in the editor, unsaved, for
+ * Save as. Text is read as UTF-8; files over [MAX_BYTES] are refused rather than loaded.
+ */
+class PlaitTextActivity : ComponentActivity() {
+    private var uri by mutableStateOf<Uri?>(null)
+    private var name by mutableStateOf("")
+    private var text by mutableStateOf(TextFieldValue(""))
+    private var saved by mutableStateOf("")
+    private var editing by mutableStateOf(false)
+    private var writable by mutableStateOf(false)
+    private var loading by mutableStateOf(true)
+    private var error by mutableStateOf<String?>(null)
+
+    private val dirty get() = text.text != saved || uri == null
+
+    private val saveAs = registerForActivityResult(ActivityResultContracts.CreateDocument("text/plain")) { target ->
+        if (target != null) write(target) { uri = target; name = displayName(target) ?: name; writable = true }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        WindowCompat.setDecorFitsSystemWindows(window, false)
+        onBackPressedDispatcher.addCallback(this, object : OnBackPressedCallback(true) {
+            override fun handleOnBackPressed() = leave()
+        })
+        load(intent)
+        setContent { PlaitTheme { Screen() } }
+    }
+
+    private fun load(intent: Intent) {
+        editing = intent.action == Intent.ACTION_EDIT || intent.action == Intent.ACTION_SEND
+        val stream = if (intent.action == Intent.ACTION_SEND)
+            intent.getParcelableExtra(Intent.EXTRA_STREAM, Uri::class.java) else intent.data
+        if (stream == null) {
+            // Shared text: nothing on disk yet, Save as names it
+            val shared = intent.getCharSequenceExtra(Intent.EXTRA_TEXT)?.toString().orEmpty()
+            name = (intent.getStringExtra(Intent.EXTRA_SUBJECT)?.takeIf { it.isNotBlank() }
+                ?: getString(R.string.plait_text_shared_name)).let { if ('.' in it) it else "$it.txt" }
+            text = TextFieldValue(shared)
+            saved = shared
+            uri = null
+            loading = false
+            return
+        }
+        uri = stream
+        Thread {
+            val label = displayName(stream) ?: stream.lastPathSegment.orEmpty()
+            val size = runCatching {
+                contentResolver.query(stream, arrayOf(OpenableColumns.SIZE), null, null, null)?.use {
+                    if (it.moveToFirst() && !it.isNull(0)) it.getLong(0) else -1L
+                }
+            }.getOrNull() ?: -1L
+            val result = if (size > MAX_BYTES) Result.failure(IllegalStateException("large"))
+            else runCatching {
+                contentResolver.openInputStream(stream)!!.use { input ->
+                    val out = java.io.ByteArrayOutputStream()
+                    val buffer = ByteArray(64 * 1024)
+                    while (true) {
+                        val n = input.read(buffer)
+                        if (n < 0) break
+                        out.write(buffer, 0, n)
+                        if (out.size() > MAX_BYTES) throw IllegalStateException("large")
+                    }
+                    String(out.toByteArray(), Charsets.UTF_8)
+                }
+            }
+            val canWrite = canWrite(stream)
+            runOnUiThread {
+                name = label
+                writable = canWrite
+                result.onSuccess { text = TextFieldValue(it, androidx.compose.ui.text.TextRange(it.length)); saved = it }
+                    .onFailure {
+                        error = getString(if (it.message == "large") R.string.plait_text_too_large
+                            else R.string.plait_text_unreadable)
+                    }
+                loading = false
+            }
+        }.start()
+    }
+
+    private fun displayName(target: Uri): String? = runCatching {
+        contentResolver.query(target, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
+            if (it.moveToFirst()) it.getString(0) else null
+        }
+    }.getOrNull()
+
+    /** A document that says it supports writing, or another address this app was let write. */
+    private fun canWrite(target: Uri): Boolean {
+        if (DocumentsContract.isDocumentUri(this, target)) {
+            return runCatching {
+                contentResolver.query(target, arrayOf(DocumentsContract.Document.COLUMN_FLAGS), null, null, null)?.use {
+                    it.moveToFirst() && (it.getInt(0) and DocumentsContract.Document.FLAG_SUPPORTS_WRITE) != 0
+                }
+            }.getOrNull() ?: false
+        }
+        return checkCallingOrSelfUriPermission(target, Intent.FLAG_GRANT_WRITE_URI_PERMISSION) ==
+            android.content.pm.PackageManager.PERMISSION_GRANTED
+    }
+
+    private fun save() {
+        val target = uri
+        if (target == null || !writable) {
+            saveAs.launch(name)
+            return
+        }
+        write(target) {}
+    }
+
+    private fun write(target: Uri, done: () -> Unit) {
+        val content = text.text
+        Thread {
+            val ok = runCatching {
+                contentResolver.openOutputStream(target, "wt")!!.use { it.write(content.toByteArray(Charsets.UTF_8)) }
+            }.isSuccess
+            runOnUiThread {
+                if (ok) {
+                    saved = content
+                    done()
+                    Toast.makeText(this, R.string.plait_text_saved, Toast.LENGTH_SHORT).show()
+                } else {
+                    Toast.makeText(this, R.string.plait_text_save_failed, Toast.LENGTH_SHORT).show()
+                }
+            }
+        }.start()
+    }
+
+    private fun leave() {
+        if (!editing || !dirty || (uri == null && text.text.isEmpty())) {
+            finish()
+            return
+        }
+        MaterialAlertDialogBuilder(this)
+            .setTitle(R.string.plait_text_unsaved)
+            .setNegativeButton(R.string.plait_text_discard) { _, _ -> finish() }
+            .setNeutralButton(android.R.string.cancel, null)
+            .setPositiveButton(R.string.plait_text_save) { _, _ -> save() }
+            .show()
+    }
+
+    private fun share() {
+        val target = uri
+        val send = Intent(Intent.ACTION_SEND).setType("text/plain")
+        if (target != null && !dirty) {
+            send.putExtra(Intent.EXTRA_STREAM, target).addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        } else {
+            send.putExtra(Intent.EXTRA_TEXT, text.text)
+        }
+        startActivity(Intent.createChooser(send, name))
+    }
+
+    @Composable
+    private fun Screen() {
+        val colors = MaterialTheme.colorScheme
+        Column(
