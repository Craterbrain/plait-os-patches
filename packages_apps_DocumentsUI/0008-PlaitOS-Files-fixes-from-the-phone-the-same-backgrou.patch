             Runnable {
                 PlaitCompose.showSheet(activity, activity.getString(R.string.plait_more), null,
-                    more.map { row(it, 0, it.icon) })
+                    more.map { row(it, moreIcon(it.itemId), if (moreIcon(it.itemId) == 0) it.icon else null) })
             },
         )
         selection = SelectionUi(title, clear, actions)
         visibility = VISIBLE
     }
 
+    /** Design-guide icons for the More sheet's rows (0: the item's own icon, if any). */
+    private fun moreIcon(id: Int): Int {
+        val art = app.plait.design.PlaitIcon
+        return when (id) {
+            appId(R.id.action_menu_open), appId(R.id.action_menu_open_with),
+            appId(R.id.action_menu_open_in_new_window), appId(R.id.action_menu_view_in_owner) -> art.OpenInNew
+            appId(R.id.action_menu_inspect) -> art.Info
+            appId(R.id.action_menu_rename) -> art.Rename
+            appId(R.id.action_menu_compress) -> art.Zip
+            appId(R.id.action_menu_extract_to), appId(R.id.action_menu_extract_here) -> art.Archive
+            appId(R.id.action_menu_browse) -> art.Files
+            appId(R.id.action_menu_delete), appId(R.id.action_menu_move_to_trash) -> art.Delete
+            appId(R.id.action_menu_restore_from_trash) -> art.Restore
+            appId(R.id.action_menu_paste_into_folder) -> art.Paste
+            appId(R.id.action_menu_copy_to), appId(R.id.action_menu_copy_to_clipboard) -> art.Copy
+            appId(R.id.action_menu_move_to) -> art.Move
+            appId(R.id.action_menu_cut_to_clipboard) -> art.Cut
+            appId(R.id.action_menu_share) -> art.Share
+            else -> 0
+        }
+    }
+
     private fun appId(id: Int) = com.android.documentsui.util.Material3Config.getRes(id)
     private data class SelectionUi(val title: String, val clear: Runnable,
         val actions: List<PlaitCompose.SheetRow>)
