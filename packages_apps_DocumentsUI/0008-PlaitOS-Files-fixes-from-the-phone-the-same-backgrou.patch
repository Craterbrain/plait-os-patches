+    /** Opens the More sheet, as tapping More does (screenshot scenes, keyboard). */
+    fun plaitOpenMore() {
+        selection?.actions?.lastOrNull { it.icon == app.plait.design.PlaitIcon.More }?.action?.run()
+    }
+
     fun show(title: String, menu: android.view.Menu, clear: Runnable,
         invoke: java.util.function.Consumer<android.view.MenuItem>) {
         val visible = (0 until menu.size()).map(menu::getItem).filter { it.isVisible && it.isEnabled }
@@ -388,22 +393,47 @@ internal class PlaitSelectionActions(private val activity: AppCompatActivity) :
             PlaitCompose.SheetRow((item.titleCondensed ?: item.title).toString(), icon, drawable,
                 Runnable { invoke.accept(item) })
         // LocalSend's button shows the app's own icon (its menu item carries it)
-        val direct = visible.filter { it.itemId in primary }
+        // One delete: Move to trash when the folder has a trash, Delete forever then goes to More
+        val trash = visible.any { it.itemId == appId(R.id.action_menu_move_to_trash) }
+        val main = if (trash) primary - appId(R.id.action_menu_delete) else primary
+        val direct = visible.filter { it.itemId in main }
             .sortedBy { primary.keys.indexOf(it.itemId) }
             .map { row(it, primary.getValue(it.itemId),
