 constexpr const char* kDone = ".plait_restore_done";
+constexpr const char* kIncoming = "incoming";
+constexpr const char* kPrevious = "previous";
+constexpr const char* kInstalling = "installing";
+constexpr const char* kCommitted = "committed";
+constexpr const char* kIdentity = "identity";
+constexpr const char* kCleanupPrefix = ".plait_restore_cleanup.";
