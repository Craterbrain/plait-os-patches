-    if (!dir) {
-        close(dupFd);
-        return -errno;
+int writeMarker(int fd, const char* name) {
+    unique_fd marker(openat(fd, name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
+    if (marker < 0 || fsync(marker.get()) != 0 || fsync(fd) != 0) return -errno;
+    return 0;
