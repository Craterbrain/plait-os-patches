+
+bool journalTarget(int stageFd, int liveFd, bool create) {
+    struct stat st;
+    if (fstat(liveFd, &st) != 0) return false;
+    const auto identity = std::to_string(st.st_dev) + ":" + std::to_string(st.st_ino);
+    if (create) {
+        unique_fd file(openat(stageFd, kIdentity, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
+        return file >= 0 && writeAll(file.get(), identity.data(), identity.size()) &&
+                fsync(file.get()) == 0 && fsync(stageFd) == 0;
+    }
+    unique_fd file(openat(stageFd, kIdentity, O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+    char bytes[64];
+    const ssize_t n = file < 0 ? -1 : TEMP_FAILURE_RETRY(read(file.get(), bytes, sizeof(bytes)));
+    return n == static_cast<ssize_t>(identity.size()) && !memcmp(bytes, identity.data(), identity.size());
+}
+
+int listEntries(int fd, bool skipCaches, std::vector<std::string>* entries) {
+    unique_fd separate = openDirectory(fd, ".");
+    if (separate < 0) return -errno;
+    DIR* raw = fdopendir(separate.get());
+    if (!raw) return -errno;
+    (void) separate.release();
+    std::unique_ptr<DIR, decltype(&closedir)> dir(raw, closedir);
+    for (;;) {
+        errno = 0;
+        const struct dirent* entry = readdir(dir.get());
+        if (!entry) return -errno;
+        const char* name = entry->d_name;
+        if (!strcmp(name, ".") || !strcmp(name, "..") || (skipCaches && isCacheName(name))) continue;
+        entries->emplace_back(name);
     }
-    std::vector<std::pair<std::string, bool>> entries;
-    while (struct dirent* de = readdir(dir.get())) {
-        if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
-        if (skipCaches && isCacheName(de->d_name)) continue;
-        if (strcmp(de->d_name, kStage) == 0 || strcmp(de->d_name, kDone) == 0) continue;
-        struct stat st;
-        if (fstatat(rootFd, de->d_name, &st, AT_SYMLINK_NOFOLLOW) != 0) continue;
-        entries.emplace_back(de->d_name, S_ISDIR(st.st_mode));
-    }
-    for (const auto& [name, isDir] : entries) {
-        if (isDir) {
-            if (delete_dir_contents_fd(rootFd, name.c_str()) != 0) return -EIO;
-            if (unlinkat(rootFd, name.c_str(), AT_REMOVEDIR) != 0) return -errno;
-        } else if (unlinkat(rootFd, name.c_str(), 0) != 0) {
+}
+
+int moveEntries(int from, int to, bool skipCaches) {
+    std::vector<std::string> entries;
+    if (int r = listEntries(from, skipCaches, &entries); r != 0) return r;
+    for (const auto& entry : entries) {
+        if (renameat(from, entry.c_str(), to, entry.c_str()) != 0) return -errno;
+    }
+    if (fsync(from) != 0 || fsync(to) != 0) return -errno;
+    return 0;
+}
+
+int removePrivateDirectory(int parentFd, const std::string& name) {
+    auto dir = openPrivateDirectory(parentFd, name);
+    if (dir < 0) return errno == ENOENT ? 0 : -errno;
+    if (delete_dir_contents_fd(parentFd, name.c_str()) != 0) return -EIO;
+    return unlinkat(parentFd, name.c_str(), AT_REMOVEDIR) == 0 ? 0 : -errno;
+}
+
+// Recover an interrupted replacement before using this target again. The phase is made durable
+// before touching the next set of entries. Keep the journal if recovery itself fails.
+int discardOrRecoverStage(int parentFd, const std::string& name, bool skipCaches) {
+    unique_fd stage = openPrivateDirectory(parentFd, stageName(name));
+    if (stage < 0) return errno == ENOENT ? 0 : -errno;
+    const bool committed = faccessat(stage.get(), kCommitted, F_OK, 0) == 0;
+    if (!committed) {
+        unique_fd previous = openDirectory(stage.get(), kPrevious);
+        if (previous >= 0) {
+            unique_fd live = openDirectory(parentFd, name);
+            if (live < 0) return -errno;
+            if (!journalTarget(stage.get(), live.get(), false)) return -ESTALE;
+            if (faccessat(stage.get(), kInstalling, F_OK, 0) == 0) {
+                // The old directory was emptied. Move any newly installed files aside before rollback.
+                unique_fd incoming = openDirectory(stage.get(), kIncoming);
+                if (incoming < 0) return -errno;
+                if (int r = moveEntries(live.get(), incoming.get(), skipCaches); r != 0) return r;
+                if (unlinkat(stage.get(), kInstalling, 0) != 0 || fsync(stage.get()) != 0) return -errno;
+            }
+            if (int r = moveEntries(previous.get(), live.get(), false); r != 0) return r;
+        } else if (errno != ENOENT) {
             return -errno;
         }
     }
-    return 0;
+    const auto path = stageName(name);
+    // Detach the journal before deleting its entries. A crash during cleanup must not
+    // leave a directory that looks like an uncommitted journal.
+    const auto trash = std::string(kCleanupPrefix) + name;
+    if (int r = removePrivateDirectory(parentFd, trash); r != 0) return r;
+    if (renameat(parentFd, path.c_str(), parentFd, trash.c_str()) != 0 ||
+        fsync(parentFd) != 0) return -errno;
+    return removePrivateDirectory(parentFd, trash);
 }
 
