+// ---- PlaitOS backups (PlaitBackup.cpp) ----
+
+namespace {
+
+struct PlaitPart {
+    std::string parent;
+    gid_t gid;  // 0 = the app's own gid
+    mode_t newDirMode;
+    bool external;
+};
+
+bool plaitPart(const char* uuid, int32_t userId, int32_t part, PlaitPart* out) {
+    const std::string media = create_data_media_path(uuid, userId) + "/Android/";
+    switch (part) {
+        case android::os::IInstalld::PLAIT_PART_CE:
+            *out = {create_data_user_ce_path(uuid, userId), 0, 0700, false};
+            return true;
+        case android::os::IInstalld::PLAIT_PART_DE:
+            *out = {create_data_user_de_path(uuid, userId), 0, 0700, false};
+            return true;
+        case android::os::IInstalld::PLAIT_PART_EXT_DATA:
+            *out = {media + "data", AID_EXT_DATA_RW, 0770, true};
+            return true;
+        case android::os::IInstalld::PLAIT_PART_EXT_OBB:
+            *out = {media + "obb", AID_EXT_OBB_RW, 0770, true};
+            return true;
+        case android::os::IInstalld::PLAIT_PART_EXT_MEDIA:
+            *out = {media + "media", AID_MEDIA_RW, 0770, true};
+            return true;
+    }
+    return false;
+}
+
+}  // namespace
+
+binder::Status InstalldNativeService::plaitBackupAppData(const std::optional<std::string>& uuid,
+        const std::string& packageName, int32_t userId, int32_t part,
+        const android::os::ParcelFileDescriptor& out, bool* _aidl_return) {
+    ENFORCE_UID(AID_SYSTEM);
+    ENFORCE_VALID_USER(userId);
+    CHECK_ARGUMENT_UUID(uuid);
+    CHECK_ARGUMENT_PACKAGE_NAME(packageName);
+    LOCK_PACKAGE_USER();
+    PlaitPart p;
+    if (!plaitPart(uuid ? uuid->c_str() : nullptr, userId, part, &p)) {
+        return error("unknown backup part " + std::to_string(part));
+    }
+    std::string err;
+    int r = plait::writeTreeTarZst(out.get(), p.parent, packageName, /* skipCaches= */ true, &err);
+    if (r == -ENOENT) {
+        *_aidl_return = false;
+        return ok();
+    }
+    if (r != 0) return error(-r, "backup of " + packageName + " failed: " + err);
+    *_aidl_return = true;
+    return ok();
+}
+
+binder::Status InstalldNativeService::plaitRestoreAppData(const std::optional<std::string>& uuid,
+        const std::string& packageName, int32_t userId, int32_t appId, const std::string& seInfo,
+        int32_t part, const android::os::ParcelFileDescriptor& source) {
+    ENFORCE_UID(AID_SYSTEM);
+    ENFORCE_VALID_USER(userId);
+    CHECK_ARGUMENT_UUID(uuid);
+    CHECK_ARGUMENT_PACKAGE_NAME(packageName);
+    LOCK_PACKAGE_USER();
+    // Only real apps: never a shared system uid
+    if (appId < AID_APP_START || appId > AID_APP_END) {
+        return error("refusing to restore into appId " + std::to_string(appId));
+    }
+    const char* uuid_ = uuid ? uuid->c_str() : nullptr;
+    PlaitPart p;
+    if (!plaitPart(uuid_, userId, part, &p)) {
+        return error("unknown backup part " + std::to_string(part));
+    }
+    uid_t uid = multiuser_get_uid(userId, appId);
+    gid_t gid = p.gid ? p.gid : uid;
+    std::string err;
+    int r = plait::extractTreeTarZst(source.get(), p.parent, packageName, uid, gid, p.newDirMode,
+                                     /* skipCaches= */ true, &err);
+    if (r != 0) return error(-r, "restore of " + packageName + " failed: " + err);
+    if (!p.external) {
+        int flag = part == android::os::IInstalld::PLAIT_PART_CE ? FLAG_STORAGE_CE : FLAG_STORAGE_DE;
+        return restoreconAppDataLocked(uuid, packageName, userId, flag, appId, seInfo);
+    }
+    auto path = p.parent + "/" + packageName;
+    if (selinux_android_restorecon(path.c_str(), SELINUX_ANDROID_RESTORECON_RECURSE) < 0) {
+        return error("restorecon failed for " + path);
+    }
+    return ok();
+}
+
+binder::Status InstalldNativeService::plaitBackupApks(const std::string& codePath,
+        const android::os::ParcelFileDescriptor& out) {
+    ENFORCE_UID(AID_SYSTEM);
+    // An installed app's code dir only
+    char real[PATH_MAX];
+    if (realpath(codePath.c_str(), real) == nullptr ||
+        !android::base::StartsWith(std::string(real), "/data/app/")) {
+        return error("not an app code dir: " + codePath);
+    }
+    std::string err;
+    int r = plait::writeApksTarZst(out.get(), real, &err);
+    if (r != 0) return error(-r, "APK backup failed: " + err);
+    return ok();
+}
+
+binder::Status InstalldNativeService::plaitZstdDecompress(
+        const android::os::ParcelFileDescriptor& source, const android::os::ParcelFileDescriptor& out) {
+    ENFORCE_UID(AID_SYSTEM);
+    std::string err;
+    int r = plait::zstdDecompress(source.get(), out.get(), &err);
+    if (r != 0) return error(-r, err);
+    return ok();
+}
