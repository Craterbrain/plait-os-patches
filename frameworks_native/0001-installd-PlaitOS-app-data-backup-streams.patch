+constexpr size_t kBlock = 512;
+constexpr size_t kChunk = 64 * 1024;
+constexpr size_t kMaxPath = 4096;
+constexpr size_t kMaxPax = 64 * 1024;
+constexpr int kZstdLevel = 3;
+
+// A reader that goes away (the app closed its end) must be an EPIPE error, not a SIGPIPE that kills installd.
+// Only this thread's mask changes, so nothing installd starts inherits SIG_IGN.
+class ScopedSigpipeBlock {
+  public:
+    ScopedSigpipeBlock() {
+        sigset_t set;
+        sigemptyset(&set);
+        sigaddset(&set, SIGPIPE);
+        pthread_sigmask(SIG_BLOCK, &set, &mOld);
+    }
+    ~ScopedSigpipeBlock() {
+        sigset_t set, pending;
+        sigemptyset(&set);
+        sigaddset(&set, SIGPIPE);
+        if (sigpending(&pending) == 0 && sigismember(&pending, SIGPIPE)) {
+            struct timespec zero = {0, 0};
+            sigtimedwait(&set, nullptr, &zero);
+        }
+        pthread_sigmask(SIG_SETMASK, &mOld, nullptr);
+    }
+
+  private:
+    sigset_t mOld;
+};
+
+bool writeAll(int fd, const void* data, size_t size) {
+    const char* p = static_cast<const char*>(data);
+    while (size > 0) {
+        ssize_t n = TEMP_FAILURE_RETRY(write(fd, p, size));
+        if (n <= 0) return false;
+        p += n;
+        size -= n;
+    }
+    return true;
+}
+
+// ---- zstd streams ----
+
+class ZstdOut {
+  public:
+    explicit ZstdOut(int fd) : mFd(fd), mCtx(ZSTD_createCCtx()), mBuf(ZSTD_CStreamOutSize()) {
+        ZSTD_CCtx_setParameter(mCtx, ZSTD_c_compressionLevel, kZstdLevel);
+    }
+    ~ZstdOut() { ZSTD_freeCCtx(mCtx); }
+
+    bool write(const void* data, size_t size) { return feed(data, size, ZSTD_e_continue); }
+    bool finish() { return feed(nullptr, 0, ZSTD_e_end); }
+
+  private:
+    bool feed(const void* data, size_t size, ZSTD_EndDirective mode) {
+        ZSTD_inBuffer in = {data, size, 0};
+        while (true) {
+            ZSTD_outBuffer out = {mBuf.data(), mBuf.size(), 0};
+            size_t left = ZSTD_compressStream2(mCtx, &out, &in, mode);
+            if (ZSTD_isError(left)) return false;
+            if (out.pos > 0 && !writeAll(mFd, mBuf.data(), out.pos)) return false;
+            if (mode == ZSTD_e_end ? left == 0 : in.pos == in.size) return true;
+        }
+    }
+
+    int mFd;
+    ZSTD_CCtx* mCtx;
+    std::vector<char> mBuf;
+};
+
+class ZstdIn {
+  public:
+    explicit ZstdIn(int fd)
+        : mFd(fd), mCtx(ZSTD_createDCtx()), mIn(ZSTD_DStreamInSize()), mOut(ZSTD_DStreamOutSize()) {}
+    ~ZstdIn() { ZSTD_freeDCtx(mCtx); }
+
+    // Fills exactly size bytes; false at the end of the stream or on an error (see failed()).
+    bool readExact(void* dst, size_t size) {
+        char* d = static_cast<char*>(dst);
+        while (size > 0) {
+            if (mOutPos == mOutEnd && !refill()) return false;
+            size_t n = std::min(size, mOutEnd - mOutPos);
+            memcpy(d, mOut.data() + mOutPos, n);
+            mOutPos += n;
+            d += n;
+            size -= n;
+        }
+        return true;
+    }
+
+    // Up to size bytes; 0 at the end of the stream or on an error (see failed()).
+    size_t readSome(void* dst, size_t size) {
+        if (mOutPos == mOutEnd && !refill()) return 0;
+        size_t n = std::min(size, mOutEnd - mOutPos);
+        memcpy(dst, mOut.data() + mOutPos, n);
+        mOutPos += n;
+        return n;
+    }
+
+    bool skip(uint64_t size) {
+        char buf[kBlock * 8];
+        while (size > 0) {
+            size_t n = std::min<uint64_t>(size, sizeof(buf));
+            if (!readExact(buf, n)) return false;
+            size -= n;
+        }
+        return true;
+    }
+
+    bool failed() const { return mFailed; }
+
+  private:
+    bool refill() {
+        while (true) {
+            if (mInBuf.pos == mInBuf.size) {
+                ssize_t n = TEMP_FAILURE_RETRY(read(mFd, mIn.data(), mIn.size()));
+                if (n < 0) {
+                    mFailed = true;
+                    return false;
+                }
+                if (n == 0) return false;
+                mInBuf = {mIn.data(), static_cast<size_t>(n), 0};
+            }
+            ZSTD_outBuffer out = {mOut.data(), mOut.size(), 0};
+            size_t r = ZSTD_decompressStream(mCtx, &out, &mInBuf);
+            if (ZSTD_isError(r)) {
+                mFailed = true;
+                return false;
+            }
+            if (out.pos > 0) {
+                mOutPos = 0;
+                mOutEnd = out.pos;
+                return true;
+            }
+        }
+    }
+
+    int mFd;
+    ZSTD_DCtx* mCtx;
+    std::vector<char> mIn;
+    std::vector<char> mOut;
+    ZSTD_inBuffer mInBuf = {nullptr, 0, 0};
+    size_t mOutPos = 0;
+    size_t mOutEnd = 0;
+    bool mFailed = false;
+};
+
+// ---- tar writer (GNU format: ustar header, long names in ././@LongLink entries) ----
+
+void putOctal(char* field, size_t width, uint64_t value) {
+    (void)snprintf(field, width, "%0*llo", static_cast<int>(width - 1),
+             static_cast<unsigned long long>(value));
+}
+
+void putNumber(char* field, size_t width, uint64_t value) {
+    // Octal fits for anything under 8^(width-1); larger values use GNU base-256
+    if (value < (1ULL << (3 * (width - 1)))) {
+        putOctal(field, width, value);
+        return;
+    }
+    memset(field, 0, width);
+    field[0] = static_cast<char>(0x80);
+    for (size_t i = width - 1; i > 0 && value > 0; i--, value >>= 8) {
+        field[i] = static_cast<char>(value & 0xff);
+    }
+}
+
+class TarOut {
+  public:
+    explicit TarOut(ZstdOut* z) : mZ(z) {}
+
+    bool header(const std::string& name, char type, mode_t mode, uint64_t size, time_t mtime,
+                const std::string& link = "") {
+        if (name.size() >= 100 && !longEntry('L', name)) return false;
+        if (link.size() >= 100 && !longEntry('K', link)) return false;
+        char h[kBlock] = {};
+        memcpy(h, name.data(), std::min<size_t>(name.size(), 99));
+        putOctal(h + 100, 8, mode & 07777);
+        putOctal(h + 108, 8, 0);
+        putOctal(h + 116, 8, 0);
+        putNumber(h + 124, 12, size);
+        putOctal(h + 136, 12, mtime > 0 ? mtime : 0);
+        h[156] = type;
+        memcpy(h + 157, link.data(), std::min<size_t>(link.size(), 99));
+        memcpy(h + 257, "ustar  ", 8);  // GNU magic + version
+        memset(h + 148, ' ', 8);
+        unsigned sum = 0;
+        for (size_t i = 0; i < kBlock; i++) sum += static_cast<unsigned char>(h[i]);
+        (void)snprintf(h + 148, 8, "%06o", sum);
+        h[155] = ' ';
+        return mZ->write(h, kBlock);
+    }
+
+    bool data(const void* d, size_t n) { return mZ->write(d, n); }
+
+    bool pad(uint64_t size) {
+        static const char zeros[kBlock] = {};
+        size_t rem = size % kBlock;
+        return rem == 0 || mZ->write(zeros, kBlock - rem);
+    }
+
+    bool end() {
+        static const char zeros[kBlock * 2] = {};
+        return mZ->write(zeros, sizeof(zeros));
+    }
+
+  private:
+    bool longEntry(char type, const std::string& value) {
+        // NUL-terminated, as GNU tar writes it
+        if (!header("././@LongLink", type, 0644, value.size() + 1, 0)) return false;
+        if (!mZ->write(value.c_str(), value.size() + 1)) return false;
+        return pad(value.size() + 1);
+    }
+
+    ZstdOut* mZ;
+};
+
+bool isCacheName(const char* n) {
+    return strcmp(n, "cache") == 0 || strcmp(n, "code_cache") == 0;
+}
+
+int writeFile(TarOut* tar, int dirFd, const char* leaf, const std::string& path, const struct stat& st,
+              std::string* err) {
+    unique_fd fd(openat(dirFd, leaf, O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+    if (fd < 0) {
+        // Files that vanish while the app is running are skipped, not fatal
+        if (errno == ENOENT) return 0;
+        *err = StringPrintf("open %s: %s", path.c_str(), strerror(errno));
+        return -errno;
+    }
+    uint64_t size = st.st_size;
+    if (!tar->header(path, '0', st.st_mode, size, st.st_mtime)) return -EIO;
+    std::vector<char> buf(kChunk);
+    uint64_t done = 0;
+    while (done < size) {
+        ssize_t n = TEMP_FAILURE_RETRY(read(fd.get(), buf.data(), std::min<uint64_t>(kChunk, size - done)));
+        if (n < 0) {
+            *err = StringPrintf("read %s: %s", path.c_str(), strerror(errno));
+            return -errno;
+        }
+        if (n == 0) {
+            // Shrunk while reading: pad to the size in the header
+            std::fill(buf.begin(), buf.end(), 0);
+            n = std::min<uint64_t>(kChunk, size - done);
+        }
+        if (!tar->data(buf.data(), n)) return -EIO;
+        done += n;
+    }
+    return tar->pad(size) ? 0 : -EIO;
+}
+
+int walk(TarOut* tar, int dirFd, const std::string& rel, bool skipCachesHere, std::string* err) {
+    int dupFd = fcntl(dirFd, F_DUPFD_CLOEXEC, 0);
+    if (dupFd < 0) return -errno;
+    std::unique_ptr<DIR, decltype(&closedir)> dir(fdopendir(dupFd), closedir);
+    if (!dir) {
+        close(dupFd);
+        return -errno;
+    }
+    std::vector<std::string> names;
+    while (struct dirent* de = readdir(dir.get())) {
+        if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
+        if (skipCachesHere && isCacheName(de->d_name)) continue;
+        names.emplace_back(de->d_name);
+    }
+    std::sort(names.begin(), names.end());
+    for (const auto& n : names) {
+        struct stat st;
+        if (fstatat(dirFd, n.c_str(), &st, AT_SYMLINK_NOFOLLOW) != 0) continue;
+        std::string path = rel + "/" + n;
+        int r = 0;
+        if (S_ISDIR(st.st_mode)) {
+            unique_fd child(openat(dirFd, n.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+            if (child < 0) continue;
+            if (!tar->header(path + "/", '5', st.st_mode, 0, st.st_mtime)) return -EIO;
+            r = walk(tar, child.get(), path, false, err);
+        } else if (S_ISREG(st.st_mode)) {
+            r = writeFile(tar, dirFd, n.c_str(), path, st, err);
+        } else if (S_ISLNK(st.st_mode)) {
+            char target[kMaxPath];
+            ssize_t len = readlinkat(dirFd, n.c_str(), target, sizeof(target) - 1);
+            if (len < 0) continue;
+            if (!tar->header(path, '2', st.st_mode, 0, st.st_mtime, std::string(target, len))) {
+                return -EIO;
+            }
+        }
+        // Sockets, fifos and device nodes are runtime state, never part of a backup
+        if (r != 0) return r;
+    }
+    return 0;
+}
+
+// ---- tar reader ----
+
+uint64_t parseNumber(const char* field, size_t width) {
+    if (static_cast<unsigned char>(field[0]) & 0x80) {
+        uint64_t v = 0;
+        for (size_t i = 1; i < width; i++) v = (v << 8) | static_cast<unsigned char>(field[i]);
+        return v;
+    }
+    uint64_t v = 0;
+    for (size_t i = 0; i < width && field[i]; i++) {
+        if (field[i] == ' ') continue;
+        if (field[i] < '0' || field[i] > '7') break;
+        v = (v << 3) | (field[i] - '0');
+    }
+    return v;
+}
+
+std::string fieldString(const char* field, size_t width) {
+    return std::string(field, strnlen(field, width));
+}
+
+bool checksumOk(const char* h) {
+    unsigned sum = 0;
+    for (size_t i = 0; i < kBlock; i++) {
+        sum += (i >= 148 && i < 156) ? ' ' : static_cast<unsigned char>(h[i]);
+    }
+    return sum == parseNumber(h + 148, 8);
+}
+
+bool readString(ZstdIn* z, uint64_t size, size_t limit, std::string* out) {
+    if (size > limit) return false;
+    out->assign(size, '\0');
+    if (!z->readExact(out->data(), size)) return false;
+    size_t rem = size % kBlock;
+    if (rem && !z->skip(kBlock - rem)) return false;
+    out->resize(strnlen(out->c_str(), out->size()));
+    return true;
+}
+
+void parsePax(const std::string& data, std::string* path, std::string* link) {
+    size_t pos = 0;
+    while (pos < data.size()) {
+        size_t sp = data.find(' ', pos);
+        if (sp == std::string::npos) return;
+        size_t len = strtoul(data.c_str() + pos, nullptr, 10);
+        if (len == 0 || pos + len > data.size()) return;
+        std::string rec = data.substr(sp + 1, pos + len - sp - 2);  // without the trailing newline
+        size_t eq = rec.find('=');
+        if (eq != std::string::npos) {
+            std::string key = rec.substr(0, eq);
+            if (key == "path") *path = rec.substr(eq + 1);
+            if (key == "linkpath") *link = rec.substr(eq + 1);
+        }
+        pos += len;
+    }
+}
+
+// Splits an archive path into components; false for anything that could leave the tree.
+bool splitSafe(std::string path, std::vector<std::string>* parts) {
+    while (path.compare(0, 2, "./") == 0) path.erase(0, 2);
+    while (!path.empty() && path.back() == '/') path.pop_back();
+    if (path.empty() || path[0] == '/' || path.size() > kMaxPath) return false;
+    size_t start = 0;
+    while (true) {
+        size_t slash = path.find('/', start);
+        std::string c = path.substr(start, slash == std::string::npos ? std::string::npos : slash - start);
+        if (c.empty() || c == "." || c == ".." || c.size() > NAME_MAX) return false;
+        parts->push_back(c);
+        if (slash == std::string::npos) return true;
+        start = slash + 1;
+    }
+}
+
+class Extractor {
+  public:
+    Extractor(int rootFd, uid_t uid, gid_t gid, mode_t newDirMode)
+        : mRoot(rootFd), mUid(uid), mGid(gid), mNewDirMode(newDirMode) {}
+
+    // An fd for the directory holding parts[1..n-1]'s last element, creating missing dirs; -1 on error.
+    unique_fd parentOf(const std::vector<std::string>& parts) {
+        unique_fd cur(fcntl(mRoot, F_DUPFD_CLOEXEC, 0));
+        for (size_t i = 1; i + 1 < parts.size() && cur >= 0; i++) {
+            cur = openDir(cur.get(), parts[i]);
+        }
+        return cur;
+    }
+
+    unique_fd openDir(int dirFd, const std::string& name) {
+        unique_fd fd(openat(dirFd, name.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+        if (fd < 0 && errno == ENOENT) {
+            if (mkdirat(dirFd, name.c_str(), mNewDirMode) != 0 && errno != EEXIST) return unique_fd();
+            fd.reset(openat(dirFd, name.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+            if (fd >= 0 && (fchown(fd.get(), mUid, mGid) != 0 || fchmod(fd.get(), mNewDirMode) != 0)) {
+                return unique_fd();
+            }
+        }
+        return fd;
+    }
+
+    // Removes whatever is at name unless it is a directory (which is kept and reused).
+    bool clearNonDir(int dirFd, const std::string& name) {
+        struct stat st;
+        if (fstatat(dirFd, name.c_str(), &st, AT_SYMLINK_NOFOLLOW) != 0) return errno == ENOENT;
+        if (S_ISDIR(st.st_mode)) return false;
+        return unlinkat(dirFd, name.c_str(), 0) == 0;
+    }
+
+    int mRoot;
+    uid_t mUid;
+    gid_t mGid;
+    mode_t mNewDirMode;
+};
+
+// Deletes everything in the dir except (when skipCaches) its cache and code_cache.
+int clearTree(int rootFd, bool skipCaches) {
+    int dupFd = fcntl(rootFd, F_DUPFD_CLOEXEC, 0);
+    if (dupFd < 0) return -errno;
+    std::unique_ptr<DIR, decltype(&closedir)> dir(fdopendir(dupFd), closedir);
+    if (!dir) {
+        close(dupFd);
+        return -errno;
+    }
+    std::vector<std::pair<std::string, bool>> entries;
+    while (struct dirent* de = readdir(dir.get())) {
+        if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
+        if (skipCaches && isCacheName(de->d_name)) continue;
+        struct stat st;
+        if (fstatat(rootFd, de->d_name, &st, AT_SYMLINK_NOFOLLOW) != 0) continue;
+        entries.emplace_back(de->d_name, S_ISDIR(st.st_mode));
+    }
+    for (const auto& [name, isDir] : entries) {
+        if (isDir) {
+            if (delete_dir_contents_fd(rootFd, name.c_str()) != 0) return -EIO;
+            if (unlinkat(rootFd, name.c_str(), AT_REMOVEDIR) != 0) return -errno;
+        } else if (unlinkat(rootFd, name.c_str(), 0) != 0) {
+            return -errno;
+        }
+    }
+    return 0;
+}
+
+}  // namespace
+
+int writeTreeTarZst(int outFd, const std::string& parent, const std::string& name, bool skipCaches,
+                    std::string* err) {
+    unique_fd parentFd(open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    if (parentFd < 0) return errno == ENOENT ? -ENOENT : -errno;
+    unique_fd root(openat(parentFd.get(), name.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (root < 0) return errno == ENOENT ? -ENOENT : -errno;
+    struct stat st;
+    if (fstat(root.get(), &st) != 0) return -errno;
+    ScopedSigpipeBlock noSigpipe;
+    ZstdOut z(outFd);
+    TarOut tar(&z);
+    if (!tar.header(name + "/", '5', st.st_mode, 0, st.st_mtime)) return -EIO;
+    int r = walk(&tar, root.get(), name, skipCaches, err);
+    if (r != 0) return r;
+    if (!tar.end() || !z.finish()) {
+        *err = "write failed (reader gone?)";
+        return -EIO;
+    }
+    return 0;
+}
+
+int writeApksTarZst(int outFd, const std::string& dir, std::string* err) {
+    unique_fd dirFd(open(dir.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (dirFd < 0) {
+        *err = StringPrintf("open %s: %s", dir.c_str(), strerror(errno));
+        return -errno;
+    }
+    int dupFd = fcntl(dirFd.get(), F_DUPFD_CLOEXEC, 0);
+    std::unique_ptr<DIR, decltype(&closedir)> d(fdopendir(dupFd), closedir);
+    if (!d) {
+        close(dupFd);
+        return -errno;
+    }
+    std::vector<std::string> apks;
+    while (struct dirent* de = readdir(d.get())) {
+        std::string n = de->d_name;
+        if (n.size() > 4 && n.compare(n.size() - 4, 4, ".apk") == 0) apks.push_back(n);
+    }
+    if (apks.empty()) {
+        *err = "no APKs in " + dir;
+        return -ENOENT;
+    }
+    std::sort(apks.begin(), apks.end());
+    ScopedSigpipeBlock noSigpipe;
+    ZstdOut z(outFd);
+    TarOut tar(&z);
+    for (const auto& n : apks) {
+        struct stat st;
+        if (fstatat(dirFd.get(), n.c_str(), &st, AT_SYMLINK_NOFOLLOW) != 0 || !S_ISREG(st.st_mode)) continue;
+        int r = writeFile(&tar, dirFd.get(), n.c_str(), n, st, err);
+        if (r != 0) return r;
+    }
+    if (!tar.end() || !z.finish()) {
+        *err = "write failed (reader gone?)";
+        return -EIO;
+    }
+    return 0;
+}
+
+int extractTreeTarZst(int inFd, const std::string& parent, const std::string& name, uid_t uid, gid_t gid,
+                      mode_t newDirMode, bool skipCaches, std::string* err) {
+    unique_fd parentFd(open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    if (parentFd < 0) {
+        *err = StringPrintf("open %s: %s", parent.c_str(), strerror(errno));
+        return -errno;
+    }
+    Extractor ex(parentFd.get(), uid, gid, newDirMode);
+    unique_fd root = ex.openDir(parentFd.get(), name);
+    if (root < 0) {
+        *err = StringPrintf("open %s/%s: %s", parent.c_str(), name.c_str(), strerror(errno));
+        return -EIO;
+    }
+    // Only the app's own dir is ever opened from here on
+    ex.mRoot = root.get();
+    if (int r = clearTree(root.get(), skipCaches); r != 0) {
+        *err = "could not clear the old data";
+        return r;
+    }
+
+    ZstdIn z(inFd);
+    std::string longName, longLink, paxPath, paxLink;
+    int zeroBlocks = 0;
+    while (true) {
+        char h[kBlock];
+        if (!z.readExact(h, kBlock)) {
+            if (z.failed()) {
+                *err = "archive is damaged (zstd)";
+                return -EINVAL;
+            }
+            break;  // tolerate archives without the closing zero blocks
+        }
+        if (std::all_of(h, h + kBlock, [](char c) { return c == 0; })) {
+            if (++zeroBlocks == 2) break;
+            continue;
+        }
+        zeroBlocks = 0;
+        if (!checksumOk(h)) {
+            *err = "archive is damaged (tar header checksum)";
+            return -EINVAL;
+        }
+        char type = h[156] ? h[156] : '0';
+        uint64_t size = parseNumber(h + 124, 12);
+        if (type == 'L' || type == 'K' || type == 'x' || type == 'g') {
+            std::string data;
+            if (!readString(&z, size, type == 'x' || type == 'g' ? kMaxPax : kMaxPath, &data)) {
+                *err = "archive has an oversized or damaged header";
+                return -EINVAL;
+            }
+            if (type == 'L') longName = data;
+            if (type == 'K') longLink = data;
+            if (type == 'x') parsePax(data, &paxPath, &paxLink);
+            continue;
+        }
+
+        std::string path = fieldString(h, 100);
+        if (memcmp(h + 257, "ustar\0", 6) == 0 && h[345]) {
+            path = fieldString(h + 345, 155) + "/" + path;  // POSIX ustar prefix
+        }
+        if (!paxPath.empty()) path = paxPath;
+        if (!longName.empty()) path = longName;
+        std::string link = fieldString(h + 157, 100);
+        if (!paxLink.empty()) link = paxLink;
+        if (!longLink.empty()) link = longLink;
+        longName.clear();
+        longLink.clear();
+        paxPath.clear();
+        paxLink.clear();
+        uint64_t dataSize = (type == '0' || type == '7') ? size : 0;
+        auto skipData = [&]() {
+            uint64_t padded = (size + kBlock - 1) / kBlock * kBlock;
+            return z.skip(padded);
+        };
+
+        std::vector<std::string> parts;
+        if (!splitSafe(path, &parts) || parts[0] != name) {
+            *err = "refused an entry outside the app's data: " + path.substr(0, 200);
+            return -EPERM;
+        }
+        if (skipCaches && parts.size() >= 2 && isCacheName(parts[1].c_str())) {
+            if (!skipData()) return -EINVAL;
+            continue;
+        }
+        mode_t perm = parseNumber(h + 100, 8) & 0777;
+        if (parts.size() == 1) {
+            // The app's dir itself: keep it, just set its mode from the archive
+            if (type == '5') fchmod(root.get(), perm | 0700);
+            if (!skipData()) return -EINVAL;
+            continue;
+        }
+        unique_fd dir = ex.parentOf(parts);
+        if (dir < 0) {
+            *err = "could not create the directories for " + path.substr(0, 200);
+            return -EIO;
+        }
+        const std::string& leaf = parts.back();
+        if (type == '5') {
+            unique_fd d = ex.openDir(dir.get(), leaf);
+            if (d < 0 || fchown(d.get(), uid, gid) != 0 || fchmod(d.get(), perm | 0700) != 0) {
+                *err = "could not create " + path.substr(0, 200);
+                return -EIO;
+            }
+        } else if (type == '0' || type == '7') {
+            if (!ex.clearNonDir(dir.get(), leaf)) {
+                *err = "could not replace " + path.substr(0, 200);
+                return -EIO;
+            }
+            unique_fd f(openat(dir.get(), leaf.c_str(),
+                               O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
+            if (f < 0) {
+                *err = StringPrintf("create %s: %s", path.substr(0, 200).c_str(), strerror(errno));
+                return -errno;
+            }
+            std::vector<char> buf(kChunk);
+            uint64_t left = dataSize;
+            while (left > 0) {
+                size_t n = std::min<uint64_t>(kChunk, left);
+                if (!z.readExact(buf.data(), n)) {
+                    *err = "archive ended inside " + path.substr(0, 200);
+                    return -EINVAL;
+                }
+                if (!writeAll(f.get(), buf.data(), n)) {
+                    *err = StringPrintf("write %s: %s", path.substr(0, 200).c_str(), strerror(errno));
+                    return -EIO;
+                }
+                left -= n;
+            }
+            size_t rem = dataSize % kBlock;
+            if (rem && !z.skip(kBlock - rem)) return -EINVAL;
+            struct timespec times[2] = {{0, UTIME_OMIT}, {static_cast<time_t>(parseNumber(h + 136, 12)), 0}};
+            if (fchown(f.get(), uid, gid) != 0 || fchmod(f.get(), perm) != 0) {
+                *err = "could not set the owner of " + path.substr(0, 200);
+                return -EIO;
+            }
+            futimens(f.get(), times);
+        } else if (type == '2') {
+            // Kept as a link; nothing here ever follows it
+            if (!ex.clearNonDir(dir.get(), leaf) || link.empty() || link.size() > kMaxPath ||
+                symlinkat(link.c_str(), dir.get(), leaf.c_str()) != 0 ||
+                fchownat(dir.get(), leaf.c_str(), uid, gid, AT_SYMLINK_NOFOLLOW) != 0) {
+                *err = "could not create the link " + path.substr(0, 200);
+                return -EIO;
+            }
+        } else {
+            // Hard links, devices, fifos: never restored
+            if (!skipData()) return -EINVAL;
+        }
+    }
+    return 0;
+}
+
+int zstdDecompress(int inFd, int outFd, std::string* err) {
+    ZstdIn z(inFd);
+    std::vector<char> buf(kChunk);
+    ScopedSigpipeBlock noSigpipe;
+    while (true) {
+        size_t got = z.readSome(buf.data(), buf.size());
+        if (got == 0) break;
+        if (!writeAll(outFd, buf.data(), got)) {
+            *err = "write failed (reader gone?)";
+            return -EIO;
+        }
+    }
+    if (z.failed()) {
+        *err = "archive is damaged (zstd)";
+        return -EINVAL;
+    }
+    return 0;
+}
+
+}  // namespace plait
+}  // namespace installd
+}  // namespace android
