+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <sys/types.h>
+
+#include <string>
+
+namespace android {
+namespace installd {
+namespace plait {
+
+/*
+ * Streaming app data backups for PlaitOS's plait_backup service: zstd-compressed tar, in the archive layout
+ * Android-DataBackup uses (entries "<pkg>/..." relative to the parent dir, cache and code_cache left out), so
+ * archives move between Plait Backup's rooted-phone backend and PlaitOS.
+ *
+ * Restores only ever write inside <parent>/<name>: every path is walked one component at a time with openat and
+ * O_NOFOLLOW (a symlink in the app's data can never redirect a write), only regular files, directories and symlinks
+ * are created, and everything is owned by the given uid:gid with permission bits only (no setuid/setgid files).
+ * The tar's own owners are ignored. Labels are fixed afterwards by the caller (restorecon).
+ */
+
+// Returns -ENOENT (and writes nothing) if <parent>/<name> does not exist.
+int writeTreeTarZst(int outFd, const std::string& parent, const std::string& name, bool skipCaches,
+                    std::string* err);
+
+// The *.apk files directly in dir, as entries "base.apk", "split_*.apk".
+int writeApksTarZst(int outFd, const std::string& dir, std::string* err);
+
+// Replaces the contents of <parent>/<name> (except cache and code_cache when skipCaches) with the archive's.
+int extractTreeTarZst(int inFd, const std::string& parent, const std::string& name, uid_t uid, gid_t gid,
+                      mode_t newDirMode, bool skipCaches, std::string* err);
+
+// Plain zstd decompression from one fd to another (APK archives, which system_server unpacks itself).
+int zstdDecompress(int inFd, int outFd, std::string* err);
+
+}  // namespace plait
+}  // namespace installd
+}  // namespace android
