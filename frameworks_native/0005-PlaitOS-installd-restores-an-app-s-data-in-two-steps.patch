+// The same in two steps, for a restore whose archive can only be checked once it has all been read (its signed
+// hash): stageTreeTarZst extracts into a staging dir inside <parent>/<name> and leaves the app's data alone;
+// commitStage swaps it in (-ENOENT if there is no complete staged restore); abortStage throws it away (always
+// safe, also when nothing is staged). A stage left by a crash is removed by the next stage or abort.
+int stageTreeTarZst(int inFd, const std::string& parent, const std::string& name, uid_t uid, gid_t gid,
+                    mode_t newDirMode, bool skipCaches, bool external, std::string* err);
+int commitStage(const std::string& parent, const std::string& name, bool skipCaches, std::string* err);
+void abortStage(const std::string& parent, const std::string& name);
+
 // Plain zstd decompression from one fd to another (APK archives, which system_server unpacks itself).
 int zstdDecompress(int inFd, int outFd, std::string* err);
 
