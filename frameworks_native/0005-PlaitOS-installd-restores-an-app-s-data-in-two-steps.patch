+binder::Status InstalldNativeService::plaitRestoreAppDataStage(const std::optional<std::string>& uuid,
+        const std::string& packageName, int32_t userId, int32_t appId, const std::string& /* seInfo: labels are fixed by Finish */,
+        int32_t part, const android::os::ParcelFileDescriptor& source) {
+    ENFORCE_UID(AID_SYSTEM);
+    ENFORCE_VALID_USER(userId);
+    CHECK_ARGUMENT_UUID(uuid);
+    CHECK_ARGUMENT_PACKAGE_NAME(packageName);
+    LOCK_PACKAGE_USER();
+    if (appId < AID_APP_START || appId > AID_APP_END) {
+        return error("refusing to restore into appId " + std::to_string(appId));
+    }
+    const char* uuid_ = uuid ? uuid->c_str() : nullptr;
+    PlaitPart p;
+    if (!plaitPart(uuid_, userId, part, &p)) {
+        return error("unknown backup part " + std::to_string(part));
+    }
+    uid_t uid = multiuser_get_uid(userId, appId);
+    gid_t gid = p.gid ? p.gid : uid;
+    std::string err;
+    int r = plait::stageTreeTarZst(source.get(), p.parent, packageName, uid, gid, p.newDirMode,
+                                   /* skipCaches= */ true, p.external, &err);
+    if (r != 0) return error(-r, "staging the restore of " + packageName + " failed: " + err);
+    return ok();
+}
+
+binder::Status InstalldNativeService::plaitRestoreAppDataFinish(const std::optional<std::string>& uuid,
+        const std::string& packageName, int32_t userId, int32_t appId, const std::string& seInfo,
+        int32_t part, bool commit) {
+    ENFORCE_UID(AID_SYSTEM);
+    ENFORCE_VALID_USER(userId);
+    CHECK_ARGUMENT_UUID(uuid);
+    CHECK_ARGUMENT_PACKAGE_NAME(packageName);
+    LOCK_PACKAGE_USER();
+    if (appId < AID_APP_START || appId > AID_APP_END) {
+        return error("refusing to restore into appId " + std::to_string(appId));
+    }
+    const char* uuid_ = uuid ? uuid->c_str() : nullptr;
+    PlaitPart p;
+    if (!plaitPart(uuid_, userId, part, &p)) {
+        return error("unknown backup part " + std::to_string(part));
+    }
+    if (!commit) {
+        plait::abortStage(p.parent, packageName);
+        return ok();
+    }
+    std::string err;
+    int r = plait::commitStage(p.parent, packageName, /* skipCaches= */ true, &err);
+    if (r != 0) {
+        plait::abortStage(p.parent, packageName);
+        return error(-r, "restore of " + packageName + " failed: " + err);
+    }
+    if (!p.external) {
+        int flag = part == android::os::IInstalld::PLAIT_PART_CE ? FLAG_STORAGE_CE : FLAG_STORAGE_DE;
+        return restoreconAppDataLocked(uuid, packageName, userId, flag, appId, seInfo);
+    }
+    auto path = p.parent + "/" + packageName;
+    if (selinux_android_restorecon(path.c_str(), SELINUX_ANDROID_RESTORECON_RECURSE) < 0) {
+        return error("restorecon failed for " + path);
+    }
+    return ok();
+}
