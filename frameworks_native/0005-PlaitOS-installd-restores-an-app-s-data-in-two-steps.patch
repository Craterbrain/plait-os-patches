+// The staging names (kStage, kDone, below) count as caches: a backup never archives a half-made restore and a
+// swap never clears one.
 bool isCacheName(const char* n) {
-    return strcmp(n, "cache") == 0 || strcmp(n, "code_cache") == 0;
+    return strcmp(n, "cache") == 0 || strcmp(n, "code_cache") == 0 || strcmp(n, ".plait_restore") == 0 ||
+           strcmp(n, ".plait_restore_done") == 0;
 }
 
 constexpr int kMaxDepth = 128;
@@ -510,8 +514,12 @@ class Extractor {
 // Restores are extracted here (inside the app's own dir, so the dir and its inode stay) and only moved into
 // place once the whole archive has arrived intact.
 constexpr const char* kStage = ".plait_restore";
+// Written when the archive has been extracted completely: holds the root dir's mode for the swap. Without it a
+// staged restore is never swapped in (a crash or kill mid-extract leaves a stage that the next restore removes).
+constexpr const char* kDone = ".plait_restore_done";
 
 void removeStage(int rootFd) {
+    unlinkat(rootFd, kDone, 0);
     struct stat st;
     if (fstatat(rootFd, kStage, &st, AT_SYMLINK_NOFOLLOW) != 0) return;
     if (S_ISDIR(st.st_mode)) {
@@ -535,7 +543,7 @@ int clearTree(int rootFd, bool skipCaches) {
     while (struct dirent* de = readdir(dir.get())) {
         if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
         if (skipCaches && isCacheName(de->d_name)) continue;
-        if (strcmp(de->d_name, kStage) == 0) continue;
+        if (strcmp(de->d_name, kStage) == 0 || strcmp(de->d_name, kDone) == 0) continue;
         struct stat st;
         if (fstatat(rootFd, de->d_name, &st, AT_SYMLINK_NOFOLLOW) != 0) continue;
         entries.emplace_back(de->d_name, S_ISDIR(st.st_mode));
@@ -613,8 +621,8 @@ int writeApksTarZst(int outFd, const std::string& dir, std::string* err) {
 static int extractEntries(int inFd, Extractor* exPtr, const std::string& name, uid_t uid, gid_t gid,
                           bool skipCaches, bool external, mode_t* rootMode, std::string* err);
 
-int extractTreeTarZst(int inFd, const std::string& parent, const std::string& name, uid_t uid, gid_t gid,
-                      mode_t newDirMode, bool skipCaches, bool external, std::string* err) {
+int stageTreeTarZst(int inFd, const std::string& parent, const std::string& name, uid_t uid, gid_t gid,
+                    mode_t newDirMode, bool skipCaches, bool external, std::string* err) {
     unique_fd parentFd(open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
     if (parentFd < 0) {
         *err = StringPrintf("open %s: %s", parent.c_str(), strerror(errno));
@@ -626,7 +634,7 @@ int extractTreeTarZst(int inFd, const std::string& parent, const std::string& na
         *err = StringPrintf("open %s/%s: %s", parent.c_str(), name.c_str(), strerror(errno));
         return -EIO;
     }
-    // Extract into the staging dir; the app's current data stays untouched until the archive is complete
+    // Extract into the staging dir; the app's current data stays untouched until commitStage
     removeStage(root.get());
     unique_fd stage = ex.openDir(root.get(), kStage);
     if (stage < 0) {
@@ -636,10 +644,48 @@ int extractTreeTarZst(int inFd, const std::string& parent, const std::string& na
     ex.mRoot = stage.get();
     mode_t rootMode = 0;
     int r = extractEntries(inFd, &ex, name, uid, gid, skipCaches, external, &rootMode, err);
+    if (r == 0) {
+        std::string mode = std::to_string(static_cast<unsigned>(rootMode));
+        unique_fd done(openat(root.get(), kDone, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_CLOEXEC, 0600));
+        if (done < 0 || !writeAll(done.get(), mode.data(), mode.size())) {
+            *err = "could not mark the staged restore complete";
+            r = -EIO;
+        }
+    }
     if (r != 0) {
         stage.reset();
         removeStage(root.get());
-        return r;
+    }
+    return r;
+}
+
+int commitStage(const std::string& parent, const std::string& name, bool skipCaches, std::string* err) {
+    unique_fd parentFd(open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    if (parentFd < 0) {
+        *err = StringPrintf("open %s: %s", parent.c_str(), strerror(errno));
+        return -errno;
+    }
+    unique_fd root(openat(parentFd.get(), name.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (root < 0) {
+        *err = StringPrintf("open %s/%s: %s", parent.c_str(), name.c_str(), strerror(errno));
+        return -errno;
+    }
+    // Only a restore that was extracted completely (the marker is written last) is swapped in
+    mode_t rootMode = 0;
+    {
+        unique_fd done(openat(root.get(), kDone, O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+        char buf[16] = {};
+        ssize_t n = done < 0 ? -1 : TEMP_FAILURE_RETRY(read(done.get(), buf, sizeof(buf) - 1));
+        if (n <= 0) {
+            *err = "there is no complete staged restore";
+            return -ENOENT;
+        }
+        rootMode = static_cast<mode_t>(strtoul(buf, nullptr, 10)) & 07777;
+    }
+    unique_fd stage(openat(root.get(), kStage, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (stage < 0) {
+        *err = "there is no staged restore";
+        return -ENOENT;
     }
     // Complete and intact: swap the old data for the new
     if (int c = clearTree(root.get(), skipCaches); c != 0) {
@@ -671,6 +717,23 @@ int extractTreeTarZst(int inFd, const std::string& parent, const std::string& na
     return 0;
 }
 
+void abortStage(const std::string& parent, const std::string& name) {
+    unique_fd parentFd(open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    if (parentFd < 0) return;
+    unique_fd root(openat(parentFd.get(), name.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (root < 0) return;
+    removeStage(root.get());
+}
+
+int extractTreeTarZst(int inFd, const std::string& parent, const std::string& name, uid_t uid, gid_t gid,
+                      mode_t newDirMode, bool skipCaches, bool external, std::string* err) {
+    int r = stageTreeTarZst(inFd, parent, name, uid, gid, newDirMode, skipCaches, external, err);
+    if (r != 0) return r;
+    r = commitStage(parent, name, skipCaches, err);
+    if (r != 0) abortStage(parent, name);
+    return r;
+}
+
 static int extractEntries(int inFd, Extractor* exPtr, const std::string& name, uid_t uid, gid_t gid, bool skipCaches,
                    bool external, mode_t* rootMode, std::string* err) {
     Extractor& ex = *exPtr;
