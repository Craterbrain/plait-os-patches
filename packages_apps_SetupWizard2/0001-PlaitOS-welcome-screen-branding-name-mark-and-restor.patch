 res/drawable/grapheneos_icon.xml              | 21 ++++++++++++-------
 res/values/strings.xml                        |  6 +++---
 3 files changed, 27 insertions(+), 13 deletions(-)

diff --git a/java/app/grapheneos/setupwizard/action/MigrationActions.kt b/java/app/grapheneos/setupwizard/action/MigrationActions.kt
index d3f0817..524d4fe 100644
--- a/java/app/grapheneos/setupwizard/action/MigrationActions.kt
+++ b/java/app/grapheneos/setupwizard/action/MigrationActions.kt
@@ -7,15 +7,22 @@ import app.grapheneos.setupwizard.view.activity.SetupWizardActivity
 
 object MigrationActions {
     private const val TAG = "MigrationActions"
-    private const val ACTION_SEEDVAULT_RESTORE = "com.stevesoltys.seedvault.RESTORE_BACKUP"
+    // PlaitOS: restores come from Plait Backup (Seedvault is not in PlaitOS)
+    private const val PLAIT_BACKUP_PACKAGE = "app.plait.backup"
+    private const val PLAIT_BACKUP_ACTIVITY = "app.plait.backup.MainActivity"
 
     init {
     }
 
     fun launchMigration(context: SetupWizardActivity) {
         Log.d(TAG, "launchMigration")
-        val intent = Intent(ACTION_SEEDVAULT_RESTORE)
-        SetupWizard.startActivityForResult(context, intent)
+        val intent = Intent().setClassName(PLAIT_BACKUP_PACKAGE, PLAIT_BACKUP_ACTIVITY)
+        try {
+            SetupWizard.startActivityForResult(context, intent)
+        } catch (e: android.content.ActivityNotFoundException) {
+            Log.w(TAG, "Plait Backup is not installed", e)
+            SetupWizard.next(context)
+        }
     }
 
     fun handleResult(context: Activity, resultCode: Int) {
