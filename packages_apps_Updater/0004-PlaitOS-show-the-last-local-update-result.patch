diff --git a/src/app/seamlessupdate/client/LocalUpdateResult.java b/src/app/seamlessupdate/client/LocalUpdateResult.java
new file mode 100644
index 0000000..117631f
--- /dev/null
+++ b/src/app/seamlessupdate/client/LocalUpdateResult.java
@@ -0,0 +1,85 @@
+package app.seamlessupdate.client;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.os.SystemProperties;
+import android.os.UpdateEngine;
+
+final class LocalUpdateResult {
+    static final String STATE = "local_update_result";
+    private static final String TARGET = "local_update_target";
+    private static final String SLOT = "local_update_previous_slot";
+    private static final String CODE = "local_update_engine_code";
+
+    private static final String CHECKING = "checking";
+    private static final String REJECTED = "rejected";
+    private static final String FAILED = "failed";
+    private static final String PENDING = "pending";
+    private static final String INSTALLED = "installed";
+    private static final String DIFFERENT_BUILD = "different_build";
+    private static final String UNKNOWN = "unknown";
+
+    private LocalUpdateResult() {}
+
+    static void start(Context context) {
+        Settings.getPreferences(context).edit().remove(TARGET).remove(SLOT).remove(CODE)
+                .putString(STATE, CHECKING).commit();
+    }
+
+    static void reject(Context context) {
+        final var prefs = Settings.getPreferences(context);
+        if (CHECKING.equals(prefs.getString(STATE, ""))) {
+            prefs.edit().putString(STATE, REJECTED).commit();
+        }
+    }
+
+    static void complete(Context context, String target, int code) {
+        final var editor = Settings.getPreferences(context).edit().putString(TARGET, target)
+                .putInt(CODE, code);
+        if (code == UpdateEngine.ErrorCodeConstants.SUCCESS) {
+            editor.putString(STATE, PENDING).putString(SLOT, currentSlot());
+        } else {
+            editor.putString(STATE, FAILED);
+        }
+        editor.commit();
+    }
+
+    static void finishBoot(SharedPreferences prefs) {
+        switch (prefs.getString(STATE, "")) {
+            case CHECKING -> prefs.edit().putString(STATE, UNKNOWN).commit();
+            case PENDING -> {
+                final String target = prefs.getString(TARGET, "");
+                final String previousSlot = prefs.getString(SLOT, "");
+                final String currentSlot = currentSlot();
+                final String result;
+                if (target.isEmpty() || previousSlot.isEmpty() || currentSlot.isEmpty()) {
+                    result = UNKNOWN;
+                } else if (target.equals(Build.FINGERPRINT) && !currentSlot.equals(previousSlot)) {
+                    result = INSTALLED;
+                } else {
+                    result = DIFFERENT_BUILD;
+                }
+                prefs.edit().putString(STATE, result).commit();
+            }
+        }
+    }
+
+    static CharSequence summary(Context context) {
+        final var prefs = Settings.getPreferences(context);
+        return switch (prefs.getString(STATE, "")) {
+            case CHECKING -> context.getString(R.string.local_update_checking);
+            case REJECTED -> context.getString(R.string.local_update_rejected);
+            case FAILED -> context.getString(R.string.local_update_failed, prefs.getInt(CODE, -1));
+            case PENDING -> context.getString(R.string.local_update_pending);
+            case INSTALLED -> context.getString(R.string.local_update_installed, prefs.getString(TARGET, ""));
+            case DIFFERENT_BUILD -> context.getString(R.string.local_update_different_build);
+            case UNKNOWN -> context.getString(R.string.local_update_unknown);
+            default -> context.getString(R.string.local_update_none);
+        };
+    }
+
+    private static String currentSlot() {
+        return SystemProperties.get("ro.boot.slot_suffix");
+    }
+}
