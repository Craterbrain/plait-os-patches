diff --git a/src/app/seamlessupdate/client/UpdateLog.java b/src/app/seamlessupdate/client/UpdateLog.java
new file mode 100644
index 0000000..435f851
--- /dev/null
+++ b/src/app/seamlessupdate/client/UpdateLog.java
@@ -0,0 +1,153 @@
+package app.seamlessupdate.client;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.UpdateEngine;
+import android.util.Log;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * PlaitOS: what the updater is doing, for the progress row on its page. Every step is written to a
+ * small log in device-protected storage (so it survives the reboot that finishes an update) and
+ * to logcat (tag UpdaterLog); the current phase and percentage are kept in the preferences, which
+ * the page listens to.
+ */
+final class UpdateLog {
+    static final String PHASE = "update_progress_phase";
+    static final String PERCENT = "update_progress_percent";
+    static final String DETAIL = "update_progress_detail";
+    /** Bumped on every new line, so the page knows to redraw. */
+    static final String REVISION = "update_log_revision";
+
+    static final int PHASE_IDLE = 0;
+    static final int PHASE_COPY = 1;
+    static final int PHASE_VERIFY = 2;
+    static final int PHASE_INSTALL = 3;
+    static final int PHASE_VALIDATE = 4;
+    static final int PHASE_FINALIZE = 5;
+    static final int PHASE_DONE = 6;
+    static final int PHASE_FAILED = 7;
+    static final int PHASE_DOWNLOAD = 8;
+    static final int PHASE_CHECK = 9;
+
+    private static final String TAG = "UpdaterLog";
+    private static final String FILE = "update.log";
+    private static final int MAX_BYTES = 96 * 1024;
+    private static final int KEEP_LINES = 400;
+
+    private UpdateLog() {}
+
+    private static File file(Context context) {
+        return new File(context.createDeviceProtectedStorageContext().getFilesDir(), FILE);
+    }
+
+    static synchronized void log(Context context, String message) {
+        Log.i(TAG, message);
+        final String line = new SimpleDateFormat("MM-dd HH:mm:ss", Locale.ROOT).format(new Date())
+                + "  " + message.replace('\n', ' ');
+        final File f = file(context);
+        try {
+            if (f.length() > MAX_BYTES) {
+                final List<String> lines = Files.readAllLines(f.toPath(), StandardCharsets.UTF_8);
+                Files.write(f.toPath(), lines.subList(Math.max(0, lines.size() - KEEP_LINES), lines.size()),
+                        StandardCharsets.UTF_8);
+            }
+            try (final FileWriter writer = new FileWriter(f, StandardCharsets.UTF_8, true)) {
+                writer.write(line);
+                writer.write('\n');
+            }
+        } catch (IOException e) {
+            Log.w(TAG, "unable to write the update log", e);
+        }
+        Settings.getPreferences(context).edit().putLong(REVISION, System.nanoTime()).apply();
+    }
+
+    /** Starts a new update's section in the log. */
+    static void begin(Context context, String what) {
+        log(context, "──────── " + what);
+    }
+
+    static synchronized List<String> lines(Context context) {
+        try {
+            return Files.readAllLines(file(context).toPath(), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            return Collections.emptyList();
+        }
+    }
+
+    static List<String> lastLines(Context context, int count) {
+        final List<String> all = lines(context);
+        return new ArrayList<>(all.subList(Math.max(0, all.size() - count), all.size()));
+    }
+
+    static synchronized void clear(Context context) {
+        file(context).delete();
+        Settings.getPreferences(context).edit().putLong(REVISION, System.nanoTime()).apply();
+    }
+
+    /** The current phase; percent < 0 means no percentage (an indeterminate bar). */
+    static void progress(Context context, int phase, int percent, String detail) {
+        final SharedPreferences prefs = Settings.getPreferences(context);
+        if (prefs.getInt(PHASE, PHASE_IDLE) == phase && prefs.getInt(PERCENT, -1) == percent
+                && java.util.Objects.equals(prefs.getString(DETAIL, null), detail)) {
+            return;
+        }
+        prefs.edit().putInt(PHASE, phase).putInt(PERCENT, percent).putString(DETAIL, detail).apply();
+    }
+
+    static void progress(Context context, int phase, int percent) {
+        progress(context, phase, percent, null);
+    }
+
+    static int phase(Context context) {
+        return Settings.getPreferences(context).getInt(PHASE, PHASE_IDLE);
+    }
+
+    static int percent(Context context) {
+        return Settings.getPreferences(context).getInt(PERCENT, -1);
+    }
+
+    static String detail(Context context) {
+        return Settings.getPreferences(context).getString(DETAIL, null);
+    }
+
+    /** update_engine's name for an error code, e.g. "DOWNLOAD_TRANSFER_ERROR (9)". */
+    static String errorName(int code) {
+        return constantName(UpdateEngine.ErrorCodeConstants.class, code);
+    }
+
+    /** update_engine's name for a status, e.g. "FINALIZING". */
+    static String statusName(int status) {
+        return constantName(UpdateEngine.UpdateStatusConstants.class, status);
+    }
+
+    private static String constantName(Class<?> constants, int value) {
+        for (Field field : constants.getFields()) {
+            if (Modifier.isStatic(field.getModifiers()) && field.getType() == int.class) {
+                try {
+                    if (field.getInt(null) == value) return field.getName() + " (" + value + ")";
+                } catch (IllegalAccessException ignored) {
+                }
+            }
+        }
+        return String.valueOf(value);
+    }
+
+    static String size(long bytes) {
+        if (bytes < 1024 * 1024) return (bytes / 1024) + " KB";
+        return String.format(Locale.ROOT, "%.1f MB", bytes / (1024.0 * 1024.0));
+    }
+}
