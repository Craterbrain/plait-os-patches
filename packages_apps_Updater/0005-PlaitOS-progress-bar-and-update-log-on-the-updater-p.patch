+package app.seamlessupdate.client;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.View;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import java.util.List;
+
+/**
+ * PlaitOS: the progress row at the top of the updater page: the phase, a progress bar and the
+ * last few lines of the update log. Tapping it opens the whole log (see Settings).
+ */
+public class UpdateProgressPreference extends Preference {
+    private static final int SHOWN_LINES = 6;
+
+    public UpdateProgressPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.update_progress_preference);
+    }
+
+    /** Redraws the row (phase, percentage or log changed). */
+    void refresh() {
+        notifyChanged();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        final Context context = getContext();
+        final int phase = UpdateLog.phase(context);
+        final int percent = UpdateLog.percent(context);
+        final String detail = UpdateLog.detail(context);
+
+        final TextView title = (TextView) holder.findViewById(R.id.update_progress_title);
+        final TextView status = (TextView) holder.findViewById(R.id.update_progress_status);
+        final ProgressBar bar = (ProgressBar) holder.findViewById(R.id.update_progress_bar);
+        final TextView log = (TextView) holder.findViewById(R.id.update_progress_log);
+
+        title.setText(phaseTitle(phase));
+        final boolean running = phase != UpdateLog.PHASE_IDLE && phase != UpdateLog.PHASE_DONE
+                && phase != UpdateLog.PHASE_FAILED;
+        bar.setVisibility(running || phase == UpdateLog.PHASE_DONE ? View.VISIBLE : View.GONE);
+        if (phase == UpdateLog.PHASE_DONE) {
+            bar.setIndeterminate(false);
+            bar.setProgress(100);
+        } else if (percent < 0) {
+            bar.setIndeterminate(true);
+        } else {
+            bar.setIndeterminate(false);
+            bar.setProgress(percent);
+        }
+
+        final StringBuilder statusText = new StringBuilder();
+        if (running && percent >= 0) statusText.append(percent).append('%');
+        if (detail != null && !detail.isEmpty()) {
+            if (statusText.length() > 0) statusText.append(" · ");
+            statusText.append(detail);
+        }
+        status.setText(statusText);
+        status.setVisibility(statusText.length() > 0 ? View.VISIBLE : View.GONE);
+
+        final List<String> lines = UpdateLog.lastLines(context, SHOWN_LINES);
+        log.setText(lines.isEmpty() ? context.getString(R.string.update_log_empty)
+                : String.join("\n", lines));
+    }
+
+    private int phaseTitle(int phase) {
+        return switch (phase) {
+            case UpdateLog.PHASE_CHECK -> R.string.notification_check_title;
+            case UpdateLog.PHASE_DOWNLOAD -> R.string.notification_download_title;
+            case UpdateLog.PHASE_COPY -> R.string.update_progress_copy;
+            case UpdateLog.PHASE_VERIFY -> R.string.notification_verify_title;
+            case UpdateLog.PHASE_INSTALL -> R.string.notification_install_title;
+            case UpdateLog.PHASE_VALIDATE -> R.string.notification_validate_title;
+            case UpdateLog.PHASE_FINALIZE -> R.string.notification_finalize_title;
+            case UpdateLog.PHASE_DONE -> R.string.notification_reboot_title;
+            case UpdateLog.PHASE_FAILED -> R.string.update_progress_failed;
+            default -> R.string.update_progress_idle;
+        };
+    }
+}
