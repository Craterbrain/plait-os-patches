+    /** Installs an update zip the user picked: copies it to where the downloader keeps its file, then verifies and applies it. */
+    private void installLocalFile(final Uri uri) throws IOException, GeneralSecurityException {
+        Files.deleteIfExists(UPDATE_PATH.toPath());
+        long size = -1;
+        try (final var descriptor = getContentResolver().openFileDescriptor(uri, "r")) {
+            if (descriptor != null) {
+                size = descriptor.getStatSize();
+            }
+        }
+        if (size > 0) {
+            try {
+                StorageManager sm = getSystemService(StorageManager.class);
+                sm.allocateBytes(sm.getUuidForPath(UPDATE_PATH), size, StorageManager.FLAG_ALLOCATE_AGGRESSIVE);
+            } catch (IOException e) {
+                Log.d(TAG, "unable to allocate " + size + " bytes, proceeding anyway", e);
+            }
+        }
+        // A different file than the server flow's, so its resume logic starts fresh next time
+        Settings.getPreferences(this).edit().remove(PREFERENCE_DOWNLOAD_FILE).commit();
+
+        notificationHandler.showDownloadNotification(0, Math.max(size, 1));
+        try (final InputStream input = getContentResolver().openInputStream(uri);
+                final OutputStream output = new FileOutputStream(UPDATE_PATH)) {
+            if (input == null) {
+                throw new IOException("unable to open the update file");
+            }
+            long copied = 0;
+            long last = System.nanoTime();
+            final byte[] buffer = new byte[16384];
+            int bytesRead;
+            while ((bytesRead = input.read(buffer)) != -1) {
+                output.write(buffer, 0, bytesRead);
+                copied += bytesRead;
+                final long now = System.nanoTime();
+                if (now - last > 1000 * 1000 * 1000) {
+                    notificationHandler.showDownloadNotification(copied, Math.max(size, copied));
+                    last = now;
+                }
+            }
+        } catch (final IOException e) {
+            UPDATE_PATH.delete();
+            throw e;
+        }
+        Log.d(TAG, "update file copied");
+        onDownloadFinished(false, LOCAL_FILE, null);
+    }
+
     private void annoyUser() {
         PeriodicJob.cancel(this);
         final SharedPreferences preferences = Settings.getPreferences(this);
@@ -285,6 +343,11 @@ public class Service extends IntentService {
