diff --git a/src/com/android/calculator2/Calculator.java b/src/com/android/calculator2/Calculator.java
index 81ab1f6..a121b17 100644
--- a/src/com/android/calculator2/Calculator.java
+++ b/src/com/android/calculator2/Calculator.java
@@ -826,7 +826,15 @@ public class Calculator extends Activity
         // See onKey above for the rationale behind some of the behavior below:
         cancelUnrequested();
 
-        final int id = view.getId();
+        int id = view.getId();
+        // PlaitOS: the extra pad keys stand for existing ones
+        if (id == R.id.plait_pct) {
+            id = R.id.op_pct;
+        } else if (id == R.id.plait_paren) {
+            id = smartParen();
+        } else if (id == R.id.plait_ac) {
+            id = R.id.clr;
+        }
         switch (id) {
             case R.id.eq:
                 onEquals();
@@ -880,6 +888,30 @@ public class Calculator extends Activity
         showOrHideToolbar();
     }
 
+    /**
+     * PlaitOS: the "( )" key. Closes a bracket when one is open and the formula ends in something
+     * a bracket can close (a number, a constant, a closing bracket or a postfix operator);
+     * opens one otherwise.
+     */
+    private int smartParen() {
+        final String formula = mEvaluator.getExpr(Evaluator.MAIN_INDEX)
+                .toSpannableStringBuilder(this).toString().trim();
+        int open = 0;
+        for (int i = 0; i < formula.length(); i++) {
+            final char c = formula.charAt(i);
+            if (c == '(') open++;
+            else if (c == ')') open--;
+        }
+        if (open <= 0 || formula.isEmpty() || mCurrentState == CalculatorState.RESULT) {
+            return R.id.lparen;
+        }
+        final char last = formula.charAt(formula.length() - 1);
+        final boolean closable = Character.isDigit(last) || Character.isLetter(last)
+                || last == ')' || last == '!' || last == '%' || last == '\u00B2' /* ² */
+                || last == '\u03C0' /* π */ || last == '.';
+        return closable ? R.id.rparen : R.id.lparen;
+    }
+
     void redisplayFormula() {
         SpannableStringBuilder formula
                 = mEvaluator.getExpr(Evaluator.MAIN_INDEX).toSpannableStringBuilder(this);
