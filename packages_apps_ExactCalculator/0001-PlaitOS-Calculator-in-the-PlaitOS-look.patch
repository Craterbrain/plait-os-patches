new file mode 100644
index 0000000..9d7b0b0
--- /dev/null
+++ b/res/values-night/color.xml
@@ -0,0 +1,60 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2014 The Android Open Source Project
+
