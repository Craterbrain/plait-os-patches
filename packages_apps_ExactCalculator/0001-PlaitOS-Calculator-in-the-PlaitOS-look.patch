+  limitations under the License.
+  -->
+
+<!-- PlaitOS: the PlaitOS look (dark). Every color comes from the wallpaper's Material You palettes
+     (system_accent1 = primary, accent2 = secondary, neutral1/2 = surfaces), like the other PlaitOS apps;
+     the light twin is in values/color.xml. -->
+<resources>
+
+    <!-- Accent: history labels, cursor and selection. -->
+    <color name="calculator_accent_color">@android:color/system_accent1_200</color>
+
+    <!-- Fills the display when it is cleared (primary container). -->
+    <color name="calculator_primary_color">@android:color/system_accent1_700</color>
+
+    <!-- Status bar: the same surface as the display. -->
+    <color name="calculator_statusbar_color">@android:color/system_neutral1_900</color>
+
+    <!-- Error (Material 3 error). -->
+    <color name="calculator_error_color">#F2B8B5</color>
+
+    <!-- Display (surface). -->
+    <color name="display_background_color">@android:color/system_neutral1_900</color>
+    <color name="display_formula_text_color">@android:color/system_neutral1_100</color>
+    <color name="display_result_text_color">@android:color/system_neutral2_200</color>
+    <color name="display_result_exponent_text_color">@android:color/system_neutral2_500</color>
+
+    <!-- Numbers: a tonal surface one step from the display. -->
+    <color name="pad_numeric_background_color">@android:color/system_neutral2_800</color>
+    <color name="pad_button_text_color">@android:color/system_neutral1_100</color>
+
+    <!-- Operators: secondary container. -->
+    <color name="pad_operator_background_color">@android:color/system_accent2_700</color>
+    <color name="pad_operator_text_color">@android:color/system_accent2_100</color>
+
+    <!-- Functions (the pad that slides in): primary container, the one accent. -->
+    <color name="pad_advanced_background_color">@android:color/system_accent1_700</color>
+    <color name="pad_button_advanced_text_color">@android:color/system_accent1_100</color>
+
+    <!-- Ripples. -->
+    <color name="pad_button_ripple_color">#33FFFFFF</color>
+    <color name="pad_button_advanced_ripple_color">#33FFFFFF</color>
+
+    <!-- Empty history. -->
+    <color name="empty_history_color">@android:color/system_neutral1_800</color>
+
+</resources>
