+    <!-- PlaitOS: memory in the brackets' cells where the operator pad has the "( )" key (these
+         pads are shared with sizes whose operator pad has none); styles pick which pair shows.
+         Long press: M+ subtracts (M-), MR clears the memory (MC). -->
+    <Button
+        android:id="@+id/plait_mr"
+        style="@style/PadButtonStyle.Advanced.Memory"
+        android:contentDescription="@string/desc_plait_mr"
+        android:text="@string/plait_mr"
+        app:layout_row="3"
+        app:layout_column="0" />
+
+    <Button
+        android:id="@+id/plait_mplus"
+        style="@style/PadButtonStyle.Advanced.Memory"
+        android:contentDescription="@string/desc_plait_mplus"
+        android:text="@string/plait_mplus"
