+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * PlaitOS: the favorites row at the top of the Home tab. It only reads the starred contacts through the same loader the
+ * Favorites tab used and places a call on tap; editing favorites stays in Contacts.
+ */
+public class FavoritesStripFragment extends Fragment {
+
+  private SupportUiListener<ImmutableList<SpeedDialUiItem>> loaderListener;
+  private final StripAdapter adapter = new StripAdapter();
+  private View root;
+
+  @Nullable
+  @Override
+  public View onCreateView(
+      LayoutInflater inflater, @Nullable ViewGroup container, @Nullable Bundle savedInstanceState) {
+    root = inflater.inflate(R.layout.plait_favorites_strip, container, false);
+    RecyclerView list = root.findViewById(R.id.plait_favorites_list);
+    list.setLayoutManager(new LinearLayoutManager(getContext(), LinearLayoutManager.HORIZONTAL, false));
+    list.setAdapter(adapter);
+    loaderListener =
+        DialerExecutorComponent.get(getContext())
+            .createUiListener(getChildFragmentManager(), "plait_favorites_strip_loader");
+    root.setVisibility(View.GONE);
+    return root;
+  }
+
+  @Override
+  public void onResume() {
+    super.onResume();
+    load();
+  }
+
+  private void load() {
+    if (getContext() == null) {
+      return;
+    }
+    if (!PermissionsUtil.hasContactsReadPermissions(getContext())) {
+      root.setVisibility(View.GONE);
+      return;
+    }
+    loaderListener.listen(
+        getContext(),
+        UiItemLoaderComponent.get(getContext()).speedDialUiItemMutator().loadSpeedDialUiItems(),
+        this::onLoaded,
+        // A favorites row that fails to load must never take the phone app down
+        throwable -> LogUtil.e("FavoritesStripFragment.load", "failed", throwable));
+  }
+
+  private void onLoaded(ImmutableList<SpeedDialUiItem> items) {
+    List<SpeedDialUiItem> starred = new ArrayList<>();
+    for (SpeedDialUiItem item : items) {
+      if (item.isStarred()) {
+        starred.add(item);
+      }
+    }
+    adapter.items = starred;
+    adapter.notifyDataSetChanged();
+    root.setVisibility(starred.isEmpty() ? View.GONE : View.VISIBLE);
+  }
+
+  private void call(SpeedDialUiItem item) {
+    Channel channel = item.defaultChannel();
+    if (channel == null) {
+      channel = item.getDefaultVoiceChannel();
+    }
+    if (channel == null || getActivity() == null) {
+      return;
+    }
+    PreCall.start(
+        getActivity(),
+        new CallIntentBuilder(channel.number(), CallInitiationType.Type.SPEED_DIAL)
+            .setAllowAssistedDial(true)
+            .setIsVideoCall(channel.isVideoTechnology())
+            .setIsDuoCall(channel.technology() == Channel.DUO));
+  }
+
+  private final class StripAdapter extends RecyclerView.Adapter<ChipHolder> {
+    List<SpeedDialUiItem> items = new ArrayList<>();
+
+    @Override
+    public ChipHolder onCreateViewHolder(ViewGroup parent, int viewType) {
+      return new ChipHolder(
+          LayoutInflater.from(parent.getContext()).inflate(R.layout.plait_favorite_chip, parent, false));
+    }
+
+    @Override
+    public void onBindViewHolder(ChipHolder holder, int position) {
+      SpeedDialUiItem item = items.get(position);
+      holder.name.setText(item.name());
+      holder.itemView.setOnClickListener(v -> call(item));
+      GlidePhotoManagerComponent.get(holder.itemView.getContext())
+          .glidePhotoManager()
+          .loadQuickContactBadge(
+              holder.photo,
+              PhotoInfo.newBuilder()
+                  .setPhotoId(item.photoId())
+                  .setPhotoUri(item.photoUri())
+                  .setName(item.name())
+                  .setLookupUri(Contacts.getLookupUri(item.contactId(), item.lookupKey()).toString())
+                  .build());
+    }
+
+    @Override
+    public int getItemCount() {
+      return items.size();
+    }
+  }
+
+  private static final class ChipHolder extends RecyclerView.ViewHolder {
+    final QuickContactBadge photo;
+    final TextView name;
+
+    ChipHolder(View view) {
+      super(view);
+      photo = view.findViewById(R.id.plait_favorite_photo);
+      name = view.findViewById(R.id.plait_favorite_name);
+      photo.setClickable(false);
+    }
+  }
+}
