+ * limitations under the License
+ */
+
+package com.android.dialer.main.impl;
+
+import android.content.ContentResolver;
+import android.content.ContentUris;
+import android.content.Intent;
+import android.database.Cursor;
+import android.media.MediaPlayer;
+import android.net.Uri;
+import android.os.Bundle;
+import android.provider.ContactsContract.PhoneLookup;
+import android.provider.MediaStore;
+import android.support.annotation.Nullable;
+import android.support.v4.app.Fragment;
+import android.support.v7.widget.LinearLayoutManager;
+import android.support.v7.widget.RecyclerView;
+import android.text.format.DateUtils;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.PopupMenu;
+import android.widget.TextView;
+import com.android.dialer.common.LogUtil;
+import com.android.dialer.util.PermissionsUtil;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * PlaitOS: the Recordings tab. The call recorder saves each recording through MediaStore under
+ * Recordings/CallRecordings; an app can always read the files it created itself, so this needs no extra permission.
+ * One row per recording with its caller, when and how long; tap plays or pauses, the overflow shares or deletes.
+ */
+public class RecordingsFragment extends Fragment {
+
+  private static final String RECORDINGS_PATH = "Recordings/CallRecordings/";
+
+  private static final class Recording {
+    long id;
+    String number;
+    String name;
+    long when;
+    long durationMs;
+    Uri uri;
+  }
+
+  private final ExecutorService io = Executors.newSingleThreadExecutor();
+  private final RecordingsAdapter adapter = new RecordingsAdapter();
+  private View empty;
+  private MediaPlayer player;
+  private long playingId = -1;
+
+  @Nullable
+  @Override
+  public View onCreateView(
+      LayoutInflater inflater, @Nullable ViewGroup container, @Nullable Bundle savedInstanceState) {
+    View root = inflater.inflate(R.layout.plait_recordings_fragment, container, false);
+    RecyclerView list = root.findViewById(R.id.plait_recordings_list);
+    list.setLayoutManager(new LinearLayoutManager(getContext()));
+    list.setAdapter(adapter);
+    empty = root.findViewById(R.id.plait_recordings_empty);
+    return root;
+  }
+
+  @Override
+  public void onResume() {
+    super.onResume();
+    load();
+  }
+
+  @Override
+  public void onPause() {
+    super.onPause();
+    stopPlayback();
+  }
+
+  @Override
+  public void onDestroy() {
+    super.onDestroy();
+    io.shutdownNow();
+  }
+
+  private void load() {
+    if (getContext() == null) {
+      return;
+    }
+    final android.content.Context context = getContext().getApplicationContext();
+    final boolean contacts = PermissionsUtil.hasContactsReadPermissions(context);
+    io.execute(
+        () -> {
+          List<Recording> found = new ArrayList<>();
+          try (Cursor c =
+              context
+                  .getContentResolver()
+                  .query(
+                      MediaStore.Audio.Media.EXTERNAL_CONTENT_URI,
+                      new String[] {
+                        MediaStore.Audio.Media._ID,
+                        MediaStore.Audio.Media.DISPLAY_NAME,
+                        MediaStore.Audio.Media.DATE_TAKEN,
+                        MediaStore.Audio.Media.DATE_ADDED,
+                        MediaStore.Audio.Media.DURATION
+                      },
+                      MediaStore.Audio.Media.RELATIVE_PATH + " LIKE ?",
+                      new String[] {RECORDINGS_PATH + "%"},
+                      MediaStore.Audio.Media.DATE_TAKEN + " DESC")) {
+            while (c != null && c.moveToNext()) {
+              Recording r = new Recording();
+              r.id = c.getLong(0);
+              r.uri = ContentUris.withAppendedId(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, r.id);
+              r.number = numberFromFilename(c.getString(1));
+              long taken = c.getLong(2);
+              r.when = taken > 0 ? taken : c.getLong(3) * 1000;
+              r.durationMs = c.getLong(4);
+              r.name = contacts ? contactName(context.getContentResolver(), r.number) : null;
+              found.add(r);
+            }
+          } catch (RuntimeException e) {
+            // A listing that fails must leave an empty tab, not take the phone app down
+            LogUtil.e("RecordingsFragment.load", "query failed", e);
+          }
+          if (getActivity() != null) {
+            getActivity()
+                .runOnUiThread(
+                    () -> {
+                      adapter.items = found;
+                      adapter.notifyDataSetChanged();
+                      empty.setVisibility(found.isEmpty() ? View.VISIBLE : View.GONE);
+                    });
+          }
+        });
+  }
+
+  /** CallRecord_yyyyMMdd-HHmmss_number.ext -> number (or null). */
+  @Nullable
+  private static String numberFromFilename(@Nullable String displayName) {
+    if (displayName == null) {
+      return null;
+    }
+    String[] parts = displayName.split("_", 3);
+    if (parts.length < 3) {
+      return null;
+    }
+    String number = parts[2];
+    int dot = number.lastIndexOf('.');
+    if (dot > 0) {
+      number = number.substring(0, dot);
+    }
+    return number.equals("unknown") ? null : number;
+  }
+
+  @Nullable
+  private static String contactName(ContentResolver resolver, @Nullable String number) {
+    if (number == null) {
+      return null;
+    }
+    try (Cursor c =
+        resolver.query(
+            Uri.withAppendedPath(PhoneLookup.CONTENT_FILTER_URI, Uri.encode(number)),
+            new String[] {PhoneLookup.DISPLAY_NAME},
+            null,
+            null,
+            null)) {
+      return c != null && c.moveToFirst() ? c.getString(0) : null;
+    } catch (RuntimeException e) {
+      return null;
+    }
+  }
+
+  private void togglePlayback(Recording r) {
+    if (playingId == r.id) {
+      stopPlayback();
+      return;
+    }
+    stopPlayback();
+    try {
+      MediaPlayer p = new MediaPlayer();
+      p.setDataSource(getContext(), r.uri);
+      p.setOnCompletionListener(mp -> stopPlayback());
+      p.prepare();
+      p.start();
+      player = p;
+      playingId = r.id;
+    } catch (java.io.IOException | RuntimeException e) {
+      LogUtil.e("RecordingsFragment.togglePlayback", "cannot play", e);
+      stopPlayback();
+    }
+    adapter.notifyDataSetChanged();
+  }
+
+  private void stopPlayback() {
+    if (player != null) {
+      try {
+        player.release();
+      } catch (RuntimeException ignored) {
+      }
+      player = null;
+    }
+    playingId = -1;
+    adapter.notifyDataSetChanged();
+  }
+
+  private void share(Recording r) {
+    Intent send = new Intent(Intent.ACTION_SEND);
+    send.setType("audio/*");
+    send.putExtra(Intent.EXTRA_STREAM, r.uri);
+    send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+    startActivity(Intent.createChooser(send, null));
+  }
+
+  private void delete(Recording r) {
+    if (playingId == r.id) {
+      stopPlayback();
+    }
+    final android.content.Context context = getContext().getApplicationContext();
+    io.execute(
+        () -> {
+          try {
+            context.getContentResolver().delete(r.uri, null, null);
+          } catch (RuntimeException e) {
+            LogUtil.e("RecordingsFragment.delete", "failed", e);
+          }
+          load();
+        });
+  }
+
+  private final class RecordingsAdapter extends RecyclerView.Adapter<RowHolder> {
+    List<Recording> items = new ArrayList<>();
+
+    @Override
+    public RowHolder onCreateViewHolder(ViewGroup parent, int viewType) {
+      return new RowHolder(
+          LayoutInflater.from(parent.getContext()).inflate(R.layout.plait_recording_row, parent, false));
+    }
+
+    @Override
+    public void onBindViewHolder(RowHolder h, int position) {
+      Recording r = items.get(position);
+      boolean playing = playingId == r.id;
+      h.title.setText(
+          r.name != null
+              ? r.name
+              : r.number != null ? r.number : h.itemView.getContext().getString(R.string.plait_recording_unknown_number));
+      long seconds = Math.max(0, r.durationMs / 1000);
+      h.subtitle.setText(
+          DateUtils.getRelativeTimeSpanString(
+                  r.when, System.currentTimeMillis(), DateUtils.MINUTE_IN_MILLIS, DateUtils.FORMAT_ABBREV_RELATIVE)
+              + " · "
+              + (seconds / 60)
+              + ":"
+              + String.format("%02d", seconds % 60));
+      h.play.setImageResource(
+          playing ? R.drawable.plait_ic_pause : R.drawable.plait_ic_play);
+      h.itemView.setOnClickListener(v -> togglePlayback(r));
+      h.more.setOnClickListener(
+          v -> {
+            PopupMenu menu = new PopupMenu(v.getContext(), v);
+            menu.getMenu().add(0, 1, 0, R.string.plait_recording_share);
+            menu.getMenu().add(0, 2, 1, R.string.plait_recording_delete);
+            menu.setOnMenuItemClickListener(
+                item -> {
+                  if (item.getItemId() == 1) {
+                    share(r);
+                  } else {
+                    delete(r);
+                  }
+                  return true;
+                });
+            menu.show();
+          });
+    }
+
+    @Override
+    public int getItemCount() {
+      return items.size();
+    }
+  }
+
+  private static final class RowHolder extends RecyclerView.ViewHolder {
+    final ImageView play;
+    final TextView title;
+    final TextView subtitle;
+    final View more;
+
+    RowHolder(View view) {
+      super(view);
+      play = view.findViewById(R.id.plait_recording_play);
+      title = view.findViewById(R.id.plait_recording_title);
+      subtitle = view.findViewById(R.id.plait_recording_subtitle);
+      more = view.findViewById(R.id.plait_recording_more);
+    }
+  }
+}
