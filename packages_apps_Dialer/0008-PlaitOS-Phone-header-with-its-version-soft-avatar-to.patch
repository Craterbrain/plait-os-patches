diff --git a/java/com/android/dialer/main/impl/toolbar/MainToolbar.java b/java/com/android/dialer/main/impl/toolbar/MainToolbar.java
index 475383b..1d7ac19 100644
--- a/java/com/android/dialer/main/impl/toolbar/MainToolbar.java
+++ b/java/com/android/dialer/main/impl/toolbar/MainToolbar.java
@@ -59,6 +59,27 @@ public final class MainToolbar extends Toolbar implements PopupMenu.OnMenuItemCl
     optionsMenuButton.setOnTouchListener(overflowMenu.getDragToOpenListener());
 
     searchBar = findViewById(R.id.search_view_container);
+    android.widget.TextView title = findViewById(R.id.plait_app_title);
+    if (title != null) title.setText(appTitle(getContext(), title.getCurrentTextColor()));
+  }
+
+  /** PlaitOS: the app's name with its installed version after it, smaller and muted, as on every Plait app's root. */
+  private static CharSequence appTitle(Context context, int textColor) {
+    CharSequence name = context.getApplicationInfo().loadLabel(context.getPackageManager());
+    String version = null;
+    try {
+      version = context.getPackageManager().getPackageInfo(context.getPackageName(), 0).versionName;
+    } catch (android.content.pm.PackageManager.NameNotFoundException e) {
+      // Our own package always exists; leave the version out if not
+    }
+    if (version == null || version.isEmpty()) return name;
+    String text = name + "  " + version;
+    android.text.SpannableString s = new android.text.SpannableString(text);
+    int start = name.length() + 2;
+    s.setSpan(new android.text.style.RelativeSizeSpan(0.5f), start, text.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+    s.setSpan(new android.text.style.ForegroundColorSpan((textColor & 0x00ffffff) | 0xb0000000),
+        start, text.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+    return s;
   }
 
   @Override
