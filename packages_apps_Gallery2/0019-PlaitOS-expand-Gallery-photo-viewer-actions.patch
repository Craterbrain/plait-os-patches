+    private void chooseAlbum(Media item) {
+        LinkedHashMap<String, Media> albums = new LinkedHashMap<>();
+        for (Media candidate : media) {
+            if (candidate.video || candidate.folder.isEmpty()) continue;
+            String volume = MediaStore.getVolumeName(candidate.uri);
+            if (candidate.folder.equals(item.folder)
+                    && volume.equals(MediaStore.getVolumeName(item.uri))) continue;
+            albums.putIfAbsent(volume + "/" + candidate.folder, candidate);
+        }
+        List<Media> destinations = new ArrayList<>(albums.values());
+        String[] names = destinations.stream().map(album -> album.folder)
+                .toArray(String[]::new);
+        AlertDialog.Builder picker = new AlertDialog.Builder(this)
+                .setTitle(R.string.plait_gallery_add_to_album)
+                .setPositiveButton(R.string.plait_gallery_new_album, (dialog, which) -> newAlbum(item))
+                .setNegativeButton(android.R.string.cancel, null);
+        if (names.length > 0) picker.setItems(names, (dialog, which) -> {
+            Media album = destinations.get(which);
+            copyToAlbum(item, MediaStore.getVolumeName(album.uri), album.folder, album.uri);
+        });
+        picker.show();
+    }
+
+    private void newAlbum(Media item) {
+        EditText input = new EditText(this);
+        input.setSingleLine(true);
+        input.setHint(R.string.plait_gallery_album_name);
+        LinearLayout field = column();
+        field.setPadding(dp(24), 0, dp(24), 0);
+        field.addView(input);
+        AlertDialog dialog = new AlertDialog.Builder(this).setTitle(R.string.plait_gallery_new_album)
+                .setView(field).setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(android.R.string.ok, null).create();
+        dialog.setOnShowListener(ignored -> dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                .setOnClickListener(view -> {
+                    String name = input.getText().toString().trim();
+                    if (name.isEmpty() || name.startsWith(".") || name.contains("/")
+                            || name.contains("\\") || name.codePoints().anyMatch(Character::isISOControl)) {
+                        input.setError(getString(R.string.plait_gallery_invalid_album));
+                        return;
+                    }
+                    dialog.dismiss();
+                    copyToAlbum(item, MediaStore.VOLUME_EXTERNAL_PRIMARY,
+                            "Pictures/" + name + "/", null);
+                }));
+        dialog.show();
+    }
+
+    private InputStream openPhotoData(Uri uri) throws IOException {
+        if (checkSelfPermission(android.Manifest.permission.ACCESS_MEDIA_LOCATION)
+                == PackageManager.PERMISSION_GRANTED) {
+            try {
+                InputStream original = getContentResolver().openInputStream(
+                        MediaStore.setRequireOriginal(uri));
+                if (original != null) return original;
+            } catch (IOException | IllegalArgumentException | SecurityException unavailable) {
+                // The provider can still expose metadata and image data with location redacted.
+            }
+        }
+        InputStream input = getContentResolver().openInputStream(uri);
+        if (input == null) throw new IOException("Photo unavailable");
+        return input;
+    }
+
+    private void copyToAlbum(Media item, String volume, String folder, Uri related) {
+        mediaLoader.execute(() -> {
+            Uri copy = null;
+            boolean saved = false;
+            try (InputStream source = openPhotoData(item.uri)) {
+                ContentValues metadata = new ContentValues();
+                metadata.put(MediaStore.MediaColumns.DISPLAY_NAME, item.name);
+                metadata.put(MediaStore.MediaColumns.MIME_TYPE, item.mime);
+                metadata.put(MediaStore.MediaColumns.RELATIVE_PATH, folder);
+                metadata.put(MediaStore.MediaColumns.IS_PENDING, 1);
+                if (item.date > 0) metadata.put(MediaStore.MediaColumns.DATE_TAKEN, item.date);
+                Bundle placement = new Bundle();
+                if (related != null) placement.putParcelable(MediaStore.QUERY_ARG_RELATED_URI, related);
+                copy = getContentResolver().insert(MediaStore.Images.Media.getContentUri(volume),
+                        metadata, placement);
+                if (copy == null) throw new IOException("Could not create album copy");
+                try (OutputStream output = getContentResolver().openOutputStream(copy)) {
+                    if (output == null) throw new IOException("Could not write album copy");
+                    source.transferTo(output);
+                }
+                ContentValues ready = new ContentValues();
+                ready.put(MediaStore.MediaColumns.IS_PENDING, 0);
+                saved = getContentResolver().update(copy, ready, null, null) > 0;
+            } catch (IOException | RuntimeException failure) {
+                android.util.Log.w("PlaitGallery", "Could not copy photo to album", failure);
+            } finally {
+                if (copy != null && !saved) {
+                    try {
+                        getContentResolver().delete(copy, null, null);
+                    } catch (RuntimeException failure) {
+                        android.util.Log.w("PlaitGallery", "Could not remove pending album copy", failure);
+                    }
+                }
+            }
+            boolean success = saved;
+            runOnUiThread(() -> {
+                if (isDestroyed()) return;
+                Toast.makeText(this, success ? R.string.plait_gallery_album_added
+                        : R.string.plait_gallery_album_failed, Toast.LENGTH_SHORT).show();
+                if (success) refresh();
+            });
+        });
+    }
+
