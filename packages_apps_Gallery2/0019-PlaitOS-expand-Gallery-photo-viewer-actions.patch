+                    fields.forEach((key, value) -> data.append(key).append(": ").append(value).append('\n'));
+                }
+            } catch (IOException | IllegalAccessException | RuntimeException unavailable) {
+                // MediaStore details remain available for images without readable EXIF.
+            }
+            runOnUiThread(() -> {
+                if (isDestroyed() || selected == null || !selected.uri.equals(item.uri)) return;
+                new AlertDialog.Builder(this).setTitle(item.name).setMessage(data.toString().trim())
+                        .setPositiveButton(android.R.string.ok, null).show();
+            });
+        });
+    }
