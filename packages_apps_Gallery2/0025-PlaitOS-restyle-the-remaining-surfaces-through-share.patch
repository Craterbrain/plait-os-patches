--- /dev/null
+++ b/src/com/android/gallery3d/util/PlaitSheet.java
@@ -0,0 +1,255 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.gallery3d.util;
+
+import android.app.Dialog;
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Typeface;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.RippleDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.Switch;
+import android.widget.TextView;
+
+import com.android.gallery3d.R;
+
+import java.util.function.Consumer;
+
+/**
+ * PlaitOS: the design guide's PlaitSheet for views (the Gallery has no Compose or Material
+ * components): pickers, details and quick settings slide up from the bottom on the raised surface
+ * with 28 dp top corners and a handle, an optional title, and rows from the guide (ListRow with a
+ * tonal tile, SwitchRow, a label over a value). Confirmations stay AlertDialogs.
+ */
+public final class PlaitSheet {
+    private final Context mContext;
+    private final Dialog mDialog;
+    private final LinearLayout mContent;
+
+    public PlaitSheet(Context context, CharSequence title) {
+        mContext = context;
+        mDialog = new Dialog(context);
+        mDialog.requestWindowFeature(Window.FEATURE_NO_TITLE);
+
+        LinearLayout sheet = new LinearLayout(context);
+        sheet.setOrientation(LinearLayout.VERTICAL);
+        GradientDrawable surface = new GradientDrawable();
+        float r = dp(28);
+        surface.setCornerRadii(new float[] {r, r, r, r, 0, 0, 0, 0});
+        surface.setColor(context.getColor(R.color.plait_sheet));
+        sheet.setBackground(surface);
+        sheet.setPadding(dp(16), dp(10), dp(16), dp(24));
+
+        View handle = new View(context);
+        GradientDrawable pill = new GradientDrawable();
+        pill.setCornerRadius(dp(2));
+        pill.setColor(context.getColor(R.color.plait_bar_icon));
+        handle.setBackground(pill);
+        handle.setAlpha(0.4f);
+        LinearLayout.LayoutParams handleParams = new LinearLayout.LayoutParams(dp(32), dp(4));
+        handleParams.gravity = Gravity.CENTER_HORIZONTAL;
+        handleParams.bottomMargin = dp(14);
+        sheet.addView(handle, handleParams);
+
+        if (title != null) {
+            TextView heading = text(title, 22, R.color.plait_editor_label);
+            heading.setTypeface(Typeface.create(Typeface.DEFAULT, 600, false));
+            heading.setPadding(dp(4), 0, dp(4), dp(8));
+            sheet.addView(heading);
+        }
+
+        mContent = new LinearLayout(context);
+        mContent.setOrientation(LinearLayout.VERTICAL);
+        ScrollView scroll = new ScrollView(context);
+        scroll.addView(mContent);
+        sheet.addView(scroll, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        // Short sheets open fully; a long one stops at 85 % of the screen and scrolls
+        FrameLayout limiter = new FrameLayout(context) {
+            @Override protected void onMeasure(int widthSpec, int heightSpec) {
+                int max = (int) (getResources().getDisplayMetrics().heightPixels * 0.85f);
+                super.onMeasure(widthSpec, MeasureSpec.makeMeasureSpec(
+                        Math.min(max, MeasureSpec.getSize(heightSpec)), MeasureSpec.AT_MOST));
+            }
+        };
+        limiter.addView(sheet);
+        mDialog.setContentView(limiter);
