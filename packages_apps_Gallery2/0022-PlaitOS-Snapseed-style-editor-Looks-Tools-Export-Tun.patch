new file mode 100644
index 0000000..5e5f598
--- /dev/null
+++ b/src/com/android/gallery3d/filtershow/category/PlaitToolTiles.java
@@ -0,0 +1,152 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.gallery3d.filtershow.category;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.text.TextUtils;
+
+import com.android.gallery3d.R;
+import com.android.gallery3d.filtershow.filters.FilterRepresentation;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * PlaitOS: how the editor's tool rows look. Tools (Adjust, Crop, Markup) are tonal tiles with a
+ * Material Symbol and the name under them, like the Plait apps and Google Photos' tool row; the
+ * chosen one is on the primary container. Filters and borders keep their photo previews, with
+ * rounded corners and an accent ring for the chosen one.
+ */
+public final class PlaitToolTiles {
+    private static final Map<String, Integer> ICONS = new HashMap<>();
+    static {
+        ICONS.put("WBALANCE", R.drawable.plait_tool_auto_awesome);
+        ICONS.put("EXPOSURE", R.drawable.plait_tool_exposure);
+        ICONS.put("CONTRAST", R.drawable.plait_tool_contrast);
+        ICONS.put("SHADOWS", R.drawable.plait_tool_shadow);
+        ICONS.put("HIGHLIGHTS", R.drawable.plait_tool_highlight);
+        ICONS.put("VIBRANCE", R.drawable.plait_tool_palette);
+        ICONS.put("CURVES", R.drawable.plait_tool_show_chart);
+        ICONS.put("HUE", R.drawable.plait_tool_colorize);
+        ICONS.put("BWFILTER", R.drawable.plait_tool_filter_b_and_w);
+        ICONS.put("NEGATIVE", R.drawable.plait_tool_invert_colors);
+        ICONS.put("EDGE", R.drawable.plait_tool_blur_on);
+        ICONS.put("KMEANS", R.drawable.plait_tool_gradient);
+        ICONS.put("TINYPLANET", R.drawable.plait_tool_public);
+        ICONS.put("CROP", R.drawable.plait_tool_crop);
+        ICONS.put("STRAIGHTEN", R.drawable.plait_tool_straighten);
+        ICONS.put("ROTATION", R.drawable.plait_tool_rotate_90_degrees_cw);
+        ICONS.put("MIRROR", R.drawable.plait_tool_flip);
+        ICONS.put("DRAW", R.drawable.plait_tool_draw);
+    }
+
+    private PlaitToolTiles() {}
+
+    /** The tile icon for a tool, or 0 for rows that keep their photo preview. */
+    public static int iconFor(Action action) {
+        if (action == null || action.getRepresentation() == null) return 0;
+        FilterRepresentation rep = action.getRepresentation();
+        String name = rep.getSerializationName();
+        Integer icon = name == null ? null : ICONS.get(name.toUpperCase());
+        return icon == null ? 0 : icon;
+    }
+
+    /** A tool: a rounded tile with its symbol, the name underneath. */
+    static void drawTool(Canvas canvas, Context context, int width, int height, int icon,
+            CharSequence label, boolean selected, Paint paint) {
+        float density = context.getResources().getDisplayMetrics().density;
+        float labelSize = 12 * density;
+        float labelGap = 6 * density;
+        float tile = Math.min(width - 12 * density, height - labelSize - labelGap - 14 * density);
+        tile = Math.min(tile, 52 * density);
+        float left = (width - tile) / 2f;
+        float top = (height - tile - labelGap - labelSize) / 2f;
+        RectF rect = new RectF(left, top, left + tile, top + tile);
+        float radius = 14 * density;
+
+        paint.reset();
+        paint.setAntiAlias(true);
+        paint.setColor(context.getColor(selected ? R.color.plait_editor_tone : R.color.plait_editor_tile));
+        canvas.drawRoundRect(rect, radius, radius, paint);
+
+        Drawable symbol = context.getDrawable(icon);
+        if (symbol != null) {
+            int size = Math.round(24 * density);
+            int cx = Math.round(rect.centerX()), cy = Math.round(rect.centerY());
+            symbol.setBounds(cx - size / 2, cy - size / 2, cx + size / 2, cy + size / 2);
+            symbol.setTint(context.getColor(selected ? R.color.plait_editor_on_tone : R.color.plait_editor_on_tile));
+            symbol.draw(canvas);
+        }
+
+        drawLabel(canvas, context, width, rect.bottom + labelGap, label, selected, paint);
+    }
+
+    /** A filter or border: the preview with rounded corners, the name underneath, a ring when chosen. */
+    static void drawPreview(Canvas canvas, Context context, int width, int height, Bitmap preview,
+            CharSequence label, boolean selected, Paint paint) {
+        float density = context.getResources().getDisplayMetrics().density;
+        float labelSize = 12 * density;
+        float labelGap = 6 * density;
+        float inset = 5 * density;
+        float box = Math.min(width - 2 * inset, height - labelSize - labelGap - 2 * inset);
+        float left = (width - box) / 2f;
+        float top = (height - box - labelGap - labelSize) / 2f;
+        RectF rect = new RectF(left, top, left + box, top + box);
+        float radius = 12 * density;
+
+        paint.reset();
+        paint.setAntiAlias(true);
+        paint.setFilterBitmap(true);
+        if (preview != null) {
+            canvas.save();
+            Path clip = new Path();
+            clip.addRoundRect(rect, radius, radius, Path.Direction.CW);
+            canvas.clipPath(clip);
+            // Center-crop the preview into the square
+            float scale = Math.max(box / preview.getWidth(), box / preview.getHeight());
+            float w = preview.getWidth() * scale, h = preview.getHeight() * scale;
+            RectF dst = new RectF(rect.centerX() - w / 2, rect.centerY() - h / 2,
+                    rect.centerX() + w / 2, rect.centerY() + h / 2);
+            canvas.drawBitmap(preview, null, dst, paint);
+            canvas.restore();
+        } else {
+            paint.setColor(context.getColor(R.color.plait_editor_tile));
+            canvas.drawRoundRect(rect, radius, radius, paint);
+        }
+        if (selected) {
+            paint.reset();
+            paint.setAntiAlias(true);
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(3 * density);
+            paint.setColor(context.getColor(R.color.plait_editor_accent));
+            float half = 1.5f * density;
+            canvas.drawRoundRect(new RectF(rect.left - half, rect.top - half, rect.right + half,
+                    rect.bottom + half), radius + half, radius + half, paint);
+        }
+        drawLabel(canvas, context, width, rect.bottom + labelGap, label, selected, paint);
+    }
+
+    private static void drawLabel(Canvas canvas, Context context, int width, float top,
+            CharSequence label, boolean selected, Paint paint) {
+        if (TextUtils.isEmpty(label)) return;
+        float density = context.getResources().getDisplayMetrics().density;
+        paint.reset();
+        paint.setAntiAlias(true);
+        paint.setTextSize(12 * density);
+        paint.setColor(context.getColor(selected ? R.color.plait_editor_accent : R.color.plait_editor_label));
+        paint.setFakeBoldText(selected);
+        String text = TextUtils.ellipsize(label, new android.text.TextPaint(paint), width - 4 * density,
+                TextUtils.TruncateAt.END).toString();
+        float x = (width - paint.measureText(text)) / 2f;
+        canvas.drawText(text, x, top - paint.ascent(), paint);
+    }
+}
