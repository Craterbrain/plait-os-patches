+
+/**
+ * PlaitOS: the Tools tab, a grid of every tool in three groups, the way Snapseed lists its tools.
+ * Adjust: Tune image (all the sliders in one tool), Curves, Auto color, Black and white.
+ * Shape: Crop, Rotate, Straighten, Mirror. Create: Markup, Frames, Effects, Tiny planet (photo
+ * spheres only). Tiles are tonal tiles with Material Symbols, like the rest of PlaitOS.
+ */
+public class PlaitToolsPanel extends Fragment {
+    private static final int COLUMNS = 4;
+
+    @Override
+    public View onCreateView(LayoutInflater inflater, ViewGroup container, Bundle state) {
+        FilterShowActivity activity = (FilterShowActivity) getActivity();
+        Context context = activity;
+        LinearLayout root = new LinearLayout(context);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(8), dp(4), dp(8), dp(4));
+
+        addGroup(root, R.string.plait_editor_group_adjust, new Tile[] {
+                new Tile(R.drawable.plait_tool_tune, getString(R.string.plait_editor_tune_image),
+                        activity::plaitOpenTune),
+                tool(activity, "CURVES", R.drawable.plait_tool_show_chart),
+                tool(activity, "WBALANCE", R.drawable.plait_tool_auto_awesome, R.string.plait_editor_auto_color),
+                tool(activity, "BWFILTER", R.drawable.plait_tool_filter_b_and_w, R.string.plait_editor_black_white),
+        });
+        addGroup(root, R.string.plait_editor_group_shape, new Tile[] {
+                tool(activity, "CROP", R.drawable.plait_tool_crop),
+                tool(activity, "ROTATION", R.drawable.plait_tool_rotate_90_degrees_cw),
+                tool(activity, "STRAIGHTEN", R.drawable.plait_tool_straighten),
+                tool(activity, "MIRROR", R.drawable.plait_tool_flip),
+        });
+        Tile tinyPlanet = PrimaryImage.getImage().hasTinyPlanet()
+                ? tool(activity, "TINYPLANET", R.drawable.plait_tool_public) : null;
+        addGroup(root, R.string.plait_editor_group_create, new Tile[] {
+                new Tile(R.drawable.plait_tool_draw, getString(R.string.plait_gallery_markup),
+                        () -> activity.showRepresentation(new FilterDrawRepresentation())),
+                new Tile(R.drawable.plait_tool_crop_square, getString(R.string.plait_editor_frames),
+                        () -> mainPanel(activity, MainPanel.BORDERS)),
+                new Tile(R.drawable.plait_tool_blur_on, getString(R.string.plait_editor_effects),
+                        () -> mainPanel(activity, MainPanel.EFFECTS)),
+                tinyPlanet,
+        });
+        return root;
+    }
+
+    private static void mainPanel(FilterShowActivity activity, int panel) {
+        Fragment main = activity.getSupportFragmentManager().findFragmentByTag(MainPanel.FRAGMENT_TAG);
+        if (main instanceof MainPanel) ((MainPanel) main).showPanel(panel);
+    }
+
+    /** A tile for one of the editor's own tools, found by its filter's name; null if missing. */
+    private Tile tool(FilterShowActivity activity, String name, int icon) {
+        return tool(activity, name, icon, 0);
+    }
+
+    /** label 0 uses the filter's own name. */
+    private Tile tool(FilterShowActivity activity, String name, int icon, int label) {
+        FilterRepresentation rep = activity.plaitFindTool(name);
+        if (rep == null) return null;
+        return new Tile(icon, label != 0 ? getString(label) : rep.getName(),
+                () -> activity.showRepresentation(rep));
+    }
+
+    private void addGroup(LinearLayout root, int title, Tile[] tiles) {
+        Context context = root.getContext();
+        TextView header = new TextView(context);
+        header.setText(title);
+        header.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        header.setTextColor(context.getColor(R.color.plait_editor_on_tile));
+        header.setPadding(dp(8), dp(6), dp(8), dp(2));
+        root.addView(header);
+
+        LinearLayout row = new LinearLayout(context);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        int count = 0;
+        for (Tile tile : tiles) {
+            if (tile == null) continue;
+            row.addView(tileView(context, tile),
+                    new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+            count++;
+        }
+        for (; count < COLUMNS; count++) { // keep four columns so tiles line up across groups
+            row.addView(new View(context), new LinearLayout.LayoutParams(0, 1, 1));
+        }
+        root.addView(row);
+    }
+
+    private View tileView(Context context, Tile tile) {
+        LinearLayout cell = new LinearLayout(context);
+        cell.setOrientation(LinearLayout.VERTICAL);
+        cell.setGravity(Gravity.CENTER_HORIZONTAL);
+        cell.setPadding(0, dp(4), 0, dp(4));
+        cell.setContentDescription(tile.label);
+        cell.setOnClickListener(v -> tile.action.run());
+
+        FrameLayout square = new FrameLayout(context);
+        square.setBackgroundResource(R.drawable.plait_editor_tile_bg);
+        square.setDuplicateParentStateEnabled(true);
+        ImageView icon = new ImageView(context);
+        icon.setImageResource(tile.icon);
+        icon.setImageTintList(ColorStateList.valueOf(context.getColor(R.color.plait_editor_on_tile)));
+        square.addView(icon, new FrameLayout.LayoutParams(dp(24), dp(24), Gravity.CENTER));
+        cell.addView(square, new LinearLayout.LayoutParams(dp(52), dp(52)));
+
+        TextView label = new TextView(context);
+        label.setText(tile.label);
+        label.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        label.setTextColor(context.getColor(R.color.plait_editor_label));
+        label.setGravity(Gravity.CENTER);
+        label.setMaxLines(1);
+        label.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        label.setPadding(dp(2), dp(4), dp(2), 0);
+        cell.addView(label, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+        return cell;
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+
+    private static final class Tile {
+        final int icon;
+        final CharSequence label;
+        final Runnable action;
+
+        Tile(int icon, CharSequence label, Runnable action) {
+            this.icon = icon;
+            this.label = label;
+            this.action = action;
+        }
+    }
+}
