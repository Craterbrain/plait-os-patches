+    public static void styleActionTile(ImageButton button, int icon, boolean main) {
+        Context context = button.getContext();
+        if (icon != 0) button.setImageResource(icon);
+        int container = context.getColor(main ? R.color.plait_editor_accent : R.color.plait_editor_tone);
