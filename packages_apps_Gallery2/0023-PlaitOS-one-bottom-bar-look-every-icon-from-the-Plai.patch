+        button.setScaleType(ImageView.ScaleType.CENTER);
+        button.setPadding(0, 0, 0, 0);
+    }
+
+    /** Layout params for an action tile's 48 dp touch target. */
+    public static LinearLayout.LayoutParams tileParams(Context context) {
