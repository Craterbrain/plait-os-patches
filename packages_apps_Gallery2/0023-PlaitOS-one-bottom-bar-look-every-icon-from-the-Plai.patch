+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.gallery3d.util;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.RippleDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageButton;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.android.gallery3d.R;
+
+/**
+ * PlaitOS: one look for every bottom bar in the Gallery, from the Plait design guide
+ * (plait-design PlaitNavigationBar / PlaitNavItem / TonalTile). All bars sit on surfaceContainerLow
+ * with no divider, 80 dp tall.
+ * <ul>
+ * <li>Sections (library tabs, the editor's Looks / Tools / Export): a 24 dp icon in a 64 x 32 pill,
+ * the selected one tinted with the accent (16 %), its icon in the accent; a 12 sp label.</li>
+ * <li>Actions (photo viewer, editor tool bar): 40 dp tonal tiles with 12 dp corners
+ * (primaryContainer); the one main action solid primary.</li>
+ * </ul>
+ */
+public final class PlaitBars {
+    public static final int BAR_HEIGHT_DP = 80;
+    public static final int TILE_DP = 40;
+
+    private PlaitBars() {}
+
+    public static int barColor(Context context) {
+        return context.getColor(R.color.plait_bar);
+    }
+
+    /** The bar itself: surfaceContainerLow, no divider. */
+    public static void styleBar(View bar) {
+        bar.setBackgroundColor(barColor(bar.getContext()));
+    }
+
+    /** A section item (icon in a pill + label); update it with {@link #setSelected}. */
+    public static LinearLayout navItem(Context context, int icon, CharSequence label, boolean selected,
+            View.OnClickListener onClick) {
+        LinearLayout item = new LinearLayout(context);
+        item.setOrientation(LinearLayout.VERTICAL);
+        item.setGravity(Gravity.CENTER);
+        item.setContentDescription(label);
+        item.setFocusable(true);
+        item.setClickable(true);
+        item.setOnClickListener(onClick);
+
+        ImageView image = new ImageView(context);
+        image.setImageResource(icon);
