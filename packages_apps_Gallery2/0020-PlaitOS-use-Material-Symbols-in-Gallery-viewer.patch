+    private ImageButton viewerButton(int icon, int description, Runnable action) {
+        ImageButton button = selectionButton(icon, description, action);
+        boolean night = (getResources().getConfiguration().uiMode
+                & android.content.res.Configuration.UI_MODE_NIGHT_MASK)
+                == android.content.res.Configuration.UI_MODE_NIGHT_YES;
+        int container = getColor(night ? android.R.color.system_primary_container_dark
+                : android.R.color.system_primary_container_light);
+        int foreground = getColor(night ? android.R.color.system_on_primary_container_dark
+                : android.R.color.system_on_primary_container_light);
+        RippleDrawable ripple = new RippleDrawable(
+                ColorStateList.valueOf(color(android.R.attr.colorControlHighlight)),
+                shape(container, 12), null);
+        android.graphics.drawable.LayerDrawable tile =
+                new android.graphics.drawable.LayerDrawable(new android.graphics.drawable.Drawable[]{ripple});
+        tile.setLayerSize(0, dp(40), dp(40));
+        tile.setLayerGravity(0, Gravity.CENTER);
+        button.setBackground(tile);
+        button.setPadding(0, 0, 0, 0);
+        button.setScaleType(ImageView.ScaleType.CENTER);
+        button.setColorFilter(foreground);
+        return button;
+    }
+
     private void open(Media item, boolean edit) {
         Class<?> activity = edit ? FilterShowActivity.class
                 : item.video ? MovieActivity.class : GalleryActivity.class;
