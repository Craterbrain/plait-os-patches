+    private final class LibraryList extends ListView {
+        private LibraryBarScroll bars;
+
+        LibraryList() {
+            super(PlaitGalleryActivity.this);
+        }
+
+        @Override public boolean dispatchTouchEvent(MotionEvent event) {
+            if (bars != null) bars.track(event);
+            return super.dispatchTouchEvent(event);
+        }
+    }
+
+    private final class LibraryBarScroll {
+        private final ListView list;
+        private final EditText search;
+        private final View titleBar;
+        private final View searchBar;
+        private final View bottomBar;
+        private int titleHeight;
+        private int searchHeight;
+        private int bottomHeight;
+        private float startY;
+        private float startX;
+        private float collapse;
+        private boolean hidden;
+        private ValueAnimator animator;
+
+        LibraryBarScroll(ListView list, EditText search, View titleBar, View searchBar,
+                View bottomBar) {
+            this.list = list;
+            this.search = search;
+            this.titleBar = titleBar;
+            this.searchBar = searchBar;
+            this.bottomBar = bottomBar;
+        }
+
+        void track(MotionEvent event) {
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    startX = event.getRawX();
+                    startY = event.getRawY();
+                    break;
+                case MotionEvent.ACTION_MOVE:
+                    float dy = event.getRawY() - startY;
+                    float dx = event.getRawX() - startX;
+                    if (Math.abs(dy) >= dp(16) && Math.abs(dy) > Math.abs(dx)) {
+                        if (dy > 0) animateBars(false);
+                        else if (!search.hasFocus() && list.canScrollVertically(1)) animateBars(true);
+                        startY = event.getRawY();
+                        startX = event.getRawX();
+                    }
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        private void animateBars(boolean hide) {
+            if (hidden == hide) return;
+            if (titleHeight == 0) {
+                titleHeight = titleBar.getHeight();
+                searchHeight = searchBar.getHeight();
+                bottomHeight = bottomBar.getHeight();
+                if (titleHeight == 0 || searchHeight == 0 || bottomHeight == 0) return;
+            }
+            hidden = hide;
+            if (animator != null) animator.cancel();
+            animator = ValueAnimator.ofFloat(collapse, hide ? 1f : 0f);
+            animator.setDuration(240);
+            animator.addUpdateListener(frame -> {
+                collapse = (float) frame.getAnimatedValue();
+                setBarHeight(bottomBar, bottomHeight, collapse / .45f);
+                setBarHeight(searchBar, searchHeight, collapse / .54f);
+                setBarHeight(titleBar, titleHeight, (collapse - .54f) / .46f);
+            });
+            animator.start();
+        }
+
+        private void setBarHeight(View bar, int expanded, float fraction) {
+            int height = Math.round(expanded * (1 - Math.max(0f, Math.min(1f, fraction))));
+            bar.setVisibility(height == 0 ? View.GONE : View.VISIBLE);
+            ViewGroup.LayoutParams params = bar.getLayoutParams();
+            if (params.height != height) {
+                params.height = height;
+                bar.setLayoutParams(params);
+            }
+        }
+    }
+
