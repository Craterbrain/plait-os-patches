-        for (int i = mLayout.mVisibleEnd - 1; i >= mLayout.mVisibleStart; --i) {
-            int r = renderItem(canvas, i, 0, paperActive);
-            if ((r & RENDER_MORE_FRAME) != 0) more = true;
-            if ((r & RENDER_MORE_PASS) != 0) requestedSlot[requestCount++] = i;
