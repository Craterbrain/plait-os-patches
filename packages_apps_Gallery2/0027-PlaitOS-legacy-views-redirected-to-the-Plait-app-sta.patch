-        }
-
-        public T nextOf(T node) {
-            return (T) (node.mNext == mHead ? null : node.mNext);
-        }
-
-        public T previousOf(T node) {
-            return (T) (node.mPrev == mHead ? null : node.mPrev);
-        }
-
-    }
-
-    public static <T extends LinkedNode> List<T> newList() {
-        return new List<T>();
-    }
-}
