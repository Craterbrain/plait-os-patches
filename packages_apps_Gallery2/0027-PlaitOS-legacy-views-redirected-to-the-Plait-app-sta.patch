-                return mEmptyItem;
-            }
-            case FILTER_BY_CAMERA_SHORTCUT: {
-                return new SingleItemAlbum(path, mCameraShortcutItem);
-            }
-            case FILTER_BY_CAMERA_SHORTCUT_ITEM: {
-                return mCameraShortcutItem;
-            }
-            default:
-                throw new RuntimeException("bad path: " + path);
-        }
-    }
