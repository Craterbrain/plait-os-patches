-            mScrubberLeft = mProgressBar.left - mScrubber.getWidth() / 2;
-            mTrimStartScrubberLeft = mProgressBar.left - trimStartScrubberTipOffset();
-            mTrimEndScrubberLeft = mProgressBar.right - trimEndScrubberTipOffset();
