-        Future<?> task = mTask;
-        task.cancel();
-        task.waitDone();
-        if (task.get() == null) {
-            mTask = null;
-        }
-        if (mBitmapScreenNail != null) {
-            mBitmapScreenNail.recycle();
-            mBitmapScreenNail = null;
