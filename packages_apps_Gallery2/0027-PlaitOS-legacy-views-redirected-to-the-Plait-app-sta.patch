-
-    private static final String TOP_LOCAL_SET_PATH = "/local/all";
-
-    private static final String TOP_LOCAL_IMAGE_SET_PATH = "/local/image";
-
-    private static final String TOP_LOCAL_VIDEO_SET_PATH = "/local/video";
