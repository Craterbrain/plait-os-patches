-    private synchronized Tile obtainTile(int x, int y, int level) {
-        Tile tile = mRecycledQueue.pop();
-        if (tile != null) {
-            tile.mTileState = STATE_ACTIVATED;
-            tile.update(x, y, level);
-            return tile;
