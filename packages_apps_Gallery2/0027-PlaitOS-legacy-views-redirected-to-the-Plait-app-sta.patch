-            }
-            return INDEX_NONE;
-        }
-
-        @Override
-        public UpdateInfo call() throws Exception {
-            int index = getInvalidIndex(mVersion);
-            if (index == INDEX_NONE && mSourceVersion == mVersion) return null;
-            UpdateInfo info = new UpdateInfo();
-            info.version = mSourceVersion;
-            info.index = index;
-            info.size = mSize;
-            return info;
-        }
-    }
