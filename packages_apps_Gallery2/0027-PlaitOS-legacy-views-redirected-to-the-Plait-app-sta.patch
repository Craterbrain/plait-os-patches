-      }
-    }
-    ImportTask task = new ImportTask(mDevice, importHandles, mDevicePrettyName, this);
-    task.setListener(this);
-    mNotificationBuilder.setProgress(0, 0, true)
-        .setContentText(getResources().getText(R.string.ingest_importing));
