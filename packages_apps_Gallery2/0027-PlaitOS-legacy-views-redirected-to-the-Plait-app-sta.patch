-            double itemLatitude = item.lat;
-            double itemLongitude = item.lng;
-
-            if (set.mMinLatLatitude > itemLatitude) {
-                set.mMinLatLatitude = itemLatitude;
-                set.mMinLatLongitude = itemLongitude;
-            }
-            if (set.mMaxLatLatitude < itemLatitude) {
