-                + " (compensation " + mCompensation + ")");
-        if (mContentView != null && w != 0 && h != 0) {
-            mContentView.layout(0, 0, w, h);
-        }
-        // Uncomment this to dump the view hierarchy.
-        //mContentView.dumpTree("");
-    }
