-    public boolean getBoundsOf(GLView descendant, Rect out) {
-        int xoffset = 0;
-        int yoffset = 0;
-        GLView view = descendant;
-        while (view != this) {
-            if (view == null) return false;
-            Rect bounds = view.mBounds;
-            xoffset += bounds.left;
-            yoffset += bounds.top;
-            view = view.mParent;
