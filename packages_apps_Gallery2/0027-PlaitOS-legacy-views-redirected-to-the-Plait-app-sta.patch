-    mRedeliverNotifyIndexChanged = false;
-    mRedeliverIndexFinish = false;
-    mDevice = device;
-    mIndex.setDevice(mDevice);
-    if (mDevice != null) {
-      MtpDeviceInfo deviceInfo = mDevice.getDeviceInfo();
-      if (deviceInfo == null) {
