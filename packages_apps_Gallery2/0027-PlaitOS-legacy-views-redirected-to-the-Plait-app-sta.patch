-    }
-
-    String path = Environment.getExternalStorageDirectory().getPath();
-    try {
-      StatFs stat = new StatFs(path);
-      return stat.getAvailableBlocks() * (long) stat.getBlockSize() > size;
-    } catch (Exception e) {
-      Log.i(TAG, "Fail to access external storage", e);
-    }
-    return false;
-  }
-}
