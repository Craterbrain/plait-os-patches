-                                        clampScrubber(mScrubberLeft,
-                                                mScrubber.getWidth() / 2,
-                                                lowerBound, upperBound);
-                                seekToTime = getScrubberTime(mScrubberLeft,
-                                        mScrubber.getWidth() / 2);
-                                break;
-                            case SCRUBBER_START:
-                                mTrimStartScrubberLeft = x - mScrubberCorrection;
-                                // Limit start <= end
-                                if (mTrimStartScrubberLeft > mTrimEndScrubberLeft) {
