-    private void convertBoxToRect(int i) {
-        Box b = mBoxes.get(i);
-        Rect r = mRects.get(i);
-        int y = b.mCurrentY + mPlatform.mCurrentY + mViewH / 2;
-        int w = widthOf(b);
-        int h = heightOf(b);
-        if (i == 0) {
-            int x = mPlatform.mCurrentX + mViewW / 2;
-            r.left = x - w / 2;
-            r.right = r.left + w;
-        } else if (i > 0) {
-            Rect a = mRects.get(i - 1);
-            Gap g = mGaps.get(i - 1);
-            r.left = a.right + g.mCurrentGap;
-            r.right = r.left + w;
-        } else {  // i < 0
-            Rect a = mRects.get(i + 1);
-            Gap g = mGaps.get(i);
-            r.right = a.left - g.mCurrentGap;
-            r.left = r.right - w;
-        }
-        r.top = y - h / 2;
-        r.bottom = r.top + h;
-    }
