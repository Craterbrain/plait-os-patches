-        mResumeEffect = mActivity.getTransitionStore().get(KEY_RESUME_ANIMATION);
-        if (mResumeEffect != null) {
-            mAlbumView.setSlotFilter(mResumeEffect);
-            mResumeEffect.setPositionProvider(mPositionProvider);
-            mResumeEffect.start();
