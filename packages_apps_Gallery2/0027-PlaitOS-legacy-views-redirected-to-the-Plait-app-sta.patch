-    public boolean isCancelled() {
-        return mCancelled;
-    }
-
-    public synchronized RawTexture get() {
-        if (mCancelled) {
-            return null;
-        } else if (mResultReady.block(TIMEOUT)) {
-            return mTexture;
-        } else {
-            mCancelled = true;
-            return null;
-        }
-    }
