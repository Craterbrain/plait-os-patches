-    // Circular shift the array range from a[i] to a[j] (inclusive). That is,
-    // a[i] -> a[i+1] -> a[i+2] -> ... -> a[j], and a[j] -> a[i]
-    private static <T> void circularShiftRight(T[] array, int i, int j) {
-        T temp = array[j];
-        for (int k = j; k > i; k--) {
-            array[k] = array[k - 1];
-        }
-        array[i] = temp;
-    }
