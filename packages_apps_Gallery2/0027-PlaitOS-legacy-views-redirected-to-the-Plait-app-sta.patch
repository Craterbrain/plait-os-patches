-        for (int i = 0; i < n; ) {
-            PathId pid = list.get(i);
-
-            // Find a range of items.
-            ArrayList<Integer> ids = new ArrayList<Integer>();
-            int startId = Integer.parseInt(pid.path.getSuffix());
-            ids.add(startId);
-
-            int j;
-            for (j = i + 1; j < n; j++) {
-                PathId pid2 = list.get(j);
