-        long animTime = AnimationTime.get();
-        boolean more = mScroller.advanceAnimation(animTime);
-        more |= mLayout.advanceAnimation(animTime);
-        int oldX = mScrollX;
-        updateScrollPosition(mScroller.getPosition(), false);
