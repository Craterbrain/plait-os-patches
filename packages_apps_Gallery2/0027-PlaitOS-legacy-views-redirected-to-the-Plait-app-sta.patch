-    }
-
-    public void scanPath(String path) {
-      synchronized (mLock) {
-        if (mConnected) {
-          mScannerConnection.scanFile(path, null);
-        } else {
-          mPaths.add(path);
-          mScannerConnection.connect();
-        }
-      }
