-        int start = this.mContentStart;
-        int end = this.mContentEnd;
-
-        mContentStart = contentStart;
-        mContentEnd = contentEnd;
-
-        if (contentStart >= end || start >= contentEnd) {
-            for (int i = start, n = end; i < n; ++i) {
-                clearSlot(i % length);
-            }
-        } else {
-            for (int i = start; i < contentStart; ++i) {
