-    private void switchToFilmstrip() {
-        if (mAlbumDataAdapter.size() < 1) return;
-        int targetPhoto = mSlotView.getVisibleStart();
-        prepareAnimationBackToFilmstrip(targetPhoto);
-        if(mLaunchedFromPhotoPage) {
-            onBackPressed();
-        } else {
-            pickPhoto(targetPhoto, true);
