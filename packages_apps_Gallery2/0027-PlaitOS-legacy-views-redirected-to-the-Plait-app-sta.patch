-
-        mPlatform.doAnimation(mPlatform.mDefaultX, mPlatform.mDefaultY,
-                ANIM_KIND_CAPTURE);
-        b.doAnimation(0, b.mScaleMin, ANIM_KIND_CAPTURE);
