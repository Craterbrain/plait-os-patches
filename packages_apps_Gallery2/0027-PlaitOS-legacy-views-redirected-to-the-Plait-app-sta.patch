-    public static final int INCLUDE_LOCAL_VIDEO_ONLY =
-            INCLUDE_LOCAL_ONLY | INCLUDE_VIDEO;
-    public static final int INCLUDE_LOCAL_ALL_ONLY =
-            INCLUDE_LOCAL_ONLY | INCLUDE_IMAGE | INCLUDE_VIDEO;
