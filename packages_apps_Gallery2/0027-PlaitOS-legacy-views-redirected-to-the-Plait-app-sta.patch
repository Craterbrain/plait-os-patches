-    }
-
-    @Override
-    public synchronized void setContentListener(ContentListener listener) {
-        if (mRootSet != null) {
-            mListener = listener;
-        } else {
-            mSource.setContentListener(listener);
-        }
-    }
-
-    @Override
-    public void reload() {
-        mSource.reload();
-    }
-
-    @Override
-    public void close() {
-        mSource.close();
-    }
-
-    @Override
