-        setContentPane(mRootPane);
-        mAlbumSetDataAdapter.resume();
-        mSelectionDrawer.resume();
-        mEyePosition.resume();
-        mUpdateStorageInfo = mActivity.getThreadPool().submit(mUpdateStorageInfoJob);
