-
-        for (int pass = 1; requestCount != 0; ++pass) {
-            int newCount = 0;
-            for (int i = 0; i < requestCount; ++i) {
-                int r = renderItem(canvas,
-                        requestedSlot[i], pass, paperActive);
-                if ((r & RENDER_MORE_FRAME) != 0) more = true;
-                if ((r & RENDER_MORE_PASS) != 0) requestedSlot[newCount++] = i;
