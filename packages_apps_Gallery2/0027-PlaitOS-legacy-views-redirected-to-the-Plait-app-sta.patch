-    }
-
-    @Override
-    public ArrayList<MediaItem> getMediaItem(int start, int count) {
-        return ClusterAlbum.getMediaItemFromPath(
-                mPaths, start, count, mDataManager);
-    }
-
-    @Override
-    public long reload() {
-        if (mBaseSet.reload() > mDataVersion) {
-            updateData();
-            mDataVersion = nextVersionNumber();
