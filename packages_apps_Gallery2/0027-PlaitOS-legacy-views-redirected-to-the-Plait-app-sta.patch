-                case MSG_DELETE_ANIMATION_DONE: {
-                    // message.obj is the Path of the MediaItem which should be
-                    // deleted. message.arg1 is the offset of the image.
-                    mListener.onDeleteImage((Path) message.obj, message.arg1);
