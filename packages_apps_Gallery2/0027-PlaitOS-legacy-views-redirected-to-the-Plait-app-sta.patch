-                        albumSelectionFromAccounts(selection), selectionArgs);
-                break;
-        }
-        SQLiteDatabase db = getDatabaseHelper().getWritableDatabase();
-        String table = getTableFromMatch(match, uri);
-        int deleted = db.delete(table, selection, selectionArgs);
-        if (deleted > 0) {
-            postNotifyUri(uri);
-        }
-        return deleted;
