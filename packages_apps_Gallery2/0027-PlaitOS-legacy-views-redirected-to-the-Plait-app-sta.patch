-                    if (mScrubbing) {
-                        int seekToTime = 0;
-                        switch (mPressedThumb) {
-                            case SCRUBBER_CURRENT:
-                                seekToTime = getScrubberTime(mScrubberLeft,
-                                        mScrubber.getWidth() / 2);
