-    for (int i = 0; i < count; i++) {
-      UsbInterface intf = device.getInterface(i);
-      if (intf.getInterfaceClass() == UsbConstants.USB_CLASS_STILL_IMAGE &&
-          intf.getInterfaceSubclass() == 1 &&
-          intf.getInterfaceProtocol() == 1) {
-        return true;
-      }
-    }
-    return false;
-  }
