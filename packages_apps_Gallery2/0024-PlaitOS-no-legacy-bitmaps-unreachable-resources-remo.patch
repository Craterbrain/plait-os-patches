diff --git a/src/com/android/gallery3d/util/PlaitIcons.java b/src/com/android/gallery3d/util/PlaitIcons.java
new file mode 100644
index 0000000..907f76d
--- /dev/null
+++ b/src/com/android/gallery3d/util/PlaitIcons.java
@@ -0,0 +1,85 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.gallery3d.util;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+
+/**
+ * PlaitOS: bitmaps for code that needs a Bitmap (the GL renderer's textures, the video time bars,
+ * filter overlays) without shipping bitmap artwork. Icons are the design guide's vector icons
+ * (ps_*), drawn into a bitmap in a given colour; plain shapes are drawn in code.
+ */
+public final class PlaitIcons {
+    public static final int WHITE = 0xFFFFFFFF;
+
+    private PlaitIcons() {}
+
+    /** A resource as a bitmap: decoded if it is one, else the vector drawn at scale x its size in tint. */
+    public static Bitmap decode(Context context, int resId, int tint, float scale) {
+        BitmapFactory.Options options = new BitmapFactory.Options();
+        options.inPreferredConfig = Bitmap.Config.ARGB_8888;
+        Bitmap bitmap = BitmapFactory.decodeResource(context.getResources(), resId, options);
+        if (bitmap != null) return bitmap;
+        Drawable drawable = context.getDrawable(resId);
+        if (drawable == null) return null;
+        drawable = drawable.mutate();
+        int w = Math.max(1, Math.round(Math.max(1, drawable.getIntrinsicWidth()) * scale));
+        int h = Math.max(1, Math.round(Math.max(1, drawable.getIntrinsicHeight()) * scale));
+        Bitmap out = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+        drawable.setBounds(0, 0, w, h);
+        if (tint != 0) drawable.setTint(tint);
+        drawable.draw(new Canvas(out));
+        return out;
+    }
+
+    public static Bitmap decode(Context context, int resId, int tint) {
+        return decode(context, resId, tint, 2f);
+    }
+
+    /** A 1 x 1 bitmap of one colour, stretched by the renderer (pressed and selected frames, panels). */
+    public static Bitmap solid(int color) {
+        Bitmap out = Bitmap.createBitmap(1, 1, Bitmap.Config.ARGB_8888);
+        out.eraseColor(color);
+        return out;
