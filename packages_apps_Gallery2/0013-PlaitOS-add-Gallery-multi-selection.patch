+    private void updateLibraryTitle() {
+        libraryTitle.removeAllViews();
+        if (checkedMedia.isEmpty()) {
+            libraryTitle.addView(header(title(), true));
+            return;
+        }
+        LinearLayout bar = new LinearLayout(this);
+        bar.setGravity(Gravity.CENTER_VERTICAL);
+        bar.setPadding(dp(4), 0, dp(4), 0);
+        int count = checkedMedia.size();
+        bar.addView(selectionButton(R.drawable.plait_gallery_close,
+                R.string.plait_gallery_clear_selection, this::clearSelection),
+                new LinearLayout.LayoutParams(dp(48), dp(48)));
+        boolean hasVideo = media.stream().anyMatch(item -> item.video && checkedMedia.contains(item.uri));
+        int counter = hasVideo ? R.plurals.plait_gallery_items_selected
+                : R.plurals.plait_gallery_selected;
+        TextView title = label(getResources().getQuantityString(counter, count, count), 18, true);
+        title.setGravity(Gravity.CENTER_VERTICAL);
+        title.setSingleLine();
+        title.setEllipsize(TextUtils.TruncateAt.END);
+        title.setAccessibilityLiveRegion(View.ACCESSIBILITY_LIVE_REGION_POLITE);
+        bar.addView(title, new LinearLayout.LayoutParams(0, dp(56), 1));
+        bar.addView(selectionButton(R.drawable.plait_gallery_share, R.string.plait_gallery_share,
+                this::shareSelection), new LinearLayout.LayoutParams(dp(48), dp(48)));
+        bar.addView(selectionButton(R.drawable.plait_gallery_trash, R.string.plait_gallery_trash,
+                this::trashSelection), new LinearLayout.LayoutParams(dp(48), dp(48)));
+        libraryTitle.addView(bar);
+    }
+
+    private ImageButton selectionButton(int icon, int description, Runnable action) {
+        ImageButton button = new ImageButton(this, null, android.R.attr.borderlessButtonStyle);
+        button.setImageResource(icon);
+        button.setColorFilter(color(android.R.attr.textColorPrimary));
+        button.setContentDescription(getText(description));
+        button.setOnClickListener(view -> action.run());
+        return button;
+    }
+
+    private void toggleSelection(Media item) {
+        if (trashInProgress) return;
+        if (!checkedMedia.remove(item.uri)) checkedMedia.add(item.uri);
+        if (!checkedMedia.isEmpty()) libraryBars.reveal();
+        updateLibraryTitle();
+        ((BaseAdapter) grid.getAdapter()).notifyDataSetChanged();
+    }
+
+    private void clearSelection() {
+        checkedMedia.clear();
+        updateLibraryTitle();
+        ((BaseAdapter) grid.getAdapter()).notifyDataSetChanged();
+    }
+
+    private void shareSelection() {
+        ArrayList<Uri> uris = new ArrayList<>(checkedMedia);
+        if (uris.isEmpty()) return;
+        boolean images = false;
+        boolean videos = false;
+        for (Media item : media) {
+            if (!checkedMedia.contains(item.uri)) continue;
+            if (item.video) videos = true;
+            else images = true;
+        }
+        String type = images && videos ? "*/*" : videos ? "video/*" : "image/*";
+        ClipData attachments = ClipData.newUri(getContentResolver(), "", uris.get(0));
+        for (int i = 1; i < uris.size(); i++) {
+            attachments.addItem(new ClipData.Item(uris.get(i)));
+        }
+        Intent share = new Intent(Intent.ACTION_SEND_MULTIPLE).setType(type)
+                .putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris)
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        share.setClipData(attachments);
+        startActivity(Intent.createChooser(share, getText(R.string.plait_gallery_share)));
+    }
+
+    private void trashSelection() {
+        if (checkedMedia.isEmpty() || trashInProgress) return;
+        trashInProgress = true;
+        List<Uri> requested = new ArrayList<>(checkedMedia);
+        mediaLoader.execute(() -> {
+            ArrayList<Uri> needsConsent = new ArrayList<>();
+            ArrayList<Uri> moved = new ArrayList<>();
+            boolean failed = false;
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.MediaColumns.IS_TRASHED, 1);
+            for (Uri uri : requested) {
+                try {
+                    if (getContentResolver().update(uri, values, null, null) > 0) moved.add(uri);
+                    else failed = true;
+                } catch (SecurityException denied) {
+                    needsConsent.add(uri);
+                } catch (RuntimeException error) {
+                    failed = true;
+                }
+            }
+            boolean hadFailure = failed;
+            runOnUiThread(() -> {
+                if (isDestroyed()) return;
+                trashInProgress = false;
+                checkedMedia.removeAll(moved);
+                if (selected == null) {
+                    updateLibraryTitle();
+                    if (!moved.isEmpty()) refresh();
+                }
+                if (hadFailure) Toast.makeText(this, R.string.plait_gallery_trash_partial,
+                        Toast.LENGTH_SHORT).show();
+                if (!needsConsent.isEmpty()) requestTrashConsent(needsConsent);
+            });
+        });
+    }
+
+    private void requestTrashConsent(List<Uri> uris) {
+        try {
+            android.app.PendingIntent request =
+                    MediaStore.createTrashRequest(getContentResolver(), uris, true);
+            startIntentSenderForResult(request.getIntentSender(), 2, null, 0, 0, 0);
+        } catch (android.content.IntentSender.SendIntentException | RuntimeException exception) {
+            Toast.makeText(this, R.string.plait_gallery_unavailable, Toast.LENGTH_SHORT).show();
+        }
+    }
+
