diff --git a/src/com/android/gallery3d/filtershow/editors/BasicEditor.java b/src/com/android/gallery3d/filtershow/editors/BasicEditor.java
index af694d8..bfb30f7 100644
--- a/src/com/android/gallery3d/filtershow/editors/BasicEditor.java
+++ b/src/com/android/gallery3d/filtershow/editors/BasicEditor.java
@@ -17,6 +17,11 @@
 package com.android.gallery3d.filtershow.editors;
 
 import android.content.Context;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+
+import com.android.gallery3d.filtershow.imageshow.PrimaryImage;
 
 import com.android.gallery3d.R;
 import com.android.gallery3d.filtershow.controller.Control;
@@ -50,8 +55,67 @@ public class BasicEditor extends ParametricEditor implements ParameterInteger {
     public void reflectCurrentFilter() {
         super.reflectCurrentFilter();
         if (getLocalRepresentation() != null && getLocalRepresentation() instanceof FilterBasicRepresentation) {
-            FilterBasicRepresentation interval = (FilterBasicRepresentation) getLocalRepresentation();
             updateText();
+            if (getClass() == BasicEditor.class && getImageShow() != null) {
+                getImageShow().setOnTouchListener(new AdjustmentDrag());
+            }
+        }
+    }
+
+    private final class AdjustmentDrag implements View.OnTouchListener {
+        private float startX;
+        private float startY;
+        private int startValue;
+        private boolean dragging;
+        private boolean multiplePointers;
+
+        @Override public boolean onTouch(View view, MotionEvent event) {
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    startX = event.getX();
+                    startY = event.getY();
+                    startValue = getValue();
+                    dragging = false;
+                    multiplePointers = false;
+                    return false;
+                case MotionEvent.ACTION_POINTER_DOWN:
+                    multiplePointers = true;
+                    return dragging;
+                case MotionEvent.ACTION_MOVE:
+                    if (multiplePointers || PrimaryImage.getImage().getScaleFactor() > 1) {
+                        return dragging;
+                    }
+                    float dx = event.getX() - startX;
+                    float dy = event.getY() - startY;
+                    if (!dragging) {
+                        int slop = ViewConfiguration.get(view.getContext()).getScaledTouchSlop();
+                        if (Math.abs(dx) <= slop || Math.abs(dx) <= Math.abs(dy)) return false;
+                        dragging = true;
+                        MotionEvent cancel = MotionEvent.obtain(event);
+                        cancel.setAction(MotionEvent.ACTION_CANCEL);
+                        try {
+                            view.onTouchEvent(cancel);
+                        } finally {
+                            cancel.recycle();
+                        }
+                    }
+                    int min = getMinimum();
+                    int max = getMaximum();
+                    int value = Math.max(min, Math.min(max, startValue + Math.round(
+                            dx / Math.max(1, view.getWidth()) * (max - min))));
+                    if (value != getValue()) {
+                        setValue(value);
+                        if (mControl != null) mControl.updateUI();
+                    }
+                    return true;
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    boolean handled = dragging;
+                    dragging = false;
+                    return handled;
+                default:
+                    return dragging;
+            }
         }
     }
 
