+    private void setToolSelected(View tool, boolean selected) {
+        tool.setSelected(selected);
+        android.widget.Button button = (android.widget.Button) tool;
+        int attribute = selected ? android.R.attr.colorAccent : android.R.attr.textColorPrimary;
+        android.content.res.TypedArray colors = button.getContext().obtainStyledAttributes(
+                new int[]{attribute});
+        try {
+            android.content.res.ColorStateList tint = colors.getColorStateList(0);
+            if (tint != null) {
+                button.setTextColor(tint);
+                button.setCompoundDrawableTintList(tint);
+            }
+        } finally {
+            colors.recycle();
+        }
+    }
+
