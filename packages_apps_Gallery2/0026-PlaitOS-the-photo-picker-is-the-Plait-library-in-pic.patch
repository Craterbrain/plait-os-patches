+    // PlaitOS: picker mode, for other apps' GET_CONTENT / PICK (was the legacy GL picker): the
+    // library itself, only the requested type, one tap returns the item (or several, with Done)
+    private boolean picker;
+    private boolean pickMultiple;
+    private boolean pickImages = true;
+    private boolean pickVideos = true;
+
+    private void readPickerIntent(Intent intent) {
+        String action = intent == null ? null : intent.getAction();
+        picker = Intent.ACTION_GET_CONTENT.equals(action) || Intent.ACTION_PICK.equals(action);
+        if (!picker) return;
+        pickMultiple = intent.getBooleanExtra(Intent.EXTRA_ALLOW_MULTIPLE, false);
+        String type = intent.resolveType(this);
+        if (type == null) type = intent.getType();
+        if (type != null) {
+            type = type.toLowerCase(Locale.ROOT);
+            boolean image = type.startsWith("image/") || type.endsWith("/image");
+            boolean video = type.startsWith("video/") || type.endsWith("/video");
+            if (image && !video) pickVideos = false;
+            if (video && !image) pickImages = false;
+        }
+    }
+
+    private CharSequence pickerTitle() {
+        int res;
+        if (pickImages && !pickVideos) res = pickMultiple ? R.string.plait_pick_photos : R.string.plait_pick_photo;
+        else if (pickVideos && !pickImages) res = pickMultiple ? R.string.plait_pick_videos : R.string.plait_pick_video;
+        else res = pickMultiple ? R.string.plait_pick_items : R.string.plait_pick_item;
+        return getText(res);
+    }
+
+    /** Hands the chosen items to the app that asked, readable by it, and closes. */
+    private void returnPicked(List<Uri> uris) {
+        if (uris.isEmpty()) return;
+        Intent result = new Intent().setData(uris.get(0))
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        ClipData clip = ClipData.newUri(getContentResolver(), "", uris.get(0));
+        for (int i = 1; i < uris.size(); i++) clip.addItem(new ClipData.Item(uris.get(i)));
+        result.setClipData(clip);
+        setResult(RESULT_OK, result);
+        finish();
+    }
+
+    private void cancelPicker() {
+        setResult(RESULT_CANCELED);
+        finish();
+    }
+
     @Override public void onCreate(Bundle state) {
         super.onCreate(state);
+        readPickerIntent(getIntent());
         if (state != null) {
             tab = state.getInt("tab");
             category = state.getString("category");
@@ -249,6 +298,7 @@ public final class PlaitGalleryActivity extends Activity {
