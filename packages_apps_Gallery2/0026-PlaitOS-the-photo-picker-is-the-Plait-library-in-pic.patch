+    /** Picker header: close (cancel), what to choose; no settings. */
+    private LinearLayout pickerHeader() {
+        LinearLayout bar = new LinearLayout(this);
+        bar.setGravity(Gravity.CENTER_VERTICAL);
+        bar.setPadding(dp(4), 0, dp(8), 0);
