+                new LinearLayout.LayoutParams(dp(48), dp(48)));
+        TextView name = label(pickerTitle().toString(), 22, true);
+        name.setGravity(Gravity.CENTER_VERTICAL);
+        name.setSingleLine();
+        name.setEllipsize(TextUtils.TruncateAt.END);
+        name.setPadding(dp(4), 0, 0, 0);
+        bar.addView(name, new LinearLayout.LayoutParams(0, dp(56), 1));
+        return bar;
+    }
+
+    /** The filled Done button (primary, 10 dp corners, as PlaitFilledButton). */
+    private Button pickerDone() {
+        Button done = new Button(this, null, android.R.attr.borderlessButtonStyle);
