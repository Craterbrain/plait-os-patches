+    private void trashPhoto() {
+        Media item = selected;
+        if (item == null || trashInProgress) return;
+        trashInProgress = true;
+        mediaLoader.execute(() -> {
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.MediaColumns.IS_TRASHED, 1);
+            boolean moved = false;
+            boolean needsConsent = false;
+            try {
+                // The ROM's SYSTEM_GALLERY role grants write access to shared photo media.
+                moved = getContentResolver().update(item.uri, values, null, null) > 0;
+            } catch (SecurityException denied) {
+                needsConsent = true;
+            } catch (RuntimeException error) {
+                android.util.Log.w("PlaitGallery", "Could not move photo to Trash", error);
+            }
+            boolean success = moved;
+            boolean prompt = needsConsent;
+            runOnUiThread(() -> {
+                if (isDestroyed()) return;
+                trashInProgress = false;
+                if (success) {
+                    showLibrary();
+                    refresh();
+                } else if (prompt) {
+                    requestMediaChange(item, true);
+                } else {
+                    Toast.makeText(this, R.string.plait_gallery_unavailable,
+                            Toast.LENGTH_SHORT).show();
+                }
+            });
         });
