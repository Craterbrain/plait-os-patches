From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Thu, 26 Nov 2026 19:02:30 -0600
Subject: [PATCH] PlaitOS: index Gallery subjects on device with MobileNet

---
 Android.bp                                    |  10 +-
 AndroidManifest.xml                           |   4 +-
 assets/classifier/LICENSE                     |  29 +++
 assets/classifier/NOTICE                      |   4 +
 assets/classifier/labels.json                 |   1 +
 assets/classifier/mobilenet.tflite            | Bin 0 -> 2952376 bytes
 res/values/plait_gallery.xml                  |   5 +-
 .../gallery3d/app/PhotoClassifier.java        | 167 ++++++++++++++++++
 .../gallery3d/app/PlaitGalleryActivity.java   |  99 ++++++++++-
 9 files changed, 307 insertions(+), 12 deletions(-)
 create mode 100644 assets/classifier/LICENSE
 create mode 100644 assets/classifier/NOTICE
 create mode 100644 assets/classifier/labels.json
 create mode 100644 assets/classifier/mobilenet.tflite
 create mode 100644 src/com/android/gallery3d/app/PhotoClassifier.java

diff --git a/Android.bp b/Android.bp
index faa7fac..0f835d8 100644
--- a/Android.bp
+++ b/Android.bp
@@ -1,5 +1,11 @@
 package {
-    default_applicable_licenses: ["Android-Apache-2.0"],
+    default_applicable_licenses: ["Android-Apache-2.0", "plait_gallery_model_license"],
+}
+
+license {
+    name: "plait_gallery_model_license",
+    license_kinds: ["SPDX-license-identifier-BSD-3-Clause"],
+    license_text: ["assets/classifier/LICENSE", "assets/classifier/NOTICE"],
 }
 
 android_app {
@@ -13,6 +19,7 @@ android_app {
         "com.android.gallery3d.common2",
         "xmp_toolkit",
         "mp4parser",
+        "tensorflowlite_java",
     ],
 
     srcs: [
@@ -41,6 +48,7 @@ android_app {
         "libjni_eglfence",
         "libjni_filtershow_filters",
         "libjni_jpegstream",
+        "libtensorflowlite_jni",
     ],
 
     optimize: {
