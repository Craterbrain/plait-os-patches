diff --git a/src/com/android/gallery3d/app/PhotoClassifier.java b/src/com/android/gallery3d/app/PhotoClassifier.java
new file mode 100644
index 0000000..e3e32ec
--- /dev/null
+++ b/src/com/android/gallery3d/app/PhotoClassifier.java
@@ -0,0 +1,167 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.gallery3d.app;
+
+import android.content.ContentResolver;
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.database.sqlite.SQLiteOpenHelper;
+import android.graphics.Bitmap;
+import android.net.Uri;
+import android.util.Size;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.tensorflow.lite.Interpreter;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.FloatBuffer;
+import java.util.HashMap;
+import java.util.Map;
+
+final class PhotoClassifier implements AutoCloseable {
+    private static final int EDGE = 224;
+    private static final int PIXELS = EDGE * EDGE;
+    private static final int CLASSES = 1000;
+    private static final float[] MEAN = {.485f, .456f, .406f};
+    private static final float[] STD = {.229f, .224f, .225f};
+
+    static final class Result {
+        final String label;
+        final String topic;
+
+        Result(String label, String topic) {
+            this.label = label;
+            this.topic = topic;
+        }
+    }
+
+    static final class Index extends SQLiteOpenHelper {
+        Index(Context context) {
+            super(context, new File(context.getNoBackupFilesDir(), "photo_topics.db").getPath(),
+                    null, 1);
+        }
+
+        @Override public void onCreate(SQLiteDatabase db) {
+            db.execSQL("CREATE TABLE photo (uri TEXT PRIMARY KEY, signature TEXT NOT NULL,"
+                    + " label TEXT NOT NULL, topic TEXT NOT NULL)");
+        }
+
+        @Override public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
+            db.execSQL("DROP TABLE photo");
+            onCreate(db);
+        }
+
+        Map<String, Result> load() {
+            Map<String, Result> results = new HashMap<>();
+            try (Cursor rows = getReadableDatabase().query("photo",
+                    new String[]{"uri", "signature", "label", "topic"},
+                    null, null, null, null, null)) {
+                while (rows.moveToNext()) {
+                    results.put(key(rows.getString(0), rows.getString(1)),
+                            new Result(rows.getString(2), rows.getString(3)));
+                }
+            }
+            return results;
+        }
+
+        static String key(String uri, String signature) {
+            return uri + "\n" + signature;
+        }
+
+        void save(Uri uri, String signature, Result result) {
+            ContentValues values = new ContentValues();
+            values.put("uri", uri.toString());
+            values.put("signature", signature);
+            values.put("label", result.label);
+            values.put("topic", result.topic);
+            getWritableDatabase().replaceOrThrow("photo", null, values);
+        }
+    }
+
+    private final Interpreter interpreter;
+    private final JSONObject labels;
+    private final ByteBuffer input = direct(3 * PIXELS * Float.BYTES);
+    private final ByteBuffer output = direct(CLASSES);
+    private final int[] pixels = new int[PIXELS];
+
+    PhotoClassifier(Context context) throws IOException, JSONException {
+        try (InputStream stream = context.getAssets().open("classifier/labels.json")) {
+            labels = new JSONObject(new String(stream.readAllBytes(),
+                    java.nio.charset.StandardCharsets.UTF_8));
+        }
+        try (InputStream stream = context.getAssets().open("classifier/mobilenet.tflite")) {
+            byte[] model = stream.readAllBytes();
+            ByteBuffer buffer = direct(model.length);
+            buffer.put(model);
+            buffer.rewind();
+            interpreter = new Interpreter(buffer, new Interpreter.Options().setNumThreads(1));
+        }
+    }
+
+    Result classify(ContentResolver resolver, Uri uri) throws IOException {
+        Bitmap thumbnail = resolver.loadThumbnail(uri, new Size(232, 232), null);
+        try {
+            int shorter = Math.min(thumbnail.getWidth(), thumbnail.getHeight());
+            int crop = Math.max(1, Math.round(shorter * EDGE / 232f));
+            Bitmap centered = Bitmap.createBitmap(thumbnail, (thumbnail.getWidth() - crop) / 2,
+                    (thumbnail.getHeight() - crop) / 2, crop, crop);
+            try {
+                Bitmap resized = Bitmap.createScaledBitmap(centered, EDGE, EDGE, true);
+                try {
+                    resized.getPixels(pixels, 0, EDGE, 0, 0, EDGE, EDGE);
+                } finally {
+                    if (resized != centered) resized.recycle();
+                }
+            } finally {
+                if (centered != thumbnail) centered.recycle();
+            }
+        } finally {
+            thumbnail.recycle();
+        }
+
+        FloatBuffer tensor = input.asFloatBuffer();
+        for (int channel = 0; channel < 3; channel++) {
+            int shift = 16 - 8 * channel;
+            for (int pixel : pixels) {
+                float value = ((pixel >> shift) & 255) / 255f;
+                tensor.put((value - MEAN[channel]) / STD[channel]);
+            }
+        }
+        input.rewind();
+        output.rewind();
+        interpreter.run(input, output);
+        int best = 0;
+        for (int i = 1; i < CLASSES; i++) {
+            if (output.get(i) > output.get(best)) best = i;
+        }
+        float scale = interpreter.getOutputTensor(0).quantizationParams().getScale();
+        int maximum = output.get(best);
+        double sum = 0;
+        for (int i = 0; i < CLASSES; i++) sum += Math.exp((output.get(i) - maximum) * scale);
+        if (sum > 4) return new Result("", "");
+        return new Result(labels.optString(Integer.toString(best), ""), topic(best));
+    }
+
+    private static String topic(int index) {
+        if (index >= 151 && index <= 268 || index >= 281 && index <= 285) return "pets";
+        if (index >= 924 && index <= 969) return "food";
+        if (index >= 970 && index <= 980) return "nature";
+        return "";
+    }
+
+    private static ByteBuffer direct(int bytes) {
+        return ByteBuffer.allocateDirect(bytes).order(ByteOrder.nativeOrder());
+    }
+
+    @Override public void close() {
+        interpreter.close();
+    }
+}
