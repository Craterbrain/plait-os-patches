From 429e701143d10fe27d7582d646c9eddf97e5ac24 Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Thu, 26 Nov 2026 20:03:45 -0600
Subject: [PATCH] PlaitOS: advance Gallery photos after a two-thirds swipe

---
 AndroidManifest.xml                           |  4 +-
 .../gallery3d/app/PlaitGalleryActivity.java   | 45 ++++++++++++++++++-
 2 files changed, 46 insertions(+), 3 deletions(-)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 461ab2c..06040d9 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -1,7 +1,7 @@
 <?xml version="1.0" encoding="utf-8"?>
 
-<manifest android:versionCode="40039"
-        android:versionName="1.1.40039"
+<manifest android:versionCode="40040"
+        android:versionName="1.1.40040"
         xmlns:android="http://schemas.android.com/apk/res/android"
         package="com.android.gallery3d">
 
diff --git a/src/com/android/gallery3d/app/PlaitGalleryActivity.java b/src/com/android/gallery3d/app/PlaitGalleryActivity.java
index ef6235d..b393f61 100644
--- a/src/com/android/gallery3d/app/PlaitGalleryActivity.java
+++ b/src/com/android/gallery3d/app/PlaitGalleryActivity.java
@@ -25,6 +25,7 @@ import android.text.format.DateUtils;
 import android.util.LruCache;
 import android.util.Size;
 import android.view.Gravity;
+import android.view.MotionEvent;
 import android.view.View;
 import android.view.ViewGroup;
 import android.widget.BaseAdapter;
@@ -688,7 +689,7 @@ public final class PlaitGalleryActivity extends Activity {
         if (getResources().getConfiguration().getLayoutDirection() == View.LAYOUT_DIRECTION_RTL) {
             java.util.Collections.reverse(pages);
         }
-        ViewPager pager = new ViewPager(this);
+        ViewPager pager = new PhotoPager();
         pager.setLayoutDirection(View.LAYOUT_DIRECTION_LTR);
         pager.setAdapter(new PagerAdapter() {
             @Override public int getCount() {
@@ -746,6 +747,48 @@ public final class PlaitGalleryActivity extends Activity {
         setContentView(photo);
     }
 
+    private final class PhotoPager extends ViewPager {
+        private float touchStartX;
+        private boolean singlePointer;
+
+        PhotoPager() {
+            super(PlaitGalleryActivity.this);
+        }
+
+        @Override public boolean dispatchTouchEvent(MotionEvent event) {
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    touchStartX = event.getX();
+                    singlePointer = true;
+                    break;
+                case MotionEvent.ACTION_POINTER_DOWN:
+                    singlePointer = false;
+                    break;
+                case MotionEvent.ACTION_UP:
+                    float distance = event.getX() - touchStartX;
+                    int page = getCurrentItem();
+                    int next = page;
+                    // Keep ViewPager's drag and settle animations, with our release threshold.
+                    if (singlePointer && getWidth() > 0
+                            && Math.abs(distance) >= getWidth() * (2f / 3f)) {
+                        next += distance < 0 ? 1 : -1;
+                    }
+                    MotionEvent cancel = MotionEvent.obtain(event);
+                    cancel.setAction(MotionEvent.ACTION_CANCEL);
+                    try {
+                        super.dispatchTouchEvent(cancel);
+                    } finally {
+                        cancel.recycle();
+                    }
+                    if (next != page) setCurrentItem(next, true);
+                    return true;
+                default:
+                    break;
+            }
+            return super.dispatchTouchEvent(event);
+        }
+    }
+
     private void updateViewerHeader(LinearLayout slot) {
         LinearLayout title = header(selected.name, false);
         favoriteButton = new Button(this, null, android.R.attr.borderlessButtonStyle);
