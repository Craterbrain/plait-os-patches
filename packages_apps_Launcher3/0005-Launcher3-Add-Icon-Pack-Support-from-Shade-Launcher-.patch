+
+            mCanvas.setBitmap(uponBm);
+            upon.setBounds(0, 0, bitmap.getWidth(), bitmap.getHeight());
+            upon.draw(mCanvas);
+
+            mPaint.setXfermode(new PorterDuffXfermode(PorterDuff.Mode.SRC_ATOP));
+            mCanvas.setBitmap(bitmap);
