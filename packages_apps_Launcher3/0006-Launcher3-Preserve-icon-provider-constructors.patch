[PlaitOS: ported from crDroid packages_apps_Launcher3 17.0]
---
 proguard.flags | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/proguard.flags b/proguard.flags
index b2188b1..dbbdf23 100644
--- a/proguard.flags
+++ b/proguard.flags
@@ -67,6 +67,9 @@
 -keep class androidx.lifecycle.LifecycleRegistry {
   *;
 }
+-keep class com.android.launcher3.icons.** {
+  *;
+}
 
 # Keep all classes annotated with @AppFunctionSerializable and their members.
 # These classes are serialized and their structure must be preserved.
