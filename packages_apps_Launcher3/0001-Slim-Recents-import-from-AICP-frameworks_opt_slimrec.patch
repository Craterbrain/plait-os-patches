+        VectorDrawable vd = (VectorDrawable)
+                mContext.getResources().getDrawable(R.drawable.ic_recent_keyguard);
+        vd.setTint(tintColor);
+        mKeyguardImage.setImageDrawable(vd);
+        mKeyguardText.setTextColor(tintColor);
+
