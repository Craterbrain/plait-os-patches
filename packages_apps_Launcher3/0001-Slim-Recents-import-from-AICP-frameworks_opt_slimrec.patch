+    private void openLastAppPanelToggle() {
+        if (mTasks != null && !mTasks.isEmpty()) {
+            if (!mIsTopTaskInForeground) {
+                startApplication(mTasks.get(0));
+            } else if (mTasks.size() > 1) {
+                startApplication(mTasks.get(1));
+            }
