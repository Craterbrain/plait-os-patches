From 55fd51c288c1af140816a52de010cf7dde080540 Mon Sep 17 00:00:00 2001
From: DenlNister <dcnnn950711@gmail.com>
Date: Mon, 1 Jun 2026 09:06:32 +0800
Subject: [PATCH 12/15] Launcher3: Respect adaptive icon pack shapes

Only mark icon pack drawables as no-wrap when they are not AdaptiveIconDrawable instances. This preserves fixed-shape legacy icon pack assets while allowing adaptive icon pack icons to follow the launcher icon shape pipeline.

Bump the icon provider state key so icons cached with the previous no-wrap behavior are regenerated.

Signed-off-by: DenlNister <dcnnn950711@gmail.com>
Signed-off-by: Ghosuto <clash.raja10@gmail.com>
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>

[PlaitOS: ported from crDroid packages_apps_Launcher3 17.0]
---
 src/com/android/launcher3/icons/ThirdPartyIconProvider.java | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/com/android/launcher3/icons/ThirdPartyIconProvider.java b/src/com/android/launcher3/icons/ThirdPartyIconProvider.java
index c618ffb..a5105f2 100644
--- a/src/com/android/launcher3/icons/ThirdPartyIconProvider.java
+++ b/src/com/android/launcher3/icons/ThirdPartyIconProvider.java
@@ -3,6 +3,7 @@ package com.android.launcher3.icons;
 import android.annotation.SuppressLint;
 import android.content.Context;
 import android.content.pm.ComponentInfo;
+import android.graphics.drawable.AdaptiveIconDrawable;
 import android.graphics.drawable.Drawable;
 import android.os.UserHandle;
 
@@ -48,7 +49,9 @@ public class ThirdPartyIconProvider extends LauncherIconProvider {
         if (icon == null) {
             return fallback.get();
         }
-        icon.setChangingConfigurations(icon.getChangingConfigurations() | CONFIG_HINT_NO_WRAP);
+        if (!(icon instanceof AdaptiveIconDrawable)) {
+            icon.setChangingConfigurations(icon.getChangingConfigurations() | CONFIG_HINT_NO_WRAP);
+        }
         return icon;
     }
 }
