+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: PlaitOS
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- Material 3 roles from the system (wallpaper) palette; values-night holds the dark ones -->
+<resources>
+    <!-- Panel -->
+    <color name="recent_background">@android:color/system_surface_container_dark</color>
+    <color name="recent_foreground">@android:color/system_on_surface_dark</color>
+    <color name="recent_foreground_variant">@android:color/system_on_surface_variant_dark</color>
+    <color name="recent_ripple">#1FFFFFFF</color>
+    <!-- Cards: the current app is highlighted -->
+    <color name="recent_card_background">@android:color/system_surface_container_highest_dark</color>
+    <color name="recent_card_current_background">@android:color/system_secondary_container_dark</color>
+    <color name="recent_card_current_foreground">@android:color/system_on_secondary_container_dark</color>
+    <color name="recent_option_background">@android:color/system_secondary_container_dark</color>
+    <color name="recent_option_foreground">@android:color/system_on_secondary_container_dark</color>
+    <color name="recent_favorite_background">@android:color/system_primary_dark</color>
+    <color name="recent_favorite_foreground">@android:color/system_on_primary_dark</color>
+    <!-- Empty, locked and clear-all states -->
+    <color name="recents_empty_color">@android:color/system_on_surface_variant_dark</color>
+    <color name="recent_warning_background">@android:color/system_error_container_dark</color>
+    <color name="recent_warning_foreground">@android:color/system_on_error_container_dark</color>
+    <!-- Memory bar -->
+    <color name="recents_membar_text_color">@android:color/system_on_surface_variant_dark</color>
+    <color name="recents_membar_color">@android:color/system_primary_dark</color>
+    <color name="recents_membar_track_color">@android:color/system_surface_container_highest_dark</color>
+</resources>
