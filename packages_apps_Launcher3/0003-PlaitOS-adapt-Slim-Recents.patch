diff --git a/quickstep/src/com/android/quickstep/AicpOverviewCommandHelper.kt b/quickstep/src/com/android/quickstep/AicpOverviewCommandHelper.kt
index 43c4bfc..d118abc 100644
--- a/quickstep/src/com/android/quickstep/AicpOverviewCommandHelper.kt
+++ b/quickstep/src/com/android/quickstep/AicpOverviewCommandHelper.kt
@@ -6,14 +6,18 @@ import android.database.ContentObserver
 import android.os.Handler
 import android.provider.Settings
 import com.android.systemui.slimrecent.RecentController
+import com.android.systemui.slimrecent.SlimSettings
 
 class AicpOverviewCommandHelper(
     val context: Context
 ) {
     private var useSlimRecents = false
 
-    private val slimRecents = RecentController().also {
-        it.onStart(context)
+    // Created the first time Slim Recents is used, so stock Overview users don't pay for it
+    private val slimRecents by lazy {
+        RecentController().also {
+            it.onStart(context)
+        }
     }
 
     private val settingsObserver = object : ContentObserver(Handler()) {
@@ -21,7 +25,7 @@ class AicpOverviewCommandHelper(
             val resolver: ContentResolver = context.getContentResolver()
             resolver.registerContentObserver(
                 Settings.System.getUriFor(
-                    Settings.System.USE_SLIM_RECENTS
+                    SlimSettings.ENABLED
                 ), false, this
             )
             update()
@@ -36,9 +40,11 @@ class AicpOverviewCommandHelper(
         }
 
         fun update() {
-            val resolver = context.getContentResolver()
-
-            useSlimRecents = Settings.System.getInt(resolver, Settings.System.USE_SLIM_RECENTS, 0) == 1
+            val wasUsed = useSlimRecents
+            useSlimRecents = SlimSettings.get(context, SlimSettings.ENABLED, 0) == 1
+            if (wasUsed && !useSlimRecents) {
+                slimRecents.hideRecents(true)
+            }
         }
     }.also {
         it.observe()
@@ -55,7 +61,8 @@ class AicpOverviewCommandHelper(
                 true
             }
             OverviewCommandHelper.CommandType.SHOW_ALT_TAB -> {
-                slimRecents.showRecentApps()
+                // Through the toggle, which loads the tasks first
+                if (!slimRecents.isShowing()) slimRecents.toggleRecentApps()
                 true
             }
             OverviewCommandHelper.CommandType.HIDE_ALT_TAB -> {
