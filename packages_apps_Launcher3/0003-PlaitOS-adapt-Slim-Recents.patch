+++ b/slimrecent/src/com/android/systemui/slimrecent/SlimSettings.java
@@ -0,0 +1,64 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.slimrecent;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.provider.Settings;
+import android.text.TextUtils;
+
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.Set;
+
+/**
+ * PlaitOS settings for Slim Recents. The options are Settings.System keys written by the PlaitOS
+ * page in Settings (the launcher runs as the current user, so plain reads are per user); the
+ * favorites are the launcher's own data and live in its shared preferences.
+ */
+public final class SlimSettings {
+
+    /** 0 stock Overview, 1 Slim Recents. */
+    public static final String ENABLED = "plait_slim_recents";
+    /** 0 right edge, 1 left edge. */
+    public static final String GRAVITY = "plait_slim_recents_gravity";
+    /** One of RecentPanelView.EXPANDED_MODE_*. */
+    public static final String EXPANDED_MODE = "plait_slim_recents_expanded_mode";
+    public static final String MAX_APPS = "plait_slim_recents_max_apps";
+    /** Panel width in percent of the default. */
+    public static final String SCALE = "plait_slim_recents_scale";
+    public static final String MEM_DISPLAY = "plait_slim_recents_mem_display";
+
+    public static final int DEFAULT_MAX_APPS = 15;
+    public static final int DEFAULT_SCALE = 100;
+
+    private static final String PREFS = "slim_recents";
+    private static final String KEY_FAVORITES = "favorites";
+
+    private SlimSettings() {}
+
+    public static int get(Context context, String key, int def) {
+        return Settings.System.getInt(context.getContentResolver(), key, def);
+    }
+
+    /** Favorite task identifiers (kept when clearing all). */
+    public static Set<String> getFavorites(Context context) {
+        String stored = prefs(context).getString(KEY_FAVORITES, "");
+        Set<String> favorites = new LinkedHashSet<>();
+        if (!TextUtils.isEmpty(stored)) {
+            favorites.addAll(Arrays.asList(stored.split("\\|")));
+        }
+        return favorites;
+    }
+
+    public static void setFavorites(Context context, Set<String> favorites) {
+        prefs(context).edit().putString(KEY_FAVORITES, TextUtils.join("|", favorites)).apply();
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
