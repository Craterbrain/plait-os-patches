+package com.android.contacts.util;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.content.res.TypedArray;
+import android.text.SpannableString;
+import android.text.Spanned;
+import android.text.style.ForegroundColorSpan;
+import android.text.style.RelativeSizeSpan;
+
+/** PlaitOS: a root screen's title with the installed version after it, smaller and muted, as on every Plait app. */
+public final class PlaitTitle {
+    private PlaitTitle() {}
+
+    public static CharSequence withVersion(Context context, CharSequence title) {
+        String version = null;
+        try {
+            version = context.getPackageManager().getPackageInfo(context.getPackageName(), 0).versionName;
+        } catch (PackageManager.NameNotFoundException e) {
+            // Our own package always exists; leave the version out if not
+        }
+        if (version == null || version.isEmpty()) return title;
+        String text = title + "  " + version;
+        SpannableString s = new SpannableString(text);
+        int start = title.length() + 2;
+        s.setSpan(new RelativeSizeSpan(0.6f), start, text.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        TypedArray a = context.obtainStyledAttributes(new int[] {android.R.attr.textColorSecondary});
+        try {
+            if (a.hasValue(0)) {
+                s.setSpan(new ForegroundColorSpan(a.getColor(0, 0)), start, text.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            }
+        } finally {
+            a.recycle();
+        }
+        return s;
+    }
+}
