@@ -0,0 +1,47 @@
+package com.android.messaging.ui.conversation.composer.ui
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** PlaitOS: the text the attach sheet puts into a message for a location and for a note. */
+class AttachSheetTextTest {
+
+    @Test
+    fun locationIsCoordinatesAccuracyAndAnOpenStreetMapLink() {
+        assertEquals(
+            "📍 My location (±12 m)\nhttps://www.openstreetmap.org/?mlat=40.71280&mlon=-74.00600#map=17/40.71280/-74.00600",
+            locationText(latitude = 40.7128, longitude = -74.006, accuracyMeters = 12.4f),
+        )
+    }
+
+    @Test
+    fun unknownAccuracyIsLeftOut() {
+        assertTrue(locationText(1.0, 2.0, accuracyMeters = null).startsWith("📍 My location\n"))
+        assertTrue(locationText(1.0, 2.0, accuracyMeters = 0f).startsWith("📍 My location\n"))
+    }
+
+    @Test
+    fun coordinatesUseADotWhateverTheLocale() {
+        val previous = java.util.Locale.getDefault()
+        try {
+            java.util.Locale.setDefault(java.util.Locale.GERMANY)
+            assertTrue(locationText(52.52, 13.405, null).contains("mlat=52.52000&mlon=13.40500"))
+        } finally {
+            java.util.Locale.setDefault(previous)
+        }
+    }
+
+    @Test
+    fun noteIsTrimmedWithNormalLineEndings() {
+        assertEquals("Buy milk\nand eggs", noteText("  Buy milk\r\nand eggs \n\n"))
+    }
+
+    @Test
+    fun longNoteIsCutAtAWordAndMarked() {
+        val long = List(600) { "word" }.joinToString(" ")
+        val text = noteText(long)
+        assertTrue(text.length <= MAX_NOTE_CHARS + 1)
+        assertTrue(text.endsWith("word…"))
+    }
+}
diff --git a/jni/GifTranscoder.cpp b/jni/GifTranscoder.cpp
index e91cfd9a..5dc6f5b0 100644
--- a/jni/GifTranscoder.cpp
+++ b/jni/GifTranscoder.cpp
@@ -586,9 +586,63 @@ jboolean transcode(JNIEnv* env, jobject clazz, jstring filePath, jstring outFile
     return (gifCode == GIF_OK);
 }
 
+jboolean encodeBurst(JNIEnv* env, jclass, jstring filePath, jintArray pixels,
+        jint size, jint frameCount) {
+    if (size < 1 || size > 160 || frameCount < 2 || frameCount > 16 ||
+            env->GetArrayLength(pixels) != size * size * frameCount) {
+        return JNI_FALSE;
+    }
+
+    int error = 0;
+    const char* path = env->GetStringUTFChars(filePath, nullptr);
+    if (!path) return JNI_FALSE;
+    GifFileType* gif = EGifOpenFileName(path, false, &error);
+    env->ReleaseStringUTFChars(filePath, path);
+    if (!gif) return JNI_FALSE;
+
+    std::array<GifColorType, 256> colors;
+    for (int i = 0; i < 256; ++i) {
+        colors[i] = {static_cast<GifByteType>((i >> 5) * 255 / 7),
+                     static_cast<GifByteType>(((i >> 2) & 7) * 255 / 7),
+                     static_cast<GifByteType>((i & 3) * 255 / 3)};
+    }
+    ColorMapObject* map = GifMakeMapObject(colors.size(), colors.data());
+    EGifSetGifVersion(gif, true);
+    bool ok = map && EGifPutScreenDesc(gif, size, size, 8, 0, map) == GIF_OK;
+    if (map) GifFreeMapObject(map);
+
+    const GifByteType loop[] = {1, 0, 0};
+    ok = ok && EGifPutExtensionLeader(gif, APPLICATION_EXT_FUNC_CODE) == GIF_OK
+            && EGifPutExtensionBlock(gif, 11, "NETSCAPE2.0") == GIF_OK
+            && EGifPutExtensionBlock(gif, sizeof(loop), loop) == GIF_OK
+            && EGifPutExtensionTrailer(gif) == GIF_OK;
+
+    std::vector<jint> argb(size);
+    std::vector<GifByteType> indexed(size);
+    for (int frame = 0; ok && frame < frameCount; ++frame) {
+        const GifByteType control[] = {0, 20, 0, 0};
+        ok = EGifPutExtension(gif, GRAPHICS_EXT_FUNC_CODE, sizeof(control), control) == GIF_OK
+                && EGifPutImageDesc(gif, 0, 0, size, size, false, nullptr) == GIF_OK;
+        for (int y = 0; ok && y < size; ++y) {
+            env->GetIntArrayRegion(pixels, (frame * size + y) * size, size, argb.data());
+            if (env->ExceptionCheck()) {
+                ok = false;
+                break;
+            }
+            for (int x = 0; x < size; ++x) {
+                const auto color = static_cast<uint32_t>(argb[x]);
+                indexed[x] = ((color >> 16) & 0xe0) | ((color >> 11) & 0x1c) | ((color >> 6) & 3);
+            }
+            ok = EGifPutLine(gif, indexed.data(), size) == GIF_OK;
+        }
+    }
+    return EGifCloseFile(gif, &error) == GIF_OK && ok;
+}
+
 constexpr char kClassPathName[] = "com/android/messaging/util/GifTranscoder";
 
 const JNINativeMethod kMethods[] = {
+    { "encodeBurst", "(Ljava/lang/String;[III)Z", reinterpret_cast<void*>(encodeBurst) },
     { "transcodeInternal", "(Ljava/lang/String;Ljava/lang/String;)Z", reinterpret_cast<void*>(transcode) },
 };
 
