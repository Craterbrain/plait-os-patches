+/** PlaitOS: what the attach sheet can do. Gallery and Camera open the existing media picker (camera and photos). */
+internal enum class AttachAction { Gallery, Camera, Gifs, Stickers, Files, Voice, Contact, Location, Notes, Schedule, SelfieGif }
+
+/**
+ * PlaitOS: the result launchers for the attach sheet's own actions (files, GIFs, stickers, notes, location). They live
+ * with the attach button, not the sheet, so a picker's result still arrives after the sheet has closed.
+ */
+internal class AttachLaunchers(
+    val pickMedia: (Array<String>) -> Unit,
+    val pickNote: () -> Unit,
+    val shareLocation: () -> Unit,
+    val takePhoto: () -> Unit,
+    val selfieGif: () -> Unit,
+    val selectSticker: () -> Unit,
+    val selectGif: () -> Unit,
+)
+
+@Composable
+internal fun rememberAttachLaunchers(
+    onAttachContentUris: (List<String>) -> Unit,
+    onAppendMessageText: (String) -> Unit,
+): AttachLaunchers {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+
+    // Files, GIFs and stickers are images or videos picked from any app (the same path as the photo picker's media)
+    val mediaLauncher = rememberLauncherForActivityResult(ActivityResultContracts.OpenMultipleDocuments()) { uris ->
+        if (uris.isNotEmpty()) onAttachContentUris(uris.map(Uri::toString))
+    }
+
+    val noteLauncher = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri == null) return@rememberLauncherForActivityResult
+        scope.launch {
+            val text = withContext(Dispatchers.IO) {
+                runCatching {
+                    context.contentResolver.openInputStream(uri)?.bufferedReader()?.use { reader ->
+                        val text = CharArray(4097)
+                        var count = 0
+                        while (count < text.size) {
+                            val read = reader.read(text, count, text.size - count)
+                            if (read < 0) break
+                            count += read
+                        }
+                        noteText(String(text, 0, count))
+                    }
+                }.getOrNull()
+            }
+            if (text.isNullOrEmpty()) toast(context, R.string.plait_attach_note_failed) else onAppendMessageText(text)
+        }
+    }
+
+    var photoUri by rememberSaveable { mutableStateOf<String?>(null) }
+    val camera = rememberLauncherForActivityResult(ActivityResultContracts.TakePicture()) { success ->
+        val uri = photoUri
+        photoUri = null
+        if (uri != null) {
+            if (success) onAttachContentUris(listOf(uri))
+            else context.contentResolver.delete(Uri.parse(uri), null, null)
+        }
+    }
+    fun launchCamera() {
+        if (photoUri != null) return
+        val uri = MediaScratchFileProvider.buildMediaScratchSpaceUri("jpg")
+        photoUri = uri.toString()
+        try {
+            camera.launch(uri)
+        } catch (e: android.content.ActivityNotFoundException) {
+            context.contentResolver.delete(uri, null, null)
+            photoUri = null
+            toast(context, R.string.plait_attach_camera_failed)
+        }
+    }
+    val cameraPermission = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+        if (granted) launchCamera() else toast(context, R.string.plait_attach_camera_failed)
+    }
+
+    fun sendCurrentLocation() {
+        currentLocation(context) { location ->
+            if (location == null) toast(context, R.string.plait_attach_location_failed)
+            else onAppendMessageText(locationText(location))
+        }
+    }
+
+    val locationPermissionLauncher = rememberLauncherForActivityResult(
+        ActivityResultContracts.RequestMultiplePermissions(),
+    ) { granted ->
+        if (granted.values.any { it }) sendCurrentLocation() else toast(context, R.string.plait_attach_location_denied)
+    }
+
+    var showSelfie by rememberSaveable { mutableStateOf(false) }
+    val selfiePermission = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+        if (granted) showSelfie = true else toast(context, R.string.plait_selfie_failed)
+    }
+    if (showSelfie) SelfieGifDialog(onAttachContentUris) { showSelfie = false }
+    var showStickers by rememberSaveable { mutableStateOf(false) }
+    if (showStickers) {
+        LocalStickerPicker(
+            onPickImage = { mediaLauncher.launch(arrayOf("image/webp", "image/png", "image/gif")) },
+            onAttach = onAttachContentUris,
+            onDismiss = { showStickers = false },
+        )
+    }
+
+    var showGifs by rememberSaveable { mutableStateOf(false) }
+    if (showGifs) GifPicker(onAttachContentUris) { showGifs = false }
+    return AttachLaunchers(
+        selectGif = { showGifs = true },
+        selectSticker = { showStickers = true },
+        selfieGif = {
+            if (context.checkSelfPermission(Manifest.permission.CAMERA) == PackageManager.PERMISSION_GRANTED) showSelfie = true
+            else selfiePermission.launch(Manifest.permission.CAMERA)
+        },
+        takePhoto = {
+            if (context.checkSelfPermission(Manifest.permission.CAMERA) == PackageManager.PERMISSION_GRANTED) launchCamera()
+            else cameraPermission.launch(Manifest.permission.CAMERA)
+        },
+        pickMedia = { types -> mediaLauncher.launch(types) },
+        pickNote = { noteLauncher.launch(arrayOf("text/plain", "text/markdown", "text/*")) },
+        shareLocation = {
+            if (hasLocationPermission(context)) sendCurrentLocation()
+            else locationPermissionLauncher.launch(
+                arrayOf(Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.ACCESS_COARSE_LOCATION),
+            )
+        },
+    )
+}
+
+/**
+ * The attach sheet: the actions as tonal tiles, four to a row, on a raised surface with 28 dp top corners (the PlaitOS
+ * unified look). It is a popup, not a modal sheet, and keeps the old attachment menu's window flags: focusable so back
+ * closes it, ALT_FOCUSABLE_IM so the keyboard stays up behind it (the media picker relies on that), NO_LIMITS and
+ * WATCH_OUTSIDE_TOUCH as before. It sits full width just above the attach button. Call it inside the button's box.
+ */
+@Composable
+internal fun ConversationAttachSheet(
+    isAudioRecordActionEnabled: Boolean,
+    showSchedule: Boolean = false,
+    onDismiss: () -> Unit,
+    onAction: (AttachAction) -> Unit,
+) {
+    val tiles = listOf(
+        AttachTile(AttachAction.Gallery, Icons.Rounded.PhotoLibrary, R.string.plait_attach_gallery),
+        AttachTile(AttachAction.Camera, Icons.Rounded.PhotoCamera, R.string.plait_attach_camera),
+        AttachTile(AttachAction.Gifs, Icons.Rounded.Gif, R.string.plait_attach_gifs),
+        AttachTile(AttachAction.Stickers, Icons.Rounded.EmojiEmotions, R.string.plait_attach_stickers),
+        AttachTile(AttachAction.Files, Icons.Rounded.AttachFile, R.string.plait_attach_files),
+        AttachTile(AttachAction.Voice, Icons.Rounded.Mic, R.string.mediapicker_audio_title, isAudioRecordActionEnabled),
+        AttachTile(AttachAction.Contact, Icons.Rounded.Person, R.string.mediapicker_contact_title),
+        AttachTile(AttachAction.Location, Icons.Rounded.LocationOn, R.string.plait_attach_location),
+        AttachTile(AttachAction.Notes, Icons.Rounded.EditNote, R.string.plait_attach_notes),
+        AttachTile(AttachAction.Schedule, Icons.Rounded.Schedule, R.string.plait_schedule_title),
+        AttachTile(AttachAction.SelfieGif, Icons.Rounded.Face, R.string.plait_selfie_gif),
+    ).filter { showSchedule || it.action != AttachAction.Schedule }
+    Popup(
+        popupPositionProvider = AboveAnchorFullWidth,
+        onDismissRequest = onDismiss,
+        properties = PopupProperties(
+            flags = WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
+                WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH,
+        ),
+    ) {
+        Surface(
+            modifier = Modifier.fillMaxWidth(),
+            shape = RoundedCornerShape(topStart = 28.dp, topEnd = 28.dp),
+            color = MaterialTheme.colorScheme.surfaceContainerHigh,
+            shadowElevation = 6.dp,
+        ) {
+            Column(
+                Modifier.fillMaxWidth().padding(start = 12.dp, end = 12.dp, top = 10.dp, bottom = 16.dp),
+                verticalArrangement = Arrangement.spacedBy(14.dp),
+            ) {
+                Box(
+                    Modifier.align(Alignment.CenterHorizontally).size(width = 36.dp, height = 4.dp)
+                        .background(MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.5f), RoundedCornerShape(2.dp)),
+                )
+                tiles.chunked(4).forEach { row ->
+                    Row(Modifier.fillMaxWidth()) {
+                        row.forEach { tile ->
+                            AttachTileView(
+                                tile = tile,
+                                modifier = Modifier.weight(1f),
+                                onClick = {
+                                    onDismiss()
+                                    onAction(tile.action)
+                                },
+                            )
+                        }
+                        repeat(4 - row.size) { Spacer(Modifier.weight(1f)) }
+                    }
+                }
+            }
+        }
+    }
+}
+
+/** Full window width, bottom edge on the anchor's top (above the compose bar and, with it, the keyboard). */
+private object AboveAnchorFullWidth : PopupPositionProvider {
+    override fun calculatePosition(
+        anchorBounds: IntRect,
+        windowSize: IntSize,
+        layoutDirection: LayoutDirection,
+        popupContentSize: IntSize,
+    ): IntOffset = IntOffset(0, (anchorBounds.top - popupContentSize.height).coerceAtLeast(0))
+}
+
+private class AttachTile(
+    val action: AttachAction,
+    val icon: ImageVector,
+    @StringRes val label: Int,
+    val enabled: Boolean = true,
+)
+
+@Composable
+private fun AttachTileView(tile: AttachTile, modifier: Modifier, onClick: () -> Unit) {
+    val colors = MaterialTheme.colorScheme
+    Column(
+        modifier
+            .testTag(attachTileTestTag(tile.action))
+            .clickable(enabled = tile.enabled, onClick = onClick)
+            .padding(vertical = 4.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.spacedBy(7.dp),
+    ) {
+        Box(
+            Modifier.size(width = 64.dp, height = 52.dp)
+                .background(if (tile.enabled) colors.primaryContainer else colors.surfaceContainerHighest, RoundedCornerShape(16.dp)),
+            contentAlignment = Alignment.Center,
+        ) {
+            Icon(
+                tile.icon, contentDescription = null, modifier = Modifier.size(24.dp),
+                tint = if (tile.enabled) colors.onPrimaryContainer else colors.onSurfaceVariant,
+            )
+        }
+        Text(
+            stringResource(tile.label), style = MaterialTheme.typography.labelMedium, textAlign = TextAlign.Center,
+            color = if (tile.enabled) colors.onSurface else colors.onSurfaceVariant, maxLines = 2,
+        )
+    }
+}
+
+/** The tiles that replace the old menu's items keep their test tags, so the existing tests still find them. */
+internal fun attachTileTestTag(action: AttachAction) = when (action) {
+    AttachAction.Gallery -> CONVERSATION_ATTACHMENT_MEDIA_MENU_ITEM_TEST_TAG
+    AttachAction.Voice -> CONVERSATION_ATTACHMENT_AUDIO_MENU_ITEM_TEST_TAG
+    AttachAction.Contact -> CONVERSATION_ATTACHMENT_CONTACT_MENU_ITEM_TEST_TAG
+    else -> "plait_attach_${action.name.lowercase(Locale.ROOT)}"
+}
+
+// ---------------------------------------------------------------- location and notes (pure parts are unit-tested)
+
+/** A one-time location as text: accuracy, then an OpenStreetMap link any phone can open. No map service is asked. */
+internal fun locationText(latitude: Double, longitude: Double, accuracyMeters: Float?): String {
+    val lat = String.format(Locale.ROOT, "%.5f", latitude)
+    val lon = String.format(Locale.ROOT, "%.5f", longitude)
+    val accuracy = accuracyMeters?.takeIf { it > 0f }?.let { " (±${it.roundToInt()} m)" } ?: ""
+    return "📍 My location$accuracy\nhttps://www.openstreetmap.org/?mlat=$lat&mlon=$lon#map=17/$lat/$lon"
+}
+
+private fun locationText(location: Location) =
+    locationText(location.latitude, location.longitude, if (location.hasAccuracy()) location.accuracy else null)
+
+/** Longest note inserted as text; anything longer is cut at a word boundary (MMS still carries it). */
+internal const val MAX_NOTE_CHARS = 2000
+
+/** A note's text for the message: trimmed, line endings normalised, cut to [MAX_NOTE_CHARS]. */
+internal fun noteText(raw: String): String {
+    val text = raw.replace("\r\n", "\n").replace('\r', '\n').trim()
+    if (text.length <= MAX_NOTE_CHARS) return text
+    val cut = text.substring(0, MAX_NOTE_CHARS)
+    val space = cut.lastIndexOf(' ')
+    return (if (space > MAX_NOTE_CHARS / 2) cut.substring(0, space) else cut).trimEnd() + "…"
+}
+
+private fun hasLocationPermission(context: Context) =
+    context.checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED ||
+        context.checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED
+
+/** One fresh position from the best enabled provider; null when location is off or nothing answers. */
+private fun currentLocation(context: Context, onResult: (Location?) -> Unit) {
+    val manager = context.getSystemService(LocationManager::class.java)
+    val provider = listOf(LocationManager.FUSED_PROVIDER, LocationManager.NETWORK_PROVIDER, LocationManager.GPS_PROVIDER)
+        .firstOrNull { manager != null && it in manager.allProviders && manager.isProviderEnabled(it) }
+    if (manager == null || provider == null) {
+        onResult(null)
+        return
+    }
+    try {
+        manager.getCurrentLocation(provider, null, context.mainExecutor) { onResult(it) }
+    } catch (e: SecurityException) {
+        onResult(null)
+    }
+}
+
+private fun toast(context: Context, @StringRes message: Int) {
+    Toast.makeText(context, message, Toast.LENGTH_LONG).show()
+}
