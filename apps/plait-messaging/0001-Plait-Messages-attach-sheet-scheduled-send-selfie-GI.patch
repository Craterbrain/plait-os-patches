+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.core.content.ContextCompat
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import com.android.messaging.R
+import com.android.messaging.datamodel.MediaScratchFileProvider
+import com.android.messaging.sms.MmsConfig
+import com.android.messaging.util.GifTranscoder
+import java.util.concurrent.Executor
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withContext
+
+private const val GIF_SIZE = 112
+private const val GIF_FRAMES = 10
+
+@Composable
+internal fun SelfieGifDialog(onAttach: (List<String>) -> Unit, onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    val owner = LocalLifecycleOwner.current
+    val main = remember(context) { ContextCompat.getMainExecutor(context) }
+    val scope = rememberCoroutineScope()
+    var surface by remember { mutableStateOf<SurfaceRequest?>(null) }
+    var ready by remember { mutableStateOf(false) }
+    var failed by remember { mutableStateOf(false) }
+    var recording by remember { mutableStateOf(false) }
+    val preview = remember { Preview.Builder().build() }
+    val capture = remember {
+        ImageCapture.Builder().setCaptureMode(ImageCapture.CAPTURE_MODE_MINIMIZE_LATENCY)
+            .setTargetResolution(android.util.Size(320, 240)).build()
+    }
+
+    DisposableEffect(owner, context) {
+        var provider: ProcessCameraProvider? = null
+        var disposed = false
+        preview.setSurfaceProvider(main) { surface = it }
+        val future = ProcessCameraProvider.getInstance(context)
+        future.addListener({
+            if (!disposed) {
+                try {
+                    provider = future.get().also {
+                        it.bindToLifecycle(owner, CameraSelector.DEFAULT_FRONT_CAMERA, preview, capture)
+                    }
+                    ready = true
+                } catch (e: Exception) {
+                    failed = true
+                }
+            }
+        }, main)
+        onDispose {
+            disposed = true
+            provider?.unbind(preview, capture)
+            preview.setSurfaceProvider(null)
+        }
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(R.string.plait_selfie_gif)) },
+        text = {
+            Box(Modifier.fillMaxWidth().aspectRatio(1f)) {
+                if (failed) {
+                    Text(stringResource(R.string.plait_selfie_failed))
+                } else {
+                    surface?.let { CameraXViewfinder(it, Modifier.matchParentSize()) }
+                }
+            }
+        },
+        dismissButton = { TextButton(onClick = onDismiss) { Text(stringResource(android.R.string.cancel)) } },
+        confirmButton = {
+            TextButton(enabled = ready && surface != null && !recording, onClick = {
+                recording = true
+                scope.launch {
+                    val uri = MediaScratchFileProvider.buildMediaScratchSpaceUri("gif")
+                    val file = MediaScratchFileProvider.getFileFromUri(uri)
+                    var attached = false
+                    try {
+                        val pixels = IntArray(GIF_SIZE * GIF_SIZE * GIF_FRAMES)
+                        repeat(GIF_FRAMES) { frame ->
+                            capture.readFrame(main, pixels, frame * GIF_SIZE * GIF_SIZE)
+                            if (frame < GIF_FRAMES - 1) delay(100)
+                        }
+                        withContext(Dispatchers.IO) {
+                            check(GifTranscoder.encodeBurst(file.absolutePath, pixels, GIF_SIZE, GIF_FRAMES))
+                            val max = MmsConfig.get(android.telephony.SmsManager.getDefaultSmsSubscriptionId()).maxMessageSize
+                            check(file.length() in 1..(max - 32 * 1024L))
+                        }
+                        onAttach(listOf(uri.toString()))
+                        attached = true
+                        onDismiss()
+                    } catch (e: CancellationException) {
+                        throw e
+                    } catch (e: Exception) {
+                        Toast.makeText(context, R.string.plait_selfie_failed, Toast.LENGTH_SHORT).show()
+                    } finally {
+                        if (!attached) file.delete()
+                        recording = false
+                    }
+                }
+            }) { Text(stringResource(if (recording) R.string.plait_selfie_recording else R.string.plait_selfie_record)) }
+        },
+    )
+}
+
+private suspend fun ImageCapture.readFrame(executor: Executor, dest: IntArray, offset: Int) =
+    suspendCancellableCoroutine<Unit> { continuation ->
+        takePicture(executor, object : ImageCapture.OnImageCapturedCallback() {
+            override fun onCaptureSuccess(image: ImageProxy) {
+                try {
+                    if (!continuation.isActive) return
+                    val bitmap = image.toBitmap()
+                    try {
+                        val side = minOf(bitmap.width, bitmap.height)
+                        val transform = Matrix().apply {
+                            postRotate(image.imageInfo.rotationDegrees.toFloat())
+                            postScale(-GIF_SIZE.toFloat() / side, GIF_SIZE.toFloat() / side)
+                        }
+                        val square = Bitmap.createBitmap(bitmap, (bitmap.width - side) / 2, (bitmap.height - side) / 2,
+                            side, side, transform, true)
+                        try {
+                            square.getPixels(dest, offset, GIF_SIZE, 0, 0, GIF_SIZE, GIF_SIZE)
+                        } finally {
+                            if (square !== bitmap) square.recycle()
+                        }
+                    } finally {
+                        bitmap.recycle()
+                    }
+                    continuation.resume(Unit)
+                } catch (e: Exception) {
+                    if (continuation.isActive) continuation.resumeWithException(e)
+                } finally {
+                    image.close()
+                }
+            }
+
+            override fun onError(exception: ImageCaptureException) {
+                if (continuation.isActive) continuation.resumeWithException(exception)
+            }
+        })
+    }
