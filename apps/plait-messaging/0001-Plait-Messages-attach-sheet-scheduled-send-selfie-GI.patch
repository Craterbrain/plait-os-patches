+package com.android.messaging.ui.conversation.composer.ui
+
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.widget.Toast
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.lazy.grid.GridCells
+import androidx.compose.foundation.lazy.grid.LazyVerticalGrid
+import androidx.compose.foundation.lazy.grid.items
+import androidx.compose.material3.AlertDialog
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import coil3.compose.AsyncImage
+import com.android.messaging.R
+
+@Composable
+internal fun GifPicker(onAttach: (List<String>) -> Unit, onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    val resolver = context.contentResolver
+    val prefs = remember(context) { context.getSharedPreferences("plait_gifs", Context.MODE_PRIVATE) }
+    val recent = remember(context) {
+        val readable = resolver.persistedUriPermissions.filter { it.isReadPermission }.map { it.uri }.toSet()
+        prefs.getString("recent", "").orEmpty().lineSequence().filter(String::isNotBlank)
+            .map(Uri::parse).filter { it in readable }.take(12).toList()
+    }
+    val picker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri != null) {
+            try {
+                resolver.takePersistableUriPermission(uri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                val kept = (listOf(uri) + recent).distinct().take(12)
+                (recent - kept.toSet()).forEach {
+                    runCatching { resolver.releasePersistableUriPermission(it, Intent.FLAG_GRANT_READ_URI_PERMISSION) }
+                }
+                prefs.edit().putString("recent", kept.joinToString("\n")).apply()
+            } catch (e: SecurityException) {
+                // The transient picker grant can still be used for this attachment.
+            }
+            onAttach(listOf(uri.toString()))
+            onDismiss()
+        }
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(R.string.plait_attach_gifs)) },
+        text = {
+            Column {
+                if (recent.isNotEmpty()) {
+                    Text(stringResource(R.string.plait_gif_recent))
+                    LazyVerticalGrid(GridCells.Adaptive(64.dp), Modifier.heightIn(max = 190.dp)) {
+                        items(recent, key = Uri::toString) { uri ->
+                            AsyncImage(
+                                model = uri,
+                                contentDescription = stringResource(R.string.plait_attach_gifs),
+                                modifier = Modifier.size(64.dp).clickable {
+                                    onAttach(listOf(uri.toString()))
+                                    onDismiss()
+                                }.padding(3.dp),
+                            )
+                        }
+                    }
+                }
+                TextButton(onClick = { picker.launch(arrayOf("image/gif")) }) {
+                    Text(stringResource(R.string.plait_gif_local))
+                }
+                Text(stringResource(R.string.plait_gif_external_detail))
+                TextButton(onClick = {
+                    try {
+                        context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse("https://giphy.com/")))
+                    } catch (e: ActivityNotFoundException) {
+                        Toast.makeText(context, R.string.activity_not_found_message, Toast.LENGTH_SHORT).show()
+                    }
+                }) { Text(stringResource(R.string.plait_gif_external)) }
+            }
+        },
+        confirmButton = { TextButton(onClick = onDismiss) { Text(stringResource(android.R.string.cancel)) } },
+    )
+}
