@@ -0,0 +1,151 @@
+package com.android.messaging.plait.schedule
+
+import android.app.DatePickerDialog
+import android.app.TimePickerDialog
+import android.content.SharedPreferences
+import android.text.format.DateFormat
+import android.widget.Toast
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.AlertDialog
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import com.android.messaging.R
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.ZonedDateTime
+import java.time.format.DateTimeFormatter
+import java.time.format.FormatStyle
+import java.util.Date
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+@Composable
+internal fun ScheduleDialog(
+    conversationId: String,
+    canSchedule: Boolean,
+    onSchedule: (Long) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val pending = rememberScheduledMessages(conversationId)
+
+    fun submit(at: ZonedDateTime) {
+        val millis = at.toInstant().toEpochMilli()
+        if (millis <= System.currentTimeMillis()) {
+            Toast.makeText(context, R.string.plait_schedule_future, Toast.LENGTH_SHORT).show()
+            return
+        }
+        onSchedule(millis)
+        onDismiss()
+    }
+
+    val now = ZonedDateTime.now()
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(R.string.plait_schedule_title)) },
+        text = {
+            Column(Modifier.heightIn(max = 350.dp).verticalScroll(rememberScrollState())) {
+                if (canSchedule) {
+                    quickTimes(now).forEach { option ->
+                        TextButton(onClick = { submit(option.at) }) {
+                            Text(option.at.format(DateTimeFormatter.ofLocalizedDateTime(FormatStyle.SHORT)))
+                        }
+                    }
+                    TextButton(onClick = {
+                        DatePickerDialog(context, { _, year, month, day ->
+                            val date = LocalDate.of(year, month + 1, day)
+                            TimePickerDialog(context, { _, hour, minute ->
+                                submit(date.atTime(hour, minute).atZone(ZoneId.systemDefault()))
+                            }, now.hour, now.minute, DateFormat.is24HourFormat(context)).show()
+                        }, now.year, now.monthValue - 1, now.dayOfMonth).apply {
+                            datePicker.minDate = System.currentTimeMillis()
+                        }.show()
+                    }) { Text(stringResource(R.string.plait_schedule_choose)) }
+                } else {
+                    Text(stringResource(R.string.plait_schedule_text_only))
+                }
+                if (pending.isNotEmpty()) {
+                    Text(stringResource(R.string.plait_schedule_pending), style = MaterialTheme.typography.titleSmall)
+                }
+                pending.forEach { message ->
+                    Text(message.text.ifBlank { message.subject }, maxLines = 2)
+                    Text(java.text.DateFormat.getDateTimeInstance().format(Date(message.sendAtMillis)),
+                        style = MaterialTheme.typography.bodySmall)
+                    if (message.failed) Text(stringResource(R.string.plait_schedule_retry_status))
+                    Row {
+                        if (message.failed) {
+                            TextButton(onClick = {
+                                scope.launch {
+                                    val result = withContext(Dispatchers.IO) {
+                                        runCatching { ScheduledSend.retry(context, message.id) }
+                                    }
+                                    if (result.isFailure) {
+                                        Toast.makeText(context, R.string.plait_schedule_failed, Toast.LENGTH_SHORT).show()
+                                    }
+                                }
+                            }) { Text(stringResource(R.string.plait_schedule_retry)) }
+                        }
+                        TextButton(onClick = {
+                            scope.launch(Dispatchers.IO) { ScheduledSend.cancel(context, message.id) }
+                        }) { Text(stringResource(R.string.plait_schedule_remove)) }
+                    }
+                }
+            }
+        },
+        confirmButton = { TextButton(onClick = onDismiss) { Text(stringResource(android.R.string.cancel)) } },
+    )
+}
+
+
+@Composable
+internal fun ScheduledMessagesSummary(conversationId: String, onOpen: () -> Unit) {
+    val messages = rememberScheduledMessages(conversationId)
+    val next = messages.firstOrNull() ?: return
+    val time = java.text.DateFormat.getDateTimeInstance(
+        java.text.DateFormat.SHORT, java.text.DateFormat.SHORT,
+    ).format(Date(next.sendAtMillis))
+    val label = when {
+        messages.any { it.failed } -> stringResource(R.string.plait_schedule_retry_status)
+        messages.size == 1 -> stringResource(R.string.plait_schedule_next, time)
+        else -> stringResource(R.string.plait_schedule_pending)
+    }
+    TextButton(onClick = onOpen, modifier = Modifier.fillMaxWidth()) { Text(label, maxLines = 2) }
+}
+
+@Composable
+private fun rememberScheduledMessages(conversationId: String): List<ScheduledMessage> {
+    val context = LocalContext.current
+    var pending by remember(conversationId) {
+        mutableStateOf(ScheduledSend.forConversation(context, conversationId))
+    }
+    DisposableEffect(context, conversationId) {
+        val prefs = ScheduledSend.prefs(context)
+        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ ->
+            pending = ScheduledSend.forConversation(context, conversationId)
+        }
+        prefs.registerOnSharedPreferenceChangeListener(listener)
+        pending = ScheduledSend.forConversation(context, conversationId)
+        onDispose { prefs.unregisterOnSharedPreferenceChangeListener(listener) }
+    }
+
+    return pending
+}
diff --git a/src/com/android/messaging/plait/schedule/ScheduledMessage.kt b/src/com/android/messaging/plait/schedule/ScheduledMessage.kt
new file mode 100644
index 00000000..4e2ea99c
--- /dev/null
+++ b/src/com/android/messaging/plait/schedule/ScheduledMessage.kt
@@ -0,0 +1,88 @@
+package com.android.messaging.plait.schedule
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.DayOfWeek
+import java.time.LocalTime
+import java.time.ZonedDateTime
+import java.time.temporal.TemporalAdjusters
+
+/**
+ * PlaitOS: a message waiting to be sent at [sendAtMillis]. Text only for now (a subject counts as text): the draft's
+ * attachments live in scratch space the draft may clean up, so scheduling one with attachments is refused.
+ * [failed] marks one whose send did not go through; it stays until the person retries or cancels it.
+ */
+internal data class ScheduledMessage(
+    val id: String,
+    val conversationId: String,
+    val text: String,
+    val subject: String,
+    val sendAtMillis: Long,
+    val failed: Boolean = false,
+    val selfParticipantId: String? = null,
+)
+
+/** How scheduled messages are stored (one JSON array); anything unreadable is dropped rather than crashing. */
+internal object ScheduledMessageCodec {
+    fun encode(messages: List<ScheduledMessage>): String =
+        JSONArray().apply {
+            messages.forEach { m ->
+                put(
+                    JSONObject()
+                        .put("id", m.id)
+                        .put("conversationId", m.conversationId)
+                        .put("text", m.text)
+                        .put("subject", m.subject)
+                        .put("sendAt", m.sendAtMillis)
+                        .put("failed", m.failed)
+                        .put("self", m.selfParticipantId),
+                )
+            }
+        }.toString()
+
+    fun decode(json: String?): List<ScheduledMessage> {
+        if (json.isNullOrBlank()) return emptyList()
+        return runCatching {
+            val array = JSONArray(json)
+            (0 until array.length()).mapNotNull { i ->
+                val o = array.optJSONObject(i) ?: return@mapNotNull null
+                val id = o.optString("id")
+                val conversationId = o.optString("conversationId")
+                if (id.isEmpty() || conversationId.isEmpty() || !o.has("sendAt")) return@mapNotNull null
+                ScheduledMessage(
+                    id = id,
+                    conversationId = conversationId,
+                    text = o.optString("text"),
+                    subject = o.optString("subject"),
+                    sendAtMillis = o.getLong("sendAt"),
+                    failed = o.optBoolean("failed"),
+                    selfParticipantId = o.optString("self").takeIf(String::isNotEmpty),
+                )
+            }
+        }.getOrDefault(emptyList())
+    }
+}
+
+/** A quick choice in the schedule sheet. */
+internal enum class QuickTimeKind { LaterToday, Tomorrow, NextMonday }
+
+internal data class QuickTime(val kind: QuickTimeKind, val at: ZonedDateTime)
+
+/**
+ * The quick choices for [now]: later today at 6 PM (only while that is at least an hour away), tomorrow at 8 AM, and
+ * Monday at 8 AM (left out when tomorrow already is Monday). Times are in [now]'s zone.
+ */
+internal fun quickTimes(now: ZonedDateTime): List<QuickTime> {
+    val evening = LocalTime.of(18, 0)
+    val morning = LocalTime.of(8, 0)
+    val result = mutableListOf<QuickTime>()
+    val today6pm = now.with(evening).withSecond(0).withNano(0)
+    if (!today6pm.isBefore(now.plusHours(1))) result += QuickTime(QuickTimeKind.LaterToday, today6pm)
+    val tomorrow = now.toLocalDate().plusDays(1)
+    result += QuickTime(QuickTimeKind.Tomorrow, tomorrow.atTime(morning).atZone(now.zone))
+    if (tomorrow.dayOfWeek != DayOfWeek.MONDAY) {
+        val monday = now.toLocalDate().with(TemporalAdjusters.next(DayOfWeek.MONDAY))
+        result += QuickTime(QuickTimeKind.NextMonday, monday.atTime(morning).atZone(now.zone))
+    }
+    return result
+}
diff --git a/src/com/android/messaging/plait/schedule/ScheduledSend.kt b/src/com/android/messaging/plait/schedule/ScheduledSend.kt
new file mode 100644
index 00000000..611b239a
--- /dev/null
+++ b/src/com/android/messaging/plait/schedule/ScheduledSend.kt
@@ -0,0 +1,124 @@
+package com.android.messaging.plait.schedule
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.SharedPreferences
+import java.util.UUID
+
+/**
+ * PlaitOS: scheduled messages. Kept in this app's own storage and sent by an exact alarm (set again after a reboot or
+ * an app update, see BootAndPackageReplacedReceiver), through the same send path as tapping Send. The phone has to be
+ * on at the time.
+ */
+internal object ScheduledSend {
+    private const val PREFS = "plait_scheduled_messages"
+    private const val KEY = "messages"
+    const val ACTION_SEND = "com.android.messaging.plait.SEND_SCHEDULED"
+    const val EXTRA_ID = "id"
+
+    private val lock = Any()
+    private val dispatching = mutableSetOf<String>()
+
+    fun prefs(context: Context): SharedPreferences =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    fun all(context: Context): List<ScheduledMessage> = ScheduledMessageCodec.decode(prefs(context).getString(KEY, null))
+
+    fun forConversation(context: Context, conversationId: String): List<ScheduledMessage> =
+        all(context).filter { it.conversationId == conversationId }.sortedBy { it.sendAtMillis }
+
+    fun find(context: Context, id: String): ScheduledMessage? = all(context).firstOrNull { it.id == id }
+
+    /** Schedules [text] (and [subject]) for [conversationId] at [sendAtMillis]; returns the new message. */
+    fun add(context: Context, conversationId: String, text: String, subject: String, sendAtMillis: Long, self: String?) {
+        require(sendAtMillis > System.currentTimeMillis())
+        val message = ScheduledMessage(UUID.randomUUID().toString(), conversationId, text, subject, sendAtMillis,
+            selfParticipantId = self)
+        check(update(context) { it + message })
+        try {
+            arm(context, message)
+        } catch (e: RuntimeException) {
+            cancel(context, message.id)
+            throw e
+        }
+    }
+
+    fun claim(context: Context, id: String): ScheduledMessage? = synchronized(lock) {
+        val message = find(context, id)?.takeIf { !it.failed && it.sendAtMillis <= System.currentTimeMillis() }
+            ?: return@synchronized null
+        if (id in dispatching || !markFailed(context, id)) return@synchronized null
+        dispatching.add(id)
+        message
+    }
+
+    fun cancel(context: Context, id: String) = synchronized(lock) {
+        disarm(context, id)
+        update(context) { list -> list.filterNot { it.id == id } }
+    }
+
+    fun finish(context: Context, id: String, queued: Boolean) = synchronized(lock) {
+        if (dispatching.remove(id) && queued) {
+            update(context) { list -> list.filterNot { it.id == id } }
+        }
+    }
+
+    fun markFailed(context: Context, id: String) =
+        update(context) { list -> list.map { if (it.id == id) it.copy(failed = true) else it } }
+
+    /** Tries a failed one again in a few seconds. */
+    fun retry(context: Context, id: String) = synchronized(lock) {
+        check(id !in dispatching)
+        val retried = find(context, id)?.takeIf { it.failed }?.copy(failed = false, sendAtMillis = System.currentTimeMillis() + 3_000) ?: return@synchronized
+        if (update(context) { list -> list.map { if (it.id == id) retried else it } }) {
+            try {
+                arm(context, retried)
+            } catch (e: RuntimeException) {
+                markFailed(context, id)
+                throw e
+            }
+        }
+    }
+
+    /** After a reboot or an app update alarms are gone: set every waiting one again (overdue ones go out now). */
+    fun rearmAll(context: Context) = synchronized(lock) {
+        all(context).filterNot { it.failed }.forEach { message ->
+            try {
+                arm(context, message)
+            } catch (e: RuntimeException) {
+                markFailed(context, message.id)
+            }
+        }
+    }
+
+    private fun update(context: Context, change: (List<ScheduledMessage>) -> List<ScheduledMessage>) = synchronized(lock) {
+        val p = prefs(context)
+        val next = change(ScheduledMessageCodec.decode(p.getString(KEY, null)))
+        p.edit().putString(KEY, ScheduledMessageCodec.encode(next)).commit()
+    }
+
+    private fun arm(context: Context, message: ScheduledMessage) {
+        val alarms = checkNotNull(context.getSystemService(AlarmManager::class.java))
+        val at = maxOf(message.sendAtMillis, System.currentTimeMillis() + 1_000)
+        val operation = checkNotNull(operation(context, message.id, PendingIntent.FLAG_UPDATE_CURRENT))
+        // USE_EXACT_ALARM is declared, so exact alarms are allowed; fall back to an inexact one if not
+        if (alarms.canScheduleExactAlarms()) {
+            alarms.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, operation)
+        } else {
+            alarms.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, operation)
+        }
+    }
+
+    private fun disarm(context: Context, id: String) {
+        val operation = operation(context, id, PendingIntent.FLAG_NO_CREATE) ?: return
+        context.getSystemService(AlarmManager::class.java)?.cancel(operation)
+        operation.cancel()
+    }
+
+    private fun operation(context: Context, id: String, flags: Int): PendingIntent? {
+        val intent = Intent(context, ScheduledSendReceiver::class.java).setAction(ACTION_SEND).putExtra(EXTRA_ID, id)
+            .setData(android.net.Uri.parse("plait-scheduled:$id"))   // one PendingIntent per message
+        return PendingIntent.getBroadcast(context, 0, intent, flags or PendingIntent.FLAG_IMMUTABLE)
+    }
+}
diff --git a/src/com/android/messaging/plait/schedule/ScheduledSendReceiver.kt b/src/com/android/messaging/plait/schedule/ScheduledSendReceiver.kt
new file mode 100644
index 00000000..940282fa
--- /dev/null
+++ b/src/com/android/messaging/plait/schedule/ScheduledSendReceiver.kt
@@ -0,0 +1,75 @@
+package com.android.messaging.plait.schedule
+
+import android.app.role.RoleManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import com.android.messaging.data.conversation.model.ConversationId
+import com.android.messaging.data.conversation.model.ParticipantId
+import com.android.messaging.data.conversation.model.draft.ConversationDraft
+import com.android.messaging.domain.conversation.usecase.draft.SendConversationDraft
+import com.android.messaging.util.LogUtil
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeout
+
+/**
+ * PlaitOS: sends a scheduled message when its alarm fires, through SendConversationDraft (the same validation and
+ * send as tapping Send). A failed send is kept and marked, so the conversation shows it with Retry instead of losing it.
+ */
+class ScheduledSendReceiver : BroadcastReceiver() {
+
+    @EntryPoint
+    @InstallIn(SingletonComponent::class)
+    internal interface Dependencies {
+        fun sendConversationDraft(): SendConversationDraft
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != ScheduledSend.ACTION_SEND) return
+        val id = intent.getStringExtra(ScheduledSend.EXTRA_ID) ?: return
+        val app = context.applicationContext
+        val pending = goAsync()
+        CoroutineScope(SupervisorJob() + Dispatchers.IO).launch {
+            var claimed = false
+            var queued = false
+            try {
+                val message = ScheduledSend.claim(app, id) ?: return@launch
+                claimed = true
+                if (app.getSystemService(RoleManager::class.java)?.isRoleHeld(RoleManager.ROLE_SMS) != true) {
+                    return@launch
+                }
+                val send = EntryPointAccessors.fromApplication(app, Dependencies::class.java).sendConversationDraft()
+                withTimeout(SEND_TIMEOUT_MILLIS) {
+                    send(
+                        conversationId = ConversationId(message.conversationId),
+                        draft = ConversationDraft(
+                            messageText = message.text,
+                            subjectText = message.subject,
+                            selfParticipantId = message.selfParticipantId?.let(::ParticipantId),
+                        ),
+                    ).collect()
+                }
+                queued = true
+            } catch (e: Exception) {
+                LogUtil.w(TAG, "Scheduled message could not be sent", e)
+            } finally {
+                if (claimed) ScheduledSend.finish(app, id, queued)
+                pending.finish()
+            }
+        }
+    }
+
+    private companion object {
+        const val TAG = "PlaitScheduledSend"
+        // goAsync gives about 10 s before the broadcast is considered stuck; sending is queued well before that
+        const val SEND_TIMEOUT_MILLIS = 8_000L
+    }
+}
