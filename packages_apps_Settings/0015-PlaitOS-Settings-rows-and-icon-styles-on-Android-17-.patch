diff --git a/src/com/android/settings/plait/PlaitControllers.kt b/src/com/android/settings/plait/PlaitControllers.kt
index ad14ffc..abf65b4 100644
--- a/src/com/android/settings/plait/PlaitControllers.kt
+++ b/src/com/android/settings/plait/PlaitControllers.kt
@@ -50,7 +50,9 @@ open class PlaitListController(context: Context, key: String) :
         super.updateState(preference)
         val list = preference as? ListPreference ?: return
         list.value = PlaitSettings.get(mContext, preferenceKey).toString()
-        list.summary = list.entry
+        // "%s": ListPreference fills in the chosen entry. Never the entry itself: its text goes through
+        // String.format, and an entry like "50%" crashes Settings
+        list.summary = "%s"
     }
 
     override fun onPreferenceChange(preference: Preference, newValue: Any?): Boolean {
@@ -58,7 +60,9 @@ open class PlaitListController(context: Context, key: String) :
         PlaitSettings.put(mContext, preferenceKey, value)
         val list = preference as ListPreference
         list.value = newValue
-        list.summary = list.entry
+        // "%s": ListPreference fills in the chosen entry. Never the entry itself: its text goes through
+        // String.format, and an entry like "50%" crashes Settings
+        list.summary = "%s"
         onValueChanged(value)
         return true
     }
diff --git a/src/com/android/settings/plait/PlaitIconStyler.kt b/src/com/android/settings/plait/PlaitIconStyler.kt
index 842397b..df87fdb 100644
--- a/src/com/android/settings/plait/PlaitIconStyler.kt
+++ b/src/com/android/settings/plait/PlaitIconStyler.kt
@@ -11,12 +11,14 @@ import android.graphics.Color
 import android.graphics.drawable.AdaptiveIconDrawable
 import android.graphics.drawable.BitmapDrawable
 import android.graphics.drawable.Drawable
+import android.graphics.drawable.DrawableWrapper
 import android.graphics.drawable.GradientDrawable
 import android.graphics.drawable.LayerDrawable
 import android.os.UserHandle
 import android.provider.Settings
 import androidx.preference.Preference
 import androidx.preference.PreferenceGroup
+import com.android.settingslib.widget.AdaptiveIconShapeDrawable
 import kotlin.math.abs
 import kotlin.random.Random
 
@@ -99,7 +101,20 @@ object PlaitIconStyler {
         if (icon is StyledIcon || icon is BitmapDrawable || icon is AdaptiveIconDrawable) return
         val color = colorFor(preference.key, context)
         val accent = accent(context)
-        preference.icon = styled(icon.mutate(), style, color, accent, context)
+        preference.icon = styled(symbolOf(icon).mutate(), style, color, accent, context)
+    }
+
+    /**
+     * The symbol to restyle. Android 17's expressive home tiles are already finished artwork: a layer-list of a colored
+     * shape (AdaptiveIconShapeDrawable) under the symbol in a TintDrawable. Restyling all of it would paint the whole
+     * tile white, so only its symbol is taken. Any other icon is the symbol itself.
+     */
+    private fun symbolOf(icon: Drawable): Drawable {
+        if (icon !is LayerDrawable || icon.numberOfLayers < 2 || icon.getDrawable(0) !is AdaptiveIconShapeDrawable) {
+            return icon
+        }
+        val top = icon.getDrawable(icon.numberOfLayers - 1) ?: return icon
+        return (top as? DrawableWrapper)?.drawable ?: top
     }
 
     private fun styled(icon: Drawable, style: Style, color: Int, accent: Int, context: Context):
