From bceaa71b41b021a4f3640a6e76337c685a3ab40c Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Fri, 20 Nov 2026 07:40:30 -0600
Subject: [PATCH] PlaitOS: Settings rows and icon styles on Android 17's pages

- The pages that hold PlaitOS rows (Display, Sound, Lock screen, 3-button
  navigation) stay on their XML: with the catalyst flags on, Settings built
  them from code and left the rows out (search, reading the XML, still found them)
- The PlaitOS tile is on the expressive home page too (top_level_settings_expressive*)
- Icon styles also apply to screens built from code, and restyle only the symbol
  of the expressive home tiles (the whole tile was painted white)
- List summaries use %s: an entry like 50% crashed Settings in String.format

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 res/drawable/ic_homepage_plait.xml            | 21 +++++++++++++++++++
 res/xml/top_level_settings_expressive.xml     |  8 +++++++
 .../top_level_settings_expressive_desktop.xml |  8 +++++++
 src/com/android/settings/DisplaySettings.java |  4 +++-
 .../settings/SettingsPreferenceFragment.java  |  2 ++
 .../ButtonNavigationSettingsFragment.java     |  4 +++-
 .../settings/notification/SoundSettings.java  |  4 +++-
 .../settings/plait/PlaitControllers.kt        |  8 +++++--
 .../android/settings/plait/PlaitIconStyler.kt | 17 ++++++++++++++-
 .../security/LockscreenDashboardFragment.java |  4 +++-
 10 files changed, 73 insertions(+), 7 deletions(-)
 create mode 100644 res/drawable/ic_homepage_plait.xml

diff --git a/res/drawable/ic_homepage_plait.xml b/res/drawable/ic_homepage_plait.xml
new file mode 100644
index 0000000..898f8e8
--- /dev/null
+++ b/res/drawable/ic_homepage_plait.xml
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- PlaitOS settings entry on the expressive home page: the "tune" symbol on a colored circle, like the stock tiles -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+
+    <item>
+        <com.android.settingslib.widget.AdaptiveIconShapeDrawable
+            android:width="@dimen/dashboard_tile_image_size"
+            android:height="@dimen/dashboard_tile_image_size"
+            android:color="@color/homepage_cyan_bg" />
+    </item>
+
+    <item
+        android:width="@dimen/dashboard_tile_foreground_image_size"
+        android:height="@dimen/dashboard_tile_foreground_image_size"
+        android:start="@dimen/dashboard_tile_foreground_image_inset"
+        android:top="@dimen/dashboard_tile_foreground_image_inset">
+        <com.android.settings.widget.TintDrawable
+            android:drawable="@drawable/ic_settings_plait_filled"
+            android:tint="@color/homepage_cyan_fg" />
+    </item>
+</layer-list>
