@@ -0,0 +1,81 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 (PlaitOS). Every always-on display and Peek Display option on
+     one page (Display > Always show time and info). Row keys are the settings they write. -->
+<PreferenceScreen
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:settings="http://schemas.android.com/apk/res-auto"
+    android:key="plait_always_on_display_screen"
+    android:title="@string/plait_aod_title">
+
+    <com.android.settingslib.widget.MainSwitchPreference
+        android:key="doze_always_on"
+        android:title="@string/plait_aod_main_switch"
+        settings:keywords="@string/keywords_always_show_time_info"
+        settings:controller="com.android.settings.plait.AodMainSwitchController" />
+
+    <PreferenceCategory
+        android:key="plait_aod_when"
+        android:title="@string/plait_aod_when_category">
+        <ListPreference
+            android:key="plait_doze_always_on_auto_mode"
+            android:dependency="doze_always_on"
+            android:icon="@drawable/ic_plait_sym_schedule"
+            android:title="@string/plait_aod_schedule_title"
+            android:entries="@array/plait_aod_schedule_entries"
+            android:entryValues="@array/plait_aod_schedule_values"
+            settings:controller="com.android.settings.plait.AodScheduleModeController" />
+        <Preference
+            android:key="plait_doze_always_on_auto_time_from"
+            android:dependency="doze_always_on"
+            android:icon="@drawable/ic_plait_sym_light_mode"
+            android:title="@string/plait_aod_from_title"
+            settings:controller="com.android.settings.plait.AodScheduleTimeController" />
+        <Preference
+            android:key="plait_doze_always_on_auto_time_till"
+            android:dependency="doze_always_on"
+            android:icon="@drawable/ic_plait_sym_dark_mode"
+            android:title="@string/plait_aod_till_title"
+            settings:controller="com.android.settings.plait.AodScheduleTimeController" />
+        <SwitchPreferenceCompat
+            android:key="plait_doze_on_charge"
+            android:dependency="doze_always_on"
+            android:icon="@drawable/ic_plait_sym_battery_charging_full"
+            android:title="@string/plait_doze_on_charge_title"
+            android:summary="@string/plait_doze_on_charge_summary"
+            settings:controller="com.android.settings.plait.AodAvailableSwitchController" />
+    </PreferenceCategory>
+
+    <PreferenceCategory
+        android:key="plait_peek_category"
+        android:title="@string/plait_peek_title">
+        <SwitchPreferenceCompat
+            android:key="plait_peek_display"
+            android:icon="@drawable/ic_plait_sym_notifications_active"
+            android:title="@string/plait_peek_title"
+            android:summary="@string/plait_peek_summary"
+            settings:controller="com.android.settings.plait.PeekDisplaySwitchController" />
+        <SwitchPreferenceCompat
+            android:key="plait_peek_breathing"
+            android:icon="@drawable/ic_plait_sym_animation"
+            android:title="@string/plait_peek_breathing_title"
+            android:summary="@string/plait_peek_breathing_summary"
+            android:dependency="plait_peek_display"
+            settings:controller="com.android.settings.plait.PlaitSwitchController" />
+        <ListPreference
+            android:key="plait_peek_breathing_interval"
+            android:icon="@drawable/ic_plait_sym_repeat"
+            android:title="@string/plait_peek_interval_title"
+            android:entries="@array/plait_peek_interval_entries"
+            android:entryValues="@array/plait_peek_interval_values"
+            android:dependency="plait_peek_breathing"
+            settings:controller="com.android.settings.plait.PlaitListController" />
+        <ListPreference
+            android:key="plait_peek_breathing_duration"
+            android:icon="@drawable/ic_plait_sym_timer"
+            android:title="@string/plait_peek_duration_title"
+            android:entries="@array/plait_peek_duration_entries"
+            android:entryValues="@array/plait_peek_duration_values"
+            android:dependency="plait_peek_breathing"
+            settings:controller="com.android.settings.plait.PlaitListController" />
+    </PreferenceCategory>
+</PreferenceScreen>
