@@ -0,0 +1,51 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.plait;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+/**
+ * The always-on display page (Display > Always show time and info, and Lock screen > PlaitOS):
+ * the switch, when it shows (always, only while charging, a schedule, also while charging) and
+ * Peek Display, which draws the always-on screen when both are on. Replaces the stock catalyst
+ * page, which has no room for the PlaitOS rows. Rows and controllers: R.xml.plait_always_on_display.
+ */
+@SearchIndexable
+public class PlaitAlwaysOnDisplayFragment extends DashboardFragment {
+    private static final String TAG = "PlaitAlwaysOnDisplay";
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.plait_always_on_display;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.AMBIENT_DISPLAY_ALWAYS_ON;
+    }
+
+    @Override
+    public @Nullable String getPreferenceScreenBindingKey(@NonNull Context context) {
+        return null; // the XML page, not the catalyst screen
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.plait_always_on_display);
+}
diff --git a/src/com/android/settings/plait/PlaitControllers.kt b/src/com/android/settings/plait/PlaitControllers.kt
index 3e74b5e..cd59a15 100644
--- a/src/com/android/settings/plait/PlaitControllers.kt
+++ b/src/com/android/settings/plait/PlaitControllers.kt
@@ -176,8 +176,38 @@ class PowerMenuActionsController(context: Context, key: String) :
 }
 
 /**
- * Always-on display schedule mode. The "from" and "till" rows only show for the modes that use
- * them: 2 custom (both), 3 sunset to a time (till), 4 a time to sunrise (from).
+ * The always-on display switch (Settings.Secure doze_always_on). PlaitOS keeps it the user's own:
+ * the schedule and "only while charging" decide when it shows, they never write it.
+ */
+class AodMainSwitchController(context: Context, key: String) :
+    TogglePreferenceController(context, key) {
+
+    override fun getAvailabilityStatus() =
+        if (android.hardware.display.AmbientDisplayConfiguration(mContext)
+                .alwaysOnAvailableForUser(UserHandle.myUserId())) {
+            AVAILABLE
+        } else {
+            UNSUPPORTED_ON_DEVICE
+        }
+
+    override fun isChecked() =
+        Settings.Secure.getIntForUser(mContext.contentResolver, Settings.Secure.DOZE_ALWAYS_ON,
+            if (mContext.resources.getBoolean(
+                    com.android.internal.R.bool.config_dozeAlwaysOnEnabled)) 1 else 0,
+            UserHandle.myUserId()) == 1
+
+    override fun setChecked(isChecked: Boolean) =
+        Settings.Secure.putIntForUser(mContext.contentResolver, Settings.Secure.DOZE_ALWAYS_ON,
+            if (isChecked) 1 else 0, UserHandle.myUserId())
+
+    override fun getSliceHighlightMenuRes() = R.string.menu_key_display
+}
+
+/**
+ * When the always-on display shows (AmbientDisplayConfiguration.AOD_MODE): 0 always, 5 only
+ * while charging, 1-4 a schedule. The "from" and "till" rows only show for the modes that use
+ * them (2 custom: both, 3 sunset to a time: till, 4 a time to sunrise: from), "also while
+ * charging" only with a schedule.
  */
 class AodScheduleModeController(context: Context, key: String) : PlaitListController(context, key) {
     private var screen: PreferenceScreen? = null
@@ -197,6 +227,11 @@ class AodScheduleModeController(context: Context, key: String) : PlaitListContro
             mode == 2 || mode == 4
         screen?.findPreference<Preference>(AodScheduleTimeController.KEY_TILL)?.isVisible =
             mode == 2 || mode == 3
+        screen?.findPreference<Preference>(KEY_ON_CHARGE)?.isVisible = mode in 1..4
+    }
+
+    companion object {
+        private const val KEY_ON_CHARGE = "plait_doze_on_charge"
     }
 }
 
