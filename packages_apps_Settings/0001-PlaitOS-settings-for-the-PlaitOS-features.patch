diff --git a/src/com/android/settings/plait/PlaitSettings.kt b/src/com/android/settings/plait/PlaitSettings.kt
new file mode 100644
index 0000000..da8a812
--- /dev/null
+++ b/src/com/android/settings/plait/PlaitSettings.kt
@@ -0,0 +1,168 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.plait
+
+import android.content.Context
+import android.os.UserHandle
+import android.provider.Settings
+
+/** The three settings tables a PlaitOS key can live in. */
+enum class PlaitTable {
+    SYSTEM,
+    SECURE,
+    GLOBAL,
+}
+
+/**
+ * The plain Settings keys the PlaitOS framework patches read, their table and their default (the
+ * value the framework uses while the key is unset, which matches stock GrapheneOS unless noted).
+ * Rows in Settings are keyed by the setting's name, so generic controllers can serve all of them.
+ */
+object PlaitSettings {
+
+    class Key(val table: PlaitTable, val default: Int)
+
+    private val SYSTEM = PlaitTable.SYSTEM
+    private val SECURE = PlaitTable.SECURE
+    private val GLOBAL = PlaitTable.GLOBAL
+
+    /** Every PlaitOS key; "Reset PlaitOS settings" clears exactly these. */
+    val KEYS: Map<String, Key> =
+        mapOf(
+            // Buttons and power menu
+            "plait_torch_long_press_power" to Key(SYSTEM, 0),
+            "plait_torch_long_press_power_timeout" to Key(SYSTEM, 0),
+            "plait_volbtn_music_controls" to Key(SYSTEM, 0),
+            "plait_volume_answer_call" to Key(SYSTEM, 0),
+            "plait_home_answer_call" to Key(SECURE, 0),
+            "plait_home_long_press_action" to Key(SYSTEM, 0),
+            "plait_back_long_press_action" to Key(SYSTEM, 0),
+            "plait_recents_long_press_action" to Key(SYSTEM, 0),
+            "plait_advanced_reboot" to Key(SECURE, 0),
+            // plait_power_menu_actions is a string, see PowerMenuActionsController
+            // Status bar
+            "plait_double_tap_to_sleep" to Key(SYSTEM, 0),
+            "plait_status_bar_clock" to Key(SYSTEM, 2),
+            "plait_status_bar_battery_style" to Key(SYSTEM, 0),
+            "plait_status_bar_battery_percent" to Key(SYSTEM, -1),
+            "plait_status_bar_brightness_control" to Key(SYSTEM, 0),
+            "plait_status_bar_brightness_control_lockscreen" to Key(SYSTEM, 0),
+            "plait_network_traffic_mode" to Key(SECURE, 0),
+            "plait_network_traffic_position" to Key(SECURE, 1),
+            "plait_network_traffic_autohide" to Key(SECURE, 0),
+            "plait_network_traffic_hide_arrows" to Key(SECURE, 0),
+            "plait_network_traffic_units" to Key(SECURE, 2),
+            "plait_network_traffic_show_units" to Key(SECURE, 1),
+            // Quick Settings
+            "plait_status_bar_quick_qs_pulldown" to Key(SYSTEM, 0),
+            "plait_qs_show_brightness_slider" to Key(SECURE, 1),
+            "plait_qs_brightness_slider_position" to Key(SECURE, 0),
+            // QS grid keys default to the device's resource values (-1 = unset)
+            "plait_qs_tiles_columns" to Key(SYSTEM, -1),
+            "plait_qs_tiles_columns_landscape" to Key(SYSTEM, -1),
+            "plait_qs_tiles_rows" to Key(SYSTEM, -1),
+            "plait_qs_tiles_rows_landscape" to Key(SYSTEM, -1),
+            "plait_qqs_tiles_rows" to Key(SYSTEM, -1),
+            "plait_qqs_tiles_rows_landscape" to Key(SYSTEM, -1),
+            // Notifications
+            "plait_heads_up_timeout" to Key(SYSTEM, -1),
+            "plait_notification_kill_app_button" to Key(SYSTEM, 0),
+            // Sound
+            "plait_volume_panel_left" to Key(SYSTEM, 0),
+            // Lock screen and display
+            "plait_peek_display" to Key(SECURE, 0),
+            "plait_peek_breathing" to Key(SECURE, 1),
+            "plait_peek_breathing_interval" to Key(SECURE, 30),
+            "plait_peek_breathing_duration" to Key(SECURE, 10),
+            "plait_doze_always_on_auto_mode" to Key(SECURE, 0),
+            // plait_doze_always_on_auto_time is a string, see AodScheduleTimeController
+            "plait_doze_on_charge" to Key(SECURE, 0),
+            "plait_pocket_judge" to Key(SYSTEM, 1), // on by default (PocketService)
+            "plait_smart_pixel_filter_enabled" to Key(SECURE, 0),
+            "plait_smart_pixel_filter_percent" to Key(SECURE, 25),
+            // Misc
+            "plait_pm_downgrade_allowed" to Key(GLOBAL, 0),
+        )
+
+    /** Stock keys that PlaitOS rows also show; reset leaves them alone. */
+    val STOCK_KEYS: Map<String, Key> =
+        mapOf(
+            "clock_seconds" to Key(SECURE, 0), // SystemUI tuner key, shared with the System UI Tuner
+            "volume_dialog_dismiss_timeout" to Key(SECURE, 3000), // ms, stock default 3 s
+        )
+
+    /** A key PlaitOS rows can show: one of [KEYS] or [STOCK_KEYS]. */
+    fun lookup(key: String): Key =
+        KEYS[key] ?: STOCK_KEYS[key] ?: throw IllegalArgumentException("Unknown PlaitOS key $key")
+
+    /** String-valued PlaitOS keys (cleared by reset too). */
+    val STRING_KEYS: Map<String, PlaitTable> =
+        mapOf(
+            "plait_power_menu_actions" to SECURE,
+            "plait_doze_always_on_auto_time" to SECURE,
+        )
+
+    fun getInt(context: Context, table: PlaitTable, key: String, default: Int): Int {
+        val cr = context.contentResolver
+        return when (table) {
+            PlaitTable.SYSTEM ->
+                Settings.System.getIntForUser(cr, key, default, UserHandle.USER_CURRENT)
+            PlaitTable.SECURE ->
+                Settings.Secure.getIntForUser(cr, key, default, UserHandle.USER_CURRENT)
+            PlaitTable.GLOBAL -> Settings.Global.getInt(cr, key, default)
+        }
+    }
+
+    fun putInt(context: Context, table: PlaitTable, key: String, value: Int): Boolean {
+        val cr = context.contentResolver
+        return when (table) {
+            PlaitTable.SYSTEM ->
+                Settings.System.putIntForUser(cr, key, value, UserHandle.USER_CURRENT)
+            PlaitTable.SECURE ->
+                Settings.Secure.putIntForUser(cr, key, value, UserHandle.USER_CURRENT)
+            PlaitTable.GLOBAL -> Settings.Global.putInt(cr, key, value)
+        }
+    }
+
+    fun getString(context: Context, table: PlaitTable, key: String): String? {
+        val cr = context.contentResolver
+        return when (table) {
+            PlaitTable.SYSTEM -> Settings.System.getStringForUser(cr, key, UserHandle.USER_CURRENT)
+            PlaitTable.SECURE -> Settings.Secure.getStringForUser(cr, key, UserHandle.USER_CURRENT)
+            PlaitTable.GLOBAL -> Settings.Global.getString(cr, key)
+        }
+    }
+
+    fun putString(context: Context, table: PlaitTable, key: String, value: String?): Boolean {
+        val cr = context.contentResolver
+        return when (table) {
+            PlaitTable.SYSTEM ->
+                Settings.System.putStringForUser(cr, key, value, UserHandle.USER_CURRENT)
+            PlaitTable.SECURE ->
+                Settings.Secure.putStringForUser(cr, key, value, UserHandle.USER_CURRENT)
+            PlaitTable.GLOBAL -> Settings.Global.putString(cr, key, value)
+        }
+    }
+
+    /** The key's current value, or its default while unset. */
+    fun get(context: Context, key: String): Int {
+        val k = lookup(key)
+        return getInt(context, k.table, key, k.default)
+    }
+
+    fun put(context: Context, key: String, value: Int): Boolean =
+        putInt(context, lookup(key).table, key, value)
+
+    /**
+     * Clears every PlaitOS key for the current user (a null value reads as unset, so the framework
+     * falls back to its default). Stock keys PlaitOS rows also show (clock_seconds,
+     * icon_blacklist, volume_dialog_dismiss_timeout) are left alone.
+     */
+    fun resetAll(context: Context) {
+        for ((key, k) in KEYS) putString(context, k.table, key, null)
+        for ((key, table) in STRING_KEYS) putString(context, table, key, null)
+    }
+}
