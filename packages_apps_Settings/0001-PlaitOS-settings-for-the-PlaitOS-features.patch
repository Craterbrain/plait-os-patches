+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.plait
+
+import android.app.AlertDialog
+import android.app.settings.SettingsEnums
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.Menu
+import android.view.MenuInflater
+import android.view.MenuItem
+import android.view.View
+import android.view.ViewGroup
+import androidx.fragment.app.Fragment
+import androidx.viewpager2.adapter.FragmentStateAdapter
+import androidx.viewpager2.widget.ViewPager2
+import com.android.settings.R
+import com.android.settings.core.InstrumentedFragment
+import com.google.android.material.tabs.TabLayout
+import com.google.android.material.tabs.TabLayoutMediator
+
+/**
+ * The PlaitOS page: options with no stock Settings home, in swipeable tabs as crDroid's settings
+ * are (Status bar, Quick Settings, Buttons, Misc), with "Reset PlaitOS settings" in the menu.
+ * Options that extend a stock setting are on that stock page instead.
+ */
+class PlaitSettingsFragment : InstrumentedFragment() {
+
+    private data class Tab(val title: Int, val create: () -> Fragment)
+
+    private val tabs =
+        listOf(
+            Tab(R.string.plait_tab_status_bar) { PlaitStatusBarFragment() },
+            Tab(R.string.plait_tab_quick_settings) { PlaitQuickSettingsFragment() },
+            Tab(R.string.plait_tab_buttons) { PlaitButtonsFragment() },
+            Tab(R.string.plait_tab_misc) { PlaitMiscFragment() },
+        )
+
+    override fun getMetricsCategory() = SettingsEnums.PAGE_UNKNOWN
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setHasOptionsMenu(true)
+    }
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        requireActivity().setTitle(R.string.plait_settings_title)
+        val root = inflater.inflate(R.layout.plait_settings_tabs, container, false)
+        val pager = root.findViewById<ViewPager2>(R.id.plait_pager)
+        pager.adapter =
+            object : FragmentStateAdapter(this) {
+                override fun getItemCount() = tabs.size
+
+                override fun createFragment(position: Int) = tabs[position].create()
+            }
+        TabLayoutMediator(root.findViewById<TabLayout>(R.id.plait_tabs), pager) { tab, position ->
+                tab.setText(tabs[position].title)
+            }
+            .attach()
+        return root
+    }
+
+    override fun onCreateOptionsMenu(menu: Menu, inflater: MenuInflater) {
+        menu.add(Menu.NONE, MENU_RESET, Menu.NONE, R.string.plait_reset_title)
+        super.onCreateOptionsMenu(menu, inflater)
+    }
+
+    override fun onOptionsItemSelected(item: MenuItem): Boolean {
+        if (item.itemId != MENU_RESET) return super.onOptionsItemSelected(item)
+        AlertDialog.Builder(requireContext())
+            .setTitle(R.string.plait_reset_title)
+            .setMessage(R.string.plait_reset_message)
+            .setPositiveButton(R.string.plait_reset_confirm) { _, _ ->
+                PlaitSettings.resetAll(requireContext())
+                // Rebuild the tabs so every row shows its default again
+                requireActivity().recreate()
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+        return true
+    }
+
+    private companion object {
+        const val MENU_RESET = Menu.FIRST
+    }
+}
