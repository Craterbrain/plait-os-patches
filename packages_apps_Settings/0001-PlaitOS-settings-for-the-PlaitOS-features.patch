diff --git a/src/com/android/settings/plait/PlaitControllers.kt b/src/com/android/settings/plait/PlaitControllers.kt
new file mode 100644
index 0000000..f95191e
--- /dev/null
+++ b/src/com/android/settings/plait/PlaitControllers.kt
@@ -0,0 +1,243 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.plait
+
+import android.app.TimePickerDialog
+import android.content.Context
+import android.os.UserHandle
+import android.provider.Settings
+import android.text.TextUtils
+import android.text.format.DateFormat
+import androidx.preference.ListPreference
+import androidx.preference.MultiSelectListPreference
+import androidx.preference.Preference
+import androidx.preference.PreferenceScreen
+import com.android.settings.R
+import com.android.settings.core.BasePreferenceController
+import com.android.settings.core.TogglePreferenceController
+import java.util.Calendar
+
+/**
+ * A switch for any PlaitOS key: the preference key is the setting's name, [PlaitSettings] knows its
+ * table and default. Used from XML as settings:controller.
+ */
+open class PlaitSwitchController(context: Context, key: String) :
+    TogglePreferenceController(context, key) {
+
+    override fun getAvailabilityStatus() = AVAILABLE
+
+    override fun isChecked() = PlaitSettings.get(mContext, preferenceKey) != 0
+
+    override fun setChecked(isChecked: Boolean) =
+        PlaitSettings.put(mContext, preferenceKey, if (isChecked) 1 else 0)
+
+    override fun getSliceHighlightMenuRes() = NO_RES
+}
+
+/**
+ * A list for any PlaitOS key: entry values in XML are the stored integers, the summary shows the
+ * chosen entry (or the default's entry while unset).
+ */
+open class PlaitListController(context: Context, key: String) :
+    BasePreferenceController(context, key), Preference.OnPreferenceChangeListener {
+
+    override fun getAvailabilityStatus() = AVAILABLE
+
+    override fun updateState(preference: Preference) {
+        super.updateState(preference)
+        val list = preference as? ListPreference ?: return
+        list.value = PlaitSettings.get(mContext, preferenceKey).toString()
+        list.summary = list.entry
+    }
+
+    override fun onPreferenceChange(preference: Preference, newValue: Any?): Boolean {
+        val value = (newValue as? String)?.toIntOrNull() ?: return false
+        PlaitSettings.put(mContext, preferenceKey, value)
+        val list = preference as ListPreference
+        list.value = newValue
+        list.summary = list.entry
+        onValueChanged(value)
+        return true
+    }
+
+    /** For subclasses that show or hide other rows. */
+    protected open fun onValueChanged(value: Int) {}
+}
+
+/** Switches only the main user may change (they act on the whole device). */
+class PlaitPrimaryUserSwitchController(context: Context, key: String) :
+    PlaitSwitchController(context, key) {
+    override fun getAvailabilityStatus() =
+        if (UserHandle.myUserId() == UserHandle.USER_SYSTEM) AVAILABLE else DISABLED_FOR_USER
+}
+
+/**
+ * Peek Display needs the stock "Wake screen for notifications" pulse, so turning it on turns
+ * that on too (turning Peek Display off leaves the stock switch as it is).
+ */
+class PeekDisplaySwitchController(context: Context, key: String) :
+    PlaitSwitchController(context, key) {
+    override fun setChecked(isChecked: Boolean): Boolean {
+        if (isChecked) {
+            Settings.Secure.putIntForUser(mContext.contentResolver, Settings.Secure.DOZE_ENABLED,
+                1, UserHandle.USER_CURRENT)
+        }
+        return super.setChecked(isChecked)
+    }
+}
+
+/**
+ * Power menu entries (Settings.Secure plait_power_menu_actions, "|"-separated). The entries keep
+ * the order of R.array.plait_power_menu_action_values; power and restart are always kept, so the
+ * menu can't be emptied. Unset = GrapheneOS's default menu, shown as its entries.
+ */
+class PowerMenuActionsController(context: Context, key: String) :
+    BasePreferenceController(context, key), Preference.OnPreferenceChangeListener {
+
+    override fun getAvailabilityStatus() =
+        if (UserHandle.myUserId() == UserHandle.USER_SYSTEM) AVAILABLE else DISABLED_FOR_USER
+
+    private fun allValues(): List<String> =
+        mContext.resources.getStringArray(R.array.plait_power_menu_action_values).toList()
+
+    private fun current(): Set<String> {
+        val stored = Settings.Secure.getStringForUser(mContext.contentResolver, KEY,
+            UserHandle.USER_CURRENT)
+        if (!TextUtils.isEmpty(stored)) return stored!!.split("|").toSet()
+        val id = mContext.resources.getIdentifier("config_globalActionsList", "array", "android")
+        return if (id != 0) mContext.resources.getStringArray(id).toSet() else ALWAYS
+    }
+
+    override fun updateState(preference: Preference) {
+        super.updateState(preference)
+        val multi = preference as? MultiSelectListPreference ?: return
+        multi.values = current()
+        multi.summary = summaryFor(multi, multi.values)
+    }
+
+    override fun onPreferenceChange(preference: Preference, newValue: Any?): Boolean {
+        @Suppress("UNCHECKED_CAST")
+        val chosen = (newValue as? Set<String> ?: return false) + ALWAYS
+        val ordered = allValues().filter { it in chosen }
+        Settings.Secure.putStringForUser(mContext.contentResolver, KEY,
+            ordered.joinToString("|"), UserHandle.USER_CURRENT)
+        val multi = preference as MultiSelectListPreference
+        multi.values = ordered.toSet()
+        multi.summary = summaryFor(multi, multi.values)
+        return false // values already applied, with power and restart forced in
+    }
+
+    private fun summaryFor(multi: MultiSelectListPreference, values: Set<String>): CharSequence {
+        val labels = multi.entryValues.indices
+            .filter { multi.entryValues[it].toString() in values }
+            .map { multi.entries[it] }
+        return TextUtils.join(", ", labels)
+    }
+
+    companion object {
+        const val KEY = "plait_power_menu_actions"
+        private val ALWAYS = setOf("power", "restart")
+    }
+}
+
+/**
+ * Always-on display schedule mode. The "from" and "till" rows only show for the modes that use
+ * them: 2 custom (both), 3 sunset to a time (till), 4 a time to sunrise (from).
+ */
+class AodScheduleModeController(context: Context, key: String) : PlaitListController(context, key) {
+    private var screen: PreferenceScreen? = null
+
+    override fun getAvailabilityStatus() = aodAvailability(mContext)
+
+    override fun displayPreference(screen: PreferenceScreen) {
+        super.displayPreference(screen)
+        this.screen = screen
+        updateTimeRows(PlaitSettings.get(mContext, preferenceKey))
+    }
+
+    override fun onValueChanged(value: Int) = updateTimeRows(value)
+
+    private fun updateTimeRows(mode: Int) {
+        screen?.findPreference<Preference>(AodScheduleTimeController.KEY_FROM)?.isVisible =
+            mode == 2 || mode == 4
+        screen?.findPreference<Preference>(AodScheduleTimeController.KEY_TILL)?.isVisible =
+            mode == 2 || mode == 3
+    }
+}
+
+/**
+ * One end of the custom always-on schedule, stored with the other end in Settings.Secure
+ * plait_doze_always_on_auto_time as "HH:mm,HH:mm" (from, till; default 20:00-07:00, as
+ * AutoAODService). Tapping opens a time picker.
+ */
+class AodScheduleTimeController(context: Context, key: String) : BasePreferenceController(context, key) {
+
+    override fun getAvailabilityStatus() = AVAILABLE
+
+    private val isFrom get() = preferenceKey == KEY_FROM
+
+    private fun read(): IntArray {
+        val stored = Settings.Secure.getStringForUser(mContext.contentResolver, SETTING,
+            UserHandle.USER_CURRENT)
+        val parts = (stored ?: DEFAULT).split(",").map { it.trim().split(":") }
+        return try {
+            intArrayOf(parts[0][0].toInt(), parts[0][1].toInt(), parts[1][0].toInt(),
+                parts[1][1].toInt())
+        } catch (e: RuntimeException) {
+            intArrayOf(20, 0, 7, 0)
+        }
+    }
+
+    override fun updateState(preference: Preference) {
+        super.updateState(preference)
+        val t = read()
+        val (h, m) = if (isFrom) t[0] to t[1] else t[2] to t[3]
+        val cal = Calendar.getInstance().apply {
+            set(Calendar.HOUR_OF_DAY, h)
+            set(Calendar.MINUTE, m)
+        }
+        preference.summary = DateFormat.getTimeFormat(mContext).format(cal.time)
+    }
+
+    override fun handlePreferenceTreeClick(preference: Preference): Boolean {
+        if (preference.key != preferenceKey) return false
+        val t = read()
+        val (h, m) = if (isFrom) t[0] to t[1] else t[2] to t[3]
+        TimePickerDialog(preference.context, { _, hour, minute ->
+            val now = read()
+            val value = if (isFrom) {
+                "%02d:%02d,%02d:%02d".format(hour, minute, now[2], now[3])
+            } else {
+                "%02d:%02d,%02d:%02d".format(now[0], now[1], hour, minute)
+            }
+            Settings.Secure.putStringForUser(mContext.contentResolver, SETTING, value,
+                UserHandle.USER_CURRENT)
+            updateState(preference)
+        }, h, m, DateFormat.is24HourFormat(mContext)).show()
+        return true
+    }
+
+    companion object {
+        const val KEY_FROM = "plait_doze_always_on_auto_time_from"
+        const val KEY_TILL = "plait_doze_always_on_auto_time_till"
+        private const val SETTING = "plait_doze_always_on_auto_time"
+        private const val DEFAULT = "20:00,07:00"
+    }
+}
+
+/** Always-on display rows: only on devices with an always-on display. */
+class AodAvailableSwitchController(context: Context, key: String) :
+    PlaitSwitchController(context, key) {
+    override fun getAvailabilityStatus() = aodAvailability(mContext)
+}
+
+private fun aodAvailability(context: Context): Int =
+    if (context.resources.getBoolean(
+            com.android.internal.R.bool.config_dozeAlwaysOnDisplayAvailable)) {
+        BasePreferenceController.AVAILABLE
+    } else {
+        BasePreferenceController.UNSUPPORTED_ON_DEVICE
+    }
