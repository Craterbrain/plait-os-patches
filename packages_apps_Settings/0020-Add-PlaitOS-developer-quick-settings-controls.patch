+package com.android.settings.development.qstile;
+
+import android.app.AlertDialog;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.database.ContentObserver;
+import android.hardware.display.DisplayManager;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserManager;
+import android.provider.Settings;
+import android.view.Display;
+import android.view.accessibility.AccessibilityManager;
+
+import com.android.settings.R;
+import com.android.settingslib.development.DevelopmentSettingsEnabler;
+
+import java.util.Map;
+import java.util.TreeMap;
+
+/** PlaitOS controls exposed through the existing developer tile configuration. */
+public final class PlaitDevelopmentTiles {
+    private PlaitDevelopmentTiles() {}
+
+    public abstract static class ObservedTile extends DevelopmentTiles {
+        private final ContentObserver mObserver = new ContentObserver(
+                new Handler(Looper.getMainLooper())) {
+            @Override
+            public void onChange(boolean selfChange) {
+                refresh();
+            }
+        };
+
+        protected abstract Uri[] observedSettings();
+
+        @Override
+        public void onStartListening() {
+            for (Uri uri : observedSettings()) {
+                getContentResolver().registerContentObserver(uri, false, mObserver);
+            }
+            super.onStartListening();
+        }
+
+        @Override
+        public void onStopListening() {
+            getContentResolver().unregisterContentObserver(mObserver);
+            super.onStopListening();
+        }
+    }
+
+    public static final class UsbDebugging extends ObservedTile {
+        @Override
+        protected Uri[] observedSettings() {
+            return new Uri[] {Settings.Global.getUriFor(Settings.Global.ADB_ENABLED)};
+        }
+
+        @Override
+        protected boolean isEnabled() {
+            return Settings.Global.getInt(getContentResolver(), Settings.Global.ADB_ENABLED, 0)
+                    != 0;
+        }
+
+        @Override
+        protected void setIsEnabled(boolean enabled) {
+            if (enabled && (!DevelopmentSettingsEnabler.isDevelopmentSettingsEnabled(this)
+                    || isLocked() || getSystemService(UserManager.class)
+                            .hasUserRestriction(UserManager.DISALLOW_DEBUGGING_FEATURES))) {
+                return;
+            }
+            Settings.Global.putInt(getContentResolver(), Settings.Global.ADB_ENABLED,
+                    enabled ? 1 : 0);
+        }
+
+        @Override
+        public void onClick() {
+            if (!DevelopmentSettingsEnabler.isDevelopmentSettingsEnabled(this)) {
+                refresh();
+                return;
+            }
+            if (isLocked()) {
+                unlockAndRun(this::onClick);
+                return;
+            }
+            if (isEnabled()) {
+                super.onClick();
+                return;
+            }
+
+            showDialog(new AlertDialog.Builder(this)
+                    .setTitle(com.android.settingslib.R.string.adb_warning_title)
+                    .setMessage(com.android.settingslib.R.string.adb_warning_message)
+                    .setPositiveButton(android.R.string.ok, (dialog, which) -> {
+                        setIsEnabled(true);
+                        refresh();
+                    })
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .create());
+        }
+    }
+
+    public static final class Grayscale extends ObservedTile {
+        private static final String ENABLED = Settings.Secure.ACCESSIBILITY_DISPLAY_DALTONIZER_ENABLED;
+        private static final String MODE = Settings.Secure.ACCESSIBILITY_DISPLAY_DALTONIZER;
+        private static final int MONOCHROME = AccessibilityManager.DALTONIZER_SIMULATE_MONOCHROMACY;
+
+        @Override
+        protected Uri[] observedSettings() {
+            return new Uri[] {Settings.Secure.getUriFor(ENABLED), Settings.Secure.getUriFor(MODE)};
+        }
+
+        @Override
+        protected boolean isEnabled() {
+            return Settings.Secure.getInt(getContentResolver(), ENABLED, 0) != 0
+                    && Settings.Secure.getInt(getContentResolver(), MODE, -1) == MONOCHROME;
+        }
+
+        @Override
+        protected void setIsEnabled(boolean enabled) {
+            SharedPreferences prefs = getSharedPreferences("grayscale_tile", MODE_PRIVATE);
+            if (enabled) {
+                prefs.edit()
+                        .putInt(ENABLED,
+                                Settings.Secure.getInt(getContentResolver(), ENABLED, 0))
+                        .putInt(MODE, Settings.Secure.getInt(getContentResolver(), MODE, -1))
+                        .apply();
+                Settings.Secure.putInt(getContentResolver(), MODE, MONOCHROME);
+                Settings.Secure.putInt(getContentResolver(), ENABLED, 1);
+            } else if (isEnabled()) {
+                Settings.Secure.putInt(getContentResolver(), ENABLED, prefs.getInt(ENABLED, 0));
+                if (prefs.contains(MODE)) {
+                    Settings.Secure.putInt(getContentResolver(), MODE, prefs.getInt(MODE, -1));
+                }
+                prefs.edit().clear().apply();
+            }
+        }
+    }
+
+    public static final class FrameRate extends ObservedTile {
+        private static final String MIN = Settings.System.MIN_REFRESH_RATE;
+        private static final String PEAK = Settings.System.PEAK_REFRESH_RATE;
+        private static final String SELECTED = "selected";
+        private static final String PREFS = "developer_refresh_rate_tile";
+
+        @Override
+        protected Uri[] observedSettings() {
+            return new Uri[] {Settings.System.getUriFor(MIN), Settings.System.getUriFor(PEAK)};
+        }
+
+        @Override
+        protected boolean isEnabled() {
+            return selectedRate(this) != 0f;
+        }
+
+        @Override
+        protected void setIsEnabled(boolean enabled) {
+            if (!enabled) {
+                restoreAdaptiveRate(this);
+            }
+        }
+
+        @Override
+        public void refresh() {
+            if (getQsTile() != null) {
+                float rate = selectedRate(this);
+                getQsTile().setSubtitle(rate == 0f
+                        ? getString(R.string.plait_refresh_rate_auto)
+                        : getString(R.string.screen_refresh_rate_displayed_text, Math.round(rate)));
+            }
+            super.refresh();
+        }
+
+        @Override
+        public void onClick() {
+            if (!DevelopmentSettingsEnabler.isDevelopmentSettingsEnabled(this)) {
+                refresh();
+                return;
+            }
+            Display display = getSystemService(DisplayManager.class)
+                    .getDisplay(Display.DEFAULT_DISPLAY);
+            if (display == null) {
+                return;
+            }
+            Map<Integer, Float> rates = new TreeMap<>();
+            for (float rate : display.getSupportedRefreshRates()) {
+                if (Math.round(rate) >= 30) {
+                    rates.putIfAbsent(Math.round(rate), rate);
+                }
+            }
+            float selected = selectedRate(this);
+            if (selected == 0f) {
+                restoreAdaptiveRate(this);
+            }
+            Float next = rates.entrySet().stream()
+                    .filter(entry -> entry.getKey() > Math.round(selected))
+                    .map(Map.Entry::getValue).findFirst().orElse(null);
+            if (next == null) {
+                restoreAdaptiveRate(this);
+            } else {
+                SharedPreferences prefs = getSharedPreferences(PREFS, MODE_PRIVATE);
+                var editor = prefs.edit();
+                if (selected == 0f) {
+                    editor.putString(MIN, Settings.System.getString(getContentResolver(), MIN))
+                            .putString(PEAK, Settings.System.getString(getContentResolver(), PEAK));
+                }
+                editor.putFloat(SELECTED, next).apply();
+                Settings.System.putFloat(getContentResolver(), MIN, next);
+                Settings.System.putFloat(getContentResolver(), PEAK, next);
+            }
+            refresh();
+        }
+
+        @Override
+        public void onTileRemoved() {
+            restoreAdaptiveRate(this);
+            super.onTileRemoved();
+        }
+
+        private static float selectedRate(Context context) {
+            float selected = context.getSharedPreferences(PREFS, MODE_PRIVATE)
+                    .getFloat(SELECTED, 0f);
+            var resolver = context.getContentResolver();
+            return matchesRate(resolver, MIN, selected) && matchesRate(resolver, PEAK, selected)
+                    ? selected : 0f;
+        }
+
+        private static boolean matchesRate(ContentResolver resolver, String key,
+                float rate) {
+            return rate != 0f && Settings.System.getFloat(resolver, key, 0f) == rate;
+        }
+
+        public static void restoreAdaptiveRate(Context context) {
+            SharedPreferences prefs = context.getSharedPreferences(PREFS, MODE_PRIVATE);
+            var resolver = context.getContentResolver();
+            float rate = prefs.getFloat(SELECTED, 0f);
+            if (matchesRate(resolver, MIN, rate)) {
+                Settings.System.putString(resolver, MIN, prefs.getString(MIN, null));
+            }
+            if (matchesRate(resolver, PEAK, rate)) {
+                Settings.System.putString(resolver, PEAK, prefs.getString(PEAK, null));
+            }
+            prefs.edit().clear().apply();
+        }
+    }
+}
