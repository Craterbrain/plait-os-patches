     } else {
         BasePreferenceController.UNSUPPORTED_ON_DEVICE
     }
+
+/**
+ * Icon style and shape: like any list, then restart the Settings screen so every icon on it is
+ * redrawn in the new style (rows are styled when a page is built).
+ */
+class PlaitIconStyleController(context: Context, key: String) : PlaitListController(context, key) {
+    private var activity: android.app.Activity? = null
+
+    override fun displayPreference(screen: PreferenceScreen) {
+        super.displayPreference(screen)
+        var c: Context? = screen.context
+        while (c is android.content.ContextWrapper && c !is android.app.Activity) c = c.baseContext
+        activity = c as? android.app.Activity
+    }
+
+    override fun onValueChanged(value: Int) {
+        activity?.recreate()
+    }
+}
diff --git a/src/com/android/settings/plait/PlaitIconStyler.kt b/src/com/android/settings/plait/PlaitIconStyler.kt
new file mode 100644
index 0000000..c799380
--- /dev/null
+++ b/src/com/android/settings/plait/PlaitIconStyler.kt
@@ -0,0 +1,176 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.plait
+
+import android.content.Context
+import android.content.res.Configuration
+import android.graphics.Color
+import android.graphics.drawable.AdaptiveIconDrawable
+import android.graphics.drawable.BitmapDrawable
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.LayerDrawable
+import android.os.UserHandle
+import android.provider.Settings
+import androidx.preference.Preference
+import androidx.preference.PreferenceGroup
+import kotlin.math.abs
+import kotlin.random.Random
+
+/**
+ * Settings icon styles, inspired by crDroid's "Settings style" options (icon style, corner style,
+ * random colors). Applied to the rows of every Settings page and to the home page tiles. Style 0
+ * leaves Settings exactly as stock.
+ *
+ * Settings.System keys (written from the PlaitOS page): plait_settings_icon_style (0-6, see
+ * [Style]), plait_settings_icon_corner_style (0 circle, 1 rounded square),
+ * plait_settings_icon_random_colors (0/1).
+ */
+object PlaitIconStyler {
+
+    enum class Style {
+        STOCK,
+        COLORED_BACKGROUND,
+        GRADIENT_BACKGROUND,
+        ACCENT_OUTLINE,
+        COLORED_OUTLINE,
+        COLORED_ICON,
+        ACCENT_ICON,
+    }
+
+    const val KEY_STYLE = "plait_settings_icon_style"
+    const val KEY_CORNER = "plait_settings_icon_corner_style"
+    const val KEY_RANDOM = "plait_settings_icon_random_colors"
+
+    /** Material 3 tones that read on light and dark backgrounds with a white symbol. */
+    private val PALETTE =
+        intArrayOf(
+            0xFF1E88E5.toInt(), // blue
+            0xFF43A047.toInt(), // green
+            0xFFE53935.toInt(), // red
+            0xFFFB8C00.toInt(), // orange
+            0xFF8E24AA.toInt(), // purple
+            0xFF00ACC1.toInt(), // cyan
+            0xFFD81B60.toInt(), // pink
+            0xFF3949AB.toInt(), // indigo
+            0xFF00897B.toInt(), // teal
+            0xFFFDD835.toInt(), // yellow
+            0xFF6D4C41.toInt(), // brown
+            0xFF546E7A.toInt(), // blue grey
+        )
+
+    /** Marks an icon this class made, so a refresh doesn't wrap it again. */
+    private class StyledIcon(layers: Array<Drawable>) : LayerDrawable(layers)
+
+    private fun style(context: Context): Style =
+        Style.entries.getOrElse(
+            Settings.System.getIntForUser(context.contentResolver, KEY_STYLE, 0,
+                UserHandle.USER_CURRENT)
+        ) { Style.STOCK }
+
+    /** Whether a non-stock style is chosen. */
+    @JvmStatic
+    fun isActive(context: Context?): Boolean = context != null && style(context) != Style.STOCK
+
+    /** Styles every row icon on [group] and its subgroups. */
+    @JvmStatic
+    fun styleIcons(group: PreferenceGroup?, context: Context?) {
+        if (group == null || context == null || style(context) == Style.STOCK) return
+        for (i in 0 until group.preferenceCount) {
+            val p = group.getPreference(i)
+            if (p is PreferenceGroup) styleIcons(p, context) else styleIcon(p, context)
+        }
+    }
+
+    /** Styles one row's icon (home page tiles get theirs after they load). */
+    @JvmStatic
+    fun styleIcon(preference: Preference, context: Context?) {
+        if (context == null) return
+        val style = style(context)
+        if (style == Style.STOCK) return
+        val icon = preference.icon ?: return
+        // App and account icons keep their own artwork; only symbol icons are restyled
+        if (icon is StyledIcon || icon is BitmapDrawable || icon is AdaptiveIconDrawable) return
+        val color = colorFor(preference.key, context)
+        val accent = accent(context)
+        preference.icon = styled(icon.mutate(), style, color, accent, context)
+    }
+
+    private fun styled(icon: Drawable, style: Style, color: Int, accent: Int, context: Context):
+        Drawable {
+        val density = context.resources.displayMetrics.density
+        val size = (36 * density).toInt()
+        val inset = (8 * density).toInt()
+        val circle = Settings.System.getIntForUser(context.contentResolver, KEY_CORNER, 0,
+            UserHandle.USER_CURRENT) == 0
+        fun shape() =
+            GradientDrawable().apply {
+                if (circle) shape = GradientDrawable.OVAL
+                else cornerRadius = size * 0.28f
+                setSize(size, size)
+            }
+        return when (style) {
+            Style.STOCK -> icon
+            Style.COLORED_BACKGROUND -> {
+                icon.setTint(Color.WHITE)
+                layered(shape().apply { setColor(color) }, icon, size, inset)
+            }
+            Style.GRADIENT_BACKGROUND -> {
+                icon.setTint(Color.WHITE)
+                val bg = shape().apply {
+                    colors = intArrayOf(lighten(color), color)
+                    orientation = GradientDrawable.Orientation.TL_BR
+                }
+                layered(bg, icon, size, inset)
+            }
+            Style.ACCENT_OUTLINE -> {
+                icon.setTint(accent)
+                val bg = shape().apply {
+                    setColor(Color.TRANSPARENT)
+                    setStroke((1.5f * density).toInt(), accent)
+                }
+                layered(bg, icon, size, inset)
+            }
+            Style.COLORED_OUTLINE -> {
+                icon.setTint(color)
+                val bg = shape().apply {
+                    setColor(Color.TRANSPARENT)
+                    setStroke((1.5f * density).toInt(), color)
+                }
+                layered(bg, icon, size, inset)
+            }
+            Style.COLORED_ICON -> icon.apply { setTint(color) }
+            Style.ACCENT_ICON -> icon.apply { setTint(accent) }
+        }
+    }
+
+    private fun layered(bg: Drawable, icon: Drawable, size: Int, inset: Int): Drawable =
+        StyledIcon(arrayOf(bg, icon)).apply {
+            setLayerSize(0, size, size)
+            setLayerInset(1, inset, inset, inset, inset)
+        }
+
+    /** A stable color per row (same row, same color), or a random one when chosen. */
+    private fun colorFor(key: String?, context: Context): Int {
+        val random = Settings.System.getIntForUser(context.contentResolver, KEY_RANDOM, 0,
+            UserHandle.USER_CURRENT) != 0
+        val index = if (random || key == null) Random.nextInt(PALETTE.size)
+                    else abs(key.hashCode() % PALETTE.size)
+        return PALETTE[index]
+    }
+
+    private fun accent(context: Context): Int {
+        val night = (context.resources.configuration.uiMode and
+            Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+        return context.getColor(
+            if (night) android.R.color.system_accent1_200 else android.R.color.system_accent1_600)
+    }
+
+    private fun lighten(color: Int): Int {
+        fun ch(c: Int) = c + ((255 - c) * 0.35f).toInt()
+        return Color.rgb(ch(Color.red(color)), ch(Color.green(color)), ch(Color.blue(color)))
+    }
+}
