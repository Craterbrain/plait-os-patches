--- a/res/values/plait_strings.xml
+++ b/res/values/plait_strings.xml
@@ -118,8 +118,8 @@
     <string name="plait_charge_limit_level_title">Charging limit</string>
     <string name="plait_charge_limit_alarm_title">Full before my alarm</string>
     <string name="plait_charge_limit_alarm_summary">From nine hours before your next alarm, charges slowly so the battery reaches 100% when it rings, then returns to the limit</string>
-    <string name="plait_downgrade_title">Allow app downgrades</string>
-    <string name="plait_downgrade_summary">Lets an older version of an app install over a newer one. Turns itself off after one downgrade, after an hour, or at restart</string>
+    <string name="plait_downgrade_title">Approve one app downgrade</string>
+    <string name="plait_downgrade_summary">Enter an installed app’s package name to allow one downgrade explicitly requested through ADB for the owner. Leave blank to cancel. Approval expires after an hour or at restart.</string>
     <string name="plait_tuner_title">System UI Tuner</string>
     <string name="plait_tuner_summary">More status bar and system UI options</string>
 
diff --git a/res/xml/plait_misc.xml b/res/xml/plait_misc.xml
index acca63c..314df9d 100644
--- a/res/xml/plait_misc.xml
+++ b/res/xml/plait_misc.xml
@@ -5,12 +5,15 @@
     xmlns:settings="http://schemas.android.com/apk/res-auto"
     android:key="plait_misc"
     android:title="@string/plait_tab_misc">
-    <SwitchPreferenceCompat
-        android:key="plait_pm_downgrade_allowed"
+    <EditTextPreference
+        android:key="plait_pm_downgrade_approval"
+        android:persistent="false"
