             "plait_settings_icon_style" to Key(SYSTEM, 1), // PlaitIconStyler.DEFAULT_STYLE
             "plait_settings_icon_corner_style" to Key(SYSTEM, 0),
@@ -121,6 +120,7 @@ object PlaitSettings {
     val STRING_KEYS: Map<String, PlaitTable> =
         mapOf(
             "plait_power_menu_actions" to SECURE,
+            "plait_pm_downgrade_approval" to GLOBAL,
             "plait_doze_always_on_auto_time" to SECURE,
         )
 
