             android:key="plait_charge_limit_enabled"
diff --git a/src/com/android/settings/plait/PlaitControllers.kt b/src/com/android/settings/plait/PlaitControllers.kt
index 6195c1f..3e74b5e 100644
--- a/src/com/android/settings/plait/PlaitControllers.kt
+++ b/src/com/android/settings/plait/PlaitControllers.kt
@@ -71,6 +71,27 @@ open class PlaitListController(context: Context, key: String) :
     protected open fun onValueChanged(value: Int) {}
 }
 
+/** An owner approval names an installed app and lasts for one explicitly requested ADB downgrade. */
+class PlaitDowngradeController(context: Context, key: String) :
+    BasePreferenceController(context, key), Preference.OnPreferenceChangeListener {
+
+    override fun getAvailabilityStatus() =
+        if (UserHandle.myUserId() == UserHandle.USER_SYSTEM) AVAILABLE else DISABLED_FOR_USER
+
+    override fun onPreferenceChange(preference: Preference, newValue: Any?): Boolean {
+        if (getAvailabilityStatus() != AVAILABLE) return false
+        val pkg = (newValue as? String)?.trim() ?: return false
+        val approval = if (pkg.isEmpty()) null else {
+            val installed = runCatching { mContext.packageManager.getApplicationInfo(pkg, 0) }.getOrNull()
+                ?: return false
+            if (installed.flags and android.content.pm.ApplicationInfo.FLAG_SYSTEM != 0) return false
+            val expires = android.os.SystemClock.elapsedRealtime() + 60 * 60 * 1000L
+            "$pkg:$expires:${java.util.UUID.randomUUID()}"
+        }
+        return Settings.Global.putString(mContext.contentResolver, preferenceKey, approval)
+    }
+}
+
 /** Switches only the main user may change (they act on the whole device). */
 class PlaitPrimaryUserSwitchController(context: Context, key: String) :
     PlaitSwitchController(context, key) {
