index 0000000..e19fa45
--- /dev/null
+++ b/res/xml/plait_slim_recents.xml
@@ -0,0 +1,57 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 (PlaitOS). Row keys are the settings they write. -->
+<PreferenceScreen
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:settings="http://schemas.android.com/apk/res-auto"
+    android:key="plait_slim_recents_screen"
+    android:title="@string/plait_slim_recents_title">
+    <SwitchPreferenceCompat
+        android:key="plait_slim_recents"
+        android:icon="@drawable/ic_plait_sysbar_recent"
+        android:title="@string/plait_slim_recents_title"
+        android:summary="@string/plait_slim_recents_summary"
+        settings:controller="com.android.settings.plait.PlaitSwitchController" />
+    <ListPreference
+        android:key="plait_slim_recents_gravity"
+        android:icon="@drawable/ic_plait_navbar_layout"
+        android:title="@string/plait_slim_recents_gravity_title"
+        android:entries="@array/plait_slim_recents_gravity_entries"
+        android:entryValues="@array/plait_slim_recents_gravity_values"
+        android:dependency="plait_slim_recents"
+        settings:controller="com.android.settings.plait.PlaitListController" />
+    <ListPreference
+        android:key="plait_slim_recents_expanded_mode"
+        android:icon="@drawable/ic_plait_grid_view"
+        android:title="@string/plait_slim_recents_expanded_title"
+        android:entries="@array/plait_slim_recents_expanded_entries"
+        android:entryValues="@array/plait_slim_recents_expanded_values"
+        android:dependency="plait_slim_recents"
+        settings:controller="com.android.settings.plait.PlaitListController" />
+    <ListPreference
+        android:key="plait_slim_recents_max_apps"
+        android:icon="@drawable/ic_plait_qs_tile"
+        android:title="@string/plait_slim_recents_max_apps_title"
+        android:entries="@array/plait_slim_recents_max_apps_entries"
+        android:entryValues="@array/plait_slim_recents_max_apps_values"
+        android:dependency="plait_slim_recents"
+        settings:controller="com.android.settings.plait.PlaitListController" />
+    <ListPreference
+        android:key="plait_slim_recents_scale"
+        android:icon="@drawable/ic_plait_tile_medium"
+        android:title="@string/plait_slim_recents_scale_title"
+        android:entries="@array/plait_slim_recents_scale_entries"
+        android:entryValues="@array/plait_slim_recents_scale_values"
+        android:dependency="plait_slim_recents"
+        settings:controller="com.android.settings.plait.PlaitListController" />
+    <SwitchPreferenceCompat
+        android:key="plait_slim_recents_mem_display"
+        android:icon="@drawable/ic_plait_controls_icon"
+        android:title="@string/plait_slim_recents_mem_title"
+        android:summary="@string/plait_slim_recents_mem_summary"
+        android:dependency="plait_slim_recents"
+        settings:controller="com.android.settings.plait.PlaitSwitchController" />
+    <com.android.settingslib.widget.FooterPreference
+        android:key="plait_slim_recents_footer"
+        android:title="@string/plait_slim_recents_help"
+        android:selectable="false" />
+</PreferenceScreen>
