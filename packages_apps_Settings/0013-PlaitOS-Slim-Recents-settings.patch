diff --git a/src/com/android/settings/plait/PlaitSlimRecentsFragment.java b/src/com/android/settings/plait/PlaitSlimRecentsFragment.java
new file mode 100644
index 0000000..72b2619
--- /dev/null
+++ b/src/com/android/settings/plait/PlaitSlimRecentsFragment.java
@@ -0,0 +1,37 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.plait;
+
+import android.app.settings.SettingsEnums;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+/** Slim Recents options (3-button navigation, and the Buttons tab). Rows and their controllers come from R.xml.plait_slim_recents. */
+@SearchIndexable
+public class PlaitSlimRecentsFragment extends DashboardFragment {
+    private static final String TAG = "PlaitSlimRecentsFragment";
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.plait_slim_recents;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.PAGE_UNKNOWN;
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.plait_slim_recents);
+}
