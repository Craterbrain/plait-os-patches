From 2adbf740e83a69712a2a582491ea2046c5f5d090 Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Sun, 15 Nov 2026 09:46:36 -0600
Subject: [PATCH 12/14] PlaitOS: colored-background icon style on by default

The PlaitOS look (colored background, white icon, circle) is the default
Settings icon style; "Material expressive (stock)" is still one of the
choices, and Reset PlaitOS settings returns to the colored style.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WNZzm3ssZ7eH5QDg4P9AiP
---
 src/com/android/settings/plait/PlaitIconStyler.kt | 13 ++++++++-----
 src/com/android/settings/plait/PlaitSettings.kt   |  2 +-
 2 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/src/com/android/settings/plait/PlaitIconStyler.kt b/src/com/android/settings/plait/PlaitIconStyler.kt
index c799380..842397b 100644
--- a/src/com/android/settings/plait/PlaitIconStyler.kt
+++ b/src/com/android/settings/plait/PlaitIconStyler.kt
@@ -22,8 +22,8 @@ import kotlin.random.Random
 
 /**
  * Settings icon styles, inspired by crDroid's "Settings style" options (icon style, corner style,
- * random colors). Applied to the rows of every Settings page and to the home page tiles. Style 0
- * leaves Settings exactly as stock.
+ * random colors). Applied to the rows of every Settings page and to the home page tiles. The
+ * default is [DEFAULT_STYLE]; style 0 leaves Settings exactly as stock.
  *
  * Settings.System keys (written from the PlaitOS page): plait_settings_icon_style (0-6, see
  * [Style]), plait_settings_icon_corner_style (0 circle, 1 rounded square),
@@ -45,6 +45,9 @@ object PlaitIconStyler {
     const val KEY_CORNER = "plait_settings_icon_corner_style"
     const val KEY_RANDOM = "plait_settings_icon_random_colors"
 
+    /** PlaitOS's own look by default: colored background, white icon (circle). */
+    @JvmField val DEFAULT_STYLE = Style.COLORED_BACKGROUND
+
     /** Material 3 tones that read on light and dark backgrounds with a white symbol. */
     private val PALETTE =
         intArrayOf(
@@ -67,9 +70,9 @@ object PlaitIconStyler {
 
     private fun style(context: Context): Style =
         Style.entries.getOrElse(
-            Settings.System.getIntForUser(context.contentResolver, KEY_STYLE, 0,
-                UserHandle.USER_CURRENT)
-        ) { Style.STOCK }
+            Settings.System.getIntForUser(context.contentResolver, KEY_STYLE,
+                DEFAULT_STYLE.ordinal, UserHandle.USER_CURRENT)
+        ) { DEFAULT_STYLE }
 
     /** Whether a non-stock style is chosen. */
     @JvmStatic
diff --git a/src/com/android/settings/plait/PlaitSettings.kt b/src/com/android/settings/plait/PlaitSettings.kt
index c2ef8d7..f9190c8 100644
--- a/src/com/android/settings/plait/PlaitSettings.kt
+++ b/src/com/android/settings/plait/PlaitSettings.kt
@@ -86,7 +86,7 @@ object PlaitSettings {
             // Misc
             "plait_pm_downgrade_allowed" to Key(GLOBAL, 0),
             // Settings style (PlaitIconStyler)
-            "plait_settings_icon_style" to Key(SYSTEM, 0),
+            "plait_settings_icon_style" to Key(SYSTEM, 1), // PlaitIconStyler.DEFAULT_STYLE
             "plait_settings_icon_corner_style" to Key(SYSTEM, 0),
             "plait_settings_icon_random_colors" to Key(SYSTEM, 0),
         )
