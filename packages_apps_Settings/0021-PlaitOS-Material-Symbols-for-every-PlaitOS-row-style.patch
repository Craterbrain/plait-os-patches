+    /**
+     * Styles the icon a row is drawn with, when the row is bound. Some controllers set their row's icon after the page
+     * was styled (Internet's Wi-Fi level, SIMs, Data Saver), which left a bare symbol among the tiles. Only the view is
+     * changed, from a copy of the icon: the preference keeps the controller's own drawable (and its level), and nothing
+     * here notifies the adapter, which must not happen during a bind.
+     */
+    @JvmStatic
+    fun styleBoundIcon(holder: PreferenceViewHolder, preference: Preference?) {
+        val context = holder.itemView.context ?: return
+        val style = style(context)
+        if (style == Style.STOCK || preference == null) return
+        val icon = preference.icon ?: return
+        if (!isLateSymbol(preference, icon)) return
+        val view = holder.findViewById(android.R.id.icon) as? ImageView ?: return
+        val copy = (icon.constantState?.newDrawable(context.resources) ?: return).mutate()
+        copy.level = icon.level
+        copy.state = icon.state
+        // A row is bound again on every scroll: keep its color stable even with random colors on
+        view.setImageDrawable(styled(copy, style, colorFor(preference.key, context, stable = true), accent(context), context))
+    }
+
+    /**
+     * Only symbol drawables are restyled at bind time: vectors, level/state lists of them (Wi-Fi level) and signal
+     * drawables. Rows filled in later also include app icons, which can be layers or badged drawables, so anything
+     * else, and any app row, keeps its own artwork.
+     */
+    private fun isLateSymbol(preference: Preference, icon: Drawable): Boolean {
+        if (icon is StyledIcon || preference.javaClass.simpleName.startsWith("App")) return false
+        return icon is android.graphics.drawable.VectorDrawable ||
+            icon is android.graphics.drawable.AnimatedVectorDrawable ||
+            icon is android.graphics.drawable.DrawableContainer ||
+            icon.javaClass.simpleName.contains("Signal")
+    }
