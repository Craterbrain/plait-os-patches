diff --git a/src/com/android/customization/picker/icon/ui/binder/PlaitIconPackBinder.kt b/src/com/android/customization/picker/icon/ui/binder/PlaitIconPackBinder.kt
new file mode 100644
index 0000000..b10260e
--- /dev/null
+++ b/src/com/android/customization/picker/icon/ui/binder/PlaitIconPackBinder.kt
@@ -0,0 +1,132 @@
+/*
+ * SPDX-FileCopyrightText: PlaitOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.customization.picker.icon.ui.binder
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.database.ContentObserver
+import android.graphics.drawable.Drawable
+import android.os.Handler
+import android.os.Looper
+import android.provider.Settings
+import android.view.View
+import android.view.ViewGroup
+import android.widget.ArrayAdapter
+import android.widget.ImageView
+import android.widget.TextView
+import androidx.lifecycle.DefaultLifecycleObserver
+import androidx.lifecycle.LifecycleOwner
+import com.android.themepicker.R
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+
+/**
+ * The "Icon pack" row of the App icons sheet: the system-wide icon pack (Settings.Secure
+ * plait_icon_pack), used by Launcher3 and, for the icons apps load through the package manager,
+ * by the framework. Installed packs are found by the actions launchers use for them.
+ */
+object PlaitIconPackBinder {
+
+    const val SETTING = "plait_icon_pack"
+
+    private val ICON_PACK_ACTIONS =
+        arrayOf(
+            "com.fede.launcher.THEME_ICONPACK",
+            "com.anddoes.launcher.THEME",
+            "com.novalauncher.THEME",
+            "com.teslacoilsw.launcher.THEME",
+            "com.gau.go.launcherex.theme",
+            "org.adw.launcher.THEMES",
+            "net.oneplus.launcher.icons.ACTION_PICK_ICON",
+            "org.adw.launcher.icons.ACTION_PICK_ICON",
+        )
+
+    private class Pack(val packageName: String, val label: CharSequence, val icon: Drawable?)
+
+    fun bind(view: View, lifecycleOwner: LifecycleOwner) {
+        val entry = view.requireViewById<View>(R.id.plait_icon_pack_entry)
+        val summary = view.requireViewById<TextView>(R.id.plait_icon_pack_summary)
+        val context = view.context
+        val update = { summary.text = currentLabel(context) }
+        update()
+        val observer =
+            object : ContentObserver(Handler(Looper.getMainLooper())) {
+                override fun onChange(selfChange: Boolean) = update()
+            }
+        context.contentResolver.registerContentObserver(
+            Settings.Secure.getUriFor(SETTING),
+            false,
+            observer,
+        )
+        lifecycleOwner.lifecycle.addObserver(
+            object : DefaultLifecycleObserver {
+                override fun onDestroy(owner: LifecycleOwner) {
+                    context.contentResolver.unregisterContentObserver(observer)
+                }
+            }
+        )
+        entry.setOnClickListener { showChooser(context) }
+    }
+
+    private fun current(context: Context): String =
+        Settings.Secure.getString(context.contentResolver, SETTING).orEmpty()
+
+    private fun currentLabel(context: Context): CharSequence {
+        val pack = current(context)
+        if (pack.isEmpty()) return context.getString(R.string.plait_icon_pack_none)
+        return installedPacks(context).firstOrNull { it.packageName == pack }?.label
+            ?: context.getString(R.string.plait_icon_pack_none)
+    }
+
+    private fun installedPacks(context: Context): List<Pack> {
+        val pm = context.packageManager
+        return ICON_PACK_ACTIONS.flatMap { action ->
+                pm.queryIntentActivities(Intent(action), PackageManager.GET_META_DATA)
+            }
+            .map { it.activityInfo.applicationInfo }
+            .distinctBy { it.packageName }
+            .map { Pack(it.packageName, it.loadLabel(pm), it.loadIcon(pm)) }
+            .sortedBy { it.label.toString().lowercase() }
+    }
+
+    private fun showChooser(context: Context) {
+        val none = Pack("", context.getString(R.string.plait_icon_pack_none), null)
+        val packs = listOf(none) + installedPacks(context)
+        val selected = packs.indexOfFirst { it.packageName == current(context) }.coerceAtLeast(0)
+        val adapter =
+            object :
+                ArrayAdapter<Pack>(
+                    context,
+                    android.R.layout.select_dialog_singlechoice,
+                    packs,
+                ) {
+                override fun getView(position: Int, convertView: View?, parent: ViewGroup): View {
+                    val row = super.getView(position, convertView, parent) as TextView
+                    val pack = packs[position]
+                    row.text = pack.label
+                    val size = (32 * context.resources.displayMetrics.density).toInt()
+                    pack.icon?.setBounds(0, 0, size, size)
+                    row.setCompoundDrawablesRelative(pack.icon, null, null, null)
+                    row.compoundDrawablePadding = size / 2
+                    return row
+                }
+            }
+        val builder =
+            MaterialAlertDialogBuilder(context)
+                .setTitle(R.string.plait_icon_pack_dialog_title)
+                .setSingleChoiceItems(adapter, selected) { dialog, which ->
+                    Settings.Secure.putString(
+                        context.contentResolver,
+                        SETTING,
+                        packs[which].packageName,
+                    )
+                    dialog.dismiss()
+                }
+                .setNegativeButton(android.R.string.cancel, null)
+        if (packs.size == 1) builder.setMessage(R.string.plait_icon_pack_get_more)
+        builder.show()
+    }
+}
