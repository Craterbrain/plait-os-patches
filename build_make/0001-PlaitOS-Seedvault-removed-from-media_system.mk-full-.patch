From 3f2a572faaad96a7fa9c4abe92359568d89cf7b4 Mon Sep 17 00:00:00 2001
From: Craterbrain <58347640+Craterbrain@users.noreply.github.com>
Date: Mon, 16 Nov 2026 11:13:48 -0600
Subject: [PATCH] PlaitOS: Seedvault removed from media_system.mk; full backups
 come from Plait Backup

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 target/product/media_system.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/target/product/media_system.mk b/target/product/media_system.mk
index 424844a..2fc06bf 100644
--- a/target/product/media_system.mk
+++ b/target/product/media_system.mk
@@ -40,7 +40,7 @@ ifeq ($(OFFICIAL_BUILD),true)
     PRODUCT_PACKAGES += Updater
 endif
 
-PRODUCT_PACKAGES += Seedvault
+# PlaitOS: Seedvault removed; full backups come from Plait Backup (plait-os docs/plait-backup-design.md)
 
 # Allowlist for system packages included in media_system.mk
 PRODUCT_PACKAGES += preinstalled-packages-media-system.xml
